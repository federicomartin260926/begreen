{% extends 'base.html.twig' %}

{% block title %}{{'auth.user_register'|trans}}{% endblock %}

{% block body %}

    <div class="text-center breadcrumb_container py-5">

        <!-- Contenido del Subheader -->
        <div class="container">
            <h1 class="fw-bold text-gray">{{'auth.user_register'|trans}}</h1>

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{ path('home') }}" class="text-decoration-none">{{"home"|trans}}</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        {{'auth.user_register'|trans}}
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container my-5">

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                {% for flash_error in app.flashes('verify_email_error') %}
                    <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                {% endfor %}

                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm) }}
                    {{ form_row(registrationForm.name) }}
                    {{ form_row(registrationForm.surnames) }}
                    {{ form_row(registrationForm.phone) }}
                    {{ form_row(registrationForm.email) }}
                    {{ form_row(registrationForm.plainPassword, {
                        label: 'auth.password'|trans
                    }) }}
                    {{ form_row(registrationForm.agreeTerms, {
                        label: 'auth.agree_terms'|trans
                    }) }}

                    <button type="submit" class="btn btn-success btn-begreen mt-3 btn">{{'auth.send'|trans}}</button>
                {{ form_end(registrationForm) }}

            </div>
        </div>

    </div>
{% endblock %}
