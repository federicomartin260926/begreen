{% extends 'base_backend.html.twig' %}

{% block title %}{{ (edit ? 'backend.crew_catalog.department.edit' : 'backend.crew_catalog.department.new')|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item"><a class="text-decoration-none" href="{{ path('admin_crew_catalog_index', {scope: return_scope}) }}">{{ 'backend.crew_catalog.title'|trans }}</a></li>
    <li class="breadcrumb-item active">{{ (edit ? 'backend.crew_catalog.department.edit' : 'backend.crew_catalog.department.new')|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
    <h2 class="mb-4">{{ (edit ? 'backend.crew_catalog.department.edit' : 'backend.crew_catalog.department.new')|trans }}</h2>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row">
            <div class="col-md-6">{{ form_row(form.name) }}</div>
            <div class="col-md-6">{{ form_row(form.name_en) }}</div>
            <div class="col-md-6">{{ form_row(form.scope) }}</div>
            <div class="col-md-6">{{ form_row(form.sortOrder) }}</div>
        </div>
        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('admin_crew_catalog_index', {scope: return_scope}) }}" class="btn btn-outline-secondary text-decoration-none">
                <i class="bi bi-arrow-left"></i> {{ 'backend.common.back'|trans }}
            </a>
            <button class="btn btn-success">{{ (edit ? 'backend.common.update' : 'backend.common.create')|trans }}</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
