{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.crew_catalog.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active">{{ 'backend.crew_catalog.title'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">{{ 'backend.crew_catalog.title'|trans }}</h2>
            <p class="text-muted mb-0">{{ 'backend.crew_catalog.intro'|trans }}</p>
        </div>
        <a href="{{ path('admin_crew_catalog_department_new', {scope: scope}) }}" class="btn btn-success text-decoration-none">
            <i class="bi bi-plus-lg"></i> {{ 'backend.crew_catalog.department.new'|trans }}
        </a>
    </div>

    <ul class="nav nav-tabs mb-4">
        {% for catalogScope in scopes %}
            <li class="nav-item">
                <a class="nav-link text-decoration-none {{ catalogScope == scope ? 'active' : '' }}"
                   href="{{ path('admin_crew_catalog_index', {scope: catalogScope}) }}">
                    {{ ('backend.crew_catalog.scope.' ~ catalogScope)|trans }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {% if departments is empty %}
        <div class="alert alert-info">{{ 'backend.crew_catalog.department.empty'|trans }}</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle green_table_1">
                <thead>
                    <tr>
                        <th class="text-center">{{ 'backend.crew_catalog.table.order'|trans }}</th>
                        <th>{{ 'backend.crew_catalog.table.department'|trans }}</th>
                        <th class="text-center">{{ 'backend.crew_catalog.table.positions'|trans }}</th>
                        <th class="text-center">{{ 'backend.common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for department in departments %}
                    <tr>
                        <td class="text-center">{{ department.sortOrder }}</td>
                        <td>{{ department.name }}</td>
                        <td class="text-center">
                            <a href="{{ path('admin_crew_catalog_positions', {id: department.id}) }}" class="btn btn-sm btn-outline-secondary text-decoration-none">
                                {{ department.positions|length }}
                            </a>
                        </td>
                        <td class="text-center text-nowrap">
                            <a href="{{ path('admin_crew_catalog_department_edit', {id: department.id}) }}" class="btn" title="{{ 'backend.common.edit'|trans }}">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form method="post" action="{{ path('admin_crew_catalog_department_delete', {id: department.id}) }}" class="d-inline"
                                  onsubmit="return confirm('{{ 'backend.crew_catalog.department.delete_confirm'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_crew_department_' ~ department.id) }}">
                                <button class="btn" title="{{ 'backend.common.delete'|trans }}"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
