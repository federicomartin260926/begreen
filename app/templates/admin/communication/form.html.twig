{% extends 'base_backend.html.twig' %}

{% block title %}
    {{ file.id ? 'backend.admin.communication.form.title_edit'|trans : 'backend.admin.communication.form.title_new'|trans }}
{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a class="text-decoration-none" href="{{ path('admin_communication_index') }}">{{ 'backend.admin.communication.form.breadcrumb.section'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ file.id ? 'backend.admin.communication.form.breadcrumb.edit'|trans : 'backend.admin.communication.form.breadcrumb.new'|trans }}
    </li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
            <h2 class="mb-4">
                {{ file.id ? 'backend.admin.communication.form.h2_edit'|trans : 'backend.admin.communication.form.h2_new'|trans }}
            </h2>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                <div class="mb-3">
                    {{ form_label(form.file) }}
                    {{ form_widget(form.file, {'attr': {'class': 'form-control'}}) }}
                    {% if is_edit and file is defined and file is not null and file.getFilename is defined and file.getFilename() %}
                        <small class="form-text text-muted mt-1">
                            {{ 'backend.admin.communication.form.current_file'|trans }} {{ file.getOriginalFilename() }}
                        </small>
                    {% endif %}
                    {{ form_help(form.file) }}
                    {{ form_errors(form.file) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('admin_communication_index') }}" class="btn btn-outline-secondary text-decoration-none">
                        <i class="bi bi-arrow-left"></i> {{ 'backend.admin.communication.form.back'|trans }}
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> {{ file.id ? 'backend.admin.communication.form.update'|trans : 'backend.admin.communication.form.save'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
</div>
{% endblock %}
