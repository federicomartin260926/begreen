{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.admin.communication.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.admin.communication.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}

    <div class="container my-4">
        <div class="row justify-content-center">
            <div class="col-12 bg-white p-4 rounded shadow">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="">{{ 'backend.admin.communication.title'|trans }}</h2>
                    <div class="d-flex gap-2">
                        <a href="{{ path('admin_communication_new') }}" class="btn btn-success text-decoration-none">
                            <i class="bi bi-plus-circle"></i> {{ 'backend.admin.communication.upload'|trans }}
                        </a>
                    </div>
                </div>

                {% if files is empty %}
                    <p>{{ 'backend.admin.communication.no_documents'|trans }}</p>
                {% else %}
                    <table class="table table-hover align-middle green_table_1">
                        <thead>
                            <tr>
                                <th>{{ 'backend.admin.communication.table.file'|trans }}</th>
                                <th>{{ 'backend.admin.communication.table.description'|trans }}</th>
                                <th>{{ 'backend.admin.communication.table.uploaded_at'|trans }}</th>
                                <th class="text-center dt-nosort">{{ 'backend.admin.communication.table.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for file in files %}
                                <tr>
                                    <td>{{ file.originalFilename }}</td>
                                    <td>{{ file.description|default('—') }}</td>
                                    <td>{{ file.uploadedAt|date('d/m/Y H:i') }}</td>
                                    <td class="text-center">
                                        <a
                                            href="{{ path('admin_communication_edit', {'id': file.id}) }}"
                                            data-bs-toggle="popover"
                                            data-bs-trigger="hover"
                                            data-bs-placement="right"
                                            data-bs-content="{{ 'backend.admin.communication.action.edit'|trans }}"
                                            class="btn">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a
                                            href="{{ path('admin_communication_download', {'id': file.id}) }}"
                                            data-bs-toggle="popover"
                                            data-bs-trigger="hover"
                                            data-bs-placement="right"
                                            data-bs-content="{{ 'backend.admin.communication.action.download'|trans }}"
                                            class="btn"
                                            target="_blank"
                                            rel="noopener">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_communication_delete', {id: file.id}) }}" onsubmit="return confirm('{{ 'backend.admin.communication.confirm_delete'|trans }}');" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_file_' ~ file.id) }}">
                                            <button
                                                data-bs-toggle="popover"
                                                data-bs-trigger="hover"
                                                data-bs-placement="right"
                                                data-bs-content="{{ 'backend.admin.communication.action.delete'|trans }}"
                                                class="btn">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
