{% extends 'base_backend.html.twig' %}

{% block title %}{{ edit ? 'backend.measures.form.title_edit'|trans : 'backend.measures.form.title_new'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a class="text-decoration-none" href="{{ path('admin_measures_index') }}">{{ 'backend.measures.list.breadcrumb'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ edit ? measure.name : 'backend.common.new'|trans }}
    </li>
{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-12 bg-white p-4 rounded shadow">
        <h2 class="mb-5">{{ edit ? 'backend.measures.form.h2_edit'|trans : 'backend.measures.form.h2_new'|trans }}</h2>

        {{ form_start(form, {
            attr: {
                'data-controller': 'measure-form',
                'data-measure-form-departments-base-value': path('admin_departments_by_protocol'),
                'data-measure-form-measure-blocks-base-value': path('admin_measure_blocks_by_protocol'),
                'data-measure-form-current-department-value': edit and measure.department ? measure.department.id : '',
                'data-measure-form-current-measure-block-value': edit and measure.measureBlock ? measure.measureBlock.id : ''
            }
        }) }}
            {{ form_errors(form) }}
            {# ==========================
               Campos no traducibles
               ========================== #}
            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_label(form.protocol) }}
                    {{ form_widget(form.protocol, {
                        attr: {
                            class: 'form-select',
                            'data-measure-form-target': 'protocol',
                            'data-action': 'change->measure-form#onProtocolChange'
                        }
                    }) }}
                    {{ form_errors(form.protocol) }}
                </div>

                <div class="col-md-4 mb-3">
                    {{ form_label(form.category) }}
                    {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.category) }}
                </div>

                <div class="col-md-4 mb-3">
                    {{ form_label(form.measureBlock) }}
                    {{ form_widget(form.measureBlock, {
                        'attr': {
                            'class': 'form-select',
                            'data-measure-form-target': 'measureBlock'
                        }
                    }) }}
                    {{ form_errors(form.measureBlock) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_label(form.sortOrder) }}
                    {{ form_widget(form.sortOrder, {'attr': {'class': 'form-control', 'min': 0}}) }}
                    {{ form_errors(form.sortOrder) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_label(form.categoryGhg) }}
                    {{ form_widget(form.categoryGhg, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.categoryGhg) }}
                </div>

                <div class="col-md-4 mb-3">
                    {{ form_label(form.esg) }}
                    {{ form_widget(form.esg, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.esg) }}
                </div>

                <div class="col-md-4 mb-3">
                    {{ form_label(form.scope) }}
                    {{ form_widget(form.scope, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.scope) }}
                </div>
            </div>

            {# ==========================
               TABS de traducción (ES / EN)
               ========================== #}
            <hr>
            <div class="mb-4">
                <ul class="nav nav-tabs" id="i18nTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link bg_tabs_lang active" id="tab-es"
                                data-bs-toggle="tab" data-bs-target="#pane-es"
                                type="button" role="tab" aria-controls="pane-es" aria-selected="true">
                            ES
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link bg_tabs_lang" id="tab-en"
                                data-bs-toggle="tab" data-bs-target="#pane-en"
                                type="button" role="tab" aria-controls="pane-en" aria-selected="false">
                            EN
                        </button>
                    </li>
                </ul>

                <div class="tab-content bg_tabs_lang border-start border-end border-bottom p-3 rounded-bottom" id="i18nTabsContent">
                    {# --- Español (valores base mapeados a la entidad) --- #}
                    <div class="tab-pane fade show active" id="pane-es" role="tabpanel" aria-labelledby="tab-es" tabindex="0">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                {{ form_label(form.name) }}
                                {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.name) }}
                            </div>
                            <div class="col-md-12 mb-3">
                                {{ form_label(form.nameReview) }}
                                {{ form_widget(form.nameReview, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.nameReview) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.implementation) }}
                            {{ form_widget(form.implementation, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.implementation) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.departmentActionText) }}
                            {{ form_widget(form.departmentActionText, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.departmentActionText) }}
                        </div>
                    </div>

                    {# --- Inglés (campos unmapped *_en) --- #}
                    <div class="tab-pane fade" id="pane-en" role="tabpanel" aria-labelledby="tab-en" tabindex="0">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                {{ form_label(form.name_en) }}
                                {{ form_widget(form.name_en, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.name_en) }}
                            </div>
                            <div class="col-md-12 mb-3">
                                {{ form_label(form.nameReview_en) }}
                                {{ form_widget(form.nameReview_en, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.nameReview_en) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description_en) }}
                            {{ form_widget(form.description_en, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.description_en) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.implementation_en) }}
                            {{ form_widget(form.implementation_en, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.implementation_en) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.departmentActionText_en) }}
                            {{ form_widget(form.departmentActionText_en, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.departmentActionText_en) }}
                        </div>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.departments) }}
                    {{ form_widget(form.departments, {
                        'attr': {
                            'class': 'form-select',
                            'size': '6',
                            'data-measure-form-target': 'department'
                        }
                    }) }}
                    {{ form_errors(form.departments) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.odsItems) }}
                    {{ form_widget(form.odsItems, {'attr': {'class': 'form-select', 'size': '6'}}) }}
                    {{ form_errors(form.odsItems) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.impactAreas) }}
                    {{ form_widget(form.impactAreas, {'attr': {'class': 'form-select', 'size': '6'}}) }}
                    {{ form_errors(form.impactAreas) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.tripleBalanceAxes) }}
                    {{ form_widget(form.tripleBalanceAxes, {'attr': {'class': 'form-select', 'size': '6'}}) }}
                    {{ form_errors(form.tripleBalanceAxes) }}
                </div>
            </div>

            <hr>
            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_label(form.verificationSourcePriority1) }}
                    {{ form_widget(form.verificationSourcePriority1, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.verificationSourcePriority1) }}
                </div>
                <div class="col-md-4 mb-3">
                    {{ form_label(form.verificationSourcePriority2) }}
                    {{ form_widget(form.verificationSourcePriority2, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.verificationSourcePriority2) }}
                </div>
                <div class="col-md-4 mb-3">
                    {{ form_label(form.verificationSourcePriority3) }}
                    {{ form_widget(form.verificationSourcePriority3, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.verificationSourcePriority3) }}
                </div>
            </div>

            <hr>
            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_label(form.score) }}
                    {{ form_widget(form.score, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.score) }}
                </div>

                <div class="col-md-4 mb-3">
                    {{ form_label(form.mandatory) }}
                    <div class="form-check mt-2">
                        {{ form_widget(form.mandatory, {'attr': {'class': 'form-check-input'}}) }}
                    </div>
                    {{ form_errors(form.mandatory) }}
                </div>
            </div>

            <hr>

            <div class="d-flex justify-content-between">
                <a href="{{ path('admin_measures_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> {{ 'backend.common.back'|trans }}
                </a>
                <button class="btn btn-primary">
                    <i class="bi bi-save"></i> {{ edit ? 'backend.common.update'|trans : 'backend.common.create'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
