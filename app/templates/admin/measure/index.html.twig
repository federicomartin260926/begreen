{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.measures.list.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.measures.list.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container my-4">

    <div class="row justify-content-center">
        <div class="col-12 bg-white p-4 rounded shadow">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="">{{ 'backend.measures.list.h2'|trans }}</h2>
                <div class="d-flex gap-2">
                    <a href="{{ path('admin_measures_new') }}" class="btn btn-success text-decoration-none">
                        <i class="bi bi-plus-circle"></i> {{ 'backend.measures.actions.new'|trans }}
                    </a>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
                <div class="d-flex gap-2">
                    <a href="{{ path('admin_measures_export_pdf') }}" class="btn btn-outline-primary text-decoration-none">
                        <i class="bi bi-file-earmark-pdf"></i> {{ 'backend.measures.actions.download_pdf'|trans }}
                    </a>
                    <a href="{{ path('admin_measures_export_excel') }}" class="btn btn-outline-success text-decoration-none" download>
                        <i class="bi bi-file-earmark-excel"></i> {{ 'backend.measures.actions.download_excel'|trans }}
                    </a>
                    <a
                        href="{{ path('admin_measures_template_download') }}"
                        class="btn btn-outline-primary text-decoration-none"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover"
                        data-bs-content="{{ 'backend.measures.actions.download_template_hint'|trans }}"
                        download>
                        <i class="bi bi-download"></i> {{ 'backend.measures.actions.download_template'|trans }}
                    </a>
                    <a href="#" class="btn btn-outline-primary text-decoration-none" data-bs-toggle="modal" data-bs-target="#importModal">
                        <i class="bi bi-upload"></i> {{ 'backend.measures.actions.import_excel'|trans }}
                    </a>
                </div>
            </div>

            <div class="alert alert-info small mb-4" role="alert">
                {{ 'backend.measures.template.order_note'|trans }}
            </div>

            {% if catalogSummary is defined %}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                            <div>
                                <h5 class="card-title mb-1">{{ 'backend.measures.summary.title'|trans }}</h5>
                                <div class="text-muted small">{{ 'backend.measures.summary.description'|trans }}</div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-6 col-lg-2">
                                <div class="border rounded p-3 h-100 d-flex flex-column">
                                    <div class="small text-muted flex-grow-1">Medidas</div>
                                    <div class="fs-4 fw-semibold mt-auto">{{ catalogSummary.totalMeasures }}</div>
                                </div>
                            </div>
                            <div class="col-6 col-lg-2">
                                <div class="border rounded p-3 h-100 d-flex flex-column">
                                    <div class="small text-muted flex-grow-1">Puntos</div>
                                    <div class="fs-4 fw-semibold mt-auto">{{ catalogSummary.totalPoints }}</div>
                                </div>
                            </div>
                            {% for score in [5, 4, 3, 2, 1] %}
                                <div class="col-6 col-lg-1">
                                    <div class="border rounded p-3 h-100 text-center d-flex flex-column">
                                        <div class="small text-muted flex-grow-1">{{ score }} pts</div>
                                        <div class="fs-5 fw-semibold mt-auto">{{ catalogSummary.scoreDistribution[score] ?? 0 }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6 col-xl-2">
                                <div class="border rounded p-3 h-100 d-flex flex-column">
                                    <div class="small text-muted flex-grow-1">Sin departamentos múltiples</div>
                                    <div class="fw-semibold mt-auto">{{ catalogSummary.missingDepartments }}</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-xl-2">
                                <div class="border rounded p-3 h-100 d-flex flex-column">
                                    <div class="small text-muted flex-grow-1">Sin ODS múltiples</div>
                                    <div class="fw-semibold mt-auto">{{ catalogSummary.missingOds }}</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-xl-2">
                                <div class="border rounded p-3 h-100 d-flex flex-column">
                                    <div class="small text-muted flex-grow-1">Sin fuentes de verificación</div>
                                    <div class="fw-semibold mt-auto">{{ catalogSummary.missingVerificationSources }}</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-xl-3">
                                <div class="border rounded p-3 h-100 d-flex flex-column">
                                    <div class="small text-muted flex-grow-1">Sin áreas de impacto</div>
                                    <div class="fw-semibold mt-auto">{{ catalogSummary.missingImpactAreas }}</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-xl-3">
                                <div class="border rounded p-3 h-100 d-flex flex-column">
                                    <div class="small text-muted flex-grow-1">Sin triple balance</div>
                                    <div class="fw-semibold mt-auto">{{ catalogSummary.missingTripleBalanceAxes }}</div>
                                </div>
                            </div>
                        </div>

                        {% if not catalogSummary.isExpected %}
                            <div class="alert alert-warning mt-3 mb-0">
                                {{ 'backend.measures.summary.alert'|trans }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <div
                class="d-flex gap-3 mb-4 align-items-end flex-wrap bg_green_3 p-3"
                data-controller="measure-block-filter"
                data-measure-block-filter-measure-blocks-base-value="{{ path('admin_measure_blocks_by_protocol') }}"
                data-measure-block-filter-select-protocol-first-value="{{ 'backend.measures.filters.select_protocol_first'|trans }}"
                data-measure-block-filter-all-blocks-value="{{ 'backend.measures.filters.all_blocks'|trans }}"
                data-measure-block-filter-no-blocks-value="{{ 'backend.measures.filters.no_blocks'|trans }}">
                <select id="filter-protocol" class="form-select" style="max-width: 200px;" data-dt-filter="2" data-action="change->measure-block-filter#onProtocolChange">
                    <option value="">{{ 'backend.measures.filters.all_protocols'|trans }}</option>
                    {% set protocols = [] %}
                    {% for measure in measures %}
                        {% if measure.protocol and measure.protocol.name not in protocols %}
                            {% set protocols = protocols|merge([measure.protocol.name]) %}
                            <option value="{{ measure.protocol.name }}" data-protocol-id="{{ measure.protocol.id }}">{{ measure.protocol.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <select
                    id="filter-block"
                    class="form-select"
                    style="max-width: 240px;"
                    data-measure-block-filter-target="block"
                    data-action="change->measure-block-filter#onBlockChange"
                    disabled>
                    <option value="">{{ 'backend.measures.filters.select_protocol_first'|trans }}</option>
                </select>

                <select id="filter-emission-source" class="form-select" style="max-width: 200px;" data-dt-filter="3">
                    <option value="">{{ 'backend.measures.filters.all_ghg_categories'|trans }}</option>
                    {% set sources = [] %}
                    {% for measure in measures %}
                        {% if measure.categoryGhg and measure.categoryGhg.name not in sources %}
                            {% set sources = sources|merge([measure.categoryGhg.name]) %}
                            <option value="{{ measure.categoryGhg.name }}">{{ measure.categoryGhg.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <select id="filter-category" class="form-select" style="max-width: 200px;" data-dt-filter="4">
                    <option value="">{{ 'backend.measures.filters.all_categories'|trans }}</option>
                    {% set categories = [] %}
                    {% for measure in measures %}
                        {% if measure.category and measure.category.name not in categories %}
                            {% set categories = categories|merge([measure.category.name]) %}
                            <option value="{{ measure.category.name }}">{{ measure.category.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <select id="filter-department" class="form-select" style="max-width: 200px;" data-dt-filter="5">
                    <option value="">{{ 'backend.measures.filters.all_departments'|trans }}</option>
                    {% set departments = [] %}
                    {% for measure in measures %}
                        {% if measure.department and measure.department.name not in departments %}
                            {% set departments = departments|merge([measure.department.name]) %}
                            <option value="{{ measure.department.name }}">{{ measure.department.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <select id="filter-ods" class="form-select" style="max-width: 200px;" data-dt-filter="9">
                    <option value="">{{ 'backend.measures.filters.all_ods'|trans }}</option>
                    {% set odsList = [] %}
                    {% for measure in measures %}
                        {% if measure.ods and measure.ods.name not in odsList %}
                            {% set odsList = odsList|merge([measure.ods.name]) %}
                            <option value="{{ measure.ods.name }}">{{ measure.ods.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <select id="filter-esg" class="form-select" style="max-width: 200px;" data-dt-filter="10">
                    <option value="">{{ 'backend.measures.filters.all_esg'|trans }}</option>
                    {% set esgList = [] %}
                    {% for measure in measures %}
                        {% if measure.esg and measure.esg.name not in esgList %}
                            {% set esgList = esgList|merge([measure.esg.name]) %}
                            <option value="{{ measure.esg.name }}">{{ measure.esg.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <select id="filter-scope" class="form-select" style="max-width: 200px;" data-dt-filter="11">
                    <option value="">{{ 'backend.measures.filters.all_scopes'|trans }}</option>
                    {% set scopeList = [] %}
                    {% for measure in measures %}
                        {% if measure.scope and measure.scope.name not in scopeList %}
                            {% set scopeList = scopeList|merge([measure.scope.name]) %}
                            <option value="{{ measure.scope.name }}">{{ measure.scope.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <select id="filter-mandatory" class="form-select" style="max-width: 200px;" data-dt-filter="13">
                    <option value="">{{ 'backend.measures.filters.all_mandatory'|trans }}</option>
                    <option value="{{ 'backend.common.yes'|trans }}">{{ 'backend.measures.filters.only_mandatory'|trans }}</option>
                    <option value="{{ 'backend.common.no'|trans }}">{{ 'backend.measures.filters.only_not_mandatory'|trans }}</option>
                </select>

                <div class="d-flex align-items-end gap-2">
                    <div>
                        <input type="number"
                            class="form-control"
                            style="min-width: 160px; max-width: 200px;"
                            placeholder="{{ 'backend.measures.filters.score_min'|trans }}"
                            min="0" max="100" step="1"
                            data-dt-range-min="12"
                            data-dt-for="#measures-table">
                    </div>
                    <div>
                        <input type="number"
                            class="form-control"
                            style="min-width: 160px; max-width: 200px;"
                            placeholder="{{ 'backend.measures.filters.score_max'|trans }}"
                            min="0" max="100" step="1"
                            data-dt-range-max="12"
                            data-dt-for="#measures-table">
                    </div>
                </div>

                <button type="button" class="btn btn-outline-secondary" id="reset-dt-filters" data-action="click->measure-block-filter#reset">
                    <i class="bi bi-x-circle"></i> {{ 'backend.measures.filters.reset'|trans }}
                </button>
            </div>

            {% if measures is empty %}
                <div class="alert alert-info">{{ 'backend.measures.list.empty'|trans }}</div>
            {% else %}
                <div class="table-responsive">
                    <table id="measures-table"
                        class="table table-hover green_table_1 table-bordered dt-responsive w-100 measure-table measure-table--compact"
                        data-controller="datatable"
                        data-dt-mode="compact-details"
                        data-dt-order="1,asc">
                        <thead>
                            <tr>
                                <th class="dt-nosort" aria-hidden="true"></th>
                                <th>{{ 'backend.measures.table.name'|trans }}</th>
                                <th>{{ 'backend.measures.table.protocol'|trans }}</th>
                                <th>{{ 'backend.measures.table.ghg_category'|trans }}</th>
                                <th>{{ 'backend.measures.table.category'|trans }}</th>
                                <th>{{ 'backend.measures.table.department'|trans }}</th>
                                <th>{{ 'backend.measures.table.description'|trans }}</th>
                                <th>{{ 'backend.measures.table.implementation'|trans }}</th>
                                <th>{{ 'backend.measures.table.verification_sources'|trans }}</th>
                                <th>{{ 'backend.measures.table.ods'|trans }}</th>
                                <th>{{ 'backend.measures.table.esg'|trans }}</th>
                                <th>{{ 'backend.measures.table.scope'|trans }}</th>
                                <th class="text-center">{{ 'backend.measures.table.score'|trans }}</th>
                                <th class="text-center">{{ 'backend.measures.table.mandatory'|trans }}</th>
                                <th>{{ 'backend.measures.form.measure_block'|trans }}</th>
                                <th>{{ 'backend.measures.form.departments'|trans }}</th>
                                <th>{{ 'backend.measures.form.ods_items'|trans }}</th>
                                <th>{{ 'backend.measures.form.verification_source_priority_1'|trans }}</th>
                                <th>{{ 'backend.measures.form.impact_areas'|trans }}</th>
                                <th>{{ 'backend.measures.form.triple_balance_axes'|trans }}</th>
                                <th class="text-center dt-head-center dt-nosort">{{ 'backend.common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for measure in measures %}
                                {# --- construir lista de campos faltantes --- #}
                                {% set missing = [] %}
                                {% if measure.name is empty %}{% set missing = missing|merge(['Nombre']) %}{% endif %}
                                {% if measure.department is null %}{% set missing = missing|merge(['Departamento']) %}{% endif %}
                                {% if measure.category is null %}{% set missing = missing|merge(['Categoría']) %}{% endif %}
                                {% if measure.protocol is null %}{% set missing = missing|merge(['Protocolo']) %}{% endif %}
                                {% if measure.ods is null %}{% set missing = missing|merge(['ODS']) %}{% endif %}
                                {% if measure.esg is null %}{% set missing = missing|merge(['ESG']) %}{% endif %}
                                {% if measure.scope is null %}{% set missing = missing|merge(['Alcance']) %}{% endif %}
                                {% if measure.categoryGhg is null %}{% set missing = missing|merge(['Categoría GHG']) %}{% endif %}
                                {% set departmentsMulti = taxonomyPresenter.departments(measure) %}
                                {% set odsMulti = taxonomyPresenter.odsBadges(measure) %}
                                {% set verificationLinks = taxonomyPresenter.verificationSourcesWithPriority(measure) %}
                                {% set impactAreas = taxonomyPresenter.impactAreas(measure) %}
                                {% set axes = taxonomyPresenter.tripleBalanceAxes(measure) %}

                                {% set isComplete = missing is empty %}
                                <tr>
                                    <td></td>
                                <td class="measure-main-cell">
                                        {% if isComplete %}
                                            <i class="bi bi-check-circle-fill text-success me-1"
                                                tabindex="0" role="button"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="hover focus"
                                                data-bs-placement="top"
                                                data-bs-container="body"
                                                data-bs-title="{{ 'backend.admin.measure.popover.complete.title'|trans }}"
                                                data-bs-content="{{ 'backend.admin.measure.popover.complete.content'|trans }}"
                                                aria-label="{{ 'backend.admin.measure.popover.complete.aria'|trans }}">
                                            </i>
                                        {% else %}
                                            <i class="bi bi-x-circle-fill text-danger me-1"
                                                tabindex="0" role="button"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="hover focus"
                                                data-bs-placement="top"
                                                data-bs-container="body"
                                                data-bs-title="{{ 'backend.admin.measure.popover.incomplete.title'|trans }}"
                                                data-bs-content="{{ 'backend.admin.measure.popover.incomplete.content'|trans({'%missing%': missing|join(', ')}) }}"
                                                aria-label="{{ 'backend.admin.measure.popover.incomplete.aria'|trans }}">
                                            </i>
                                        {% endif %}
                                        <span class="measure-main-label">{{ measure.name }}</span>
                                    </td>
                                    <td class="measure-detail-cell">{{ measure.protocol ? measure.protocol.name : '' }}</td>
                                    <td class="measure-detail-cell">{{ measure.categoryGhg ? measure.categoryGhg.name : '' }}</td>
                                    <td class="measure-detail-cell">{{ measure.category ? measure.category.name : '' }}</td>
                                    <td class="measure-detail-cell">{{ measure.department ? measure.department.name : '' }}</td>
                                    <td class="measure-detail-cell">{{ measure.description ? measure.description : '' }}</td>
                                    <td class="measure-detail-cell">{{ measure.implementation ? measure.implementation : '' }}</td>
                                    <td class="measure-detail-cell">{{ measure.verificationSources ? measure.verificationSources : '' }}</td>
                                    <td class="measure-detail-cell">
                                        {% if odsMulti is not empty %}
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for item in odsMulti %}
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border"
                                                          title="{{ item.title|default(item.label) }}">
                                                        {{ item.badgeLabel|default(item.label) }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="measure-detail-cell">{{ measure.esg ? measure.esg.name : '' }}</td>
                                    <td class="measure-detail-cell">{{ measure.scope ? measure.scope.name : '' }}</td>
                                    <td class="text-center">
                                        {% if measure.score is not null %}
                                            <span class="badge bg-success">{{ measure.score }}</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if measure.mandatory %}
                                            <span class="badge bg-success">{{ 'backend.common.yes'|trans }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ 'backend.common.no'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="measure-detail-cell">{{ measure.measureBlock ? measure.measureBlock.name : '—' }}</td>
                                    <td class="measure-detail-cell">
                                        {% if departmentsMulti is not empty %}
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for item in departmentsMulti %}
                                                    <span class="badge bg-light text-dark border">{{ item.displayName }}</span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="measure-detail-cell">
                                        {% if odsMulti is not empty %}
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for item in odsMulti %}
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border"
                                                          title="{{ item.title|default(item.label) }}">
                                                        {{ item.badgeLabel|default(item.label) }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="measure-detail-cell">
                                        {% if verificationLinks is not empty %}
                                            <ol class="mb-0 ps-3">
                                                {% for link in verificationLinks %}
                                                    <li>{{ link.priority }}. {{ link.displayName }}</li>
                                                {% endfor %}
                                            </ol>
                                        {% else %}
                                            {{ measure.verificationSources ? measure.verificationSources : '—' }}
                                        {% endif %}
                                    </td>
                                    <td class="measure-detail-cell">
                                        {% if impactAreas is not empty %}
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for item in impactAreas %}
                                                    <span class="badge bg-success-subtle text-success-emphasis border">{{ item.name }}</span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="measure-detail-cell">
                                        {% if axes is not empty %}
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for item in axes %}
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border">{{ item.name }}</span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <div class="d-flex justify-content-center align-items-center gap-1">
                                            <a
                                                href="{{ path('admin_measures_edit', {'id': measure.id}) }}"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="hover"
                                                data-bs-content="{{ 'backend.common.edit'|trans }}"
                                                class="btn">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <form
                                                method="post"
                                                action="{{ path('admin_measures_delete', {'id': measure.id}) }}"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="hover"
                                                data-bs-content="{{ 'backend.common.delete'|trans }}"
                                                class="d-inline"
                                                onsubmit="return confirm('{{ 'backend.common.confirm'|trans }}');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_measure_' ~ measure.id) }}">
                                                <button class="btn">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

        </div>
    </div>
</div>

{# Modal de importación #}
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg"> {# más ancho para que quepan las notas #}
    <div class="modal-content">
      <form method="post" action="{{ path('admin_measures_import') }}" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title" id="importModalLabel">{{ 'backend.measures.import.title'|trans }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            {{ form_widget(importForm.file, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(importForm.file) }}
            <div class="form-text">
              {{ 'backend.measures.import.lang_info_title'|trans }}
            </div>
          </div>

          <div class="alert alert-info mt-2 small" role="alert">
            {{ 'backend.measures.import.order_note'|trans }}
          </div>

          <div class="alert alert-info mt-2 small" role="alert">
            {{ 'backend.measures.import.lang_info_html'|trans|raw }}
          </div>

          {{ form_rest(importForm) }}
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'backend.common.cancel'|trans }}</button>
          <button type="submit" class="btn btn-primary">{{ 'backend.measures.import.cta'|trans }}</button>
        </div>
      </form>
    </div>
  </div>
</div>

{% endblock %}
