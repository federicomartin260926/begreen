{% extends 'base_backend.html.twig' %}
{% block title %}{{ 'backend.cms.logo.title'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item"><a href="{{ path('admin_cms_index') }}">{{ 'backend.cms.index.breadcrumb'|trans }}</a></li>
  <li class="breadcrumb-item active">{{ 'backend.cms.logo.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2">{{ 'backend.cms.logo.h1'|trans }}</h1>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#logoSettingsModal">
          <i class="bi bi-gear"></i> {{ 'backend.common.edit'|trans }}
        </button>
      </div>

      <div class="table-responsive">
        <table class="table table-hover green_table_1">
          <thead>
            <tr>
              <th>{{ 'backend.cms.logo.table.param'|trans }}</th>
              <th>{{ 'backend.cms.logo.table.value'|trans }}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{{ 'backend.cms.logo.param.chunk'|trans }}</td>
              <td>{{ logo_chunk }}</td>
            </tr>
            <tr>
              <td>{{ 'backend.cms.logo.param.shuffle'|trans }}</td>
              <td>{{ logo_shuffle ? 'backend.common.yes'|trans : 'backend.common.no'|trans }}</td>
            </tr>
          </tbody>
        </table>
      </div>

      {# Modal #}
      <div class="modal fade" id="logoSettingsModal" tabindex="-1" aria-labelledby="logoSettingsLabel" aria-hidden="true">
        <div class="modal-dialog">
          <form method="post" action="{{ path('admin_cms_logo_settings') }}" class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="logoSettingsLabel">{{ 'backend.cms.logo.modal.title'|trans }}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="_token" value="{{ csrf_token }}">

              <div class="mb-3">
                <label class="form-label" for="logo_chunk">{{ 'backend.cms.logo.form.chunk'|trans }}</label>
                <input type="number" id="logo_chunk" name="logo_chunk" class="form-control" min="1" step="1" value="{{ logo_chunk }}" required>
              </div>

              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="1" id="logo_shuffle" name="logo_shuffle"
                       {% if logo_shuffle %}checked{% endif %}>
                <label class="form-check-label" for="logo_shuffle">
                  {{ 'backend.cms.logo.form.shuffle'|trans }}
                </label>
              </div>

              <p class="text-muted small mt-3 mb-0">{{ 'backend.cms.logo.modal.note'|trans }}</p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'backend.common.cancel'|trans }}</button>
              <button type="submit" class="btn btn-primary">{{ 'backend.common.save'|trans }}</button>
            </div>
          </form>
        </div>
      </div>

      <hr>
      <div class="d-flex justify-content-between">
        <a href="{{ path('admin_cms_index') }}" class="btn btn-outline-secondary text-decoration-none">
          <i class="bi bi-arrow-left"></i> {{ 'backend.common.back'|trans }}
        </a>
      </div>

</div>
{% endblock %}
