{% extends 'base_backend.html.twig' %}
{% block title %}{{ 'backend.cms.index.title'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item active">{{ 'backend.cms.index.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-12 bg-white p-4 rounded shadow">
      <h2 class="mb-4">{{ 'backend.cms.index.h2'|trans }}</h2>

      <div class="row g-3">
        {# Logos (carrusel) #}
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-images fs-4 me-2"></i>
                <h2 class="h6 mb-0">{{ 'backend.cms.index.cards.logos.title'|trans }}</h2>
              </div>
              <p class="text-muted small mb-3">
                {{ 'backend.cms.index.cards.logos.desc'|trans }}
              </p>
              <div class="mt-auto">
                <a href="{{ path('admin_logo_index') }}" class="btn btn-primary btn-sm">{{ 'backend.common.manage'|trans }}</a>
              </div>
            </div>
          </div>
        </div>

        {# Ajustes carrusel #}
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-sliders fs-4 me-2"></i>
                <h2 class="h6 mb-0">{{ 'backend.cms.index.cards.logo_settings.title'|trans }}</h2>
              </div>
              <p class="text-muted small mb-3">
                {{ 'backend.cms.index.cards.logo_settings.desc'|trans }}
              </p>
              <div class="mt-auto">
                <a href="{{ path('admin_cms_logo_settings') }}" class="btn btn-primary btn-sm">{{ 'backend.common.manage'|trans }}</a>
              </div>
            </div>
          </div>
        </div>

        {# Contadores #}
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-123 fs-4 me-2"></i>
                <h2 class="h6 mb-0">{{ 'backend.cms.index.cards.counters.title'|trans }}</h2>
              </div>
              <p class="text-muted small mb-3">
                {{ 'backend.cms.index.cards.counters.desc'|trans }}
              </p>
              <div class="mt-auto">
                <a href="{{ path('admin_cms_counters') }}" class="btn btn-primary btn-sm">{{ 'backend.common.manage'|trans }}</a>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /.row -->
    </div>
  </div>
</div>
{% endblock %}
