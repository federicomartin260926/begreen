{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.report_design.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active">
        {{ 'backend.report_design.breadcrumb'|trans }}
    </li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2 class="mb-2">{{ 'backend.report_design.heading'|trans }}</h2>
            <p class="text-muted mb-0">
                {{ 'backend.report_design.description'|trans }}
            </p>
        </div>

        <div class="text-end">
            <div class="small text-muted">
                {{ 'backend.report_design.active_provider'|trans }}
            </div>
            <span class="badge bg-light text-dark border">
                {{ provider|upper }} · {{ model ?: '—' }}
            </span>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end mb-3">
                <div class="col-md-8">
                    <label class="form-label" for="report-design-document">Tipo de informe</label>
                    <select class="form-select" id="report-design-document" name="document">
                        {% for item in definitions %}
                            <option value="{{ item.document }}" {% if item.key == definition.key %}selected{% endif %}>{{ item.label }}</option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="variant" value="general">
                </div>
                <div class="col-md-4"><button class="btn btn-outline-secondary w-100" type="submit">Abrir diseño</button></div>
            </form>
            <div class="d-flex flex-wrap justify-content-between gap-3">
                <div>
                    <div class="small text-muted">
                        {{ 'backend.report_design.document'|trans }}
                    </div>
                    <div class="fw-semibold">{{ definition.label }}</div>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-start">
                    {% if draft %}
                        <span class="badge bg-warning-subtle text-warning-emphasis border">
                            {{ 'backend.report_design.status.draft'|trans }}
                        </span>
                    {% else %}
                        <span class="badge bg-light text-muted border">
                            {{ 'backend.report_design.status.no_draft'|trans }}
                        </span>
                    {% endif %}

                    {% if approved %}
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            {{ 'backend.report_design.status.approved'|trans }}
                        </span>
                    {% else %}
                        <span class="badge bg-light text-muted border">
                            {{ 'backend.report_design.status.no_approved'|trans }}
                        </span>
                    {% endif %}
                </div>
            </div>

            {% if draft %}
                <div class="small text-muted mt-3">
                    {{ 'backend.report_design.draft_updated'|trans }}:
                    {{ draft.metadata.updated_at|default('—') }}
                    {% if draft.metadata.provider|default(null) %}
                        · {{ draft.metadata.provider|upper }}
                        · {{ draft.metadata.model|default('—') }}
                    {% endif %}
                </div>
            {% endif %}

            {% if approved %}
                <div class="small text-muted mt-1">
                    {{ 'backend.report_design.approved_at'|trans }}:
                    {{ approved.metadata.approved_at|default(approved.metadata.updated_at|default('—')) }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3 class="h5 mb-2">
                        {{ 'backend.report_design.instruction_title'|trans }}
                    </h3>

                    <p class="text-muted small">
                        {{ 'backend.report_design.instruction_help'|trans }}
                    </p>

                    <details class="border rounded bg-body-tertiary mb-4">
                        <summary class="px-3 py-3 fw-semibold" style="cursor: pointer;">
                            <i class="bi bi-book me-1" aria-hidden="true"></i>
                            {{ 'backend.report_design.guide_title'|trans }}
                        </summary>

                        <div class="px-3 pb-3 small">
                            <p class="text-muted mb-3">
                                {{ 'backend.report_design.guide_intro'|trans }}
                            </p>

                            <h4 class="h6">
                                {{ 'backend.report_design.guide_flow_title'|trans }}
                            </h4>
                            <p>
                                {{ 'backend.report_design.guide_flow'|trans }}
                            </p>

                            <h4 class="h6 mt-3">
                                {{ 'backend.report_design.guide_iteration_title'|trans }}
                            </h4>
                            <p>
                                {{ 'backend.report_design.guide_iteration'|trans }}
                            </p>

                            <div class="alert alert-light border py-2 mb-3">
                                <strong>
                                    {{ 'backend.report_design.guide_iteration_example_label'|trans }}
                                </strong>
                                {{ 'backend.report_design.guide_iteration_example'|trans }}
                            </div>

                            <h4 class="h6 mt-3">
                                {{ 'backend.report_design.guide_examples_title'|trans }}
                            </h4>
                            <ul class="mb-3">
                                <li>{{ 'backend.report_design.guide_example_1'|trans }}</li>
                                <li>{{ 'backend.report_design.guide_example_2'|trans }}</li>
                                <li>{{ 'backend.report_design.guide_example_3'|trans }}</li>
                                <li>{{ 'backend.report_design.guide_example_4'|trans }}</li>
                                <li>{{ 'backend.report_design.guide_example_5'|trans }}</li>
                            </ul>

                            <h4 class="h6 mt-3">
                                {{ 'backend.report_design.guide_can_title'|trans }}
                            </h4>
                            <p>
                                {{ 'backend.report_design.guide_can'|trans }}
                            </p>

                            <h4 class="h6 mt-3">
                                {{ 'backend.report_design.guide_limits_title'|trans }}
                            </h4>
                            <p>
                                {{ 'backend.report_design.guide_limits'|trans }}
                            </p>

                            <h4 class="h6 mt-3">
                                {{ 'backend.report_design.guide_discard_title'|trans }}
                            </h4>
                            <p>
                                {{ 'backend.report_design.guide_discard'|trans }}
                            </p>

                            <h4 class="h6 mt-3">
                                {{ 'backend.report_design.guide_missing_data_title'|trans }}
                            </h4>
                            <p>
                                {{ 'backend.report_design.guide_missing_data'|trans }}
                            </p>

                            <h4 class="h6 mt-3">
                                {{ 'backend.report_design.guide_ai_title'|trans }}
                            </h4>
                            <p class="mb-0">
                                {{ 'backend.report_design.guide_ai'|trans }}
                            </p>
                        </div>
                    </details>


                    <form
                        method="post"
                        action="{{ path('admin_report_design_generate') }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('report_design_generate') }}"
                        >
                        <input type="hidden" name="document" value="{{ definition.document }}">
                        <input type="hidden" name="variant" value="{{ definition.variant }}">

                        <label class="form-label" for="report-design-instruction">
                            {{ 'backend.report_design.instruction_label'|trans }}
                        </label>

                        <textarea
                            class="form-control"
                            id="report-design-instruction"
                            name="instruction"
                            rows="8"
                            maxlength="5000"
                            required
                            placeholder="{{ 'backend.report_design.instruction_placeholder'|trans }}"
                        ></textarea>

                        <div class="form-text">
                            {{
    (
        draft
            ? 'backend.report_design.ai_notice_draft'
            : (
                approved
                    ? 'backend.report_design.ai_notice_approved'
                    : 'backend.report_design.ai_notice_base'
            )
    )|trans
}}
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button
                                class="btn btn-success"
                                type="submit"
                                data-controller="download-state"
                                data-action="click->download-state#start"
                                data-download-state-loading-label-value="{{ 'backend.report_design.generate.processing'|trans }}">
                                <i class="bi bi-stars me-1" aria-hidden="true"></i>
                                {{
    (
        draft
            ? 'backend.report_design.modify'
            : 'backend.report_design.generate'
    )|trans
}}
                            </button>
                        </div>
                    </form>

                    {% if draft %}
                        <hr class="my-4">

                        <form
                            method="post"
                            action="{{ path('admin_report_design_approve') }}"
                            onsubmit="return confirm('{{ 'backend.report_design.approve_confirm'|trans|e('js') }}');"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('report_design_approve') }}"
                            >
                            <input type="hidden" name="document" value="{{ definition.document }}">
                            <input type="hidden" name="variant" value="{{ definition.variant }}">

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <div class="fw-semibold">
                                        {{ 'backend.report_design.approve_title'|trans }}
                                    </div>
                                    <div class="small text-muted">
                                        {{ 'backend.report_design.approve_help'|trans }}
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <a
                                        class="btn btn-outline-secondary"
                                        href="{{ definition.document == 'final-sustainability-report' ? path('backend_final_report_preview', {'report_design': 'draft'}) : path('backend_plan_closure_download_pdf', {'report_design': 'draft'}) }}"
                                    >
                                        <i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>
                                        {{ 'backend.report_design.download_draft'|trans }}
                                    </a>

                                    <button
                                        type="submit"
                                        class="btn btn-outline-success"
                                    >
                                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>
                                        {{ 'backend.report_design.approve'|trans }}
                                    </button>
                                </div>
                            </div>
                        </form>

                        <form
                            class="mt-2"
                            method="post"
                            action="{{ path('admin_report_design_discard_draft') }}"
                            onsubmit="return confirm('{{ 'backend.report_design.discard_confirm'|trans|e('js') }}');"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('report_design_discard_draft') }}"
                            >
                            <input type="hidden" name="document" value="{{ definition.document }}">
                            <input type="hidden" name="variant" value="{{ definition.variant }}">

                            <button
                                type="submit"
                                class="btn btn-sm btn-outline-danger"
                            >
                                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>
                                {{ 'backend.report_design.discard'|trans }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-2">
                        {{ 'backend.report_design.components_title'|trans }}
                    </h3>

                    <p class="small text-muted mb-2">
                        {{ 'backend.report_design.components_help'|trans }}
                    </p>

                    <div class="small bg-light border rounded p-2 mb-3">
                        <span class="fw-semibold">
                            {{ 'backend.report_design.example_label'|trans }}:
                        </span>
                        {{ 'backend.report_design.components_example'|trans }}
                    </div>

                    <div class="d-flex flex-column gap-3">
                        {% for key, component in components %}
                            <div>
                                <div class="fw-semibold">
                                    {{ component.label }}
                                </div>
                                <code>[COMPONENT:{{ key }}]</code>
                                <div class="small text-muted">
                                    {{ component.description }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="h5 mb-2">
                        {{ 'backend.report_design.variables_title'|trans }}
                    </h3>

                    <p class="small text-muted mb-2">
                        {{ 'backend.report_design.variables_help'|trans }}
                    </p>

                    <div class="small bg-light border rounded p-2 mb-3">
                        <span class="fw-semibold">
                            {{ 'backend.report_design.example_label'|trans }}:
                        </span>
                        {{ 'backend.report_design.variables_example'|trans }}
                    </div>

                    <div class="accordion" id="reportDesignDataCatalog">
                        {% for groupKey, group in dataTree %}
                            <div class="accordion-item">
                                <h4
                                    class="accordion-header"
                                    id="report-design-data-{{ groupKey }}"
                                >
                                    <button
                                        class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#report-design-data-panel-{{ groupKey }}"
                                        aria-expanded="false"
                                        aria-controls="report-design-data-panel-{{ groupKey }}"
                                    >
                                        {{ group.label }}
                                    </button>
                                </h4>

                                <div
                                    id="report-design-data-panel-{{ groupKey }}"
                                    class="accordion-collapse collapse"
                                    aria-labelledby="report-design-data-{{ groupKey }}"
                                >
                                    <div class="accordion-body">
                                        {% for key, variable in group.variables %}
                                            <div class="{% if not loop.last %}mb-3{% endif %}">
                                                <div class="fw-semibold">
                                                    {{ variable.label }}
                                                </div>
                                                <code>[[{{ key }}]]</code>
                                                <div class="small text-muted">
                                                    {{ variable.description }}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="alert alert-info small mt-3 mb-0">
                        {{ 'backend.report_design.unavailable_help'|trans }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
