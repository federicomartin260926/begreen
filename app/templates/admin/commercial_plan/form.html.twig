{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.commercial_plans.form.title'|trans({'%name%': plan.name}) }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a class="text-decoration-none" href="{{ path('admin_commercial_plans_index') }}">{{ 'backend.commercial_plans.list.breadcrumb'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ plan.name }}</li>
{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10 bg-white p-4 rounded shadow">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="mb-1">{{ 'backend.commercial_plans.form.heading'|trans({'%name%': plan.name}) }}</h2>
                    <p class="text-muted mb-0">{{ 'backend.commercial_plans.form.subtitle'|trans }}</p>
                </div>
                <span class="badge bg-secondary text-uppercase">{{ plan.code }}</span>
            </div>

            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="row">
                    <div class="col-md-6 mb-3">{{ form_row(form.name) }}</div>
                    <div class="col-md-6 mb-3">{{ form_row(form.priceCurrency) }}</div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">{{ form_row(form.priceAmount) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.sortOrder) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.maxEvidenceCount) }}</div>
                </div>

                <div class="row">
                    <div class="{% if form.stripeUpgradeFromStandardPriceId is defined %}col-md-6{% else %}col-md-4{% endif %} mb-3">
                        {{ form_row(form.stripePriceId) }}
                    </div>

                    {% if form.stripeUpgradeFromStandardPriceId is defined %}
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.stripeUpgradeFromStandardPriceId) }}
                        </div>
                    {% endif %}
                </div>

                <div class="mb-3">{{ form_row(form.description) }}</div>

                <div class="row">
                    <div class="col-md-4 mb-3">{{ form_row(form.watermarkEnabled) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.active) }}</div>
                </div>

                <hr class="my-4">

                <div class="row">
                    <div class="col-12 mb-3">
                        <h5 class="mb-3">{{ 'backend.commercial_plans.form.allowed_scores_heading'|trans }}</h5>

                        <div class="d-flex flex-wrap gap-4 align-items-center">
                            {% for scoreField in form.allowedScores %}
                                <div class="form-check mb-0">
                                    {{ form_widget(scoreField, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_label(scoreField, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                </div>
                            {% endfor %}
                        </div>

                        {{ form_errors(form.allowedScores) }}
                        {% do form.allowedScores.setRendered %}
                    </div>
                </div>

                <hr class="my-4">

                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                            <h5 class="mb-0">{{ 'backend.commercial_plans.form.features_heading'|trans }}</h5>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#commercialPlanFeaturesInfoModal"
                                    aria-label="{{ 'backend.commercial_plans.form.features_info_button'|trans }}">
                                <i class="bi bi-info-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">{{ form_row(form.pdfByDepartments) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.advancedExports) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.publicComments) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.internalNotes) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.responsibles) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.checklist) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.customMeasures) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.validationSummary) }}</div>
                    <div class="col-md-4 mb-3">{{ form_row(form.branding) }}</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('admin_commercial_plans_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> {{ 'backend.common.back'|trans }}
                    </a>
                    <button class="btn btn-primary">
                        <i class="bi bi-save"></i> {{ 'backend.common.save_changes'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<div class="modal fade" id="commercialPlanFeaturesInfoModal" tabindex="-1" aria-labelledby="commercialPlanFeaturesInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commercialPlanFeaturesInfoModalLabel">
                    {{ 'backend.commercial_plans.form.features_heading'|trans }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <div class="vstack gap-3">
                    <div>
                        <h6 class="mb-1">{{ 'backend.commercial_plans.form.pdf_by_departments'|trans }}</h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.pdf_by_departments'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1">{{ 'backend.commercial_plans.form.advanced_exports'|trans }}</h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.advanced_exports'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                            <span>{{ 'backend.commercial_plans.form.public_comments'|trans }}</span>
                            <span class="badge bg-warning text-dark">{{ 'backend.commercial_plans.form.coming_soon'|trans }}</span>
                        </h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.public_comments'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1">{{ 'backend.commercial_plans.form.internal_notes'|trans }}</h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.internal_notes'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1">{{ 'backend.commercial_plans.form.responsibles'|trans }}</h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.responsibles'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1">{{ 'backend.commercial_plans.form.checklist'|trans }}</h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.checklist'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                            <span>{{ 'backend.commercial_plans.form.custom_measures'|trans }}</span>
                            <span class="badge bg-warning text-dark">{{ 'backend.commercial_plans.form.coming_soon'|trans }}</span>
                        </h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.custom_measures'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                            <span>{{ 'backend.commercial_plans.form.validation_summary'|trans }}</span>
                            <span class="badge bg-warning text-dark">{{ 'backend.commercial_plans.form.coming_soon'|trans }}</span>
                        </h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.validation_summary'|trans }}</p>
                    </div>
                    <div>
                        <h6 class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                            <span>{{ 'backend.commercial_plans.form.branding'|trans }}</span>
                            <span class="badge bg-warning text-dark">{{ 'backend.commercial_plans.form.coming_soon'|trans }}</span>
                        </h6>
                        <p class="mb-0">{{ 'backend.commercial_plans.form.features_info_modal.branding'|trans }}</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    {{ 'backend.common.close'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
