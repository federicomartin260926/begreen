{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.commercial_plans.list.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">
        {{ 'backend.commercial_plans.list.breadcrumb'|trans }}
    </li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="mb-1">{{ 'backend.commercial_plans.list.h2'|trans }}</h2>
                    <p class="text-muted mb-0">{{ 'backend.commercial_plans.list.subtitle'|trans }}</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover green_table_1" data-controller="datatable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>{{ 'backend.commercial_plans.list.table.name'|trans }}</th>
                            <th>{{ 'backend.commercial_plans.list.table.code'|trans }}</th>
                            <th class="text-end">{{ 'backend.commercial_plans.list.table.price'|trans }}</th>
                            <th>{{ 'backend.commercial_plans.list.table.status'|trans }}</th>
                            <th class="text-center">{{ 'backend.commercial_plans.list.table.sort_order'|trans }}</th>
                            <th class="text-center dt-head-center dt-nosort">{{ 'backend.common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for plan in plans %}
                            <tr>
                                <td>{{ plan.id }}</td>
                                <td>
                                    <strong>{{ plan.name }}</strong>
                                    {% if plan.description %}
                                        <div class="text-muted small">{{ plan.description }}</div>
                                    {% endif %}
                                </td>
                                <td><code>{{ plan.code }}</code></td>
                                <td class="text-end text-nowrap">
                                    {% if plan.priceAmount is not null %}
                                        {{ (plan.priceAmount / 100)|number_format(2, ',', '.') }} {{ plan.priceCurrency }}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if plan.active %}
                                        <span class="badge bg-success">{{ 'backend.common.yes'|trans }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ 'backend.common.no'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">{{ plan.sortOrder }}</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <a
                                            href="{{ path('admin_commercial_plans_edit', {id: plan.id}) }}"
                                            data-bs-toggle="popover"
                                            data-bs-trigger="hover"
                                            data-bs-content="{{ 'backend.common.edit'|trans }}"
                                            class="btn">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted">{{ 'backend.commercial_plans.list.empty'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
</div>
{% endblock %}
