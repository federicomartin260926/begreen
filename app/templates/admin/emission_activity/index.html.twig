{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'backend.admin.emission.index.title'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item active" aria-current="page">
    {{ 'backend.admin.emission.index.breadcrumb'|trans }}
  </li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="">{{ 'backend.admin.emission.index.heading'|trans }}</h2>
        <div class="d-flex gap-2">
          <a href="{{ path('admin_emission_activity_new') }}" class="btn btn-success text-decoration-none">
            <i class="bi bi-plus-circle"></i> {{ 'backend.admin.emission.index.buttons.new'|trans }}
          </a>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
        <div class="d-flex gap-2">
          <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exportPdfModal">
            <i class="bi bi-file-earmark-pdf"></i> {{ 'backend.admin.emission.index.buttons.download_pdf'|trans }}
          </button>
          <a href="#" class="btn btn-outline-primary text-decoration-none" data-bs-toggle="modal" data-bs-target="#importModal">
            <i class="bi bi-upload"></i> {{ 'backend.admin.emission.index.buttons.import_excel'|trans }}
          </a>
          <a
            href="{{ path('admin_emission_activity_template_download') }}"
            class="btn btn-outline-primary text-decoration-none"
            data-bs-toggle="popover"
            data-bs-trigger="hover"
            data-bs-content="{{ 'backend.admin.emission.index.template_popover'|trans }}"
            download>
            <i class="bi bi-download"></i> {{ 'backend.admin.emission.index.buttons.download_template'|trans }}
          </a>
        </div>
      </div>

      {% if activities is empty %}
        <div class="alert alert-info">{{ 'backend.admin.emission.index.empty'|trans }}</div>
      {% else %}
        <div class="table-responsive">
          <table id="emission-activities-table" class="table table-hover dt-responsive nowrap w-100 green_table_1" data-controller="datatable">
            <thead>
              <tr>
                <th>{{ 'backend.admin.emission.index.table.source'|trans }}</th>
                <th>{{ 'backend.admin.emission.index.table.activity'|trans }}</th>
                <th>{{ 'backend.admin.emission.index.table.unit'|trans }}</th>
                <th>{{ 'backend.admin.emission.index.table.factor'|trans }}</th>
                <th>{{ 'backend.admin.emission.index.table.category'|trans }}</th>
                <th>{{ 'backend.admin.emission.index.table.subcategory'|trans }}</th>
                <th class="text-center dt-nosort">{{ 'backend.admin.emission.index.table.actions'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for activity in activities %}
                <tr>
                  <td>{{ activity.emissionSource ? activity.emissionSource.name ~ ' - ' ~ activity.emissionSource.year : '' }}</td>
                  <td>{{ activity.name }}</td>
                  <td>{{ activity.unit }}</td>
                  <td data-order="{{ activity.emissionFactor ? 'A' ~ activity.emissionFactor : '' }}">
                    {{ activity.emissionFactor }}
                  </td>
                  <td>{{ activity.category ? activity.category.name : '' }}</td>
                  <td>
                    {% if activity.subcategory %}
                        {{ ('backend.emission.subcat.' ~ activity.subcategory)|trans }}
                    {% endif %}
                  </td>
                  <td class="text-center">
                    <a
                      href="{{ path('admin_emission_activity_edit', {'id': activity.id}) }}"
                      data-bs-toggle="popover"
                      data-bs-trigger="hover"
                      data-bs-content="{{ 'backend.common.edit'|trans }}"
                      class="btn">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form
                      method="post"
                      action="{{ path('admin_emission_activity_delete', {'id': activity.id}) }}"
                      data-bs-toggle="popover"
                      data-bs-trigger="hover"
                      data-bs-content="{{ 'backend.common.delete'|trans }}"
                      class="d-inline"
                      onsubmit="return confirm('{{ 'backend.common.confirm_delete'|trans }}');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete_emission_activity_' ~ activity.id) }}">
                      <button class="btn">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}

</div>

{# Import modal #}
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="post" action="{{ path('admin_emission_activity_import') }}" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title" id="importModalLabel">{{ 'backend.admin.emission.index.import.title'|trans }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                {{ form_widget(importForm.file, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(importForm.file) }}
                <div class="form-text">
                {{ 'backend.admin.emission.index.import.lang_info_title'|trans }}
                </div>
            </div>

            <div class="alert alert-info mt-2 small" role="alert">
                {{ 'backend.admin.emission.index.import.lang_info_html'|trans|raw }}
            </div>

        {{ form_rest(importForm) }}
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'backend.common.cancel'|trans }}</button>
          <button type="submit" class="btn btn-primary">{{ 'backend.common.import'|trans }}</button>
        </div>
      </form>
    </div>
  </div>
</div>

{# PDF modal #}
<div class="modal fade" id="exportPdfModal" tabindex="-1" aria-labelledby="exportPdfModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form method="get" action="{{ path('admin_emission_activity_export_pdf') }}">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="exportPdfModalLabel">{{ 'backend.admin.emission.index.pdf.title'|trans }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="source" class="form-label">{{ 'backend.admin.emission.index.pdf.select_source'|trans }}</label>
            <select class="form-select" id="source" name="source">
              {% for fuente in fuentes %}
                <option value="{{ fuente.id }}">{{ fuente.name ~ ' ' ~ fuente.year }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">{{ 'backend.common.download'|trans }}</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'backend.common.cancel'|trans }}</button>
        </div>
      </div>
    </form>
  </div>
</div>
{% endblock %}
