{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.ai.title'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item active">{{ 'backend.ai.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
  <h2 class="mb-2">{{ 'backend.ai.heading'|trans }}</h2>
  <p class="text-muted mb-4">{{ 'backend.ai.description'|trans }}</p>

  {{ form_start(form) }}
  {{ form_errors(form) }}

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h3 class="h5 mb-3">{{ 'backend.ai.provider_section'|trans }}</h3>
      <div class="row g-3">
        <div class="col-md-4">{{ form_row(form.provider) }}</div>
        <div class="col-md-4">{{ form_row(form.anthropicModel) }}</div>
        <div class="col-md-4">{{ form_row(form.openAiModel) }}</div>
      </div>
      <div class="form-text">{{ 'backend.ai.technical_help'|trans }}</div>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <h3 class="h5 mb-3">{{ 'backend.ai.editorial_section'|trans }}</h3>

      <ul class="nav nav-tabs mb-3" id="aiEditorialTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active"
                  id="ai-general-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#ai-general"
                  type="button"
                  role="tab"
                  aria-controls="ai-general"
                  aria-selected="true">
            Generales
          </button>
        </li>

        <li class="nav-item" role="presentation">
          <button class="nav-link"
                  id="ai-executive-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#ai-executive"
                  type="button"
                  role="tab"
                  aria-controls="ai-executive"
                  aria-selected="false">
            Resumen ejecutivo
          </button>
        </li>

        <li class="nav-item" role="presentation">
          <button class="nav-link"
                  id="ai-category-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#ai-category"
                  type="button"
                  role="tab"
                  aria-controls="ai-category"
                  aria-selected="false">
            Categorías
          </button>
        </li>

        <li class="nav-item" role="presentation">
          <button class="nav-link"
                  id="ai-avoid-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#ai-avoid"
                  type="button"
                  role="tab"
                  aria-controls="ai-avoid"
                  aria-selected="false">
            Evitar
          </button>
        </li>

        <li class="nav-item" role="presentation">
          <button class="nav-link"
                  id="ai-final-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#ai-final"
                  type="button"
                  role="tab"
                  aria-controls="ai-final"
                  aria-selected="false">
            Cierre final
          </button>
        </li>
      </ul>

      <div class="tab-content" id="aiEditorialTabsContent">
        <div class="tab-pane fade show active"
             id="ai-general"
             role="tabpanel"
             aria-labelledby="ai-general-tab"
             tabindex="0">
          {{ form_row(form.generalInstructions) }}
        </div>

        <div class="tab-pane fade"
             id="ai-executive"
             role="tabpanel"
             aria-labelledby="ai-executive-tab"
             tabindex="0">
          {{ form_row(form.executiveSummaryInstructions) }}
        </div>

        <div class="tab-pane fade"
             id="ai-category"
             role="tabpanel"
             aria-labelledby="ai-category-tab"
             tabindex="0">
          {{ form_row(form.categoryInstructions) }}
        </div>

        <div class="tab-pane fade"
             id="ai-avoid"
             role="tabpanel"
             aria-labelledby="ai-avoid-tab"
             tabindex="0">
          {{ form_row(form.avoidInstructions) }}
        </div>

        <div class="tab-pane fade"
             id="ai-final"
             role="tabpanel"
             aria-labelledby="ai-final-tab"
             tabindex="0">
          {{ form_row(form.finalConclusionInstructions) }}
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end mt-4">
    <button class="btn btn-success"><i class="bi bi-check-lg me-1"></i>{{ 'backend.common.update'|trans }}</button>
  </div>
  {{ form_end(form) }}
</div>
{% endblock %}
