{% extends 'base_backend.html.twig' %}

{% block title %}{{ edit ? 'backend.admin.users.title_edit'|trans : 'backend.admin.users.title_new'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item" aria-current="page">
        <a class="text-decoration-none" href="{{ path('admin_users_index') }}">{{ 'backend.admin.users.breadcrumb.section'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ edit ? user.email : 'backend.admin.users.breadcrumb.new'|trans }}
    </li>
{% endblock %}

{% block body %}
<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-12 bg-white p-4 rounded shadow">
      <h2 class="mb-5">{{ edit ? 'backend.admin.users.title_edit'|trans : 'backend.admin.users.title_new'|trans }}</h2>

      {{ form_start(form) }}
        {{ form_errors(form) }}

        <fieldset class="border rounded p-3 mb-4">
            <legend class="float-none w-auto px-2 fw-semibold">{{ 'backend.admin.users.fieldset.user_data'|trans }}</legend>

            <div class="row">
                <div class="col-md-6 mb-3">
                  {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.name) }}
                </div>
                <div class="col-md-6 mb-3">
                  {{ form_label(form.surnames, null, {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.surnames, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.surnames) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                  {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.email) }}
                </div>
                <div class="col-md-6 mb-3">
                  {{ form_label(form.phone, null, {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.phone, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.phone) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                  {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.plainPassword) }}
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                  {{ form_label(form.roles, null, {'label_attr': {'class': 'form-label d-block'}}) }}
                  {{ form_widget(form.roles) }}
                  {{ form_errors(form.roles) }}
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    {{ form_row(form.isVerified, {
                        row_attr:   { class: 'form-check form-switch ps-0' },
                        attr:       { class: 'form-check-input ms-0', role: 'switch' },
                        label_attr: { class: 'form-check-label ms-2' }
                    }) }}
                </div>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-save"></i> {{ edit ? 'backend.common.update'|trans : 'backend.common.create'|trans }}
                </button>
            </div>
        </fieldset>
      {{ form_end(form) }}

      {% set canAssign = edit and user is defined and user.id is not empty %}

      <fieldset class="border rounded p-3 mb-4">
        <legend class="float-none w-auto px-2 fw-semibold">{{ 'backend.admin.users.fieldset.projects'|trans }}</legend>

        {% if not edit %}
          <div class="alert alert-info mb-0">
            {{ 'backend.admin.users.projects.save_first'|trans }}
          </div>
        {% else %}
          {% if memberships is empty %}
            <p class="text-muted">{{ 'backend.admin.users.projects.none'|trans }}</p>
          {% else %}
            <div class="table-responsive">
              <table class="table align-middle table-hover green_table_1">
                <thead>
                  <tr>
                    <th>{{ 'backend.admin.users.projects.table.project'|trans }}</th>
                    <th class="text-center">{{ 'backend.admin.users.projects.table.creator'|trans }}</th>
                    <th class="text-end"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover"
                        data-bs-content="{{ 'backend.admin.users.projects.table.hint'|trans }}">
                      <i class="bi bi-info-circle"></i> {{ 'backend.common.actions'|trans }}
                    </th>
                  </tr>
                </thead>
                <tbody>
                {% for m in memberships %}
                  {% set project = m.project %}
                  {% set isCreator = project.user and project.user.id == user.id %}
                  <tr>
                    <td>{{ project.name }}</td>
                    <td class="text-center" data-order="{{ isCreator ? 1 : 0 }}">
                      {% if isCreator %}
                        <i class="bi bi-check-lg text-success" title="{{ 'backend.admin.users.projects.creator'|trans }}"></i>
                      {% else %}
                        <span class="text-muted">—</span>
                      {% endif %}
                    </td>
                    <td class="text-end">
                      {% if not isCreator %}
                        <form method="post"
                              action="{{ path('admin_users_remove_membership', {id: user.id, membershipId: m.id}) }}"
                              class="d-inline"
                              onsubmit="return confirm('{{ 'backend.admin.users.projects.confirm_remove'|trans }}');">
                          <input type="hidden" name="_token" value="{{ csrf_token('remove_membership_' ~ m.id) }}">
                          <button type="submit" class="btn" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="{{ 'backend.common.delete'|trans }}">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}

          <button type="button"
                  class="btn btn-outline-primary mt-2"
                  data-bs-toggle="modal"
                  data-bs-target="#assignProjectModal"
                  {{ canAssign ? '' : 'disabled' }}>
            <i class="bi bi-plus-lg"></i> {{ 'backend.admin.users.projects.add'|trans }}
          </button>
        {% endif %}
      </fieldset>

      <div class="modal fade" id="assignProjectModal" tabindex="-1" aria-labelledby="assignProjectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="assignProjectModalLabel">{{ 'backend.admin.users.projects.modal.title'|trans }}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
            </div>

            {% if canAssign %}
              <form method="post" action="{{ path('admin_users_assign_project', {id: user.id}) }}">
                <div class="modal-body">
                  <input type="hidden" name="_token" value="{{ csrf_token('assign_project_' ~ user.id) }}">
                  <div class="mb-3">
                    <label for="project_id" class="form-label">{{ 'backend.admin.users.projects.modal.project_label'|trans }}</label>
                    <select id="project_id" name="project_id"
                            class="selectpicker"
                            data-style="form-select border"
                            data-width="100%"
                            data-live-search="true"
                            data-none-selected-text="{{ 'backend.admin.users.projects.modal.none_selected'|trans }}"
                            required>
                      <option value="" selected disabled>{{ 'backend.admin.users.projects.modal.none_selected'|trans }}</option>
                      {% for p in availableProjects %}
                        <option value="{{ p.id }}">{{ p.name }}</option>
                      {% endfor %}
                    </select>
                    {% if availableProjects is empty %}
                      <div class="form-text">{{ 'backend.admin.users.projects.modal.no_available'|trans }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'backend.common.cancel'|trans }}</button>
                  <button type="submit" class="btn btn-primary" {{ availableProjects is empty ? 'disabled' : '' }}>{{ 'backend.common.assign'|trans }}</button>
                </div>
              </form>
            {% else %}
              <div class="modal-body">
                <div class="alert alert-info mb-0">{{ 'backend.admin.users.projects.save_first'|trans }}</div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'backend.common.close'|trans }}</button>
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <hr class="mt-4">
      <div class="d-flex justify-content-between">
        <a href="{{ path('admin_users_index') }}" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> {{ 'backend.common.back'|trans }}
        </a>
        <span></span>
      </div>

    </div>
  </div>
</div>
{% endblock %}
