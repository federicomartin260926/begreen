{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.admin.emission_factor.show.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item"><a class="text-decoration-none" href="{{ path('admin_emission_factor_index') }}">{{ 'backend.admin.emission_factor.index.breadcrumb'|trans }}</a></li>
    <li class="breadcrumb-item active">#{{ factor.id }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">{{ 'backend.admin.emission_factor.show.heading'|trans({'%id%': factor.id}) }}</h2>
        <a class="btn btn-primary" href="{{ path('admin_emission_factor_edit', {id: factor.id}) }}"><i class="bi bi-pencil me-1"></i>{{ 'backend.common.edit'|trans }}</a>
    </div>
    <dl class="row">
        <dt class="col-sm-3">ID</dt><dd class="col-sm-9">{{ factor.id }}</dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.category_key'|trans }}</dt><dd class="col-sm-9"><code>{{ factor.categoryKey }}</code></dd>
        <dt class="col-sm-3 text-muted small">{{ 'backend.admin.emission_factor.fields.functional_key'|trans }}</dt><dd class="col-sm-9 text-muted small"><code>{{ factor.functionalKey }}</code></dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.criteria'|trans }}</dt><dd class="col-sm-9"><pre class="bg-light border rounded p-3">{{ factor.criteria|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre></dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.temporal_type'|trans }}</dt><dd class="col-sm-9">{{ factor.temporalType }}</dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.year'|trans }}</dt><dd class="col-sm-9">{{ factor.year is null ? 'NULL' : factor.year }}</dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.value'|trans }}</dt><dd class="col-sm-9">{{ factor.value is null ? 'NULL' : factor.value }}</dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.unit'|trans }}</dt><dd class="col-sm-9">{{ factor.unit }}</dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.source'|trans }}</dt><dd class="col-sm-9">{{ factor.source }}</dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.source_detail'|trans }}</dt><dd class="col-sm-9">{{ factor.sourceDetail is null ? 'NULL' : factor.sourceDetail }}</dd>
        <dt class="col-sm-3">{{ 'backend.admin.emission_factor.fields.metadata'|trans }}</dt><dd class="col-sm-9">{% if factor.metadata is null %}NULL{% else %}<pre class="bg-light border rounded p-3">{{ factor.metadata|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>{% endif %}</dd>
    </dl>
    <div class="d-flex justify-content-between">
        <a class="btn btn-outline-secondary" href="{{ path('admin_emission_factor_index') }}">{{ 'backend.common.back'|trans }}</a>
        <form method="post" action="{{ path('admin_emission_factor_delete', {id: factor.id}) }}" onsubmit="return confirm('{{ 'backend.admin.emission_factor.actions.confirm_delete'|trans }}');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_emission_factor_' ~ factor.id) }}">
            <button class="btn btn-danger" type="submit"><i class="bi bi-trash me-1"></i>{{ 'backend.common.delete'|trans }}</button>
        </form>
    </div>
</div>
{% endblock %}
