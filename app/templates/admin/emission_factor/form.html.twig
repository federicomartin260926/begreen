{% extends 'base_backend.html.twig' %}

{% block title %}{{ (edit ? 'backend.admin.emission_factor.form.title_edit' : 'backend.admin.emission_factor.form.title_new')|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item"><a class="text-decoration-none" href="{{ path('admin_emission_factor_index') }}">{{ 'backend.admin.emission_factor.index.breadcrumb'|trans }}</a></li>
    <li class="breadcrumb-item active">{{ (edit ? 'backend.admin.emission_factor.actions.edit' : 'backend.admin.emission_factor.actions.new')|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-admin-shell">
    <h2 class="mb-4">{{ (edit ? 'backend.admin.emission_factor.form.heading_edit' : 'backend.admin.emission_factor.form.heading_new')|trans }}</h2>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row">
            <div class="col-md-4 mb-3">{{ form_row(form.categoryKey) }}</div>
            <div class="col-12 mb-3">{{ form_row(form.criteria) }}</div>
            <div class="col-md-4 mb-3">{{ form_row(form.temporalType) }}</div>
            <div class="col-md-2 mb-3">{{ form_row(form.year) }}</div>
            <div class="col-md-3 mb-3">{{ form_row(form.value) }}</div>
            <div class="col-md-3 mb-3">{{ form_row(form.unit) }}</div>
            <div class="col-md-5 mb-3">{{ form_row(form.source) }}</div>
            <div class="col-md-7 mb-3">{{ form_row(form.sourceDetail) }}</div>
            <div class="col-12 mb-3">{{ form_row(form.metadata) }}</div>
        </div>
        <div class="d-flex justify-content-between">
            <a class="btn btn-outline-secondary" href="{{ edit ? path('admin_emission_factor_show', {id: factor.id}) : path('admin_emission_factor_index') }}">{{ 'backend.common.cancel'|trans }}</a>
            <button class="btn btn-success" type="submit">{{ 'backend.common.save'|trans }}</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
