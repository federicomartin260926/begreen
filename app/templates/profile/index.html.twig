{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'form.profile'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active">Perfil</li>
{% endblock %}

{% block body %}

    <div class="container my-4">

        <div class="row justify-content-center">
            <div class="col-12 bg-white p-4 rounded shadow">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">

                        <h2>{{ 'form.profile_data'|trans }}</h2>
                        {{ form_start(profileForm) }}
                            {{ form_row(profileForm.name) }}
                            {{ form_row(profileForm.surnames) }}
                            {{ form_row(profileForm.phone) }}
                            {{ form_row(profileForm.submit_profile) }}
                        {{ form_end(profileForm) }}

                        <hr>

                        <h2>{{ 'form.change_password_title'|trans }}</h2>
                        {{ form_start(passwordForm) }}
                            {{ form_row(passwordForm.plainPassword.first) }}
                            {{ form_row(passwordForm.plainPassword.second) }}
                            {{ form_row(passwordForm.submit_password) }}
                        {{ form_end(passwordForm) }}               
                        
                    </div>        
                </div>
            </div>
        </div>
    </div>
{% endblock %}
