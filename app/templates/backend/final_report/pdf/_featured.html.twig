{% if featuredMeasures is not empty or texts.featured_storytelling.text|default(null) %}<section class="pdf-page report-design-final-featured"><h2>{{ 'backend.final_report.featured_title'|trans }}</h2>{% if texts.featured_storytelling.text|default(null) %}<p>{{ texts.featured_storytelling.text|nl2br }}</p>{% endif %}{% for item in featuredMeasures %}<h3>{{ item.plan.measure.name|default('backend.final_report.measure'|trans) }}</h3>{% if item.text %}<p>{{ item.text|nl2br }}</p>{% endif %}{% if item.implementation %}<p class="muted">{{ 'backend.final_report.state'|trans }}: {{ ('backend.final_report.states.' ~ item.implementation.state)|trans }}</p>{% endif %}{% endfor %}</section>{% endif %}
