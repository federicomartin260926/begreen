{% if featuredMeasures is not empty or texts.featured_storytelling.text|default(null) %}<section class="pdf-page report-design-final-featured"><h2>Medidas destacadas</h2>{% if texts.featured_storytelling.text|default(null) %}<p>{{ texts.featured_storytelling.text|nl2br }}</p>{% endif %}{% for item in featuredMeasures %}<h3>{{ item.plan.measure.name|default('Medida') }}</h3>{% if item.text %}<p>{{ item.text|nl2br }}</p>{% endif %}{% if item.implementation %}<p class="muted">Estado: {{ item.implementation.state }}</p>{% endif %}{% endfor %}</section>{% endif %}
