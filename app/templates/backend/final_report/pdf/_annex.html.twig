{% if report.implementation.measures is not empty %}
<section class="report-design-final-annex">
  <h2>{{ 'backend.final_report.pdf.annex_title'|trans }}</h2>
  <p class="muted">{{ 'backend.final_report.pdf.annex_help'|trans }}</p>
<table><thead><tr><th>{{ 'backend.final_report.measure'|trans }}</th><th>{{ 'backend.final_report.state'|trans }}</th><th>{{ 'backend.final_report.pdf.action_incident'|trans }}</th></tr></thead><tbody>{% for item in report.implementation.measures %}<tr><td>{{ item.measureName|default('—') }}</td><td>{{ ('backend.final_report.states.' ~ item.state)|trans }}</td><td>{{ item.actionTaken|default(item.incident|default(item.observations|default('—'))) }}</td></tr>{% endfor %}</tbody></table>
</section>
{% endif %}
