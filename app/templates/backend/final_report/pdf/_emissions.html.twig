{% if report.emissions.available or texts.emissions.text|default(null) %}<section class="pdf-page report-design-final-emissions"><h2>Emisiones reales</h2>{% if texts.emissions.text|default(null) %}<p>{{ texts.emissions.text|nl2br }}</p>{% endif %}{% if report.emissions.available %}<p class="metric">{{ report.emissions.totalKgCo2e|number_format(2, ',', '.') }} kgCO₂e</p><h3>Por categoría</h3><ul>{% for item in report.emissions.byCategory %}<li>{{ item.name|default('Sin categoría') }}: {{ item.kgCo2e|number_format(2, ',', '.') }} kgCO₂e</li>{% endfor %}</ul><h3>Por fase</h3><ul>{% for item in report.emissions.byPhase %}<li>{{ item.code|default('Sin fase') }}: {{ item.kgCo2e|number_format(2, ',', '.') }} kgCO₂e</li>{% endfor %}</ul>{% endif %}</section>{% endif %}
