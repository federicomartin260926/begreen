{% if report.plan.protocol or report.plan.measures is not empty %}
{% set summary = report.implementation.summary %}
{% set measures = report.implementation.measures|default([]) %}
{% set states = {
    'implemented': 'backend.final_report.pdf.states.implemented'|trans,
    'in_progress': 'backend.final_report.pdf.states.in_progress'|trans,
    'pending': 'backend.final_report.pdf.states.pending'|trans,
    'not_implemented': 'backend.final_report.pdf.states.not_implemented'|trans,
    'discarded': 'backend.final_report.pdf.states.discarded'|trans,
    'not_applicable': 'backend.final_report.pdf.states.not_applicable'|trans
} %}
<section class="pdf-page report-design-final-plan">
  <h2>{{ 'backend.final_report.pdf.plan_title'|trans }}</h2>
  {% if report.plan.protocol %}
    <p class="pdf-plan-protocol">
      {{ 'backend.final_report.pdf.protocol'|trans }}: <strong>{{ report.plan.protocol.name }}</strong>
    </p>
  {% endif %}

  <table class="pdf-plan-metrics">
    <tr>
      <td><strong>{{ summary.totalMeasures }}</strong><span>{{ 'backend.final_report.measures'|trans }}</span></td>
      <td><strong>{{ summary.implementedMeasures }}</strong><span>{{ 'backend.final_report.pdf.implemented'|trans }}</span></td>
      <td><strong>{{ summary.resolvedMeasures }}</strong><span>{{ 'backend.final_report.pdf.resolved'|trans }}</span></td>
    </tr>
  </table>

  {% if measures is not empty %}
    <h3>{{ 'backend.final_report.pdf.measure_tracking'|trans }}</h3>
    {% set stateColors = {
      'implemented': '#287b56',
      'in_progress': '#6fa993',
      'pending': '#d0a95c',
      'not_implemented': '#c07869',
      'discarded': '#80948b',
      'not_applicable': '#b0bbb4'
    } %}
    <table class="pdf-plan-states pdf-plan-state-bars">
      <tbody>
        {% for state, label in states %}
          {% set count = measures|filter(item => item.state == state)|length %}
          {% if count > 0 %}
            {% set percentage = measures|length > 0
              ? (count / (measures|length)) * 100
              : 0 %}
            <tr>
              <td class="pdf-plan-state-name">{{ label }}</td>
              <td class="pdf-plan-state-chart">
                <div class="pdf-plan-state-track">
                  <div class="pdf-plan-state-fill"
                       style="width: {{ percentage|round(2) }}%; background-color: {{ stateColors[state] }};"></div>
                </div>
              </td>
              <td class="pdf-plan-count">
                {{ count }}
                <span class="pdf-plan-state-percent">
                  ({{ percentage|number_format(0, ',', '.') }}%)
                </span>
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
    <p class="pdf-plan-state-note">{{ 'backend.final_report.pdf.state_note'|trans }}</p>
  {% endif %}
</section>
{% endif %}
