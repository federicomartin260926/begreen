{% if photos|filter(photo => not photo.isCover) is not empty %}<section class="pdf-page report-design-final-gallery"><h2>{{ 'backend.final_report.pdf.gallery'|trans }}</h2>{% for photo in photos %}{% if not photo.isCover %}<div><img class="photo" src="{{ photo.dataUri }}" alt=""><p>{{ photo.caption|default('') }}{% if photo.author %} · {{ photo.author }}{% endif %}</p></div>{% endif %}{% endfor %}</section>{% endif %}
