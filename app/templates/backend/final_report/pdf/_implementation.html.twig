{% if report.implementation.measures is not empty or texts.implementation.text|default(null) %}<section class="pdf-page report-design-final-implementation"><h2>Implementación</h2>{% if texts.implementation.text|default(null) %}<p>{{ texts.implementation.text|nl2br }}</p>{% endif %}{% if report.implementation.measures is not empty %}<table><thead><tr><th>Medida</th><th>Estado</th><th>Acción / incidencia</th></tr></thead><tbody>{% for item in report.implementation.measures %}<tr><td>{{ item.measureName|default('—') }}</td><td>{{ item.state }}</td><td>{{ item.actionTaken|default(item.incident|default(item.observations|default('—'))) }}</td></tr>{% endfor %}</tbody></table>{% endif %}</section>{% endif %}
