{% if report.ods is not empty or report.commitment.totalOfficialPoints|default(0) > 0 or texts.ods.text|default(null) %}<section class="pdf-page report-design-final-ods-commitment"><h2>{{ 'backend.final_report.pdf.ods_commitment_title'|trans }}</h2>{% if texts.ods.text|default(null) %}<p>{{ texts.ods.text|nl2br }}</p>{% endif %}{% if report.ods is not empty %}<ul>{% for ods in report.ods %}<li>ODS {{ ods.code|replace({'ODS': '', 'ods': ''})|trim }} · {{ ods.name }}</li>{% endfor %}</ul><p class="muted">{{ 'backend.final_report.pdf.ods_notice'|trans }}</p>{% endif %}{% if report.commitment.totalOfficialPoints|default(0) > 0 %}<p><strong>{{ 'backend.final_report.pdf.commitment_level'|trans }}:</strong> {{ ('backend.plan.commitment.levels.' ~ report.commitment.implemented.levelKey ~ '.label')|trans }}</p>{% endif %}</section>{% endif %}
