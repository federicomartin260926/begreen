{% if report.ods is not empty or report.commitment.totalOfficialPoints|default(0) > 0 or texts.ods.text|default(null) %}<section class="pdf-page report-design-final-ods-commitment"><h2>ODS asociados y nivel de compromiso</h2>{% if texts.ods.text|default(null) %}<p>{{ texts.ods.text|nl2br }}</p>{% endif %}{% if report.ods is not empty %}<ul>{% for ods in report.ods %}<li>ODS {{ ods.code|replace({'ODS': ''})|trim }} · {{ ods.name }}</li>{% endfor %}</ul><p class="muted">Estas asociaciones son informativas y no constituyen una certificación.</p>{% endif %}{% if report.commitment.totalOfficialPoints|default(0) > 0 %}<p><strong>Nivel de compromiso implementado:</strong> {{ ('backend.plan.commitment.levels.' ~ report.commitment.implemented.levelKey ~ '.label')|trans }}</p>{% endif %}</section>{% endif %}
