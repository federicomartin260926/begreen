{% extends 'base_backend.html.twig' %}

{% macro editorial(section, content, rows = 3, project = null, canEdit = false) %}
  {% set value = content.manualTexts[section]|default({}) %}
  <label class="form-label fw-semibold" for="manual-{{ section }}">{{ ('backend.final_report.sections.' ~ section)|trans }}</label>
  {% if value.origin|default('manual') == 'ai' %}<span class="badge text-bg-info ms-1 mb-2">{{ 'backend.final_report.origin_ai'|trans }}</span>{% endif %}
  <div class="border rounded-2 overflow-hidden bg-white final-report-rich-text" data-controller="final-report-rich-text" data-ai-section-editor data-persisted-origin="{{ value.origin|default('manual') }}">
  <div class="d-flex flex-wrap gap-1 border-bottom bg-light p-2" role="toolbar" aria-label="{{ 'backend.final_report.rich_text.toolbar'|trans }}">
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="bold" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.bold'|trans }}"><strong>B</strong></button>
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="italic" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.italic'|trans }}"><em>I</em></button>
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="ul" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.bullets'|trans }}">{{ 'backend.final_report.rich_text.bullets_short'|trans }}</button>
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="ol" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.numbered'|trans }}">{{ 'backend.final_report.rich_text.numbered_short'|trans }}</button>
  </div>
  <div class="form-control border-0 rounded-0" contenteditable="true" role="textbox" aria-multiline="true" style="min-height:100px; white-space:pre-wrap" data-rich-surface hidden></div>
  <textarea class="form-control border-0 rounded-0" data-rich-source rows="{{ rows }}" maxlength="10000" id="manual-{{ section }}" name="manualTexts[{{ section }}]" form="final-report-editorial-form">{{ value.text|default('') }}</textarea>
  {% if canEdit and project and section in ['executive_summary', 'implementation', 'featured_storytelling'] %}
  <div class="d-flex flex-wrap align-items-center gap-2 border-top p-2">
    <button class="btn btn-sm btn-outline-success" type="button" data-action="click->final-report-editor#generateSectionNarrative" data-endpoint="{{ path('backend_final_report_section_narrative_generate', {section: section}) }}" data-csrf-token="{{ csrf_token('final_report_section_ai_' ~ project.id ~ '_' ~ section) }}">
      <i class="bi bi-stars me-1" aria-hidden="true"></i>{{ 'backend.final_report.section_ai_generate'|trans }}
    </button>
    <span class="small" data-ai-section-status role="status" aria-live="polite"></span>
  </div>
  {% endif %}
</div>
{% endmacro %}

{% block title %}{{ 'backend.final_report.title'|trans }}{% endblock %}
{% block breadcrumb %}
  {% include 'backend/project/_breadcrumb_context.html.twig' with {breadcrumbProject: project} only %}
  <li class="breadcrumb-item active" aria-current="page">{{ 'backend.final_report.title'|trans }}</li>
{% endblock %}

{% block body %}
<style>
  .final-report-rich-text [data-rich-surface] { line-height: 1.3; }
  .final-report-rich-text [data-rich-surface] p { margin: 0 0 .2rem; }
  .final-report-rich-text [data-rich-surface] ul,
  .final-report-rich-text [data-rich-surface] ol { margin: 0 0 .2rem; padding-left: 1.4rem; }
  .final-report-rich-text [data-rich-surface] li { margin: 0; }
</style>
{% set canEdit = is_granted('PROJECT_EDIT', project) %}
<div class="container-fluid py-4" data-controller="final-report-editor"
     data-final-report-editor-featured-page-size-value="10"
     data-final-report-editor-featured-page-status-format-value="{{ 'backend.final_report.featured_page_status'|trans }}"
     data-final-report-editor-featured-narrative-success-message-value="{{ 'backend.final_report.featured_ai_success'|trans }}"
     data-final-report-editor-featured-narrative-error-message-value="{{ 'backend.final_report.featured_ai_error'|trans }}"
     data-final-report-editor-featured-unsaved-message-value="{{ 'backend.final_report.featured_ai_unsaved'|trans }}"
     data-final-report-editor-featured-replace-confirm-message-value="{{ 'backend.final_report.featured_ai_replace_confirm'|trans }}"
     data-final-report-editor-origin-manual-label-value="{{ 'backend.final_report.origin_manual'|trans }}"
     data-final-report-editor-origin-ai-label-value="{{ 'backend.final_report.origin_ai'|trans }}"
     data-final-report-editor-photo-save-error-message-value="{{ 'backend.final_report.photo_editorial_save_error'|trans }}"
     data-final-report-editor-photo-saving-message-value="{{ 'backend.final_report.photo_editorial_saving'|trans }}"
     data-final-report-editor-section-ai-success-message-value="{{ 'backend.final_report.section_ai_success'|trans }}"
     data-final-report-editor-section-ai-error-message-value="{{ 'backend.final_report.section_ai_error'|trans }}"
     data-final-report-editor-section-ai-unsaved-message-value="{{ 'backend.final_report.section_ai_unsaved'|trans }}"
     data-final-report-editor-section-ai-replace-confirm-message-value="{{ 'backend.final_report.section_ai_replace_confirm'|trans }}">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><span class="badge text-bg-success mb-2">{{ 'backend.final_report.phase'|trans }}</span><h1 class="h2 mb-1">{{ 'backend.final_report.title'|trans }}</h1><p class="text-muted mb-0">{{ 'backend.final_report.subtitle'|trans({'%project%': project.name}) }}</p></div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-success" target="_blank" href="{{ path('backend_final_report_preview') }}"><i class="bi bi-eye me-1"></i>{{ 'backend.final_report.preview_pdf'|trans }}</a>
      <a class="btn btn-success" href="{{ path('backend_final_report_download') }}"><i class="bi bi-file-earmark-pdf me-1"></i>{{ 'backend.final_report.download_pdf'|trans }}</a>
      <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#finalReportPhotosModal"><i class="bi bi-images me-1"></i>{{ 'backend.final_report.manage_photos'|trans }}</button>
      {% if is_granted('ROLE_SUPER_ADMIN') %}<a class="btn btn-outline-secondary" href="{{ path('admin_report_design_index', {document: 'final-sustainability-report', variant: 'general'}) }}"><i class="bi bi-palette me-1"></i>{{ 'backend.final_report.customize_design'|trans }}</a>{% endif %}
    </div>
  </div>
  <div class="alert alert-info d-flex gap-2" role="status"><i class="bi bi-info-circle-fill" aria-hidden="true"></i><div>{{ 'backend.final_report.base_notice'|trans }}<div class="small mt-1">{{ 'backend.final_report.standard_order_notice'|trans }}</div></div></div>
  <form id="final-report-editorial-form" method="post" action="{{ path('backend_final_report_save') }}" data-action="submit->final-report-editor#syncRichEditors"><input type="hidden" name="_token" value="{{ csrf_token('final_report_save_' ~ project.id) }}"></form>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-cover">
    <div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-cover">1. {{ 'backend.final_report.cards.cover'|trans }}</h2></div>
    <div class="card-body"><p class="text-muted">{{ 'backend.final_report.cover_help'|trans }}</p><div class="d-flex flex-nowrap gap-2 overflow-auto pb-2" style="scrollbar-width:thin" role="group" aria-label="{{ 'backend.final_report.cards.cover'|trans }}">
      <div class="flex-shrink-0" style="width:170px"><label class="card p-2 mb-0 h-100" for="cover-none" style="min-height:126px"><span class="d-flex align-items-start gap-2"><input class="form-check-input flex-shrink-0 mt-1 ms-0" type="radio" name="coverDocumentId" value="" id="cover-none" form="final-report-editorial-form" {% if content.coverDocumentId is null %}checked{% endif %}><span class="small fw-semibold">{{ 'backend.final_report.no_cover'|trans }}</span></span></label></div>
      {% for document in gallery %}{% set photo = photoValues[document.id]|default({}) %}<div class="flex-shrink-0" style="width:170px"><label class="card mb-0 h-100 overflow-hidden" for="cover-{{ document.id }}"><img src="{{ path('backend_final_report_photo_view', {documentId: document.id}) }}" class="card-img-top object-fit-cover" style="height:94px" alt="{{ photo.caption|default(document.originalName)|default('') }}"><span class="card-body p-2 d-flex align-items-center gap-2" style="min-width:0"><input class="form-check-input flex-shrink-0 mt-0 ms-0" type="radio" name="coverDocumentId" value="{{ document.id }}" id="cover-{{ document.id }}" form="final-report-editorial-form" {% if content.coverDocumentId == document.id %}checked{% endif %}><span class="d-block text-truncate small" style="min-width:0;max-width:132px" title="{{ photo.caption|default(document.originalName)|default(('backend.final_report.photo_number'|trans({'%id%': document.id}))) }}">{{ photo.caption|default(document.originalName)|default(('backend.final_report.photo_number'|trans({'%id%': document.id}))) }}</span></span></label></div>{% endfor %}
    </div></div>
  </section>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-summary">
    <div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-summary">2. {{ 'backend.final_report.cards.summary'|trans }}</h2></div>
    <div class="card-body">

      <div class="row g-3"><div class="col-12">{{ _self.editorial('executive_summary', content, 3, project, canEdit) }}</div></div>
    </div>
  </section>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-plan" data-begreen-plan-pdf-parity="1">
    <div class="card-header bg-white py-3">
      <h2 class="h4 mb-0" id="final-report-plan">3. {{ 'backend.final_report.cards.plan'|trans }}</h2>
    </div>
    <div class="card-body fr-plan-overview">
      <style>
        .fr-plan-overview .fr-plan-stat { background: #edf5f0; padding: 1.15rem .65rem; text-align: center; height: 100%; }
        .fr-plan-overview .fr-plan-stat-number { font-size: 1.8rem; font-weight: 700; color: #007b50; line-height: 1.2; }
        .fr-plan-overview .fr-plan-stat-label { font-size: .87rem; margin-top: .35rem; }
        .fr-plan-overview .fr-plan-row { display: grid; grid-template-columns: minmax(125px, 1fr) minmax(100px, 1.8fr) minmax(75px, .65fr); align-items: center; gap: .9rem; padding: .7rem 0; border-bottom: 1px solid #e2e7e4; }
        .fr-plan-overview .fr-plan-track { height: 13px; background: #e4eae6; overflow: hidden; }
        .fr-plan-overview .fr-plan-fill { height: 100%; background: #00815b; }
        .fr-plan-overview .fr-plan-row[data-state="in_progress"] .fr-plan-fill { background: #75b49e; }
        .fr-plan-overview .fr-plan-row[data-state="pending"] .fr-plan-fill { background: #d4a95e; }
        .fr-plan-overview .fr-plan-row[data-state="not_implemented"] .fr-plan-fill { background: #c4776a; }
        .fr-plan-overview .fr-plan-row[data-state="discarded"] .fr-plan-fill { background: #8ca198; }
        .fr-plan-overview .fr-plan-row[data-state="not_applicable"] .fr-plan-fill { background: #bdcbc3; }
        @media (max-width: 575.98px) {
          .fr-plan-overview .fr-plan-row { grid-template-columns: minmax(85px, 1fr) minmax(65px, 1fr) minmax(65px, .65fr); gap: .45rem; font-size: .8rem; }
        }
      </style>
      {% set planSummary = report.implementation.summary %}
      {% set measureTotal = planSummary.totalMeasures|default(0) %}
      {% set stateCounts = planSummary.byState|default({}) %}
      <div class="mb-3 text-muted small">
        {{ 'backend.final_report.pdf.protocol'|trans }}:
        <strong class="text-body">{{ report.plan.protocol.name|default('—') }}</strong>
      </div>
      <div class="row g-2 mb-4" aria-label="{{ 'backend.final_report.cards.plan'|trans }}">
        <div class="col-12 col-sm-4"><div class="fr-plan-stat rounded-1">
          <div class="fr-plan-stat-number">{{ measureTotal }}</div>
          <div class="fr-plan-stat-label">{{ 'backend.final_report.measures'|trans }}</div>
        </div></div>
        <div class="col-6 col-sm-4"><div class="fr-plan-stat rounded-1">
          <div class="fr-plan-stat-number">{{ planSummary.implementedMeasures|default(0) }}</div>
          <div class="fr-plan-stat-label">{{ 'backend.final_report.pdf.implemented'|trans }}</div>
        </div></div>
        <div class="col-6 col-sm-4"><div class="fr-plan-stat rounded-1">
          <div class="fr-plan-stat-number">{{ planSummary.resolvedMeasures|default(0) }}</div>
          <div class="fr-plan-stat-label">{{ 'backend.final_report.pdf.resolved'|trans }}</div>
        </div></div>
      </div>
      <h3 class="h5 mb-2">{{ 'backend.final_report.pdf.measure_tracking'|trans }}</h3>
      <div class="fr-plan-states">
        {% for state in ['implemented', 'in_progress', 'pending', 'not_implemented', 'discarded', 'not_applicable'] %}
          {% set count = stateCounts[state]|default(0) %}
          {% set percentage = measureTotal > 0 ? (count * 100 / measureTotal)|round(0) : 0 %}
          <div class="fr-plan-row" data-state="{{ state }}">
            <span>{{ ('backend.final_report.pdf.states.' ~ state)|trans }}</span>
            <div class="fr-plan-track" role="progressbar" aria-label="{{ ('backend.final_report.pdf.states.' ~ state)|trans }}" aria-valuemin="0" aria-valuemax="{{ measureTotal }}" aria-valuenow="{{ count }}">
              <div class="fr-plan-fill" style="width: {{ percentage }}%"></div>
            </div>
            <span class="text-end"><strong>{{ count }}</strong> <small class="text-muted">({{ percentage }}%)</small></span>
          </div>
        {% endfor %}
      </div>
      <p class="text-muted small mb-0 mt-3">{{ 'backend.final_report.pdf.state_note'|trans }}</p>
    </div>
  </section>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-implementation"><div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-implementation">4. {{ 'backend.final_report.cards.implementation'|trans }}</h2></div><div class="card-body"><div class="row g-3 mb-3"><div class="col-md-4"><div class="border rounded p-2"><small class="text-muted d-block">{{ 'backend.final_report.measures'|trans }}</small><strong>{{ report.implementation.summary.totalMeasures }}</strong></div></div><div class="col-md-4"><div class="border rounded p-2"><small class="text-muted d-block">{{ 'backend.final_report.states.implemented'|trans }}</small><strong>{{ report.implementation.summary.implementedMeasures }}</strong></div></div></div>{{ _self.editorial('implementation', content, 3, project, canEdit) }}</div></section>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-featured">
    <div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-featured">5. {{ 'backend.final_report.cards.featured'|trans }}</h2></div>
    <div class="card-body"><div class="border rounded p-3 mb-3"><p class="small text-muted mb-2">{{ 'backend.final_report.featured_global_help'|trans }}</p>{{ _self.editorial('featured_storytelling', content, 3, project, canEdit) }}</div><p class="small text-muted mb-2">{{ 'backend.final_report.featured_help'|trans }}</p><p class="small text-muted"><i class="bi bi-images me-1"></i>{{ 'backend.final_report.featured_photo_gallery_condition'|trans }}</p>
      <div class="row g-3 align-items-end mb-3"><div class="col-lg-7"><label class="form-label" for="featured-measure-search">{{ 'backend.final_report.search_measure'|trans }}</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input class="form-control" id="featured-measure-search" type="search" placeholder="{{ 'backend.final_report.search_placeholder'|trans }}" data-final-report-editor-target="featuredSearch" data-action="input->final-report-editor#filterFeatured"></div></div><div class="col-sm-7 col-lg-3"><div class="form-check mb-2"><input class="form-check-input" id="featured-selected-only" type="checkbox" data-final-report-editor-target="featuredSelectedOnly" data-action="change->final-report-editor#filterSelected"><label class="form-check-label" for="featured-selected-only">{{ 'backend.final_report.selected_only'|trans }}</label></div></div><div class="col-sm-5 col-lg-2 text-sm-end"><span class="badge text-bg-success"><span data-final-report-editor-target="featuredSelectedCount">{{ featuredValues|length }}</span> {{ 'backend.final_report.selected_label'|trans }}</span></div></div>
      <div class="vstack gap-3">{% for planned in report.plan.measures %}{% if planned.planMeasureId %}{% set featured = featuredValues[planned.planMeasureId]|default({}) %}{% set implementation = report.implementation.measures[loop.index0] %}{% set selectedPhotoId = featured.photoDocumentId|default(null) %}{% set persistedOrigin = featured.origin|default('manual') %}
        <details class="card" data-final-report-editor-target="featuredItem" data-measure-name="{{ planned.measure.name|default('') }}" data-persisted-origin="{{ persistedOrigin }}" {% if featured %}open{% endif %}>
          <summary class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-2"><span class="form-check mb-0"><input class="form-check-input" type="checkbox" value="1" id="featured-{{ planned.planMeasureId }}" name="featured[{{ planned.planMeasureId }}][selected]" form="final-report-editorial-form" {% if featured %}checked{% endif %} data-final-report-editor-target="featuredCheckbox" data-action="change->final-report-editor#toggleFeatured"><label class="form-check-label fw-semibold" for="featured-{{ planned.planMeasureId }}">{{ planned.measure.name|default('—') }}</label></span><span><span class="badge text-bg-light border me-2">{{ ('backend.final_report.states.' ~ implementation.state)|trans }}</span><span class="small text-muted">{{ 'backend.final_report.show_details'|trans }}</span></span></summary>
          <div class="card-body py-3" data-final-report-editor-target="featuredComment"><div class="row g-3"><div class="col-lg-4">
            <label class="form-label small fw-semibold" for="featured-photo-{{ planned.planMeasureId }}">{{ 'backend.final_report.featured_photo'|trans }}</label><select class="form-select" id="featured-photo-{{ planned.planMeasureId }}" name="featured[{{ planned.planMeasureId }}][photoDocumentId]" form="final-report-editorial-form" data-action="change->final-report-editor#previewFeaturedPhoto"><option value="">{{ 'backend.final_report.no_featured_photo'|trans }}</option>{% for document in gallery %}{% set documentId = document.id %}{% if photoValues[documentId] is defined %}{% set photo = photoValues[documentId] %}{% set filename = document.originalName|default('')|striptags|trim %}{% set fallbackName = 'backend.final_report.photo_number'|trans({'%id%': documentId}) %}{% set displayName = filename ?: fallbackName %}{% set shortName = displayName|length > 20 ? displayName|slice(0, 20) ~ '…' : displayName %}{% set description = photo.caption|default('')|striptags|replace({'\n': ' ', '\r': ' ', '\t': ' '})|trim %}{% set shortDescription = description|length > 100 ? description|slice(0, 100) ~ '…' : description %}<option value="{{ documentId }}" data-preview-url="{{ path('backend_final_report_photo_view', {documentId: documentId}) }}" {% if selectedPhotoId == documentId %}selected{% endif %}>{{ shortName }}{% if shortDescription %} — {{ shortDescription }}{% endif %}</option>{% endif %}{% endfor %}</select>
            <div class="mt-2" data-final-report-editor-target="featuredPhotoPreviewContainer" {% if not selectedPhotoId %}hidden{% endif %}><img class="img-thumbnail d-block mw-100" style="max-height:150px" src="{% if selectedPhotoId %}{{ path('backend_final_report_photo_view', {documentId: selectedPhotoId}) }}{% endif %}" alt="{{ 'backend.final_report.featured_photo_preview'|trans }}" data-final-report-editor-target="featuredPhotoPreview"></div>
          </div><div class="col-lg-8"><div class="d-flex justify-content-between align-items-center gap-2 mb-2"><label class="form-label small fw-semibold mb-0" for="featured-text-{{ planned.planMeasureId }}">{{ 'backend.final_report.featured_individual_story'|trans }}</label><span class="badge {{ persistedOrigin == 'ai' ? 'text-bg-info' : 'text-bg-light border' }}" data-final-report-editor-target="featuredOrigin">{{ persistedOrigin == 'ai' ? ('backend.final_report.origin_ai'|trans) : ('backend.final_report.origin_manual'|trans) }}</span></div>
            <div class="border rounded-2 overflow-hidden bg-white final-report-rich-text" data-controller="final-report-rich-text">
  <div class="d-flex flex-wrap gap-1 border-bottom bg-light p-2" role="toolbar" aria-label="{{ 'backend.final_report.rich_text.toolbar'|trans }}">
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="bold" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.bold'|trans }}"><strong>B</strong></button>
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="italic" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.italic'|trans }}"><em>I</em></button>
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="ul" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.bullets'|trans }}">{{ 'backend.final_report.rich_text.bullets_short'|trans }}</button>
    <button class="btn btn-outline-secondary btn-sm" type="button" data-rich-command="ol" data-action="click->final-report-rich-text#format" title="{{ 'backend.final_report.rich_text.numbered'|trans }}">{{ 'backend.final_report.rich_text.numbered_short'|trans }}</button>
  </div>
  <div class="form-control border-0 rounded-0" contenteditable="true" role="textbox" aria-multiline="true" style="min-height:100px; white-space:pre-wrap" data-rich-surface hidden></div>
  <textarea class="form-control border-0 rounded-0" data-rich-source rows="3" maxlength="2000" id="featured-text-{{ planned.planMeasureId }}" name="featured[{{ planned.planMeasureId }}][text]" form="final-report-editorial-form" data-final-report-editor-target="featuredText" data-action="input->final-report-editor#featuredTextChanged">{{ featured.text|default('') }}</textarea>
</div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">{% if canEdit %}<button class="btn btn-sm btn-outline-success" type="button" data-action="click->final-report-editor#generateFeaturedNarrative" data-endpoint="{{ path('backend_final_report_featured_narrative_generate', {planMeasureId: planned.planMeasureId}) }}" data-csrf-token="{{ csrf_token('final_report_featured_ai_' ~ project.id ~ '_' ~ planned.planMeasureId) }}"><span data-role="label"><i class="bi bi-stars me-1"></i>{{ 'backend.final_report.featured_ai_generate'|trans }}</span><span class="d-none" data-role="loading"><span class="spinner-border spinner-border-sm me-1"></span>{{ 'backend.final_report.featured_ai_loading'|trans }}</span></button>{% endif %}<span class="small" role="status" aria-live="polite" data-final-report-editor-target="featuredNarrativeStatus"></span></div>
          </div></div></div>
        </details>{% endif %}{% else %}<p class="text-muted mb-0">{{ 'backend.final_report.no_measures'|trans }}</p>{% endfor %}</div>
      <nav class="d-flex justify-content-between align-items-center gap-3 mt-3" aria-label="{{ 'backend.final_report.featured_pagination'|trans }}" data-final-report-editor-target="featuredPagination"><button class="btn btn-sm btn-outline-secondary" type="button" data-final-report-editor-target="featuredPrevious" data-action="click->final-report-editor#previousFeaturedPage">{{ 'backend.final_report.previous'|trans }}</button><span class="small text-muted text-center" data-final-report-editor-target="featuredPageStatus"></span><button class="btn btn-sm btn-outline-secondary" type="button" data-final-report-editor-target="featuredNext" data-action="click->final-report-editor#nextFeaturedPage">{{ 'backend.final_report.next'|trans }}</button></nav>
    </div>
  </section>

  <div class="modal fade" id="finalReportPhotosModal" tabindex="-1" aria-labelledby="finalReportPhotosModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="finalReportPhotosModalLabel">{{ 'backend.final_report.manage_photos'|trans }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.final_report.close'|trans }}"></button></div><div class="modal-body"><p class="text-muted">{{ 'backend.final_report.gallery_help'|trans }}</p><div class="row g-3">
    {% for document in gallery %}{% set photo = photoValues[document.id]|default({}) %}<div class="col-xl-3 col-lg-4 col-sm-6"><article class="card h-100" {% if photo %}data-controller="final-report-photo-replace" data-final-report-photo-replace-confirm-message-value="{{ 'backend.final_report.replace_confirm'|trans }}" data-final-report-photo-replace-max-size-message-value="{{ 'backend.final_report.photo_too_large'|trans }}"{% endif %}><div class="position-relative"><img src="{{ path('backend_final_report_photo_view', {documentId: document.id}) }}" class="card-img-top object-fit-cover" style="height:135px" alt="{{ photo.caption|default(document.originalName)|default('') }}" {% if photo %}data-final-report-photo-replace-target="image"{% endif %}>{% if content.coverDocumentId == document.id %}<span class="badge text-bg-success position-absolute top-0 end-0 m-2">{{ 'backend.final_report.cover_badge'|trans }}</span>{% endif %}</div><div class="card-body p-3">
      <div class="form-check mb-2"><input class="form-check-input" type="checkbox" value="1" id="photo-{{ document.id }}" name="photos[{{ document.id }}][selected]" form="final-report-editorial-form" {% if photo %}checked{% endif %}><label class="form-check-label fw-semibold" for="photo-{{ document.id }}">{{ 'backend.final_report.include_photo'|trans }}</label></div>
      <details class="border-top pt-2 mt-2"><summary class="small fw-semibold">{{ 'backend.final_report.edit_metadata'|trans }}</summary><div class="pt-2"><label class="form-label small" for="photo-caption-{{ document.id }}">{{ 'backend.final_report.caption'|trans }}</label><input class="form-control form-control-sm mb-2" id="photo-caption-{{ document.id }}" maxlength="500" name="photos[{{ document.id }}][caption]" form="final-report-editorial-form" value="{{ photo.caption|default('') }}"><label class="form-label small" for="photo-author-{{ document.id }}">{{ 'backend.final_report.author'|trans }}</label><input class="form-control form-control-sm mb-2" id="photo-author-{{ document.id }}" maxlength="160" name="photos[{{ document.id }}][author]" form="final-report-editorial-form" value="{{ photo.author|default('') }}"><input type="hidden" name="photos[{{ document.id }}][planMeasureId]" form="final-report-editorial-form" value="{{ photo.planMeasureId|default('') }}"><input type="hidden" name="photos[{{ document.id }}][position]" form="final-report-editorial-form" value="{{ photo.position|default(loop.index) }}">{% if canEdit %}<button class="btn btn-sm btn-outline-success w-100" type="submit" form="final-report-editorial-form"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Guardar descripción y autor</button>{% endif %}</div></details>
      {% if photo %}<form class="border-top pt-2 mt-2" method="post" action="{{ path('backend_final_report_photo_replace', {documentId: document.id}) }}" enctype="multipart/form-data" data-action="submit->final-report-editor#submitPhotoOperation" data-confirm-message="{{ 'backend.final_report.replace_confirm'|trans }}"><input type="hidden" name="_token" value="{{ csrf_token('final_report_photo_replace_' ~ project.id ~ '_' ~ document.id) }}"><label class="form-label small fw-semibold" for="replace-photo-{{ document.id }}">{{ 'backend.final_report.replace_photo'|trans }}</label><input class="form-control form-control-sm mb-2" id="replace-photo-{{ document.id }}" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required data-final-report-photo-replace-target="input" data-action="change->final-report-photo-replace#preview" data-upload-max-size="4194304" data-upload-extensions="jpg,jpeg,png,webp" data-upload-mime-types="image/jpeg,image/png,image/webp"><div class="form-text mb-2">{{ 'backend.final_report.photo_rules'|trans }}</div><button class="btn btn-sm btn-outline-secondary w-100" type="submit" data-final-report-photo-replace-target="submit">{{ 'backend.final_report.confirm_replace'|trans }}</button></form>{% endif %}
      <form class="border-top pt-2 mt-2" method="post" action="{{ path('backend_final_report_photo_remove', {documentId: document.id}) }}" data-action="submit->final-report-editor#submitPhotoOperation" data-confirm-message="{{ 'backend.final_report.remove_confirm'|trans }}"><input type="hidden" name="_token" value="{{ csrf_token('final_report_photo_remove_' ~ project.id ~ '_' ~ document.id) }}"><button class="btn btn-sm btn-outline-danger w-100" type="submit">{{ 'backend.final_report.remove_photo'|trans }}</button></form>
    </div></article></div>{% else %}<div class="col-12"><p class="text-muted mb-0">{{ 'backend.final_report.no_photos'|trans }}</p></div>{% endfor %}</div>
    <form method="post" action="{{ path('backend_final_report_photo_upload') }}" enctype="multipart/form-data" class="row g-3 align-items-end border-top mt-4 pt-3" data-action="submit->final-report-editor#submitPhotoOperation"><input type="hidden" name="_token" value="{{ csrf_token('final_report_upload_' ~ project.id) }}"><div class="col-md-8"><label class="form-label" for="report-photo">{{ 'backend.final_report.photo_file'|trans }}</label><input class="form-control" id="report-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required data-upload-max-size="4194304" data-upload-extensions="jpg,jpeg,png,webp" data-upload-mime-types="image/jpeg,image/png,image/webp"></div><div class="col-md-4"><button class="btn btn-outline-success w-100" type="submit">{{ 'backend.final_report.upload'|trans }}</button></div><div class="col-12 mt-1"><div class="form-text mt-0">{{ 'backend.final_report.photo_rules'|trans }}</div></div></form>
    <div class="small mt-3" role="status" aria-live="polite" data-final-report-editor-target="photoOperationStatus"></div>
  </div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'backend.final_report.close'|trans }}</button></div></div></div></div>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-emissions" data-begreen-emissions-pdf-preview="1">
    <div class="card-header bg-white py-3">
      <h2 class="h4 mb-0" id="final-report-emissions">6. {{ 'backend.final_report.cards.emissions'|trans }}</h2>
    </div>
    <div class="card-body fr-emissions-preview">
      <style>
        .fr-emissions-preview .fr-emissions-total { background: #edf5f0; padding: 1.2rem 1.35rem; }
        .fr-emissions-preview .fr-emissions-total-value { font-size: 1.85rem; line-height: 1.25; color: #007b50; font-weight: 700; }
        .fr-emissions-preview .fr-emissions-row { display: grid; grid-template-columns: minmax(125px,1fr) minmax(120px,1.6fr) minmax(85px,.65fr); align-items: center; gap: .85rem; padding: .65rem 0; border-bottom: 1px solid #e2e7e4; }
        .fr-emissions-preview .fr-emissions-track { height: 13px; background: #e4eae6; overflow: hidden; }
        .fr-emissions-preview .fr-emissions-fill { height: 100%; background: #438365; }
        .fr-emissions-preview .fr-emissions-phase { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; padding: .55rem 0; border-bottom: 1px solid #e2e7e4; }
        @media (max-width: 575.98px) {
          .fr-emissions-preview .fr-emissions-row { grid-template-columns: minmax(80px,1fr) minmax(70px,1fr) minmax(66px,.8fr); gap: .4rem; font-size: .8rem; }
          .fr-emissions-preview .fr-emissions-total-value { font-size: 1.4rem; }
        }
      </style>
      {# The existing editor remains attached to the editorial form and saves with the existing flow. #}
      <div class="mb-4">{{ _self.editorial('emissions', content, 3) }}</div>
      {% set carbon = report.emissions %}
      {% set carbonTotal = carbon.available and carbon.totalKgCo2e is not null ? carbon.totalKgCo2e : 0 %}
      <div class="fr-emissions-total rounded-1 mb-4">
        <div class="text-muted small mb-1">{{ 'backend.final_report.pdf.recorded_emissions'|trans }}</div>
        <div class="fr-emissions-total-value">
          {% if carbon.available %}{{ carbon.totalKgCo2e|number_format(2, ',', '.') }} kg CO₂e{% else %}{{ 'backend.final_report.unavailable'|trans }}{% endif %}
        </div>
        <div class="small text-muted mt-1">{{ 'backend.final_report.valid_records'|trans({'%count%': carbon.validRecordCount}) }}</div>
      </div>
      <h3 class="h5 mb-2">{{ 'backend.final_report.pdf.category_distribution'|trans }}</h3>
      <div class="fr-emissions-categories mb-2">
        {% for item in carbon.byCategory %}
          {% set percent = carbonTotal > 0 ? (item.kgCo2e * 100 / carbonTotal) : 0 %}
          {% set barPercent = percent > 100 ? 100 : (percent < 0 ? 0 : percent) %}
          <div class="fr-emissions-row">
            <span>{{ item.name|default('backend.final_report.pdf.no_category'|trans) }}</span>
            <div class="fr-emissions-track" role="progressbar" aria-label="{{ item.name|default('backend.final_report.pdf.no_category'|trans) }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ barPercent|round(2) }}">
              <div class="fr-emissions-fill" style="width: {{ barPercent|number_format(2, '.', '') }}%"></div>
            </div>
            <span class="text-end text-nowrap">{{ item.kgCo2e|number_format(2, ',', '.') }}</span>
          </div>
        {% else %}
          <p class="small text-muted">{{ 'backend.final_report.unavailable'|trans }}</p>
        {% endfor %}
      </div>
      <p class="small text-muted mb-4">{{ 'backend.final_report.pdf.emission_note'|trans }}</p>
      <h3 class="h5 mb-2">{{ 'backend.final_report.pdf.emissions_by_phase'|trans }}</h3>
      <div class="fr-emissions-phases">
        {% for phase in carbon.byPhase %}
          <div class="fr-emissions-phase">
            <span>{{ ('backend.final_report.pdf.phases.' ~ phase.code)|trans }}</span>
            <span class="text-end text-nowrap">{{ phase.kgCo2e|number_format(2, ',', '.') }} kg CO₂e</span>
          </div>
        {% else %}
          <p class="small text-muted">{{ 'backend.final_report.unavailable'|trans }}</p>
        {% endfor %}
      </div>
    </div>
  </section>
  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-ods" data-begreen-ods-pdf-preview="1">
    <div class="card-header bg-white py-3">
      <h2 class="h4 mb-0" id="final-report-ods">7. {{ 'backend.final_report.cards.ods'|trans }}</h2>
    </div>
    <div class="card-body">
      {# The WYSIWYG remains editable, bound to the same editorial form, and appears first, as in the PDF. #}
      <div class="mb-4">{{ _self.editorial('ods', content, 3) }}</div>
      {# These values come from the same factual data used by the final PDF. #}
      {% if report.ods is not empty %}
        <ul class="mb-2 ps-4">
          {% for ods in report.ods %}
            <li>ODS {{ ods.code|replace({'ODS': '', 'ods': ''})|trim }} · {{ ods.name }}</li>
          {% endfor %}
        </ul>
        <p class="small text-muted mb-3">{{ 'backend.final_report.pdf.ods_notice'|trans }}</p>
      {% else %}
        <p class="small text-muted mb-3">{{ 'backend.final_report.unavailable'|trans }}</p>
      {% endif %}
      {% if report.commitment.totalOfficialPoints|default(0) > 0 %}
        <p class="mb-0">
          <strong>{{ 'backend.final_report.pdf.commitment_level'|trans }}:</strong>
          {{ ('backend.plan.commitment.levels.' ~ report.commitment.implemented.levelKey ~ '.label')|trans }}
        </p>
      {% endif %}
    </div>
  </section>
  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-conclusion"><div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-conclusion">8. {{ 'backend.final_report.cards.conclusion'|trans }}</h2></div><div class="card-body"><div class="row g-3"><div class="col-lg-6">{{ _self.editorial('deviations_learnings', content, 3) }}</div><div class="col-lg-6">{{ _self.editorial('conclusion', content, 3) }}</div></div></div></section>
  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-annex"><div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-annex">9. {{ 'backend.final_report.cards.annex'|trans }}</h2></div><div class="card-body"><input type="hidden" name="includeTechnicalAnnex" value="0" form="final-report-editorial-form"><div class="form-check"><input class="form-check-input" type="checkbox" id="include-technical-annex" name="includeTechnicalAnnex" value="1" form="final-report-editorial-form" {% if content.technicalAnnexIncluded %}checked{% endif %}><label class="form-check-label fw-semibold" for="include-technical-annex">{{ 'backend.final_report.include_technical_annex'|trans }}</label></div><p class="small text-muted mb-0 mt-2">{{ 'backend.final_report.annex_help'|trans({'%count%': report.plan.measures|length}) }}</p></div></section>
  <div class="position-sticky bottom-0 bg-body border-top py-3 d-flex justify-content-end"><button class="btn btn-success btn-lg" type="submit" form="final-report-editorial-form"><i class="bi bi-save me-1"></i>{{ 'backend.final_report.save'|trans }}</button></div>
</div>
{% endblock %}
