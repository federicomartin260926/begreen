{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.final_report.title'|trans }}{% endblock %}

{% block body %}
<div class="container-fluid py-4" data-controller="final-report-editor" data-final-report-editor-featured-page-size-value="10">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <span class="badge text-bg-success mb-2">{{ 'backend.final_report.phase'|trans }}</span>
      <h1 class="h2 mb-1">{{ 'backend.final_report.title'|trans }}</h1>
      <p class="text-muted mb-0">{{ 'backend.final_report.subtitle'|trans({'%project%': project.name}) }}</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-success" target="_blank" href="{{ path('backend_final_report_preview') }}"><i class="bi bi-eye me-1"></i>Previsualizar PDF</a>
      <a class="btn btn-success" href="{{ path('backend_final_report_download') }}"><i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF</a>
      {% if is_granted('ROLE_SUPER_ADMIN') %}<a class="btn btn-outline-secondary" href="{{ path('admin_report_design_index', {document: 'final-sustainability-report', variant: 'general'}) }}"><i class="bi bi-palette me-1"></i>Personalizar diseño</a>{% endif %}
      <a class="btn btn-outline-secondary" href="{{ path('backend_project_index') }}"><i class="bi bi-arrow-left me-1"></i>{{ 'backend.final_report.back'|trans }}</a>
    </div>
  </div>

  <div class="alert alert-info d-flex gap-2" role="status">
    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
    <div>{{ 'backend.final_report.base_notice'|trans }}</div>
  </div>

  <form id="final-report-editorial-form" method="post" action="{{ path('backend_final_report_save') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('final_report_save_' ~ project.id) }}">
  </form>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-project-summary">
    <div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-project-summary">1. Resumen del proyecto</h2></div>
    <div class="card-body">
      <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">{{ 'backend.final_report.project'|trans }}</div><strong>{{ report.project.name }}</strong><div>{{ report.project.country|default('—') }}</div></div></div>
        <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">{{ 'backend.final_report.measures'|trans }}</div><strong>{{ report.implementation.summary.totalMeasures }}</strong><div>{{ 'backend.final_report.implemented_count'|trans({'%count%': report.implementation.summary.implementedMeasures}) }}</div></div></div>
        <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">{{ 'backend.final_report.emissions'|trans }}</div><strong>{% if report.emissions.available %}{{ report.emissions.totalKgCo2e|number_format(2, ',', '.') }} kgCO₂e{% else %}{{ 'backend.final_report.unavailable'|trans }}{% endif %}</strong><div>{{ 'backend.final_report.valid_records'|trans({'%count%': report.emissions.validRecordCount}) }}</div></div></div>
      </div>

      <div class="row g-4 mb-3">
        <div class="col-lg-6">
          <h3 class="h6">{{ 'backend.final_report.emissions_by_category'|trans }}</h3>
          <ul class="list-group list-group-flush">
            {% for item in report.emissions.byCategory %}<li class="list-group-item px-0 d-flex justify-content-between"><span>{{ item.name|default('—') }}</span><strong>{{ item.kgCo2e|number_format(2, ',', '.') }} kgCO₂e</strong></li>{% else %}<li class="list-group-item px-0 text-muted">{{ 'backend.final_report.unavailable'|trans }}</li>{% endfor %}
          </ul>
        </div>
        <div class="col-lg-6">
          <h3 class="h6">{{ 'backend.final_report.ods'|trans }}</h3>
          <div class="d-flex flex-wrap gap-2">
            {% for ods in report.ods %}<span class="badge rounded-pill text-bg-success">ODS {{ ods.code }} · {{ ods.name }}</span>{% else %}<span class="text-muted">{{ 'backend.final_report.unavailable'|trans }}</span>{% endfor %}
          </div>
          <p class="small text-muted mt-2 mb-0">{{ 'backend.final_report.ods_notice'|trans }}</p>
        </div>
      </div>

      <details class="border rounded">
        <summary class="px-3 py-2 fw-semibold">Ver las {{ report.plan.measures|length }} medidas y sus estados</summary>
        <div class="table-responsive p-3 pt-2">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>{{ 'backend.final_report.measure'|trans }}</th><th>{{ 'backend.final_report.decision'|trans }}</th><th>{{ 'backend.final_report.state'|trans }}</th></tr></thead>
            <tbody>
            {% for planned in report.plan.measures %}
              {% set implementation = report.implementation.measures[loop.index0] %}
              <tr><td>{{ planned.measure.name|default('—') }}</td><td>{{ planned.decision.primary|default('—') }}</td><td><span class="badge text-bg-light border">{{ implementation.state }}</span></td></tr>
            {% else %}
              <tr><td colspan="3" class="text-muted">{{ 'backend.final_report.no_measures'|trans }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-featured">
    <div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-featured">2. {{ 'backend.final_report.featured_title'|trans }}</h2></div>
    <div class="card-body">
      <p class="text-muted">{{ 'backend.final_report.featured_help'|trans }}</p>
      <div class="row g-3 align-items-end mb-3">
        <div class="col-lg-7">
          <label class="form-label" for="featured-measure-search">Buscar medida por nombre</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
            <input class="form-control" id="featured-measure-search" type="search" placeholder="Escribe para filtrar…" data-final-report-editor-target="featuredSearch" data-action="input->final-report-editor#filterFeatured">
          </div>
        </div>
        <div class="col-sm-7 col-lg-3">
          <div class="form-check mb-2">
            <input class="form-check-input" id="featured-selected-only" type="checkbox" data-final-report-editor-target="featuredSelectedOnly" data-action="change->final-report-editor#filterSelected">
            <label class="form-check-label" for="featured-selected-only">Solo seleccionadas</label>
          </div>
        </div>
        <div class="col-sm-5 col-lg-2 text-sm-end">
          <span class="badge text-bg-success" aria-live="polite"><span data-final-report-editor-target="featuredSelectedCount">{{ featuredValues|length }}</span> seleccionadas</span>
        </div>
      </div>
      <div class="list-group">
        {% for planned in report.plan.measures %}
          {% if planned.planMeasureId %}
            {% set featured = featuredValues[planned.planMeasureId]|default({}) %}
            <div class="list-group-item" data-final-report-editor-target="featuredItem" data-measure-name="{{ planned.measure.name|default('') }}">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="1" id="featured-{{ planned.planMeasureId }}" name="featured[{{ planned.planMeasureId }}][selected]" form="final-report-editorial-form" {% if featured %}checked{% endif %} data-final-report-editor-target="featuredCheckbox" data-action="change->final-report-editor#toggleFeatured">
                <label class="form-check-label fw-semibold" for="featured-{{ planned.planMeasureId }}">{{ planned.measure.name|default('—') }}</label>
              </div>
              <div class="mt-2" data-final-report-editor-target="featuredComment" {% if not featured %}hidden{% endif %}>
                <label class="form-label small" for="featured-text-{{ planned.planMeasureId }}">{{ 'backend.final_report.complementary_text'|trans }}</label>
                <textarea class="form-control" rows="2" maxlength="2000" id="featured-text-{{ planned.planMeasureId }}" name="featured[{{ planned.planMeasureId }}][text]" form="final-report-editorial-form">{{ featured.text|default('') }}</textarea>
              </div>
            </div>
          {% endif %}
        {% else %}
          <p class="text-muted mb-0">{{ 'backend.final_report.no_measures'|trans }}</p>
        {% endfor %}
      </div>
      <nav class="d-flex justify-content-between align-items-center gap-3 mt-3" aria-label="Paginación de medidas destacadas" data-final-report-editor-target="featuredPagination">
        <button class="btn btn-sm btn-outline-secondary" type="button" data-final-report-editor-target="featuredPrevious" data-action="click->final-report-editor#previousFeaturedPage">Anterior</button>
        <span class="small text-muted text-center" aria-live="polite" data-final-report-editor-target="featuredPageStatus"></span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-final-report-editor-target="featuredNext" data-action="click->final-report-editor#nextFeaturedPage">Siguiente</button>
      </nav>
    </div>
  </section>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-editorial">
    <div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-editorial">3. Narrativa y textos editoriales</h2></div>
    <div class="card-body">
      <form method="post" action="{{ path('backend_final_report_narrative_generate') }}" class="border rounded p-3 mb-4">
        <input type="hidden" name="_token" value="{{ csrf_token('final_report_ai_' ~ project.id) }}">
        <h3 class="h6">Narrativa asistida por IA</h3>
        <p class="text-muted small">La IA solo se ejecuta al confirmar esta acción. Usa el Informe Base y conserva los textos manuales salvo sustitución explícita.</p>
        <div class="row g-2 mb-3">
          {% for section in ['executive_summary', 'implementation', 'featured_storytelling', 'deviations_learnings', 'conclusion'] %}
            {% set editorial = content.manualTexts[section]|default({}) %}
            {% if editorial.origin|default(null) == 'manual' and editorial.text|default(null) %}
              <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" value="1" name="replaceManual[{{ section }}]" id="replace-{{ section }}"><label class="form-check-label" for="replace-{{ section }}">Sustituir “{{ ('backend.final_report.sections.' ~ section)|trans }}”</label></div></div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="alert alert-warning py-2 small"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Marca una sección solo si quieres sustituir expresamente su texto manual por contenido generado.</div>
        <button class="btn btn-outline-success" type="submit"><i class="bi bi-stars me-1"></i>Generar o mejorar narrativa</button>
      </form>

      <div class="accordion" id="finalReportEditorialSections">
        {% for section in manualSections %}
          {% set manual = content.manualTexts[section]|default({}) %}
          {% set expanded = section == 'executive_summary' %}
          <div class="accordion-item">
            <h3 class="accordion-header" id="editorial-heading-{{ section }}">
              <button class="accordion-button{% if not expanded %} collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#editorial-section-{{ section }}" aria-expanded="{{ expanded ? 'true' : 'false' }}" aria-controls="editorial-section-{{ section }}">
                {{ ('backend.final_report.sections.' ~ section)|trans }}
                {% if manual.origin|default('manual') == 'ai' %}<span class="badge text-bg-light border ms-2">IA</span>{% endif %}
              </button>
            </h3>
            <div id="editorial-section-{{ section }}" class="accordion-collapse collapse{% if expanded %} show{% endif %}" aria-labelledby="editorial-heading-{{ section }}" data-bs-parent="#finalReportEditorialSections">
              <div class="accordion-body">
                <label class="visually-hidden" for="manual-{{ section }}">{{ ('backend.final_report.sections.' ~ section)|trans }}</label>
                <textarea class="form-control" rows="5" maxlength="10000" id="manual-{{ section }}" name="manualTexts[{{ section }}]" form="final-report-editorial-form">{{ manual.text|default('') }}</textarea>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="card border-0 shadow-sm mb-4" aria-labelledby="final-report-photos">
    <div class="card-header bg-white py-3"><h2 class="h4 mb-0" id="final-report-photos">4. {{ 'backend.final_report.gallery_title'|trans }}</h2></div>
    <div class="card-body">
      <p class="text-muted">{{ 'backend.final_report.gallery_help'|trans }}</p>
      <div class="form-check mb-3">
        <input class="form-check-input" type="radio" name="coverDocumentId" value="" id="cover-none" form="final-report-editorial-form" {% if content.coverDocumentId is null %}checked{% endif %}>
        <label class="form-check-label" for="cover-none">{{ 'backend.final_report.no_cover'|trans }}</label>
      </div>

      <div class="row g-3">
        {% for document in gallery %}
          {% set photo = photoValues[document.id]|default({}) %}
          <div class="col-xl-3 col-lg-4 col-sm-6">
            <article class="card h-100" {% if photo %}data-controller="final-report-photo-replace" data-final-report-photo-replace-confirm-message-value="¿Confirmas la sustitución? Se conservarán el pie, autor, orden y portada." data-final-report-photo-replace-max-size-message-value="La imagen no puede superar 4 MB."{% endif %}>
              <div class="position-relative">
                <img src="{{ path('backend_final_report_photo_view', {documentId: document.id}) }}" class="card-img-top object-fit-cover" style="height: 135px" alt="{{ photo.caption|default(document.originalName)|default('') }}" {% if photo %}data-final-report-photo-replace-target="image"{% endif %}>
                {% if content.coverDocumentId == document.id %}<span class="badge text-bg-success position-absolute top-0 end-0 m-2"><i class="bi bi-image me-1" aria-hidden="true"></i>Portada</span>{% endif %}
              </div>
              <div class="card-body p-3">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" value="1" id="photo-{{ document.id }}" name="photos[{{ document.id }}][selected]" form="final-report-editorial-form" {% if photo %}checked{% endif %}>
                  <label class="form-check-label fw-semibold" for="photo-{{ document.id }}">{{ 'backend.final_report.include_photo'|trans }}</label>
                </div>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="coverDocumentId" value="{{ document.id }}" id="cover-{{ document.id }}" form="final-report-editorial-form" {% if content.coverDocumentId == document.id %}checked{% endif %}>
                  <label class="form-check-label" for="cover-{{ document.id }}">{{ 'backend.final_report.cover'|trans }}</label>
                </div>

                <details class="border-top pt-2 mt-2">
                  <summary class="small fw-semibold">Editar metadatos</summary>
                  <div class="pt-2">
                    <label class="form-label small" for="photo-caption-{{ document.id }}">{{ 'backend.final_report.caption'|trans }}</label>
                    <input class="form-control form-control-sm mb-2" id="photo-caption-{{ document.id }}" maxlength="500" name="photos[{{ document.id }}][caption]" form="final-report-editorial-form" value="{{ photo.caption|default('') }}">
                    <label class="form-label small" for="photo-author-{{ document.id }}">{{ 'backend.final_report.author'|trans }}</label>
                    <input class="form-control form-control-sm mb-2" id="photo-author-{{ document.id }}" maxlength="160" name="photos[{{ document.id }}][author]" form="final-report-editorial-form" value="{{ photo.author|default('') }}">
                    <label class="form-label small" for="photo-measure-{{ document.id }}">{{ 'backend.final_report.related_measure'|trans }}</label>
                    <select class="form-select form-select-sm mb-2" id="photo-measure-{{ document.id }}" name="photos[{{ document.id }}][planMeasureId]" form="final-report-editorial-form">
                      <option value="">{{ 'backend.final_report.no_related_measure'|trans }}</option>
                      {% for planned in report.plan.measures %}{% if planned.planMeasureId %}<option value="{{ planned.planMeasureId }}" {% if photo.planMeasureId|default(null) == planned.planMeasureId %}selected{% endif %}>{{ planned.measure.name|default('—') }}</option>{% endif %}{% endfor %}
                    </select>
                    <label class="form-label small" for="photo-position-{{ document.id }}">{{ 'backend.final_report.position'|trans }}</label>
                    <input class="form-control form-control-sm" id="photo-position-{{ document.id }}" type="number" min="0" max="10000" name="photos[{{ document.id }}][position]" form="final-report-editorial-form" value="{{ photo.position|default(loop.index) }}">
                  </div>
                </details>

                {% if photo %}
                  <form class="border-top pt-2 mt-2" method="post" action="{{ path('backend_final_report_photo_replace', {documentId: document.id}) }}" enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ csrf_token('final_report_photo_replace_' ~ project.id ~ '_' ~ document.id) }}">
                    <label class="form-label small fw-semibold" for="replace-photo-{{ document.id }}">{{ 'backend.final_report.replace_photo'|trans }}</label>
                    <input class="form-control form-control-sm mb-2" id="replace-photo-{{ document.id }}" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required data-final-report-photo-replace-target="input" data-action="change->final-report-photo-replace#preview">
                    <div class="form-text mb-2">{{ 'backend.final_report.photo_rules'|trans }}</div>
                    <button class="btn btn-sm btn-outline-secondary w-100" type="submit" data-final-report-photo-replace-target="submit" data-action="click->final-report-photo-replace#confirmReplacement"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Confirmar cambio</button>
                  </form>
                {% endif %}
                <form class="border-top pt-2 mt-2" method="post" action="{{ path('backend_final_report_photo_remove', {documentId: document.id}) }}" data-action="submit->final-report-editor#confirmPhotoRemoval" data-confirm-message="¿Quitar esta fotografía de la galería del Informe Final? El archivo original no se borrará.">
                  <input type="hidden" name="_token" value="{{ csrf_token('final_report_photo_remove_' ~ project.id ~ '_' ~ document.id) }}">
                  <button class="btn btn-sm btn-outline-danger w-100" type="submit"><i class="bi bi-eye-slash me-1" aria-hidden="true"></i>Quitar de la galería</button>
                </form>
              </div>
            </article>
          </div>
        {% else %}
          <div class="col-12"><p class="text-muted mb-0">{{ 'backend.final_report.no_photos'|trans }}</p></div>
        {% endfor %}
      </div>

      <form method="post" action="{{ path('backend_final_report_photo_upload') }}" enctype="multipart/form-data" class="row g-3 align-items-end border-top mt-4 pt-3">
        <input type="hidden" name="_token" value="{{ csrf_token('final_report_upload_' ~ project.id) }}">
        <div class="col-md-8"><label class="form-label" for="report-photo">{{ 'backend.final_report.photo_file'|trans }}</label><input class="form-control" id="report-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required></div>
        <div class="col-md-4"><button class="btn btn-outline-success w-100" type="submit"><i class="bi bi-upload me-1"></i>{{ 'backend.final_report.upload'|trans }}</button></div>
        <div class="col-12 mt-1"><div class="form-text mt-0">{{ 'backend.final_report.photo_rules'|trans }}</div></div>
      </form>
    </div>
  </section>

  <div class="position-sticky bottom-0 bg-body border-top py-3 d-flex justify-content-end">
    <button class="btn btn-success btn-lg" type="submit" form="final-report-editorial-form"><i class="bi bi-save me-1"></i>{{ 'backend.final_report.save'|trans }}</button>
  </div>
</div>
{% endblock %}
