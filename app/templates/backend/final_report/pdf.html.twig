<!doctype html>
<html lang="es"><head><meta charset="UTF-8"><style>
@page { margin: 14mm; }
body { font-family: 'DejaVu Sans', sans-serif; color: #24352c; font-size: 10pt; line-height: 1.4; }
.pdf-page { page-break-after: auto; }
.report-design-final-cover { page-break-after: always; }
.report-design-final-cover--no-image { page-break-after: auto; }
.pdf-page:last-child { page-break-after: auto; }
.report-design-final-executive {
  page-break-after: auto;
  margin-bottom: 8mm;
}
.report-design-final-executive h2 { page-break-after: avoid; }
h1,h2,h3 { color: #176b43; }
table { width: 100%; border-collapse: collapse; }
th,td { padding: 5px; border-bottom: 1px solid #dce5df; text-align: left; vertical-align: top; }
.metric { font-size: 20pt; color: #176b43; }
.photo { max-width: 100%; max-height: 175mm; }
.muted { color: #64736b; }

/* #79 — Formato editorial limitado */
.report-design-final-featured ul, .report-design-final-featured ol,
.report-design-final-conclusion ul, .report-design-final-conclusion ol { margin: 2mm 0 3mm 6mm; }
.pdf-featured-story p { margin: 0 0 2mm; }

/* #79 — Relato al lado de fotografía en Dompdf, sin floats ni flex */
.report-design-final-featured { page-break-after: auto; margin-bottom: 5mm; }
.pdf-featured-measure { page-break-inside: avoid; margin: 0 0 6mm; }
.pdf-featured-measure h3, .pdf-featured-state { page-break-after: avoid; }
.pdf-featured-state { margin-bottom: 2mm; }
.pdf-featured-layout { width: 100%; border-collapse: collapse; table-layout: fixed; }
.pdf-featured-layout td { border: 0; padding: 0; vertical-align: top; }
.pdf-featured-image-cell { width: 26%; padding-right: 5mm !important; }
.pdf-featured-story-cell { width: 74%; }
.pdf-featured-photo { display: block; width: auto; height: auto; max-width: 42mm; max-height: 55mm; }
.pdf-featured-caption { font-size: 8pt; line-height: 1.25; margin-top: 2mm; overflow-wrap: break-word; }
.pdf-featured-story { margin: 0; overflow-wrap: break-word; }

/* Plan de Sostenibilidad — composición compatible con Dompdf */
.report-design-final-plan {
  page-break-after: auto;
  margin-bottom: 8mm;
}
.pdf-plan-protocol { color: #64736b; margin-bottom: 6mm; }
.pdf-plan-metrics { margin: 0 0 6mm; table-layout: fixed; }
.pdf-plan-metrics td {
  width: 33.33%;
  text-align: center;
  padding: 4mm 2mm;
  background: #eef4ef;
  border: 2px solid #fff;
}
.pdf-plan-metrics strong {
  display: block;
  font-size: 22pt;
  color: #176b43;
}
.pdf-plan-metrics span { display: block; font-size: 9pt; }
.pdf-plan-states { width: 100%; margin-bottom: 4mm; }
.pdf-plan-states td { padding: 2mm 3mm; }
.pdf-plan-count { width: 18mm; text-align: right; font-weight: bold; }


/* #72 - Presentación de emisiones compatible con Dompdf */
.pdf-emission-total {
  background: #eef4ef;
  padding: 5mm;
  margin: 0 0 7mm;
}
.pdf-emission-total span {
  display: block;
  color: #64736b;
  font-size: 9pt;
}
.pdf-emission-total strong {
  display: block;
  color: #176b43;
  font-size: 23pt;
}
.pdf-emission-bars {
  width: 100%;
  table-layout: fixed;
  margin: 0 0 3mm;
}
.pdf-emission-bars tr,
.pdf-emission-phases tr {
  page-break-inside: avoid;
}
.pdf-emission-bars td {
  border-bottom: 1px solid #edf1ed;
  padding: 3mm 1mm;
  vertical-align: middle;
}
.pdf-emission-name {
  width: 28%;
  font-size: 9pt;
}
.pdf-emission-chart {
  width: 43%;
}
.pdf-emission-number {
  width: 29%;
  text-align: right;
  white-space: nowrap;
  font-size: 9pt;
}
.pdf-emission-track {
  width: 100%;
  height: 5mm;
  background: #e5ebe7;
}
.pdf-emission-fill {
  height: 5mm;
  background: #287b56;
}
.pdf-emission-note {
  font-size: 8pt;
  color: #64736b;
  margin-bottom: 7mm;
}
.pdf-emission-phases {
  width: 100%;
  margin-top: 3mm;
}
.pdf-emission-phases td:last-child {
  text-align: right;
  white-space: nowrap;
}


/* #72 — Seguimiento visual de medidas */
.pdf-plan-state-bars {
  width: 100%;
  table-layout: fixed;
}
.pdf-plan-state-bars tr {
  page-break-inside: avoid;
}
.pdf-plan-state-bars td {
  vertical-align: middle;
  padding: 3mm 2mm;
}
.pdf-plan-state-name {
  width: 30%;
  font-size: 9pt;
}
.pdf-plan-state-chart {
  width: 42%;
}
.pdf-plan-state-bars .pdf-plan-count {
  width: 28%;
  text-align: right;
  white-space: nowrap;
}
.pdf-plan-state-track {
  width: 100%;
  height: 5mm;
  background: #e5ebe7;
}
.pdf-plan-state-fill {
  height: 5mm;
}
.pdf-plan-state-percent {
  color: #64736b;
  font-size: 8pt;
  font-weight: normal;
}
.pdf-plan-state-note {
  color: #64736b;
  font-size: 8pt;
  margin-top: 2mm;
}


/* #72 — Anexo técnico final */
.report-design-final-annex {
  page-break-before: always;
  page-break-after: auto;
}
.report-design-final-annex h2 {
  margin-bottom: 4mm;
}
.report-design-final-annex table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
  font-size: 8.5pt;
}
.report-design-final-annex thead {
  display: table-header-group;
}
.report-design-final-annex tr {
  page-break-inside: avoid;
}
.report-design-final-annex th,
.report-design-final-annex td {
  padding: 2.5mm;
  vertical-align: top;
  overflow-wrap: break-word;
}

.report-design-final-implementation {
  page-break-inside: avoid;
}

/* #79 Portada con resumen, y espaciado editorial compacto (Dompdf). */
.pdf-cover-photo { display: block; width: 100%; max-width: 100%; height: auto; max-height: none; margin: 0 0 4mm; }
.pdf-cover-project { font-size: 13pt; margin: 0 0 2mm; }
.pdf-cover-credit { font-size: 8pt; margin: 0 0 4mm; }
.pdf-cover-summary-title { font-size: 12pt; margin: 4mm 0 2mm; }
.pdf-rich-text, .pdf-featured-story { line-height: 1.3; }
.pdf-rich-text p, .pdf-featured-story p { margin: 0 0 1.5mm; }
.pdf-rich-text ul, .pdf-rich-text ol, .pdf-featured-story ul, .pdf-featured-story ol { margin: 0 0 1.5mm; padding-left: 5mm; }
.pdf-rich-text li, .pdf-featured-story li { margin: 0; padding: 0; }

{{ reportDesignCss|default('')|raw }}

    </style></head><body>
{% if reportDesignHtml %}{{ reportDesignHtml|raw }}{% else %}
{% include 'backend/final_report/pdf/_cover.html.twig' %}
{% include 'backend/final_report/pdf/_executive.html.twig' %}
{% include 'backend/final_report/pdf/_plan.html.twig' %}
{% include 'backend/final_report/pdf/_implementation.html.twig' %}
{% include 'backend/final_report/pdf/_featured.html.twig' %}
{% include 'backend/final_report/pdf/_gallery.html.twig' %}
{% include 'backend/final_report/pdf/_emissions.html.twig' %}
{% include 'backend/final_report/pdf/_ods-commitment.html.twig' %}
{% include 'backend/final_report/pdf/_conclusion.html.twig' %}
{% endif %}
{% if includeTechnicalAnnex is not defined or includeTechnicalAnnex %}{% include 'backend/final_report/pdf/_annex.html.twig' %}{% endif %}
</body></html>
