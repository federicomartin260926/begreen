{% extends 'base_backend.html.twig' %}

{% set comparisonTitle = 'backend.commercial_plan_comparison.title'|trans({'%phase%': phaseLabel}) %}

{% block title %}{{ comparisonTitle }} · {{ project.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .commercial-plan-comparison__column,
        .commercial-plan-comparison__card,
        .commercial-plan-comparison__card .card-header > .d-flex > div {
            min-width: 0;
        }

        .commercial-plan-comparison__card .card-header {
            padding: 0.75rem 1rem;
        }

        .commercial-plan-comparison__feature-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.5rem 1rem;
        }

        .commercial-plan-comparison__feature-label,
        .commercial-plan-comparison__feature-value {
            line-height: 1.25;
        }

        .commercial-plan-comparison__feature-label {
            flex: 1 1 auto;
            min-width: 0;
        }

        .commercial-plan-comparison__feature-value {
            flex: 0 1 48%;
            min-width: 0;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .commercial-plan-comparison__footer {
            min-height: 4.5rem;
        }

        @media (max-width: 575.98px) {
            .commercial-plan-comparison__feature-row {
                flex-direction: column;
                gap: 0.15rem;
            }

            .commercial-plan-comparison__feature-value {
                flex-basis: auto;
                text-align: left;
            }
        }
    </style>
{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a href="{{ path('backend_project_edit', {id: project.id}) }}" class="text-decoration-none">{{ project.name }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ comparisonTitle }}</li>
{% endblock %}

{% block body %}
    <div class="container-fluid px-0 backend-client-shell">
        <div class="backend-client-content">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h1 class="h3 mb-0">{{ comparisonTitle }}</h1>
                </div>
                <a href="{{ backUrl }}" class="btn btn-outline-secondary text-decoration-none flex-shrink-0">
                    <i class="bi bi-arrow-left me-1"></i>{{ 'backend.common.back'|trans }}
                </a>
            </div>

            <div class="bg-light border rounded-4 p-2 p-md-3">
                {% if phase.value == 'implementation' %}
                    {% include 'backend/commercial_plan/_comparison_implementation.html.twig' with {
                        project: project,
                        comparison: comparison
                    } only %}
                {% else %}
                    {% include 'backend/commercial_plan/_comparison_elaboration.html.twig' with {
                        project: project,
                        comparison: comparison
                    } only %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
