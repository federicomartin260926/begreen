{% extends 'base_backend.html.twig' %}

{% set comparisonTitle = 'backend.commercial_plan_comparison.title'|trans({'%phase%': phaseLabel}) %}

{% block title %}{{ comparisonTitle }} · {{ project.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .commercial-plan-comparison__column,
        .commercial-plan-comparison__card,
        .commercial-plan-comparison__card .card-header > .d-flex > div {
            min-width: 0;
        }

        .commercial-plan-comparison__card .card-header {
            padding: 0.75rem 1rem;
        }

        .commercial-plan-comparison__feature-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.5rem 1rem;
        }

        .commercial-plan-comparison__feature-label,
        .commercial-plan-comparison__feature-value {
            line-height: 1.25;
        }

        .commercial-plan-comparison__feature-label {
            flex: 1 1 auto;
            min-width: 0;
        }

        .commercial-plan-comparison__feature-value {
            flex: 0 1 48%;
            min-width: 0;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .commercial-plan-comparison__footer {
            min-height: 4.5rem;
        }

        @media (max-width: 575.98px) {
            .commercial-plan-comparison__feature-row {
                flex-direction: column;
                gap: 0.15rem;
            }

            .commercial-plan-comparison__feature-value {
                flex-basis: auto;
                text-align: left;
            }
        }
    </style>
{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a href="{{ path('backend_project_edit', {id: project.id}) }}" class="text-decoration-none">{{ project.name }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ comparisonTitle }}</li>
{% endblock %}

{% block body %}
    <div class="container-fluid px-0 backend-client-shell">
        <div class="backend-client-content">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h1 class="h3 mb-0">{{ comparisonTitle }}</h1>
                </div>
                <a href="{{ backUrl }}" class="btn btn-outline-secondary text-decoration-none flex-shrink-0">
                    <i class="bi bi-arrow-left me-1"></i>{{ 'backend.common.back'|trans }}
                </a>
            </div>

            <div class="bg-light border rounded-4 p-2 p-md-3">
                {% if checkoutEnabled %}
                    <div class="border rounded-3 bg-white p-3 mx-2 mt-2 mb-3">
                        <div class="fw-semibold mb-1">Plan comercial del proyecto</div>
                        <p class="small text-muted mb-3">Una única contratación para Elaboración e Implementación. Pago seguro en Stripe (entorno de pruebas).</p>
                        {% if pendingPaymentStatus is not null %}
                            <div class="alert alert-warning py-2 mb-2">
                                Existe un intento de pago pendiente de revisar ({{ pendingPaymentStatus }}). Antes de iniciar otro, verifica el resultado en Stripe.
                            </div>
                            <form method="post" action="{{ path('backend_project_commercial_checkout_verify', {id: project.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('project_commercial_checkout_verify_' ~ project.id) }}">
                                <input type="hidden" name="phase" value="{{ phase.value }}">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Verificar pago en Stripe</button>
                            </form>
                        {% elseif checkoutOffers is not empty %}
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                {% for targetTier, offer in checkoutOffers %}
                                    <form method="post" action="{{ path('backend_project_commercial_checkout_start', {id: project.id, targetTier: targetTier}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('project_commercial_checkout_start_' ~ project.id ~ '_' ~ targetTier) }}">
                                        <input type="hidden" name="phase" value="{{ phase.value }}">
                                        <button type="submit" class="btn {{ targetTier == 'pro' ? 'btn-success' : 'btn-primary' }}">
                                            {{ offer.isUpgrade ? 'Mejorar a Pro' : ('Contratar ' ~ (targetTier|capitalize)) }}
                                            · {{ (offer.amountCents / 100)|number_format(2, ',', '.') }} €
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                            <div class="small text-muted mt-2">El importe se calcula en el servidor y se vuelve a comprobar antes de confirmar el pago.</div>
                        {% elseif checkoutPricingUnavailable %}
                            <div class="alert alert-warning py-2 mb-0">Completa los datos del proyecto necesarios para calcular su tarifa antes de contratar.</div>
                        {% else %}
                            <div class="small text-success">Ya tienes el plan comercial máximo disponible o no hay mejoras activas para este proyecto.</div>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="alert alert-info mx-2 mt-2 mb-3">
                        {{ 'backend.commercial_plan_comparison.checkout_temporarily_unavailable'|trans }}
                    </div>
                {% endif %}
                {% if phase.value == 'implementation' %}
                    {% include 'backend/commercial_plan/_comparison_implementation.html.twig' with {
                        project: project,
                        comparison: comparison
                    } only %}
                {% else %}
                    {% include 'backend/commercial_plan/_comparison_elaboration.html.twig' with {
                        project: project,
                        comparison: comparison
                    } only %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
