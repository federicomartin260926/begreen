<div class="overflow-x-auto py-3">
    <div class="row gx-3 mx-0 flex-nowrap flex-md-wrap">
        {% for plan in comparison.plans %}
            <div class="col-10 col-sm-6 col-md-4 d-flex commercial-plan-comparison__column">
                <section class="card h-100 w-100 position-relative commercial-plan-comparison__card {{ plan.code == 'standard' ? 'border-primary border-2' : 'border' }}">
                    {% if plan.code == 'standard' %}
                        <span class="position-absolute top-0 start-0 translate-middle-y ms-3 badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">
                            {{ 'backend.commercial_plan_comparison.most_popular'|trans }}
                        </span>
                    {% endif %}

                    <div class="card-header bg-white p-3 {{ plan.code == 'standard' ? 'pt-4' : '' }}">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <h3 class="h5 mb-1">{{ plan.name }}</h3>
                                <div class="small text-uppercase text-muted mb-1">{{ plan.code }}</div>
                                <div class="h3 mb-0 {{ plan.code == 'standard' ? 'text-primary' : (plan.code == 'pro' ? 'text-success' : '') }}">
                                    {{ plan.priceLabel }}
                                </div>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-1">
                                {% if plan.current %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        {{ 'backend.commercial_plan_comparison.current_plan'|trans }}
                                    </span>
                                {% endif %}
                                {% if not plan.active %}
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        {{ 'backend.commercial_plan_comparison.inactive_plan'|trans }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        {% for row in comparison.rows %}
                            {% set value = row.values[plan.code]|default(null) %}
                            <div class="border-top px-3 py-2">
                                <div class="small text-muted">{{ row.label }}</div>
                                <div class="{{ value and value.enabled is same as(false) ? 'text-body-tertiary' : (plan.code == 'standard' ? 'text-primary' : (plan.code == 'pro' ? 'text-success' : '')) }}">
                                    {{ value ? value.label : 'backend.common.placeholder'|trans }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="card-footer bg-white p-3 mt-auto d-flex align-items-center justify-content-center commercial-plan-comparison__footer">
                        {% if plan.current %}
                            <div class="text-center small text-success fw-semibold">{{ 'backend.commercial_plan_comparison.current_plan'|trans }}</div>
                        {% elseif plan.upgrade %}
                            <form method="post" action="{{ path('backend_project_subscription_checkout', {id: project.id, phase: comparison.phase, targetTier: plan.upgrade.targetTier}) }}" class="w-100">
                                <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_checkout_' ~ project.id ~ '_' ~ comparison.phase ~ '_' ~ plan.upgrade.targetTier) }}">
                                <button type="submit" class="btn {{ plan.code == 'pro' ? 'btn-success' : 'btn-primary' }} w-100">
                                    {{ 'backend.commercial_plan_comparison.upgrade_to'|trans({'%tier%': plan.name, '%price%': plan.upgrade.priceLabel}) }}
                                </button>
                            </form>
                        {% else %}
                            <div class="text-center small text-muted">{{ 'backend.commercial_plan_comparison.not_selectable'|trans }}</div>
                        {% endif %}
                    </div>
                </section>
            </div>
        {% endfor %}
    </div>
</div>
