{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ duplicate ? 'backend.emission.accommodation_v1.title_duplicate'|trans : (edit ? 'backend.emission.accommodation_v1.title_edit'|trans : 'backend.emission.accommodation_v1.title_new'|trans) }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item"><a href="{{ path('backend_emission_index', backQuery) }}" class="text-decoration-none">{{ 'backend.emission.accommodation_v1.breadcrumb_list'|trans }}</a></li>
  <li class="breadcrumb-item active">{{ duplicate ? 'backend.emission.accommodation_v1.breadcrumb_duplicate'|trans : (edit ? 'backend.emission.accommodation_v1.breadcrumb_edit'|trans : 'backend.emission.accommodation_v1.breadcrumb_new'|trans) }}</li>
{% endblock %}

{% block body %}
{% set messageKeys = ['emission_factor_unavailable', 'emission_factor_not_calculable', 'automatic_factor_unavailable'] %}
{% set messageLabels = {} %}
{% for key in messageKeys %}{% set messageLabels = messageLabels|merge({(key): ('backend.emission.accommodation_v1.messages.' ~ key)|trans}) %}{% endfor %}
{% set accommodationI18n = {
  calculating: 'backend.emission.accommodation_v1.preview.calculating'|trans,
  previewError: 'backend.emission.accommodation_v1.preview.error'|trans,
  statusLabels: {
    CALCULATED: 'backend.emission.accommodation_v1.statuses.CALCULATED'|trans,
    PENDING_DATA: 'backend.emission.accommodation_v1.statuses.PENDING_DATA'|trans,
    NOT_AUTOMATICALLY_CALCULABLE: 'backend.emission.accommodation_v1.statuses.NOT_AUTOMATICALLY_CALCULABLE'|trans
  },
  typeLabels: {
    hotel: 'backend.emission.accommodation_v1.types.hotel'|trans,
    hostel: 'backend.emission.accommodation_v1.types.hostel'|trans,
    apartment: 'backend.emission.accommodation_v1.types.apartment'|trans,
    other: 'backend.emission.accommodation_v1.types.other'|trans
  },
  fallback: 'backend.emission.accommodation_v1.preview.fallback'|trans,
  geographicProxy: 'backend.emission.accommodation_v1.preview.geographic_proxy'|trans,
  activityYear: 'backend.emission.accommodation_v1.preview.activity_year'|trans,
  factorId: 'backend.emission.accommodation_v1.preview.factor_id'|trans,
  factorActivityYear: 'backend.emission.accommodation_v1.preview.factor_activity_year'|trans,
  factorYear: 'backend.emission.accommodation_v1.preview.factor_year'|trans,
  temporalType: 'backend.emission.accommodation_v1.preview.temporal_type'|trans,
  factorVersion: 'backend.emission.accommodation_v1.preview.factor_version'|trans,
  factor: 'backend.emission.accommodation_v1.preview.factor'|trans,
  sourceDetail: 'backend.emission.accommodation_v1.preview.source_detail'|trans,
  quality: 'backend.emission.accommodation_v1.preview.quality'|trans,
  unitLabels: {
    'occupied room-night': 'backend.emission.accommodation_v1.units.occupied_room_night'|trans,
    'guest-night': 'backend.emission.accommodation_v1.units.guest_night'|trans,
    'person-night': 'backend.emission.accommodation_v1.units.person_night'|trans,
    'persona-noche': 'backend.emission.accommodation_v1.units.person_night'|trans
  },
  proxyReasonLabels: {
    'Land 2025 contextual apartment factor for all countries': 'backend.emission.accommodation_v1.preview.apartment_proxy_reason'|trans
  },
  messageLabels: messageLabels
} %}

<div class="container-fluid px-0 backend-client-shell"
     data-controller="accommodation-v1-form"
     data-accommodation-v1-form-i18n-value="{{ accommodationI18n|json_encode|e('html_attr') }}"
     data-accommodation-v1-form-preview-url-value="{{ path('backend_emission_accommodation_v1_preview') }}"
     data-accommodation-v1-form-preview-token-value="{{ csrf_token('accommodation_emission_v1_preview') }}">
  <div class="backend-client-content">
    <h2>{{ duplicate ? 'backend.emission.accommodation_v1.heading_duplicate'|trans : (edit ? 'backend.emission.accommodation_v1.heading_edit'|trans : 'backend.emission.accommodation_v1.heading_new'|trans) }}</h2>
    <p class="text-muted mb-4">{{ 'backend.emission.accommodation_v1.intro'|trans }}</p>

    <section class="card mb-4"><div class="card-body"><div class="row g-3">
      <div class="col-md-6"><small class="text-muted d-block">{{ 'backend.emission.accommodation_v1.project'|trans }}</small><strong>{{ project.name }}</strong></div>
      <div class="col-md-6"><small class="text-muted d-block">{{ 'backend.emission.accommodation_v1.category'|trans }}</small><span class="badge text-bg-success">{{ category.name }}</span></div>
      <div class="col-12"><small class="text-muted d-block mb-1">{{ 'backend.emission.accommodation_v1.phases'|trans }}</small>{% for phaseDate in project.phaseDates %}<span class="badge text-bg-light border me-1">{{ project.getPhaseLabel(phaseDate.phase)|trans }} · {{ phaseDate.startDate|date('d/m/Y') }}–{{ phaseDate.endDate|date('d/m/Y') }}</span>{% else %}—{% endfor %}</div>
    </div></div></section>

    {% if errors %}<div class="alert alert-danger"><ul class="mb-0">{% for error in errors %}<li>{{ ('backend.emission.accommodation_v1.errors.' ~ error)|trans }}</li>{% endfor %}</ul></div>{% endif %}

    {% if edit and record.attachments|length > 0 %}
      <section class="card mb-4"><div class="card-body">
        <h3 class="h5">{{ 'backend.emission.attachments.title'|trans }}</h3>
        <div class="list-group list-group-flush">{% for attachment in record.attachments %}<div class="list-group-item px-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
          <span>{{ attachment.originalName }} <small class="text-muted">({{ (attachment.size / 1024)|number_format(1, ',', '.') }} KB)</small></span>
          <div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="{{ path('backend_emission_attachment_download', {recordId: record.id, attachmentId: attachment.id}) }}">{{ 'backend.emission.attachments.download'|trans }}</a><form method="post" action="{{ path('backend_emission_attachment_delete', {recordId: record.id, attachmentId: attachment.id}|merge(backQuery)) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_emission_attachment_' ~ attachment.id) }}"><button class="btn btn-sm btn-outline-danger" type="submit">{{ 'backend.emission.attachments.delete'|trans }}</button></form></div>
        </div>{% endfor %}</div>
      </div></section>
    {% endif %}

    <form method="post" action="{{ formAction }}" enctype="multipart/form-data" novalidate
          data-accommodation-v1-form-target="form"
          data-action="input->accommodation-v1-form#queuePreview change->accommodation-v1-form#queuePreview change->accommodation-v1-form#updateFields submit->accommodation-v1-form#validate">
      <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">

      <section class="card mb-4"><div class="card-body">
        <h3 class="h5 mb-3">{{ 'backend.emission.accommodation_v1.sections.activity'|trans }}</h3>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label" for="accommodation-start-date">{{ 'backend.emission.accommodation_v1.fields.start_date'|trans }} *</label><input class="form-control" id="accommodation-start-date" type="date" name="startDate" value="{{ values.startDate|default('') }}" required></div>
          <div class="col-md-4"><label class="form-label" for="accommodation-end-date">{{ 'backend.emission.accommodation_v1.fields.end_date'|trans }} *</label><input class="form-control" id="accommodation-end-date" type="date" name="endDate" value="{{ values.endDate|default('') }}" required></div>
          <div class="col-md-4"><label class="form-label" for="accommodation-country">{{ 'backend.emission.accommodation_v1.fields.country'|trans }} *</label><select class="form-select" id="accommodation-country" name="country" required><option value="">{{ 'backend.common.select'|trans }}</option>{% for code, name in countries %}<option value="{{ code }}" {% if values.country|default('') == code %}selected{% endif %}>{{ name }}</option>{% endfor %}</select></div>
          <div class="col-md-6"><label class="form-label" for="accommodation-type">{{ 'backend.emission.accommodation_v1.fields.type'|trans }} *</label><select class="form-select" id="accommodation-type" name="accommodationType" required data-accommodation-v1-form-target="type"><option value="">{{ 'backend.common.select'|trans }}</option>{% for type in accommodationTypes %}<option value="{{ type }}" {% if values.accommodationType|default('') == type %}selected{% endif %}>{{ ('backend.emission.accommodation_v1.types.' ~ type)|trans }}</option>{% endfor %}</select></div>
          <div class="col-md-3" data-accommodation-v1-form-target="starsField"><label class="form-label" for="accommodation-stars">{{ 'backend.emission.accommodation_v1.fields.stars'|trans }} *</label><select class="form-select" id="accommodation-stars" name="stars">{% for stars in hotelStars %}<option value="{{ stars }}" {% if values.stars|default('unknown') == stars %}selected{% endif %}>{{ stars == 'unknown' ? 'backend.emission.accommodation_v1.stars.unknown'|trans : stars ~ ' ★' }}</option>{% endfor %}</select></div>
          <div class="col-md-3" data-accommodation-v1-form-target="roomsField"><label class="form-label" for="accommodation-rooms">{{ 'backend.emission.accommodation_v1.fields.rooms'|trans }}</label><input class="form-control" id="accommodation-rooms" name="occupiedRooms" value="{{ values.occupiedRooms|default('') }}" inputmode="decimal"></div>
          <div class="col-md-3" data-accommodation-v1-form-target="peopleField"><label class="form-label" for="accommodation-people">{{ 'backend.emission.accommodation_v1.fields.people'|trans }}</label><input class="form-control" id="accommodation-people" name="people" value="{{ values.people|default('') }}" inputmode="decimal"></div>
          <div class="col-md-3" data-accommodation-v1-form-target="nightsField"><label class="form-label" for="accommodation-nights">{{ 'backend.emission.accommodation_v1.fields.nights'|trans }} *</label><input class="form-control" id="accommodation-nights" name="nights" value="{{ values.nights|default('') }}" inputmode="decimal"></div>
        </div>
      </div></section>

      <section class="card mb-4"><div class="card-body">
        <h3 class="h5">{{ 'backend.emission.accommodation_v1.preview.title'|trans }}</h3>
        <div class="d-flex flex-wrap align-items-baseline gap-3 mb-2"><strong data-accommodation-v1-form-target="previewStatus">{{ 'backend.emission.accommodation_v1.preview.error'|trans }}</strong><span class="fs-4" data-accommodation-v1-form-target="previewEmission">—</span></div>
        <ul class="small text-muted mb-2" data-accommodation-v1-form-target="previewTrace"></ul><ul class="small text-danger mb-0" data-accommodation-v1-form-target="previewMessages"></ul>
      </div></section>

      <section class="card mb-4"><div class="card-body">
        <div class="mb-3"><label class="form-label" for="accommodation-notes">{{ 'backend.emission.accommodation_v1.fields.notes'|trans }}</label><textarea class="form-control" id="accommodation-notes" name="notes" rows="3">{{ values.notes|default('') }}</textarea></div>
        <div><label class="form-label" for="accommodation-attachments">{{ 'backend.emission.attachments.add'|trans }}</label><input class="form-control" id="accommodation-attachments" type="file" name="attachments[]" multiple accept="application/pdf,image/jpeg,image/png,image/webp"><div class="form-text">{{ 'backend.emission.attachments.help'|trans }}</div></div>
      </div></section>

      <div class="d-flex gap-2 justify-content-end"><a class="btn btn-outline-secondary" href="{{ path('backend_emission_index', backQuery) }}">{{ 'backend.common.cancel'|trans }}</a><button class="btn btn-success" type="submit">{{ 'backend.common.save'|trans }}</button></div>
    </form>
  </div>
</div>
{% endblock %}
