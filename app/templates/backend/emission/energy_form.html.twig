{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ edit ? 'backend.emission.energy_form.title_edit'|trans : 'backend.emission.energy_form.title_new'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item" aria-current="page">
    <a href="{{ path('backend_emission_index') }}" class="text-decoration-none">
      {{ 'backend.emission.energy_form.breadcrumb.list_title'|trans }}
    </a>
  </li>
  <li class="breadcrumb-item active">
    {{ edit ? 'backend.emission.energy_form.breadcrumb.edit'|trans : 'backend.emission.energy_form.breadcrumb.new'|trans }}
  </li>
{% endblock %}

{% block body %}
<<div class="container-fluid px-0 backend-client-shell"
     data-controller="energy-form"
     data-energy-form-calculation-details-value="{{ record.calculationDetails|default('{}')|e('html_attr') }}"
     data-energy-form-i18n-value='{{ {
       parseError:               "backend.emission.energy_js.parse_error"|trans,
       jsonMalformed:            "backend.emission.energy_js.json_malformed"|trans,
       noForm:                   "backend.emission.energy_js.no_form"|trans
     }|json_encode|e("html_attr") }}'>
  <div class="backend-client-content">
      <h2>{{ edit ? 'backend.emission.energy_form.heading_edit'|trans : 'backend.emission.energy_form.heading_new'|trans }}</h2>

      <div class="mb-4 d-grid bg_green_3 rounded p-3"
           style="grid-template-columns: max-content 1fr; row-gap: 0.5rem; column-gap: 1rem;">
        <div><strong>{{ 'backend.emission.energy_form.project_label'|trans }}:</strong></div>
        <div>{{ project.name }}</div>

        <div><strong>{{ 'backend.emission.energy_form.phases_label'|trans }}:</strong></div>
        <div>
          <ul class="list-unstyled mb-0">
          {% for pd in project.phaseDates %}
            <li>
              {{ project.getPhaseLabel(pd.phase)|trans }}
              &nbsp; - &nbsp;
              <i class="bi bi-clock-history"></i>
              {{ pd.startDate ? pd.startDate|date('d/m/Y') : 'backend.emission.energy_form.date_placeholder'|trans }}
              -
              {{ pd.endDate ? pd.endDate|date('d/m/Y') : 'backend.emission.energy_form.date_placeholder'|trans }}
            </li>
          {% endfor %}
          </ul>
        </div>

        <div><strong>{{ 'backend.emission.energy_form.category_label'|trans }}:</strong></div>
        <div><span class="badge text-bg-secondary">{{ 'backend.emission.energy_form.category_energy'|trans }}</span></div>
      </div>

      {{ form_start(form) }}

        <div class="row">
          <div class="col-md-6 mb-3">
            {{ form_label(form.registeredAt) }}
            {{ form_widget(form.registeredAt, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.registeredAt) }}
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            {{ form_label(form.subCategory) }}
            {{ form_widget(form.subCategory, {
              'attr': {
                'class': 'form-select',
                'data-energy-form-target': 'subCategory',
                'data-action': 'change->energy-form#updateUnitLabel'
              }
            }) }}
            {{ form_errors(form.subCategory) }}
          </div>
        </div>

        <div id="electricity-method-wrapper" data-energy-form-target="electricityMethodWrapper" class="d-none">
          <div class="row">
            <div class="col-md-6 mb-3">
              {{ form_label(form.electricityMethod) }}
              {{ form_widget(form.electricityMethod, {
                'attr': {
                  'class': 'form-control',
                  'data-energy-form-target': 'electricityMethod'
                }
              }) }}
              {{ form_errors(form.electricityMethod) }}
            </div>
          </div>
        </div>

        <div class="p-4 bg_green_1 mb-3 shadow-sm" id="dynamic-fields" data-energy-form-target="dynamicFields"></div>

        <div id="amount-wrapper" data-energy-form-target="amountWrapper" class="d-none">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="energy_emission_amount">
                {{ 'backend.emission.energy_form.amount_label'|trans }}
                <span data-energy-form-target="unitLabel"></span>
              </label>
              {{ form_widget(form.amount, { 'attr': {'class': 'form-control'} }) }}
            </div>
          </div>
        </div>

        {{ form_row(form.calculationDetails) }}

        <div class="d-flex justify-content-between mt-4">
          <a href="{{ path('backend_emission_index', { category: category.name }) }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> {{ 'backend.common.back'|trans }}
          </a>
          <button class="btn btn-primary">
            <i class="bi bi-save"></i> {{ 'backend.common.save'|trans }}
          </button>
        </div>

      {{ form_end(form) }}
  </div>

  {# TEMPLATES #}
  {% include 'backend/emission/_energy_templates.html.twig' %}
</div>
{% endblock %}
