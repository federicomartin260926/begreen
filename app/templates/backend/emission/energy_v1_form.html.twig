{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ duplicate ? 'backend.emission.energy_v1.title_duplicate'|trans : (edit ? 'backend.emission.energy_v1.title_edit'|trans : 'backend.emission.energy_v1.title_new'|trans) }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .energy-v1-heading {
      margin-bottom: .35rem;
    }

    .energy-v1-intro {
      max-width: 70rem;
      margin-bottom: 1.5rem;
      color: var(--bs-secondary-color);
    }

    .energy-v1-context {
      padding: 1rem 1.25rem;
      border: 1px solid var(--bs-border-color);
      border-radius: .75rem;
      background: var(--bs-tertiary-bg);
    }

    .energy-v1-context-grid {
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) auto;
      gap: .9rem 2rem;
      align-items: start;
    }

    .energy-v1-context-item--full {
      grid-column: 1 / -1;
    }

    .energy-v1-context-label {
      display: block;
      margin-bottom: .2rem;
      font-size: .78rem;
      font-weight: 600;
      color: var(--bs-secondary-color);
      text-transform: uppercase;
      letter-spacing: .025em;
    }

    .energy-v1-phase-list {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
    }

    .energy-v1-phase {
      display: inline-flex;
      align-items: center;
      padding: .3rem .55rem;
      border: 1px solid var(--bs-border-color);
      border-radius: .45rem;
      background: var(--bs-body-bg);
      font-size: .875rem;
    }

    .energy-v1-section {
      overflow: hidden;
      border: 1px solid var(--bs-border-color);
      border-radius: .85rem;
      background: var(--bs-body-bg);
      box-shadow: 0 .125rem .4rem rgba(0, 0, 0, .035);
    }

    .energy-v1-section__header {
      padding: 1rem 1.25rem .8rem;
      border-bottom: 1px solid var(--bs-border-color);
      background: var(--bs-tertiary-bg);
    }

    .energy-v1-section__title {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 600;
    }

    .energy-v1-section__help {
      margin: .25rem 0 0;
      color: var(--bs-secondary-color);
      font-size: .875rem;
    }

    .energy-v1-section__body {
      padding: 1.25rem;
    }

    .energy-v1-type-grid .btn {
      min-height: 3.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 500;
    }

    @media (max-width: 767.98px) {
      .energy-v1-context-grid {
        grid-template-columns: 1fr;
      }

      .energy-v1-context-item--full {
        grid-column: auto;
      }

      .energy-v1-section__body,
      .energy-v1-section__header {
        padding-left: 1rem;
        padding-right: 1rem;
      }
    }
  </style>
{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item"><a href="{{ path('backend_emission_index', backQuery) }}" class="text-decoration-none">{{ 'backend.emission.energy_v1.breadcrumb_list'|trans }}</a></li>
  <li class="breadcrumb-item active">{{ duplicate ? 'backend.emission.energy_v1.breadcrumb_duplicate'|trans : (edit ? 'backend.emission.energy_v1.breadcrumb_edit'|trans : 'backend.emission.energy_v1.breadcrumb_new'|trans) }}</li>
{% endblock %}

{% block body %}
{% set messageKeys = [
  'dates_required', 'invalid_date_range', 'split_by_year', 'country_required', 'electricity_origin_required',
  'electricity_origin_unknown', 'electricity_amount_and_unit_required', 'electricity_activity_data_required',
  'final_reading_before_initial', 'mixed_energy_breakdown_required', 'mixed_energy_total_mismatch',
  'equipment_type_required', 'fuel_required', 'fuel_amount_and_unit_required', 'equipment_mode_unknown',
  'incompatible_fuel_unit', 'invalid_cylinder_size', 'invalid_cylinder_count', 'battery_type_required',
  'charged_kwh_required', 'emission_factor_unavailable', 'emission_factor_not_calculable'
] %}
{% set messageLabels = {} %}
{% for key in messageKeys %}{% set messageLabels = messageLabels|merge({(key): ('backend.emission.energy_v1.messages.' ~ key)|trans}) %}{% endfor %}
{% set energyI18n = {
  calculating: 'backend.emission.energy_v1.preview.calculating'|trans,
  previewError: 'backend.emission.energy_v1.preview.error'|trans,
  statusLabels: {
    CALCULATED: 'backend.emission.energy_v1.statuses.CALCULATED'|trans,
    PENDING_DATA: 'backend.emission.energy_v1.statuses.PENDING_DATA'|trans,
    NOT_AUTOMATICALLY_CALCULABLE: 'backend.emission.energy_v1.statuses.NOT_AUTOMATICALLY_CALCULABLE'|trans
  },
  fallbackLabels: {
    exact_year_missing: 'backend.emission.energy_v1.fallbacks.exact_year_missing'|trans
  },
  activityYear: 'backend.emission.energy_v1.preview.activity_year'|trans,
  factorId: 'backend.emission.energy_v1.preview.factor_id'|trans,
  factorActivityYear: 'backend.emission.energy_v1.preview.factor_activity_year'|trans,
  factorYear: 'backend.emission.energy_v1.preview.factor_year'|trans,
  temporalType: 'backend.emission.energy_v1.preview.temporal_type'|trans,
  factorVersion: 'backend.emission.energy_v1.preview.factor_version'|trans,
  factor: 'backend.emission.energy_v1.preview.factor'|trans,
  sourceDetail: 'backend.emission.energy_v1.preview.source_detail'|trans,
  fallback: 'backend.emission.energy_v1.preview.fallback'|trans,
  geographicProxy: 'backend.emission.energy_v1.preview.geographic_proxy'|trans,
  quality: 'backend.emission.energy_v1.preview.quality'|trans,
  messageLabels: messageLabels,
  select: 'backend.common.select'|trans
} %}

<div class="container-fluid px-0 backend-client-shell"
     data-controller="energy-v1-form"
     data-energy-v1-form-config-value="{{ energyUiConfig|json_encode|e('html_attr') }}"
     data-energy-v1-form-initial-value="{{ values|json_encode|e('html_attr') }}"
     data-energy-v1-form-i18n-value="{{ energyI18n|json_encode|e('html_attr') }}"
     data-energy-v1-form-preview-url-value="{{ path('backend_emission_energy_v1_preview') }}"
     data-energy-v1-form-preview-token-value="{{ csrf_token('energy_emission_v1_preview') }}">
  <div class="backend-client-content">
    <h2 class="energy-v1-heading">{{ duplicate ? 'backend.emission.energy_v1.heading_duplicate'|trans : (edit ? 'backend.emission.energy_v1.heading_edit'|trans : 'backend.emission.energy_v1.heading_new'|trans) }}</h2>
    <p class="energy-v1-intro">{{ 'backend.emission.energy_v1.intro'|trans }}</p>

    <div class="energy-v1-context mb-4">
      <div class="energy-v1-context-grid">
        <div>
          <span class="energy-v1-context-label">{{ 'backend.emission.energy_v1.project'|trans }}</span>
          <strong>{{ project.name }}</strong>
        </div>

        <div>
          <span class="energy-v1-context-label">{{ 'backend.emission.energy_v1.category'|trans }}</span>
          <span class="badge text-bg-success">{{ category.name }}</span>
        </div>

        <div class="energy-v1-context-item--full">
          <span class="energy-v1-context-label">{{ 'backend.emission.energy_v1.phases'|trans }}</span>
          <div class="energy-v1-phase-list">
            {% for phaseDate in project.phaseDates %}
              <span class="energy-v1-phase">
                {{ project.getPhaseLabel(phaseDate.phase)|trans }}
                &nbsp;·&nbsp;
                {{ phaseDate.startDate ? phaseDate.startDate|date('d/m/Y') : '—' }}
                –
                {{ phaseDate.endDate ? phaseDate.endDate|date('d/m/Y') : '—' }}
              </span>
            {% else %}
              <span class="energy-v1-phase">—</span>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    {% if errors %}
      <div class="alert alert-danger"><ul class="mb-0">{% for error in errors %}<li>{{ ('backend.emission.energy_v1.errors.' ~ error)|trans }}</li>{% endfor %}</ul></div>
    {% endif %}

    {% if edit and record.attachments|length > 0 %}
      <section class="card mb-4"><div class="card-body">
        <h3 class="h5">{{ 'backend.emission.attachments.title'|trans }}</h3>
        <div class="list-group list-group-flush">
          {% for attachment in record.attachments %}
            <div class="list-group-item px-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
              <span>{{ attachment.originalName }} <small class="text-muted">({{ (attachment.size / 1024)|number_format(1, ',', '.') }} KB)</small></span>
              <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-primary" href="{{ path('backend_emission_attachment_download', {recordId: record.id, attachmentId: attachment.id}) }}">{{ 'backend.emission.attachments.download'|trans }}</a>
                <form method="post" action="{{ path('backend_emission_attachment_delete', {recordId: record.id, attachmentId: attachment.id}|merge(backQuery)) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_emission_attachment_' ~ attachment.id) }}">
                  <button class="btn btn-sm btn-outline-danger" type="submit">{{ 'backend.emission.attachments.delete'|trans }}</button>
                </form>
              </div>
            </div>
          {% endfor %}
        </div>
      </div></section>
    {% endif %}

    <form method="post" action="{{ formAction }}" enctype="multipart/form-data" novalidate
          data-energy-v1-form-target="form"
          data-action="input->energy-v1-form#queuePreview change->energy-v1-form#refresh submit->energy-v1-form#validate">
      <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">

      <section class="energy-v1-section mb-4">
        <div class="energy-v1-section__header">
          <h3 class="energy-v1-section__title">{{ 'backend.emission.energy_v1.sections.context'|trans }}</h3>
          <p class="energy-v1-section__help">{{ 'backend.emission.energy_v1.section_context_help'|trans }}</p>
        </div>
        <div class="energy-v1-section__body">
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label" for="energy-start-date">
                {{ 'backend.emission.energy_v1.fields.start_date'|trans }}
                <span class="text-danger">*</span>
              </label>
              <input class="form-control" id="energy-start-date" type="date" name="startDate" value="{{ values.startDate|default('') }}" required>
            </div>

            <div class="col-md-4 mb-3">
              <label class="form-label" for="energy-end-date">
                {{ 'backend.emission.energy_v1.fields.end_date'|trans }}
                <span class="text-danger">*</span>
              </label>
              <input class="form-control" id="energy-end-date" type="date" name="endDate" value="{{ values.endDate|default('') }}" required>
            </div>

            <div class="col-md-4 mb-3">
              <label class="form-label" for="energy-country">
                {{ 'backend.emission.energy_v1.fields.country'|trans }}
                <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="energy-country" name="country" required>
                <option value="">{{ 'backend.common.select'|trans }}</option>
                {% for code, name in countries %}
                  <option value="{{ code }}" {% if values.country|default('') == code %}selected{% endif %}>{{ name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
        </div>
      </section>

      <fieldset class="energy-v1-section mb-4">
        <div class="energy-v1-section__header">
          <h3 class="energy-v1-section__title">{{ 'backend.emission.energy_v1.sections.family'|trans }}</h3>
          <p class="energy-v1-section__help">{{ 'backend.emission.energy_v1.section_family_help'|trans }}</p>
        </div>
        <div class="energy-v1-section__body">
          <div class="row g-2 energy-v1-type-grid">
            {% for family in ['electricity', 'equipment', 'battery'] %}
              <div class="col-md-4">
                <input class="btn-check" id="energy-family-{{ family }}" type="radio" name="family" value="{{ family }}" {% if values.family|default('electricity') == family %}checked{% endif %} required>
                <label class="btn btn-outline-primary w-100" for="energy-family-{{ family }}">{{ ('backend.emission.energy_v1.families.' ~ family)|trans }}</label>
              </div>
            {% endfor %}
          </div>
        </div>
      </fieldset>

      <section class="card mb-4" data-energy-v1-form-target="electricityPanel"><div class="card-body">
        <h3 class="h5 mb-3">{{ 'backend.emission.energy_v1.families.electricity'|trans }}</h3>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.origin'|trans }}</label><select class="form-select" name="origin" data-energy-v1-form-target="origin"><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in ['grid', 'solar', 'mixed', 'unknown'] %}<option value="{{ value }}" {% if values.origin|default('') == value %}selected{% endif %}>{{ ('backend.emission.energy_v1.origins.' ~ value)|trans }}</option>{% endfor %}</select></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.input_method'|trans }}</label><select class="form-select" name="inputMethod" data-energy-v1-form-target="inputMethod"><option value="total" {% if values.inputMethod|default('total') == 'total' %}selected{% endif %}>{{ 'backend.emission.energy_v1.input_methods.total'|trans }}</option><option value="meter" {% if values.inputMethod|default('') == 'meter' %}selected{% endif %}>{{ 'backend.emission.energy_v1.input_methods.meter'|trans }}</option></select></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.labeling'|trans }}</label><select class="form-select" name="labeling"><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in energyUiConfig.labelings %}<option value="{{ value }}" {% if values.labeling|default('') == value %}selected{% endif %}>{{ value }}</option>{% endfor %}</select></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.supplier'|trans }}</label><input class="form-control" name="supplier" list="energy-suppliers" value="{{ values.supplier|default('') }}"><datalist id="energy-suppliers">{% for supplier in energyUiConfig.suppliers %}<option value="{{ supplier }}"></option>{% endfor %}</datalist></div>
        </div>
        <div class="row g-3 mt-0" data-energy-v1-form-target="totalFields">
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.amount'|trans }}</label><input class="form-control" name="amount" value="{{ values.amount|default('') }}" inputmode="decimal"></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.unit'|trans }}</label><select class="form-select" name="unit"><option value="kWh" {% if values.unit|default('kWh') == 'kWh' %}selected{% endif %}>kWh</option><option value="MWh" {% if values.unit|default('') == 'MWh' %}selected{% endif %}>MWh</option></select></div>
        </div>
        <div class="row g-3 mt-0" data-energy-v1-form-target="meterFields" hidden>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.initial_reading'|trans }}</label><input class="form-control" name="initialReading" value="{{ values.initialReading|default('') }}" inputmode="decimal"></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.final_reading'|trans }}</label><input class="form-control" name="finalReading" value="{{ values.finalReading|default('') }}" inputmode="decimal"></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.unit'|trans }}</label><select class="form-select" name="unit"><option value="kWh" {% if values.unit|default('kWh') == 'kWh' %}selected{% endif %}>kWh</option><option value="MWh" {% if values.unit|default('') == 'MWh' %}selected{% endif %}>MWh</option></select></div>
        </div>
        <div class="row g-3 mt-0 bg-light rounded p-2" data-energy-v1-form-target="mixedFields" hidden>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.grid_kwh'|trans }}</label><input class="form-control" name="gridKwh" value="{{ values.gridKwh|default('') }}" inputmode="decimal"></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.solar_kwh'|trans }}</label><input class="form-control" name="solarKwh" value="{{ values.solarKwh|default('') }}" inputmode="decimal"></div>
        </div>
      </div></section>

      <section class="card mb-4" data-energy-v1-form-target="equipmentPanel" hidden><div class="card-body">
        <h3 class="h5 mb-3">{{ 'backend.emission.energy_v1.families.equipment'|trans }}</h3>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.equipment_type'|trans }}</label><select class="form-select" name="equipmentType"><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in ['generator', 'heating', 'cooking', 'boiler', 'climate', 'other'] %}<option value="{{ value }}" {% if values.equipmentType|default('') == value %}selected{% endif %}>{{ ('backend.emission.energy_v1.equipment_types.' ~ value)|trans }}</option>{% endfor %}</select></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.fuel'|trans }}</label><select class="form-select" name="fuel" data-energy-v1-form-target="fuel"></select></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.mode'|trans }}</label><select class="form-select" name="mode" data-energy-v1-form-target="equipmentMode"><option value="direct" {% if values.mode|default('direct') == 'direct' %}selected{% endif %}>{{ 'backend.emission.energy_v1.modes.direct'|trans }}</option><option value="cylinders" {% if values.mode|default('') == 'cylinders' %}selected{% endif %}>{{ 'backend.emission.energy_v1.modes.cylinders'|trans }}</option></select></div>
        </div>
        <div class="row g-3 mt-0" data-energy-v1-form-target="equipmentDirectFields">
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.amount'|trans }}</label><input class="form-control" name="amount" value="{{ values.amount|default('') }}" inputmode="decimal"></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.unit'|trans }}</label><select class="form-select" name="unit" data-energy-v1-form-target="fuelUnit"></select></div>
        </div>
        <div class="row g-3 mt-0" data-energy-v1-form-target="cylinderFields" hidden>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.bottle_size'|trans }}</label><select class="form-select" name="bottleSizeKg" data-energy-v1-form-target="bottleSize"></select></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.bottle_count'|trans }}</label><input class="form-control" name="bottleCount" value="{{ values.bottleCount|default('') }}" type="number" min="1" step="1"></div>
        </div>
      </div></section>

      <section class="card mb-4" data-energy-v1-form-target="batteryPanel" hidden><div class="card-body">
        <h3 class="h5 mb-3">{{ 'backend.emission.energy_v1.families.battery'|trans }}</h3>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.battery_type'|trans }}</label><select class="form-select" name="batteryType"><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in ['portable_station', 'battery', 'fixed_battery', 'ups', 'other'] %}<option value="{{ value }}" {% if values.batteryType|default('') == value %}selected{% endif %}>{{ ('backend.emission.energy_v1.battery_types.' ~ value)|trans }}</option>{% endfor %}</select></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.charge_source'|trans }}</label><select class="form-select" name="chargeSource" data-energy-v1-form-target="chargeSource"><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in ['grid', 'solar', 'mixed', 'unknown'] %}<option value="{{ value }}" {% if values.chargeSource|default('') == value %}selected{% endif %}>{{ ('backend.emission.energy_v1.origins.' ~ value)|trans }}</option>{% endfor %}</select></div>
          <div class="col-md-4"><label class="form-label">{{ 'backend.emission.energy_v1.fields.charged_kwh'|trans }}</label><input class="form-control" name="chargedKwh" value="{{ values.chargedKwh|default('') }}" inputmode="decimal"></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.supplier'|trans }}</label><input class="form-control" name="supplier" list="energy-suppliers" value="{{ values.supplier|default('') }}"></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.labeling'|trans }}</label><select class="form-select" name="labeling"><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in energyUiConfig.labelings %}<option value="{{ value }}" {% if values.labeling|default('') == value %}selected{% endif %}>{{ value }}</option>{% endfor %}</select></div>
        </div>
        <div class="row g-3 mt-0 bg-light rounded p-2" data-energy-v1-form-target="batteryMixedFields" hidden>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.grid_kwh'|trans }}</label><input class="form-control" name="gridKwh" value="{{ values.gridKwh|default('') }}" inputmode="decimal"></div>
          <div class="col-md-6"><label class="form-label">{{ 'backend.emission.energy_v1.fields.solar_kwh'|trans }}</label><input class="form-control" name="solarKwh" value="{{ values.solarKwh|default('') }}" inputmode="decimal"></div>
        </div>
      </div></section>

      <section class="card border-primary mb-4"><div class="card-body">
        <h3 class="h5">{{ 'backend.emission.energy_v1.preview.title'|trans }}</h3>
        <div class="fw-semibold" data-energy-v1-form-target="previewStatus">{{ 'backend.emission.energy_v1.preview.complete_data'|trans }}</div>
        <div class="fs-4 my-2" data-energy-v1-form-target="previewEmission">—</div>
        <div class="small text-muted" data-energy-v1-form-target="previewTrace"></div>
        <ul class="small mb-0 mt-2" data-energy-v1-form-target="previewMessages"></ul>
      </div></section>

      <section class="card mb-4"><div class="card-body">
        <div class="mb-3"><label class="form-label" for="energy-notes">{{ 'backend.emission.energy_v1.fields.notes'|trans }}</label><textarea class="form-control" id="energy-notes" name="notes" rows="3">{{ values.notes|default('') }}</textarea></div>
        <div><label class="form-label" for="energy-attachments">{{ 'backend.emission.attachments.add'|trans }}</label><input class="form-control" id="energy-attachments" type="file" name="attachments[]" multiple accept=".pdf,.jpg,.jpeg,.png,.webp"><div class="form-text">{{ 'backend.emission.attachments.help'|trans }}</div></div>
      </div></section>

      <div class="d-flex justify-content-between gap-3">
        <a href="{{ path('backend_emission_index', backQuery) }}" class="btn btn-outline-secondary">{{ 'backend.common.back'|trans }}</a>
        <button class="btn btn-primary" type="submit">{{ 'backend.common.save'|trans }}</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
