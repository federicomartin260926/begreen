{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ duplicate ? 'backend.emission.transport_v20.title_duplicate'|trans : (edit ? 'backend.emission.transport_v20.title_edit'|trans : 'backend.emission.transport_v20.title_new'|trans) }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .transport-v20-suggestions { position: relative; }
    .transport-v20-suggestions .ors-suggestions-list { position: absolute; z-index: 20; width: 100%; max-height: 14rem; overflow-y: auto; background: #fff; border: 1px solid #dee2e6; box-shadow: 0 .25rem .5rem rgba(0, 0, 0, .08); }
    .transport-v20-suggestions .ors-suggestion { padding: .5rem .75rem; cursor: pointer; }
    .transport-v20-suggestions .ors-suggestion:hover { background: #f1f7ff; }
    .transport-v20-heading {
      margin-bottom: .35rem;
    }

    .transport-v20-intro {
      max-width: 70rem;
      margin-bottom: 1.5rem;
      color: var(--bs-secondary-color);
    }

    .transport-v20-context {
      padding: 1rem 1.25rem;
      border: 1px solid var(--bs-border-color);
      border-radius: .75rem;
      background: var(--bs-tertiary-bg);
    }

    .transport-v20-context-grid {
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) auto;
      gap: .9rem 2rem;
      align-items: start;
    }

    .transport-v20-context-item--full {
      grid-column: 1 / -1;
    }

    .transport-v20-context-label {
      display: block;
      margin-bottom: .2rem;
      font-size: .78rem;
      font-weight: 600;
      color: var(--bs-secondary-color);
      text-transform: uppercase;
      letter-spacing: .025em;
    }

    .transport-v20-phase-list {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
    }

    .transport-v20-phase {
      display: inline-flex;
      align-items: center;
      padding: .3rem .55rem;
      border: 1px solid var(--bs-border-color);
      border-radius: .45rem;
      background: var(--bs-body-bg);
      font-size: .875rem;
    }

    .transport-v20-section {
      overflow: hidden;
      border: 1px solid var(--bs-border-color);
      border-radius: .85rem;
      background: var(--bs-body-bg);
      box-shadow: 0 .125rem .4rem rgba(0, 0, 0, .035);
    }

    .transport-v20-section__header {
      padding: 1rem 1.25rem .8rem;
      border-bottom: 1px solid var(--bs-border-color);
      background: var(--bs-tertiary-bg);
    }

    .transport-v20-section__title {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 600;
    }

    .transport-v20-section__help {
      margin: .25rem 0 0;
      color: var(--bs-secondary-color);
      font-size: .875rem;
    }

    .transport-v20-section__body {
      padding: 1.25rem;
    }

    .transport-v20-type-grid .btn {
      min-height: 3.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 500;
    }

    .transport-v20-dynamic-panel {
      margin-top: .25rem;
      padding: 1.25rem;
      border: 1px solid var(--bs-border-color);
      border-radius: .7rem;
      background: var(--bs-tertiary-bg);
    }

    .transport-v20-factor-help {
      margin-top: -.25rem;
      color: var(--bs-secondary-color);
      font-size: .825rem;
    }

    .transport-v20-actionbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--bs-border-color);
    }

    .transport-v20-actionbar .btn-primary {
      min-width: 8.5rem;
    }

    @media (max-width: 767.98px) {
      .transport-v20-context-grid {
        grid-template-columns: 1fr;
      }

      .transport-v20-context-item--full {
        grid-column: auto;
      }

      .transport-v20-section__body,
      .transport-v20-section__header {
        padding-left: 1rem;
        padding-right: 1rem;
      }

      .transport-v20-actionbar {
        align-items: stretch;
      }

      .transport-v20-actionbar .btn {
        flex: 1;
      }
    }
  </style>
{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item"><a href="{{ path('backend_emission_index', backQuery) }}" class="text-decoration-none">{{ 'backend.emission.transport_v20.breadcrumb_list'|trans }}</a></li>
  <li class="breadcrumb-item active">{{ duplicate ? 'backend.emission.transport_v20.breadcrumb_duplicate'|trans : (edit ? 'backend.emission.transport_v20.breadcrumb_edit'|trans : 'backend.emission.transport_v20.breadcrumb_new'|trans) }}</li>
{% endblock %}

{% block body %}
{% set modeLabels = {} %}
{% for categoryCode, modes in transportUiConfig.categories %}
  {% for mode in modes %}{% set modeLabels = modeLabels|merge({(mode): ('backend.emission.transport_v20.modes.' ~ mode)|trans}) %}{% endfor %}
{% endfor %}
{% set methodLabels = {} %}
{% for method in transportMethods %}{% set methodLabels = methodLabels|merge({(method): ('backend.emission.transport_v20.methods.' ~ method)|trans}) %}{% endfor %}
{% set vehicleTypeLabels = {} %}{% for option in transportUiConfig.vehicleTypes %}{% set vehicleTypeLabels = vehicleTypeLabels|merge({(option): ('backend.emission.transport_v20.vehicle_types.' ~ option)|trans}) %}{% endfor %}
{% set carSizeLabels = {} %}{% for option in transportUiConfig.carSizes %}{% set carSizeLabels = carSizeLabels|merge({(option): ('backend.emission.transport_v20.car_sizes.' ~ option)|trans}) %}{% endfor %}
{% set fuelLabels = {} %}{% for modes in transportUiConfig.fuelsByMode %}{% for option in modes %}{% set fuelLabels = fuelLabels|merge({(option): ('backend.emission.transport_v20.fuels.' ~ option)|trans}) %}{% endfor %}{% endfor %}
{% set travelClassLabels = {} %}{% for option in transportUiConfig.travelClasses %}{% set travelClassLabels = travelClassLabels|merge({(option): ('backend.emission.transport_v20.travel_classes.' ~ option)|trans}) %}{% endfor %}
{% set routeClassificationLabels = {} %}{% for option in transportUiConfig.routeClassifications %}{% set routeClassificationLabels = routeClassificationLabels|merge({(option): ('backend.emission.transport_v20.route_classifications.' ~ option)|trans}) %}{% endfor %}
{% set tripTypeLabels = {} %}{% for option in transportUiConfig.tripTypes %}{% set tripTypeLabels = tripTypeLabels|merge({(option): ('backend.emission.transport_v20.trip_types.' ~ option)|trans}) %}{% endfor %}
{% set unitLabels = {} %}
{% for units in transportUiConfig.unitsByMethod %}{% for unit in units %}{% set unitLabels = unitLabels|merge({(unit): ('backend.emission.transport_v20.units.' ~ unit)|trans}) %}{% endfor %}{% endfor %}
{% for unit in transportUiConfig.weightUnits %}{% set unitLabels = unitLabels|merge({(unit): ('backend.emission.transport_v20.units.' ~ unit)|trans}) %}{% endfor %}
{% for units in transportUiConfig.secondaryUnits %}{% for unit in units %}{% set unitLabels = unitLabels|merge({(unit): ('backend.emission.transport_v20.units.' ~ unit)|trans}) %}{% endfor %}{% endfor %}
{% set transportI18n = {
  select: 'backend.common.select'|trans,
  modeLabels: modeLabels,
  methodLabels: methodLabels,
  vehicleTypeLabels: vehicleTypeLabels,
  carSizeLabels: carSizeLabels,
  fuelLabels: fuelLabels,
  travelClassLabels: travelClassLabels,
  routeClassificationLabels: routeClassificationLabels,
  tripTypeLabels: tripTypeLabels,
  unitLabels: unitLabels,
  activityLabels: {
    distance: 'backend.emission.transport_v20.dynamic.distance'|trans,
    fuel: 'backend.emission.transport_v20.dynamic.fuel'|trans,
    electricity: 'backend.emission.transport_v20.dynamic.electricity'|trans,
    fuel_and_electricity: 'backend.emission.transport_v20.dynamic.fuel'|trans,
    distance_consumption: 'backend.emission.transport_v20.dynamic.distance'|trans,
    route: 'backend.emission.transport_v20.dynamic.route_distance'|trans,
    route_stops: 'backend.emission.transport_v20.dynamic.route_distance'|trans,
    passenger_distance: 'backend.emission.transport_v20.dynamic.passenger_distance'|trans,
    weight_distance: 'backend.emission.transport_v20.dynamic.distance'|trans,
    tonne_km: 'backend.emission.transport_v20.dynamic.tonne_km'|trans,
    route_weight: 'backend.emission.transport_v20.dynamic.route_distance'|trans,
    operator: 'backend.emission.transport_v20.dynamic.operator_emission'|trans
  },
  secondaryConsumption: 'backend.emission.transport_v20.dynamic.consumption'|trans,
  calculating: 'backend.emission.transport_v20.ors.calculating'|trans,
  calculateDistance: 'backend.emission.transport_v20.ors.calculate'|trans,
  selectSuggestions: 'backend.emission.transport_v20.ors.select_suggestions'|trans,
  genericOrsError: 'backend.emission.transport_v20.ors.error'|trans,
  distanceReady: 'backend.emission.transport_v20.ors.distance_ready'|trans,
  multipleManualDistance: 'backend.emission.transport_v20.ors.multiple_manual_distance'|trans,
  external_factor_required: 'backend.emission.transport_v20.errors.external_factor_required'|trans,
  unsupported: 'backend.emission.transport_v20.errors.unsupported'|trans
} %}

<div class="container-fluid px-0 backend-client-shell"
     data-controller="transport-v20-form"
     data-transport-v20-form-config-value="{{ transportUiConfig|json_encode|e('html_attr') }}"
     data-transport-v20-form-initial-value="{{ values|json_encode|e('html_attr') }}"
     data-transport-v20-form-i18n-value="{{ transportI18n|json_encode|e('html_attr') }}"
     data-transport-v20-form-autocomplete-url-value="{{ path('backend_emission_location_autocomplete') }}"
     data-transport-v20-form-distance-url-value="{{ path('backend_emission_calculate_distance') }}">
  <div class="backend-client-content">
    <h2 class="transport-v20-heading">{{ duplicate ? 'backend.emission.transport_v20.heading_duplicate'|trans : (edit ? 'backend.emission.transport_v20.heading_edit'|trans : 'backend.emission.transport_v20.heading_new'|trans) }}</h2>
    <p class="transport-v20-intro">{{ 'backend.emission.transport_v20.intro'|trans }}</p>

    <div class="transport-v20-context mb-4">
      <div class="transport-v20-context-grid">
        <div>
          <span class="transport-v20-context-label">{{ 'backend.emission.transport_v20.project'|trans }}</span>
          <strong>{{ project.name }}</strong>
        </div>

        <div>
          <span class="transport-v20-context-label">{{ 'backend.emission.transport_v20.doctrine_category'|trans }}</span>
          <span class="badge text-bg-success">{{ category.name }}</span>
        </div>

        <div class="transport-v20-context-item--full">
          <span class="transport-v20-context-label">{{ 'backend.emission.transport_v20.phases'|trans }}</span>
          <div class="transport-v20-phase-list">
            {% for phaseDate in project.phaseDates %}
              <span class="transport-v20-phase">
                {{ project.getPhaseLabel(phaseDate.phase)|trans }}
                &nbsp;·&nbsp;
                {{ phaseDate.startDate ? phaseDate.startDate|date('d/m/Y') : '—' }}
                –
                {{ phaseDate.endDate ? phaseDate.endDate|date('d/m/Y') : '—' }}
              </span>
            {% else %}
              <span class="transport-v20-phase">—</span>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    {% if errors %}
      <div class="alert alert-danger" role="alert"><ul class="mb-0">{% for error in errors %}<li>{{ ('backend.emission.transport_v20.errors.' ~ error)|trans }}</li>{% endfor %}</ul></div>
    {% endif %}

    {% if edit and record.attachments|length > 0 %}
      <section class="card mb-4">
        <div class="card-body">
          <h3 class="h5">{{ 'backend.emission.attachments.title'|trans }}</h3>
          <div class="list-group list-group-flush">
            {% for attachment in record.attachments %}
              <div class="list-group-item px-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span>{{ attachment.originalName }} <small class="text-muted">({{ (attachment.size / 1024)|number_format(1, ',', '.') }} KB)</small></span>
                <div class="d-flex gap-2">
                  <a class="btn btn-sm btn-outline-primary" href="{{ path('backend_emission_attachment_download', {recordId: record.id, attachmentId: attachment.id}) }}">
                    {{ 'backend.emission.attachments.download'|trans }}
                  </a>
                  <form method="post" action="{{ path('backend_emission_attachment_delete', {recordId: record.id, attachmentId: attachment.id}|merge(backQuery)) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_emission_attachment_' ~ attachment.id) }}">
                    <button class="btn btn-sm btn-outline-danger" type="submit">{{ 'backend.emission.attachments.delete'|trans }}</button>
                  </form>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    <form method="post" action="{{ formAction }}" enctype="multipart/form-data" novalidate data-transport-v20-form-target="form" data-action="submit->transport-v20-form#validate">
      <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">

      <section class="transport-v20-section mb-4">
        <div class="transport-v20-section__header">
          <h3 class="transport-v20-section__title">{{ 'backend.emission.transport_v20.section_context'|trans }}</h3>
          <p class="transport-v20-section__help">{{ 'backend.emission.transport_v20.section_context_help'|trans }}</p>
        </div>
        <div class="transport-v20-section__body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="transport-started-at">
                {{ 'backend.emission.transport_v20.started_at'|trans }}
                <span class="text-danger">*</span>
              </label>
              <input class="form-control" id="transport-started-at" type="date" name="startedAt" value="{{ values.startedAt|default('') }}" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label" for="transport-country">
                {{ 'backend.emission.transport_v20.country'|trans }}
                <span class="text-danger">*</span>
              </label>
              <select
                class="form-select"
                id="transport-country"
                name="country"
                required
                data-action="change->transport-v20-form#countryChanged"
              >
                <option value="">{{ 'backend.common.select'|trans }}</option>
                {% for countryCode, countryName in transportCountries %}
                  <option value="{{ countryCode }}" {% if values.country|default('') == countryCode %}selected{% endif %}>
                    {{ countryName }}
                  </option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="transport-v20-factor-help">{{ 'backend.emission.transport_v20.factor_resolution_help'|trans }}</div>
        </div>
      </section>

      <fieldset class="transport-v20-section mb-4">
        <div class="transport-v20-section__header">
          <legend class="transport-v20-section__title">{{ 'backend.emission.transport_v20.group'|trans }}</legend>
          <p class="transport-v20-section__help">{{ 'backend.emission.transport_v20.section_transport_help'|trans }}</p>
        </div>
        <div class="transport-v20-section__body">
          <div class="row g-3 transport-v20-type-grid">
          {% for categoryCode, modes in transportCategories %}
            <div class="col-md-4">
              <input class="btn-check" type="radio" name="category" id="transport-category-{{ categoryCode }}" value="{{ categoryCode }}" {% if values.category == categoryCode %}checked{% endif %} required data-action="change->transport-v20-form#categoryChanged">
              <label class="btn btn-outline-primary w-100 h-100 py-3" for="transport-category-{{ categoryCode }}">{{ ('backend.emission.transport_v20.categories.' ~ categoryCode)|trans }}</label>
            </div>
          {% endfor %}
          </div>
        </div>
      </fieldset>

      <section class="transport-v20-section mb-4">
        <div class="transport-v20-section__header">
          <h3 class="transport-v20-section__title">{{ 'backend.emission.transport_v20.section_calculation'|trans }}</h3>
          <p class="transport-v20-section__help">{{ 'backend.emission.transport_v20.section_calculation_help'|trans }}</p>
        </div>
        <div class="transport-v20-section__body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="transport-mode">{{ 'backend.emission.transport_v20.mode'|trans }}</label>
          <select class="form-select" id="transport-mode" name="mode" required data-transport-v20-form-target="mode" data-action="change->transport-v20-form#modeChanged"></select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label" for="transport-method">{{ 'backend.emission.transport_v20.method'|trans }}</label>
          <select class="form-select" id="transport-method" name="method" required data-transport-v20-form-target="method" data-action="change->transport-v20-form#methodChanged"></select>
        </div>
      </div>

          <div class="transport-v20-dynamic-panel">
        <div class="row">
          <div class="col-md-6 mb-3" data-transport-v20-form-target="carSizeFields" hidden>
            <label class="form-label" for="transport-car-size">{{ 'backend.emission.transport_v20.car_size'|trans }}</label>
            <select class="form-select" id="transport-car-size" name="carSize" data-transport-v20-form-target="carSize" required></select>
          </div>
          <div class="col-md-6 mb-3" data-transport-v20-form-target="vehicleTypeFields" hidden>
            <label class="form-label" for="transport-vehicle-type">{{ 'backend.emission.transport_v20.vehicle_type'|trans }}</label>
            <select class="form-select" id="transport-vehicle-type" name="vehicleType" data-transport-v20-form-target="vehicleType" data-action="change->transport-v20-form#vehicleTypeChanged" required></select>
          </div>
        </div>

        <div class="row" data-transport-v20-form-target="planeFields" hidden>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="transport-route-classification">{{ 'backend.emission.transport_v20.route_classification'|trans }}</label>
            <select class="form-select" id="transport-route-classification" name="routeClassification" data-transport-v20-form-target="routeClassification"></select>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="transport-travel-class">{{ 'backend.emission.transport_v20.travel_class'|trans }}</label>
            <select class="form-select" id="transport-travel-class" name="travelClass" data-transport-v20-form-target="travelClass"></select>
          </div>
        </div>

        <div class="row" data-transport-v20-form-target="fuelFields" hidden>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="transport-fuel">{{ 'backend.emission.transport_v20.fuel'|trans }}</label>
            <select class="form-select" id="transport-fuel" name="fuel" data-transport-v20-form-target="fuel" data-action="change->transport-v20-form#countryChanged"></select>
          </div>
        </div>
        <div class="row" data-transport-v20-form-target="thermalFuelFields" hidden>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="transport-thermal-fuel">{{ 'backend.emission.transport_v20.thermal_fuel'|trans }}</label>
            <select class="form-select" id="transport-thermal-fuel" name="thermalFuel" data-transport-v20-form-target="thermalFuel" data-action="change->transport-v20-form#countryChanged"></select>
          </div>
        </div>

        <div data-transport-v20-form-target="routeFields" hidden>
          <div class="row">
            <div class="col-md-6 mb-3 transport-v20-suggestions">
              <label class="form-label" for="transport-origin">{{ 'backend.emission.transport_v20.origin'|trans }}</label>
              <input class="form-control" id="transport-origin" name="origin" value="{{ values.origin|default('') }}" autocomplete="off" data-transport-v20-form-target="origin" data-action="input->transport-v20-form#searchOrigin" data-lat="{{ values.originLatitude|default('') }}" data-lon="{{ values.originLongitude|default('') }}">
              <div class="ors-suggestions-list" data-transport-v20-form-target="originSuggestions"></div>
            </div>
            <div class="col-md-6 mb-3 transport-v20-suggestions">
              <label class="form-label" for="transport-destination">{{ 'backend.emission.transport_v20.destination'|trans }}</label>
              <input class="form-control" id="transport-destination" name="destination" value="{{ values.destination|default('') }}" autocomplete="off" data-transport-v20-form-target="destination" data-action="input->transport-v20-form#searchDestination" data-lat="{{ values.destinationLatitude|default('') }}" data-lon="{{ values.destinationLongitude|default('') }}">
              <div class="ors-suggestions-list" data-transport-v20-form-target="destinationSuggestions"></div>
            </div>
          </div>
          <input type="hidden" name="originLatitude" value="{{ values.originLatitude|default('') }}" data-transport-v20-form-target="originLatitude">
          <input type="hidden" name="originLongitude" value="{{ values.originLongitude|default('') }}" data-transport-v20-form-target="originLongitude">
          <input type="hidden" name="destinationLatitude" value="{{ values.destinationLatitude|default('') }}" data-transport-v20-form-target="destinationLatitude">
          <input type="hidden" name="destinationLongitude" value="{{ values.destinationLongitude|default('') }}" data-transport-v20-form-target="destinationLongitude">
          <div class="row">
            <div class="col-md-6 mb-3" data-transport-v20-form-target="tripTypeFields">
              <label class="form-label" for="transport-trip-type">{{ 'backend.emission.transport_v20.trip_type'|trans }}</label>
              <select class="form-select" id="transport-trip-type" name="tripType" data-transport-v20-form-target="tripType" data-action="change->transport-v20-form#tripTypeChanged"></select>
            </div>
            <div class="col-md-6 mb-3" data-transport-v20-form-target="stopsFields" hidden>
              <label class="form-label" for="transport-stops">{{ 'backend.emission.transport_v20.stops'|trans }}</label>
              <textarea class="form-control" id="transport-stops" name="stops" rows="2">{{ values.stops|default('') }}</textarea>
            </div>
          </div>
          <div class="alert alert-warning py-2" data-transport-v20-form-target="stopsNotice" hidden>{{ 'backend.emission.transport_v20.ors.stops_limitation'|trans }}</div>
          <button class="btn btn-outline-primary mb-3" type="button" data-transport-v20-form-target="routeButton" data-action="transport-v20-form#calculateRoute">{{ 'backend.emission.transport_v20.ors.calculate'|trans }}</button>
          <div class="small mb-3" data-transport-v20-form-target="routeMessage"></div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3" data-transport-v20-form-target="activityFields">
            <label class="form-label" for="transport-activity-value" data-transport-v20-form-target="activityLabel">{{ 'backend.emission.transport_v20.activity_value'|trans }}</label>
            <div class="input-group">
              <input class="form-control" id="transport-activity-value" name="activityValue" value="{{ values.activityValue|default('') }}" inputmode="decimal" pattern="(?:0|[1-9][0-9]*)(?:\.[0-9]+)?" data-transport-v20-form-target="activityValue" required>
              <select class="form-select" id="transport-activity-unit" name="activityUnit" data-transport-v20-form-target="activityUnit" required></select>
            </div>
          </div>
          <div class="col-md-6 mb-3" data-transport-v20-form-target="weightFields" hidden>
            <label class="form-label" for="transport-weight-value">{{ 'backend.emission.transport_v20.weight'|trans }}</label>
            <div class="input-group">
              <input class="form-control" id="transport-weight-value" name="weightValue" value="{{ values.weightValue|default('') }}" inputmode="decimal" pattern="(?:0|[1-9][0-9]*)(?:\.[0-9]+)?" data-transport-v20-form-target="weightValue">
              <select class="form-select" name="weightUnit" data-transport-v20-form-target="weightUnit"></select>
            </div>
          </div>
        </div>

        <div class="row" data-transport-v20-form-target="secondaryFields" hidden>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="transport-secondary-value" data-transport-v20-form-target="secondaryLabel">{{ 'backend.emission.transport_v20.dynamic.secondary_value'|trans }}</label>
            <div class="input-group">
              <input class="form-control" id="transport-secondary-value" name="secondaryActivityValue" value="{{ values.secondaryActivityValue|default('') }}" inputmode="decimal" pattern="(?:0|[1-9][0-9]*)(?:\.[0-9]+)?" data-transport-v20-form-target="secondaryValue">
              <select class="form-select" name="secondaryActivityUnit" data-transport-v20-form-target="secondaryUnit"></select>
            </div>
          </div>
        </div>

        <div class="row" data-transport-v20-form-target="passengerFields" hidden>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="transport-passengers">{{ 'backend.emission.transport_v20.passengers'|trans }}</label>
            <input class="form-control" id="transport-passengers" type="number" name="passengers" value="{{ values.passengers|default('') }}" min="1" step="1" data-transport-v20-form-target="passengers">
          </div>
        </div>

        <div class="row" data-transport-v20-form-target="operatorFields" hidden>
          <div class="col-md-12 mb-3">
            <label class="form-label" for="transport-operator-reference">{{ 'backend.emission.transport_v20.operator_reference'|trans }}</label>
            <input class="form-control" id="transport-operator-reference" name="operatorReference" value="{{ values.operatorReference|default('') }}" data-transport-v20-form-target="operatorReference">
          </div>
        </div>

        <div class="alert alert-warning mb-0" data-transport-v20-form-target="availabilityNotice" hidden></div>
      </div>

        </div>
      </section>

      <section class="transport-v20-section mb-4">
        <div class="transport-v20-section__header">
          <h3 class="transport-v20-section__title">{{ 'backend.emission.transport_v20.section_additional'|trans }}</h3>
          <p class="transport-v20-section__help">{{ 'backend.emission.transport_v20.section_additional_help'|trans }}</p>
        </div>
        <div class="transport-v20-section__body">
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label" for="transport-repetitions">{{ 'backend.emission.transport_v20.repetitions'|trans }}</label>
          <input class="form-control" id="transport-repetitions" type="number" name="repetitions" value="{{ values.repetitions|default('1') }}" min="1" step="1" required>
        </div>
        <div class="col-md-8 mb-3">
          <label class="form-label" for="transport-notes">{{ 'backend.emission.transport_v20.notes'|trans }}</label>
          <textarea class="form-control" id="transport-notes" name="notes" rows="3">{{ values.notes|default('') }}</textarea>
        </div>
      </div>

          <div class="mb-0">
            <label class="form-label" for="transport-attachments">{{ 'backend.emission.attachments.add'|trans }}</label>
            <input class="form-control" id="transport-attachments" type="file" name="attachments[]" multiple accept=".pdf,.jpg,.jpeg,.png,.webp">
            <div class="form-text">{{ 'backend.emission.attachments.help'|trans }}</div>
          </div>
        </div>
      </section>

      <div class="transport-v20-actionbar">
        <a href="{{ path('backend_emission_index', backQuery) }}" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left"></i>
          {{ 'backend.common.back'|trans }}
        </a>
        <button class="btn btn-primary" type="submit" data-transport-v20-form-target="submit">
          <i class="bi bi-save"></i>
          {{ 'backend.common.save'|trans }}
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
