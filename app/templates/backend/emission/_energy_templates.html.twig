{% trans_default_domain 'messages' %}

<template id="tpl-electricidad-contador">
  <div class="alert alert-info bg_green_3 border-0 mb-4">
    <i class="bi bi-info-circle-fill me-2"></i>
    {{ 'backend.emission.energy_tpl.counter.info'|trans }}
  </div>
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.common.space_name'|trans }}</label>
      <input type="text" class="form-control" data-field="contador_localizacion" required />
    </div>
    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.common.reading_date'|trans }}</label>
      <input type="date" class="form-control" data-field="contador_fecha_lectura" required />
    </div>
    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.common.supplier'|trans }}</label>
      <input type="text" class="form-control" data-field="contador_comercializadora" required />
    </div>
    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.common.tariff'|trans }}</label>
      <select class="form-select" data-field="contador_tarifa" required>
        <option value="">{{ 'backend.common.select'|trans }}</option>
        <option value="estandar">{{ 'backend.common.standard'|trans }}</option>
        <option value="renovable">{{ 'backend.common.renewable'|trans }}</option>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.counter.initial_kwh'|trans }}</label>
      <input type="number" step="0.01" class="form-control" data-field="contador_lectura_inicial" required />
    </div>
    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.counter.final_kwh'|trans }}</label>
      <input type="number" step="0.01" class="form-control" data-field="contador_lectura_final" required />
    </div>
  </div>
</template>

