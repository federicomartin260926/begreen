<template id="tpl-electricidad-estimacion_espacio">
  <div class="alert alert-info bg_green_3 border-0 mb-4">
    <i class="bi bi-info-circle-fill me-2"></i>
    {{ 'backend.emission.energy_tpl.space.info'|trans }}
  </div>

  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.common.space_name'|trans }}</label>
      <input type="text" class="form-control" data-field="espacio_nombre_espacio" required />
    </div>

    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.space.space_type'|trans }}</label>
      <select class="form-select" data-field="espacio_tipo_espacio" required>
        <option value="">{{ 'backend.common.select'|trans }}</option>
        <option value="bar_pub_club">{{ 'backend.emission.energy_tpl.space.type.bar_pub_club'|trans }}</option>
        <option value="hotel_conferencias">{{ 'backend.emission.energy_tpl.space.type.hotel_conference'|trans }}</option>
        <option value="museo_galeria">{{ 'backend.emission.energy_tpl.space.type.museum_gallery'|trans }}</option>
        <option value="escuela_comunitario">{{ 'backend.emission.energy_tpl.space.type.school_community'|trans }}</option>
        <option value="teatro_concierto">{{ 'backend.emission.energy_tpl.space.type.theatre_concert'|trans }}</option>
        <option value="universidad">{{ 'backend.emission.energy_tpl.space.type.university'|trans }}</option>
        <option value="otros">{{ 'backend.emission.energy_tpl.space.type.other'|trans }}</option>
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.space.total_area'|trans }}</label>
      <input type="number" step="0.1" class="form-control" data-field="espacio_superficie_total" required />
    </div>

    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.space.used_area'|trans }}</label>
      <input type="number" step="0.1" class="form-control" data-field="espacio_superficie_utilizada" required />
