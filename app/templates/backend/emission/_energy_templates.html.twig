      <label class="form-label">{{ 'backend.emission.energy_tpl.space.hours'|trans }}</label>
      <input type="number" step="0.1" class="form-control" data-field="espacio_horas_uso" required />
    </div>

    <div class="col-md-12">
      <label class="form-label">{{ 'backend.emission.energy_tpl.space.description'|trans }}</label>
      <textarea class="form-control" data-field="espacio_descripcion_espacio" rows="2" placeholder="{{ 'backend.emission.energy_tpl.space.description_ph'|trans }}"></textarea>
    </div>

    <div class="col-md-6">
      <label class="form-label">{{ 'backend.emission.energy_tpl.space.estimated_kwh'|trans }}</label>
      <input type="number" step="0.01" class="form-control" data-field="espacio_estimacion_consumo" required />
    </div>
  </div>
</template>

