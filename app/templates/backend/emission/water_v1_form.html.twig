{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ duplicate ? 'backend.emission.water_v1.title_duplicate'|trans : (edit ? 'backend.emission.water_v1.title_edit'|trans : 'backend.emission.water_v1.title_new'|trans) }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item"><a href="{{ path('backend_emission_index', backQuery) }}" class="text-decoration-none">{{ 'backend.emission.water_v1.breadcrumb_list'|trans }}</a></li>
  <li class="breadcrumb-item active">{{ duplicate ? 'backend.emission.water_v1.breadcrumb_duplicate'|trans : (edit ? 'backend.emission.water_v1.breadcrumb_edit'|trans : 'backend.emission.water_v1.breadcrumb_new'|trans) }}</li>
{% endblock %}

{% block body %}
{% set messageKeys = [
  'dates_required', 'invalid_date_range', 'split_by_year', 'country_required', 'country_invalid',
  'water_use_type_required', 'water_use_type_unknown', 'destination_required', 'destination_unknown',
  'volume_invalid', 'volume_unit_unknown', 'emission_factor_unavailable', 'emission_factor_not_calculable'
] %}
{% set messageLabels = {} %}
{% for key in messageKeys %}{% set messageLabels = messageLabels|merge({(key): ('backend.emission.water_v1.messages.' ~ key)|trans}) %}{% endfor %}
{% set waterI18n = {
  calculating: 'backend.emission.water_v1.preview.calculating'|trans,
  previewError: 'backend.emission.water_v1.preview.error'|trans,
  statusLabels: {
    CALCULATED: 'backend.emission.water_v1.statuses.CALCULATED'|trans,
    PENDING_DATA: 'backend.emission.water_v1.statuses.PENDING_DATA'|trans,
    NOT_AUTOMATICALLY_CALCULABLE: 'backend.emission.water_v1.statuses.NOT_AUTOMATICALLY_CALCULABLE'|trans
  },
  componentLabels: {
    water_supply: 'backend.emission.water_v1.components.water_supply'|trans,
    water_treatment: 'backend.emission.water_v1.components.water_treatment'|trans,
    urban_water_cycle: 'backend.emission.water_v1.components.urban_water_cycle'|trans
  },
  fallback: 'backend.emission.water_v1.preview.fallback'|trans,
  geographicProxy: 'backend.emission.water_v1.preview.geographic_proxy'|trans,
  dataQuality: 'backend.emission.water_v1.preview.data_quality'|trans,
  factorId: 'backend.emission.water_v1.preview.factor_id'|trans,
  activityYear: 'backend.emission.water_v1.preview.activity_year'|trans,
  factorYear: 'backend.emission.water_v1.preview.factor_year'|trans,
  factorVersion: 'backend.emission.water_v1.preview.factor_version'|trans,
  requestedGeography: 'backend.emission.water_v1.preview.requested_geography'|trans,
  sourceGeography: 'backend.emission.water_v1.preview.source_geography'|trans,
  messageLabels: messageLabels
} %}

<div class="container-fluid px-0 backend-client-shell"
     data-controller="water-v1-form"
     data-water-v1-form-i18n-value="{{ waterI18n|json_encode|e('html_attr') }}"
     data-water-v1-form-preview-url-value="{{ path('backend_emission_water_v1_preview') }}"
     data-water-v1-form-preview-token-value="{{ csrf_token('water_emission_v1_preview') }}">
  <div class="backend-client-content">
    <h2>{{ duplicate ? 'backend.emission.water_v1.heading_duplicate'|trans : (edit ? 'backend.emission.water_v1.heading_edit'|trans : 'backend.emission.water_v1.heading_new'|trans) }}</h2>
    <p class="text-muted mb-4">{{ 'backend.emission.water_v1.intro'|trans }}</p>

    <section class="card mb-4"><div class="card-body">
      <div class="row g-3">
        <div class="col-md-6"><small class="text-muted d-block">{{ 'backend.emission.water_v1.project'|trans }}</small><strong>{{ project.name }}</strong></div>
        <div class="col-md-6"><small class="text-muted d-block">{{ 'backend.emission.water_v1.category'|trans }}</small><span class="badge text-bg-success">{{ category.name }}</span></div>
        <div class="col-12">
          <small class="text-muted d-block mb-1">{{ 'backend.emission.water_v1.phases'|trans }}</small>
          {% for phaseDate in project.phaseDates %}
            <span class="badge text-bg-light border me-1">{{ project.getPhaseLabel(phaseDate.phase)|trans }} · {{ phaseDate.startDate|date('d/m/Y') }}–{{ phaseDate.endDate|date('d/m/Y') }}</span>
          {% else %}—{% endfor %}
        </div>
      </div>
    </div></section>

    {% if errors %}
      <div class="alert alert-danger"><ul class="mb-0">{% for error in errors %}<li>{{ ('backend.emission.water_v1.errors.' ~ error)|trans }}</li>{% endfor %}</ul></div>
    {% endif %}

    {% if edit and record.attachments|length > 0 %}
      <section class="card mb-4"><div class="card-body">
        <h3 class="h5">{{ 'backend.emission.attachments.title'|trans }}</h3>
        <div class="list-group list-group-flush">
          {% for attachment in record.attachments %}
            <div class="list-group-item px-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
              <span>{{ attachment.originalName }} <small class="text-muted">({{ (attachment.size / 1024)|number_format(1, ',', '.') }} KB)</small></span>
              <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-primary" href="{{ path('backend_emission_attachment_download', {recordId: record.id, attachmentId: attachment.id}) }}">{{ 'backend.emission.attachments.download'|trans }}</a>
                <form method="post" action="{{ path('backend_emission_attachment_delete', {recordId: record.id, attachmentId: attachment.id}|merge(backQuery)) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_emission_attachment_' ~ attachment.id) }}">
                  <button class="btn btn-sm btn-outline-danger" type="submit">{{ 'backend.emission.attachments.delete'|trans }}</button>
                </form>
              </div>
            </div>
          {% endfor %}
        </div>
      </div></section>
    {% endif %}

    <form method="post" action="{{ formAction }}" enctype="multipart/form-data" novalidate
          data-water-v1-form-target="form"
          data-action="input->water-v1-form#queuePreview change->water-v1-form#queuePreview submit->water-v1-form#validate">
      <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">

      <section class="card mb-4"><div class="card-body">
        <h3 class="h5 mb-3">{{ 'backend.emission.water_v1.sections.activity'|trans }}</h3>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label" for="water-start-date">{{ 'backend.emission.water_v1.fields.start_date'|trans }} *</label><input class="form-control" id="water-start-date" type="date" name="startDate" value="{{ values.startDate|default('') }}" required></div>
          <div class="col-md-4"><label class="form-label" for="water-end-date">{{ 'backend.emission.water_v1.fields.end_date'|trans }} *</label><input class="form-control" id="water-end-date" type="date" name="endDate" value="{{ values.endDate|default('') }}" required></div>
          <div class="col-md-4"><label class="form-label" for="water-country">{{ 'backend.emission.water_v1.fields.country'|trans }} *</label><select class="form-select" id="water-country" name="country" required><option value="">{{ 'backend.common.select'|trans }}</option>{% for code, name in countries %}<option value="{{ code }}" {% if values.country|default('') == code %}selected{% endif %}>{{ name }}</option>{% endfor %}</select></div>
          <div class="col-md-6"><label class="form-label" for="water-use-type">{{ 'backend.emission.water_v1.fields.water_use_type'|trans }} *</label><select class="form-select" id="water-use-type" name="waterUseType" required><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in waterUseTypes %}<option value="{{ value }}" {% if values.waterUseType|default('') == value %}selected{% endif %}>{{ ('backend.emission.water_v1.water_use_types.' ~ value)|trans }}</option>{% endfor %}</select></div>
          <div class="col-md-3"><label class="form-label" for="water-volume">{{ 'backend.emission.water_v1.fields.volume'|trans }} *</label><input class="form-control" id="water-volume" name="volumeInput" value="{{ values.volumeInput|default('') }}" inputmode="decimal" required></div>
          <div class="col-md-3"><label class="form-label" for="water-unit">{{ 'backend.emission.water_v1.fields.unit'|trans }} *</label><select class="form-select" id="water-unit" name="volumeInputUnit" required><option value="L" {% if values.volumeInputUnit|default('') == 'L' %}selected{% endif %}>{{ 'backend.emission.water_v1.units.L'|trans }}</option><option value="m3" {% if values.volumeInputUnit|default('m3') == 'm3' %}selected{% endif %}>{{ 'backend.emission.water_v1.units.m3'|trans }}</option></select></div>
          <div class="col-md-6"><label class="form-label" for="water-destination">{{ 'backend.emission.water_v1.fields.destination'|trans }} *</label><select class="form-select" id="water-destination" name="destination" required><option value="">{{ 'backend.common.select'|trans }}</option>{% for value in destinations %}<option value="{{ value }}" {% if values.destination|default('') == value %}selected{% endif %}>{{ ('backend.emission.water_v1.destinations.' ~ value)|trans }}</option>{% endfor %}</select></div>
        </div>
      </div></section>

      <section class="card mb-4"><div class="card-body">
        <h3 class="h5">{{ 'backend.emission.water_v1.preview.title'|trans }}</h3>
        <div class="d-flex flex-wrap align-items-baseline gap-3 mb-2"><strong data-water-v1-form-target="previewStatus">{{ 'backend.emission.water_v1.preview.error'|trans }}</strong><span class="fs-4" data-water-v1-form-target="previewEmission">—</span></div>
        <ul class="small text-muted mb-2" data-water-v1-form-target="previewTrace"></ul>
        <ul class="small text-danger mb-0" data-water-v1-form-target="previewMessages"></ul>
      </div></section>

      <section class="card mb-4"><div class="card-body">
        <div class="mb-3"><label class="form-label" for="water-notes">{{ 'backend.emission.water_v1.fields.notes'|trans }}</label><textarea class="form-control" id="water-notes" name="notes" rows="3">{{ values.notes|default('') }}</textarea></div>
        <div><label class="form-label" for="water-attachments">{{ 'backend.emission.attachments.add'|trans }}</label><input class="form-control" id="water-attachments" type="file" name="attachments[]" multiple accept="application/pdf,image/jpeg,image/png,image/webp"><div class="form-text">{{ 'backend.emission.attachments.help'|trans }}</div></div>
      </div></section>

      <div class="d-flex gap-2 justify-content-end">
        <a class="btn btn-outline-secondary" href="{{ path('backend_emission_index', backQuery) }}">{{ 'backend.common.cancel'|trans }}</a>
        <button class="btn btn-success" type="submit">{{ 'backend.common.save'|trans }}</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
