{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'backend.emission.index.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">
        {{ 'backend.emission.index.breadcrumb'|trans }}
    </li>
{% endblock %}

{% block body %}
{% set currentQuery = app.request.query.all %}
<div
    class="container-fluid px-0 backend-client-shell"
    data-controller="emission"
    data-emission-i18n-value='{{ {
        "backend.emission.chart.title.by_activity": "backend.emission.chart.title.by_activity"|trans,
        "backend.emission.chart.title.by_phase": "backend.emission.chart.title.by_phase"|trans,
        "backend.emission.chart.legend.by_activity": "backend.emission.chart.legend.by_activity"|trans,
        "backend.emission.chart.legend.by_phase": "backend.emission.chart.legend.by_phase"|trans,
        "backend.emission.chart.axis.kgco2e": "backend.emission.chart.axis.kgco2e"|trans,
        "backend.emission.chart.unit.kgco2e": "backend.emission.chart.unit.kgco2e"|trans
        }|json_encode|e('html_attr') }}'
    data-emission-chart-data-value='{{ chartDataByCategory|json_encode|e('html_attr') }}'>
    <div class="backend-client-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="">
                    {{ 'backend.emission.index.heading'|trans }}
                    <strong>{{ project.name }}</strong>
                </h2>
            </div>

            <div class="d-flex align-items-center mb-3">
                {# Normalizamos a una clave canónica #}
                {% set typeKey = (project.type ?? '')|lower %}
                {% set typeIcon = typeKey == 'evento' ? 'bi-calendar-event' : 'bi-camera-reels' %}
                {% set typeLabel = ('backend.project.type.' ~ typeKey)|trans %}

                <span
                    class="badge bg-secondary ms-1"
                    data-bs-toggle="popover"
                    data-bs-trigger="hover"
                    data-bs-html="true"
                    data-bs-content="{{ 'backend.plan.badges.type_popover'|trans({'%type%': typeLabel})|e('html_attr') }}">
                    <i class="bi {{ typeIcon }}"></i> {{ typeLabel }}
                </span>
            </div>


            <button type="button" class="btn btn-outline-secondary mb-4" data-bs-toggle="modal" data-bs-target="#reportModal">
                <i class="bi bi-file-earmark-pdf me-2"></i> {{ 'backend.emission.index.reports_btn'|trans }}
            </button>

            {% if not hasCategories %}
                <div class="alert alert-info">{{ 'backend.emission.index.no_categories'|trans }}</div>
            {% else %}
                <div class="emissions-layout">
                    <aside class="emissions-category-panel card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                                <h3 class="h6 mb-0">{{ 'backend.emission.index.categories_title'|trans }}</h3>
                                <span class="badge text-bg-light border text-success-emphasis">
                                    {{ selectedCategoryCount }}
                                </span>
                            </div>

                            <div class="emissions-category-list">
                                {% for category in categoriesNavigation %}
                                    <a
                                        href="{{ category.url }}"
                                        class="emissions-category-item {{ category.active ? 'emissions-category-item--active' : '' }} {{ hasAnyEmissionRecords and category.empty ? 'emissions-category-item--empty' : '' }}"
                                        aria-current="{{ category.active ? 'true' : 'false' }}"
                                    >
                                        <span class="emissions-category-item__label">
                                            <i class="bi {{ category.icon }}"></i>
                                            <span class="emissions-category-item__text">{{ category.name }}</span>
                                        </span>
                                        <span class="badge rounded-pill {{ category.active ? 'text-bg-success' : 'text-bg-secondary' }}">
                                            {{ category.count }}
                                        </span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </aside>

                    <section class="emissions-records-panel">
                        <div class="emissions-records-header d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-3">
                            <div>
                                <h3 class="h5 mb-1">{{ selectedCategoryName }}</h3>
                                <div class="text-muted small">
                                    {{ 'backend.emission.index.records_count'|trans({'%count%': selectedCategoryCount}) }}
                                </div>
                            </div>

                            <a
                                href="{{ newRecordUrl }}"
                                class="btn btn-sm btn-success shadow-sm px-4 py-2 d-inline-flex align-items-center gap-2 text-decoration-none emissions-new-record-btn"
                            >
                                <i class="bi bi-plus-circle-fill fs-5"></i>
                                <span class="fw-semibold">{{ 'backend.emission.index.new_record'|trans }}</span>
                            </a>
                        </div>

                        {% if selectedCategoryRecords is empty %}
                            <div class="alert alert-light mb-0">{{ 'backend.emission.index.no_records'|trans }}</div>
                        {% else %}
                            <div class="table-responsive emissions-table-wrapper">
                                <table class="table table-hover green_table_1 align-middle mb-0">
                                    <thead>
                                    <tr>
                                        <th>{{ 'backend.emission.index.th.activity'|trans }}</th>
                                        <th>{{ 'backend.emission.index.th.phase'|trans }}</th>
                                        <th>{{ 'backend.emission.index.th.unit'|trans }}</th>
                                        <th>{{ 'backend.emission.index.th.amount'|trans }}</th>
                                        <th title="{{ 'backend.emission.index.th.emission_title'|trans }}">{{ 'backend.emission.index.th.emission'|trans }}</th>
                                        <th>{{ 'backend.emission.index.th.date'|trans }}</th>
                                        <th>{{ 'backend.emission.index.th.actions'|trans }}</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for record in selectedCategoryRecords %}
                                        <tr class="emissions-record-row">
                                            <td>
                                                {{ record.activity.name }}
                                                {% if record.activity.subcategory %}
                                                    <span class="text-muted">
                                                        ({{ ('backend.emission.subcat.' ~ record.activity.subcategory)|trans }})
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td>{{ project.getPhaseLabel(record.phase.phase)|trans }}</td>
                                            <td>{{ record.activity.unit }}</td>
                                            <td>{{ record.amount }}</td>
                                            <td>{{ record.emission|number_format(2, ',', '.') }}</td>
                                            <td>{{ record.registeredAt|date('d/m/Y') }}</td>
                                            <td class="text-nowrap">
                                                <a
                                                    href="{{
                                                        record.activity.category.id == energyId
                                                            ? path('backend_emission_edit_energy', { id: record.id }|merge(currentQuery))
                                                            : (record.activity.category.id in [transportId, tripsId]
                                                                ? path('backend_emission_edit_transport', { id: record.id }|merge(currentQuery))
                                                                : path('backend_emission_edit', { id: record.id }|merge(currentQuery)))
                                                    }}"
                                                    data-bs-toggle="popover"
                                                    data-bs-trigger="hover"
                                                    data-bs-placement="right"
                                                    data-bs-content="{{ 'backend.common.edit'|trans }}"
                                                    class="btn btn-sm btn-outline-secondary"
                                                >
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <form
                                                    action="{{ path('backend_emission_delete', { id: record.id }|merge(currentQuery)) }}"
                                                    method="post"
                                                    data-bs-toggle="popover"
                                                    data-bs-trigger="hover"
                                                    data-bs-placement="right"
                                                    data-bs-content="{{ 'backend.common.delete'|trans }}"
                                                    class="d-inline"
                                                    onsubmit="return confirm('{{ 'backend.common.confirm_delete'|trans|e('js') }}');"
                                                >
                                                    <input type="hidden" name="categoryId" value="{{ record.activity.category.id }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ record.id) }}">
                                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                    <tfoot class="fw-bold">
                                    <tr>
                                        <td colspan="4">{{ 'backend.emission.index.total'|trans }}</td>
                                        <td>{{ selectedCategoryTotalEmission|number_format(2, ',', '.') }}</td>
                                        <td colspan="2"></td>
                                    </tr>
                                    </tfoot>
                                </table>
                            </div>

                            {% if totalPages > 1 %}
                                <nav class="d-flex justify-content-center mt-4 emissions-pagination" aria-label="{{ 'backend.pagination.title'|trans }}">
                                    <ul class="pagination mb-0 flex-nowrap">
                                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                                            <a
                                                class="page-link text-decoration-none"
                                                href="{{ path(app.request.attributes.get('_route'), paginationQuery|merge({'page': currentPage - 1})) }}"
                                                tabindex="-1"
                                                aria-label="{{ 'backend.pagination.previous'|trans }}"
                                            >
                                                <span class="pagination-label pagination-label--desktop">&laquo; {{ 'backend.pagination.previous'|trans }}</span>
                                                <span class="pagination-label pagination-label--mobile" aria-hidden="true">‹</span>
                                            </a>
                                        </li>

                                        {% set startPage = currentPage - 2 %}
                                        {% set endPage = currentPage + 2 %}
                                        {% if startPage < 1 %}
                                            {% set endPage = endPage + (1 - startPage) %}
                                            {% set startPage = 1 %}
                                        {% endif %}
                                        {% if endPage > totalPages %}
                                            {% set startPage = startPage - (endPage - totalPages) %}
                                            {% set endPage = totalPages %}
                                            {% if startPage < 1 %}
                                                {% set startPage = 1 %}
                                            {% endif %}
                                        {% endif %}

                                        {% if startPage > 1 %}
                                            <li class="page-item">
                                                <a class="page-link text-decoration-none" href="{{ path(app.request.attributes.get('_route'), paginationQuery|merge({'page': 1})) }}">1</a>
                                            </li>
                                            {% if startPage > 2 %}
                                                <li class="page-item disabled"><span class="page-link">…</span></li>
                                            {% endif %}
                                        {% endif %}

                                        {% for p in startPage..endPage %}
                                            <li class="page-item {{ p == currentPage ? 'active' : '' }}">
                                                <a class="page-link text-decoration-none" href="{{ path(app.request.attributes.get('_route'), paginationQuery|merge({'page': p})) }}">{{ p }}</a>
                                            </li>
                                        {% endfor %}

                                        {% if endPage < totalPages %}
                                            {% if endPage < totalPages - 1 %}
                                                <li class="page-item disabled"><span class="page-link">…</span></li>
                                            {% endif %}
                                            <li class="page-item">
                                                <a class="page-link text-decoration-none" href="{{ path(app.request.attributes.get('_route'), paginationQuery|merge({'page': totalPages})) }}">{{ totalPages }}</a>
                                            </li>
                                        {% endif %}

                                        <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                                            <a
                                                class="page-link text-decoration-none"
                                                href="{{ path(app.request.attributes.get('_route'), paginationQuery|merge({'page': currentPage + 1})) }}"
                                                aria-label="{{ 'backend.pagination.next'|trans }}"
                                            >
                                                <span class="pagination-label pagination-label--desktop">{{ 'backend.pagination.next'|trans }} &raquo;</span>
                                                <span class="pagination-label pagination-label--mobile" aria-hidden="true">›</span>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            {% endif %}

                            <div class="emissions-chart-wrapper mt-4">
                                <canvas
                                    data-emission-target="chart"
                                    data-chart-category="{{ selectedCategoryChartKey }}"
                                    class="emissions-chart">
                                </canvas>
                            </div>
                        {% endif %}
                    </section>
                </div>

            {% endif %}
    </div>
</div>

<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="reportModalLabel">
            <i class="bi bi-file-earmark-pdf me-2"></i> {{ 'backend.emission.index.modal.title'|trans }}
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3 text-center">{{ 'backend.emission.index.modal.subtitle'|trans }}</p>
        <div class="d-grid gap-2">
          <a href="{{ path('report_emission_overview_pdf') }}" class="btn btn-outline-dark">
            <i class="bi bi-diagram-3-fill me-2"></i> {{ 'backend.emission.index.modal.report_overview'|trans }}
          </a>
          <a href="{{ path('report_emission_detailed_pdf') }}" class="btn btn-outline-dark">
            <i class="bi bi-table me-2"></i> {{ 'backend.emission.index.modal.report_detailed'|trans }}
          </a>
          <a href="{{ path('report_emission_by_activity_pdf') }}" class="btn btn-outline-dark">
            <i class="bi bi-list-check me-2"></i> {{ 'backend.emission.index.modal.report_by_activity'|trans }}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
