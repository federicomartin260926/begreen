{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'backend.emission.index.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.emission.index.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-client-shell emission-dashboard">
    <div class="backend-client-content">
        <header class="emission-dashboard__header">
            <div>
                <div class="emission-dashboard__eyebrow">{{ 'backend.emission.index.dashboard.eyebrow'|trans }}</div>
                <h2 class="emission-dashboard__project-name">{{ project.name }}</h2>
            </div>
            {% if is_granted('PROJECT_EDIT', project) %}
                <a href="{{ path('backend_project_edit', {id: project.id}) }}" class="btn btn-outline-secondary">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>
                    {{ 'backend.emission.index.dashboard.edit_project'|trans }}
                </a>
            {% endif %}
        </header>

        {% set typeKey = (project.type ?? '')|lower %}
        <section class="emission-dashboard__project-meta" aria-label="{{ 'backend.emission.index.dashboard.project_data'|trans }}">
            <div class="emission-dashboard__meta-item">
                <span>{{ 'backend.emission.index.dashboard.project_type'|trans }}</span>
                <strong>{{ ('backend.project.type.' ~ typeKey)|trans }}</strong>
            </div>
            {% for phaseDate in project.phaseDates %}
                <div class="emission-dashboard__meta-item">
                    <span>{{ project.getPhaseLabel(phaseDate.phase)|trans }}</span>
                    <strong>
                        {{ phaseDate.startDate ? phaseDate.startDate|date('d/m/Y') : '—' }}
                        —
                        {{ phaseDate.endDate ? phaseDate.endDate|date('d/m/Y') : '—' }}
                    </strong>
                </div>
            {% endfor %}
        </section>

        <section class="emission-dashboard__hero">
            <div class="emission-dashboard__metric">
                <strong>{{ totalEmissionKg is null ? '—' : totalEmissionKg|number_format(2, ',', '.') ~ ' kg CO₂e' }}</strong>
                <span>{{ 'backend.emission.index.dashboard.emissions'|trans }}</span>
            </div>
        </section>

        <div class="emission-dashboard__section-title">
            <h3>{{ 'backend.emission.index.categories_title'|trans }}</h3>
            <p>{{ 'backend.emission.index.dashboard.categories_help'|trans }}</p>
        </div>

        {% if not hasCategories %}
            <div class="alert alert-info">{{ 'backend.emission.index.no_categories'|trans }}</div>
        {% else %}
            <div class="accordion emission-dashboard__categories" id="emission-categories">
                {% for category in categories %}
                    {% set categoryQuery = app.request.query.all|merge({categoryId: category.id}) %}
                    <article class="accordion-item emission-dashboard-category emission-dashboard-category--{{ category.slug }}" id="emission-category-{{ category.id }}">
                        <h4 class="accordion-header">
                            <button
                                class="accordion-button emission-dashboard-category__header {{ category.active ? '' : 'collapsed' }}"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#emission-category-body-{{ category.id }}"
                                aria-expanded="{{ category.active ? 'true' : 'false' }}"
                                aria-controls="emission-category-body-{{ category.id }}"
                            >
                                <span class="emission-dashboard-category__icon"><i class="bi {{ category.icon }}" aria-hidden="true"></i></span>
                                <span class="emission-dashboard-category__identity">
                                    <span class="emission-dashboard-category__name">{{ ('backend.emission.index.dashboard.categories.' ~ category.labelKey)|trans }}</span>
                                    <span class="emission-dashboard-category__count">
                                        {{ category.count == 0
                                            ? 'backend.emission.index.dashboard.no_records'|trans
                                            : 'backend.emission.index.records_count'|trans({'%count%': category.count}) }}
                                    </span>
                                </span>
                                <span class="emission-dashboard-category__subtotal">
                                    {{ category.totalEmissionKg is null ? '—' : category.totalEmissionKg|number_format(2, ',', '.') ~ ' kg CO₂e' }}
                                </span>
                            </button>
                        </h4>

                        <div
                            id="emission-category-body-{{ category.id }}"
                            class="accordion-collapse collapse {{ category.active ? 'show' : '' }}"
                            data-bs-parent="#emission-categories"
                        >
                            <div class="accordion-body emission-dashboard-category__body">
                                <div class="emission-dashboard-category__tools">
                                    <h5>{{ 'backend.emission.index.dashboard.entered_data'|trans }}</h5>
                                    <a href="{{ category.createUrl }}" class="btn btn-sm emission-dashboard-category__add">
                                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                                        {{ 'backend.emission.index.dashboard.add_data'|trans }}
                                    </a>
                                </div>

                                {% if category.records is empty %}
                                    <div class="emission-dashboard-category__empty">
                                        <i class="bi bi-inbox" aria-hidden="true"></i>
                                        <span>{{ 'backend.emission.index.no_records'|trans }}</span>
                                    </div>
                                {% else %}
                                    <div class="emission-dashboard-records">
                                        {% for record in category.records %}
                                            {% set transportSummary = transportV20Summaries[record.id]|default(null) %}
                                            {% set energySummary = energyV1Summaries[record.id]|default(null) %}
                                            {% set waterSummary = waterV1Summaries[record.id]|default(null) %}
                                            {% set accommodationSummary = accommodationV1Summaries[record.id]|default(null) %}
                                            {% set cateringSummary = cateringV1Summaries[record.id]|default(null) %}
                                            {% set wasteSummary = wasteV1Summaries[record.id]|default(null) %}
                                            {% set materialSummary = materialV1Summaries[record.id]|default(null) %}
                                            {% set action = recordActions[record.id]|default(null) %}

                                            {% set activity %}
                                                {% if transportSummary %}
                                                    {{ ('backend.emission.transport_v20.modes.' ~ transportSummary.mode)|trans }}
                                                    {% if transportSummary.detailCode %}
                                                        · {{ ((transportSummary.detailKind == 'vehicle_type'
                                                            ? 'backend.emission.transport_v20.vehicle_types.'
                                                            : 'backend.emission.transport_v20.fuels.') ~ transportSummary.detailCode)|trans }}
                                                    {% endif %}
                                                {% elseif energySummary %}
                                                    {{ ('backend.emission.energy_v1.families.' ~ energySummary.family)|trans }}
                                                {% elseif waterSummary and waterSummary.waterUseType %}
                                                    {{ ('backend.emission.water_v1.water_use_types.' ~ waterSummary.waterUseType)|trans }}
                                                {% elseif accommodationSummary and accommodationSummary.accommodationType %}
                                                    {{ ('backend.emission.accommodation_v1.types.' ~ accommodationSummary.accommodationType)|trans }}
                                                {% elseif cateringSummary and cateringSummary.activityType %}
                                                    {{ ('backend.emission.catering_v1.activities.' ~ cateringSummary.activityType)|trans }}
                                                {% elseif wasteSummary and wasteSummary.displayActivity %}
                                                    {{ wasteSummary.displayActivity }}
                                                {% elseif materialSummary and materialSummary.displayActivity %}
                                                    {{ materialSummary.displayActivity }}
                                                {% else %}—{% endif %}
                                            {% endset %}

                                            {% set unit %}
                                                {% if transportSummary and transportSummary.displayActivityUnit %}
                                                    {{ ('backend.emission.transport_v20.units.' ~ transportSummary.displayActivityUnit)|trans }}
                                                {% elseif energySummary and energySummary.normalizedUnit %}
                                                    {{ energySummary.normalizedUnit }}
                                                {% elseif waterSummary and waterSummary.normalizedUnit %}
                                                    {{ ('backend.emission.water_v1.units.' ~ waterSummary.normalizedUnit)|trans }}
                                                {% elseif accommodationSummary and accommodationSummary.normalizedUnitKey %}
                                                    {{ ('backend.emission.accommodation_v1.units.' ~ accommodationSummary.normalizedUnitKey)|trans }}
                                                {% elseif cateringSummary and cateringSummary.normalizedUnitKey %}
                                                    {{ ('backend.emission.catering_v1.units.' ~ cateringSummary.normalizedUnitKey)|trans }}
                                                {% elseif wasteSummary and wasteSummary.normalizedUnit %}
                                                    {{ wasteSummary.normalizedUnit }}
                                                {% elseif materialSummary and materialSummary.normalizedUnit %}
                                                    {{ materialSummary.normalizedUnit }}
                                                {% else %}—{% endif %}
                                            {% endset %}

                                            <div class="emission-dashboard-record emissions-record-row">
                                                <div class="emission-dashboard-record__summary">
                                                    <span class="emission-dashboard-record__date">{{ record.registeredAt|date('d/m/Y') }}</span>
                                                    <span class="emission-dashboard-record__activity">{{ activity|trim }}</span>
                                                    <span class="emission-dashboard-record__description">
                                                        {{ record.amount is null ? '—' : record.amount|number_format(2, ',', '.') }}
                                                        {% if unit|trim != '—' %} {{ unit|trim }}{% endif %}
                                                    </span>
                                                    <span class="emission-dashboard-record__emission">
                                                        {{ record.emission is null ? '—' : record.emission|number_format(2, ',', '.') ~ ' kgCO₂e' }}
                                                    </span>
                                                    <button
                                                        class="btn btn-sm btn-outline-secondary"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#emission-record-detail-{{ record.id }}"
                                                        aria-expanded="false"
                                                        aria-controls="emission-record-detail-{{ record.id }}"
                                                    >{{ 'backend.emission.index.dashboard.view'|trans }}</button>
                                                </div>

                                                <div class="collapse" id="emission-record-detail-{{ record.id }}">
                                                    <div class="emission-dashboard-record__detail">
                                                        <dl>
                                                            <div><dt>{{ 'backend.emission.index.th.phase'|trans }}</dt><dd>{{ project.getPhaseLabel(record.phase.phase)|trans }}</dd></div>
                                                            <div><dt>{{ 'backend.emission.index.th.activity'|trans }}</dt><dd>{{ activity|trim }}</dd></div>
                                                            <div><dt>{{ 'backend.emission.index.th.amount'|trans }}</dt><dd>{{ record.amount is null ? '—' : record.amount|number_format(2, ',', '.') }}</dd></div>
                                                            <div><dt>{{ 'backend.emission.index.th.unit'|trans }}</dt><dd>{{ unit|trim }}</dd></div>
                                                            <div><dt>{{ 'backend.emission.index.dashboard.status'|trans }}</dt><dd>{{ record.status ? ('backend.emission.energy_v1.statuses.' ~ record.status)|trans : '—' }}</dd></div>
                                                            <div><dt>{{ 'backend.emission.index.dashboard.emissions'|trans }}</dt><dd>{{ record.emission is null ? '—' : record.emission|number_format(2, ',', '.') ~ ' kgCO₂e' }}</dd></div>
                                                        </dl>
                                                        <div class="emission-dashboard-record__actions">
                                                            {% if action %}
                                                                <a href="{{ path(action.editRoute, {id: record.id}|merge(categoryQuery)) }}" class="btn btn-sm btn-outline-secondary">
                                                                    <i class="bi bi-pencil me-1" aria-hidden="true"></i>{{ 'backend.common.edit'|trans }}
                                                                </a>
                                                                <a href="{{ path(action.duplicateRoute, {id: record.id}|merge(categoryQuery)) }}" class="btn btn-sm btn-outline-secondary">
                                                                    <i class="bi bi-files me-1" aria-hidden="true"></i>{{ 'backend.emission.index.dashboard.duplicate'|trans }}
                                                                </a>
                                                            {% endif %}
                                                            <form
                                                                action="{{ path('backend_emission_delete', {id: record.id}|merge(categoryQuery)) }}"
                                                                method="post"
                                                                onsubmit="return confirm('{{ 'backend.common.confirm_delete'|trans|e('js') }}');"
                                                            >
                                                                <input type="hidden" name="category" value="{{ category.name }}">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ record.id) }}">
                                                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                                                    <i class="bi bi-trash me-1" aria-hidden="true"></i>{{ 'backend.common.delete'|trans }}
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>

                                    {% if category.hasMore %}
                                        <a href="{{ category.showAllUrl }}" class="emission-dashboard-category__show-all">
                                            {{ 'backend.emission.index.dashboard.show_all'|trans }}
                                        </a>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}

        <div class="emission-dashboard__footer">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#reportModal">
                <i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>
                {{ 'backend.emission.index.dashboard.provisional_results'|trans }}
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="reportModalLabel"><i class="bi bi-file-earmark-pdf me-2"></i>{{ 'backend.emission.index.modal.title'|trans }}</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3 text-center">{{ 'backend.emission.index.modal.subtitle'|trans }}</p>
                <div class="d-grid gap-2">
                    <a href="{{ path('report_emission_overview_pdf') }}" class="btn btn-outline-dark"><i class="bi bi-diagram-3-fill me-2"></i>{{ 'backend.emission.index.modal.report_overview'|trans }}</a>
                    <a href="{{ path('report_emission_detailed_pdf') }}" class="btn btn-outline-dark"><i class="bi bi-table me-2"></i>{{ 'backend.emission.index.modal.report_detailed'|trans }}</a>
                    <a href="{{ path('report_emission_by_activity_pdf') }}" class="btn btn-outline-dark"><i class="bi bi-list-check me-2"></i>{{ 'backend.emission.index.modal.report_by_activity'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
