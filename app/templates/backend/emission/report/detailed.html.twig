{% extends 'pdf/base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'backend.emission.reports.detailed.title'|trans }}{% endblock %}

{% block body %}
  <h1>{{ 'backend.emission.reports.detailed.h1'|trans }}</h1>

  <p><strong>{{ 'backend.emission.reports.detailed.project'|trans }}:</strong> {{ project.name }}</p>
  <p><strong>{{ 'backend.emission.reports.detailed.type'|trans }}:</strong> {{ project.type|capitalize }}</p>
  <p><strong>{{ 'backend.emission.reports.detailed.total_records'|trans }}:</strong> {{ records|length }}</p>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>{{ 'backend.emission.reports.detailed.th.phase'|trans }}</th>
        <th>{{ 'backend.emission.reports.detailed.th.date'|trans }}</th>
        <th>{{ 'backend.emission.reports.detailed.th.category'|trans }}</th>
        <th>{{ 'backend.emission.reports.detailed.th.activity'|trans }}</th>
        <th>{{ 'backend.emission.reports.detailed.th.amount'|trans }}</th>
        <th>{{ 'backend.emission.reports.detailed.th.unit'|trans }}</th>
        <th>{{ 'backend.emission.reports.detailed.th.emission'|trans }}</th>
        <th>{{ 'backend.emission.reports.detailed.th.details'|trans }}</th>
      </tr>
    </thead>
    <tbody>
      {% for record in records %}
        {% set details = record.calculationDetails ? record.calculationDetails|json_decode : {} %}
        {% set presentation = recordPresentations[loop.index0] %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ record.phase.getPhase(project.type) }}</td>
          <td>{{ record.createdAt|date('d/m/Y') }}</td>
          <td>{{ record.effectiveCategory ? record.effectiveCategory.name : ('backend.common.no_category'|trans) }}</td>
          <td>{{ presentation.activity }}</td>
          <td class="text-right">{{ record.amount is null ? '—' : record.amount }}</td>
          <td>{{ presentation.unit }}</td>
          <td class="text-right">{{ record.emission is null ? '—' : record.emission|number_format(2, '.', ',') }}</td>
          <td class="small">
            {% if details.version is defined %}
              <strong>Version:</strong> {{ details.version }}
            {% elseif details %}
              {% for key, value in details %}
                {% if value is not iterable %}
                  <strong>{{ key|replace({'_': ' '})|capitalize }}:</strong> {{ value }}<br>
                {% endif %}
              {% endfor %}
            {% else %}
              –
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}
