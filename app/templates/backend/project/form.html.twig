{% extends 'base_backend.html.twig' %}

{% block title %}{{ edit ? 'backend.projects.form.title_edit'|trans : 'backend.projects.form.title_new'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item">
    <a href="{{ path('backend_project_index') }}" class="text-decoration-none">{{ 'backend.projects.list.breadcrumb'|trans }}</a>
  </li>
  <li class="breadcrumb-item active">{{ edit ? project.name : 'backend.common.new'|trans }}</li>
{% endblock %}

{% block body %}
{% set wizardInitialStep = edit
  ? app.request.request.get('_wizard_step')|default(app.request.query.get('step')|default(1))
  : 1
%}
<div class="container-fluid px-0 backend-client-shell">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h2 class="mb-1">{{ edit ? 'backend.projects.form.h2_edit'|trans : 'backend.projects.form.h2_new'|trans }}</h2>
      {% if edit %}
        <div class="text-muted">{{ project.name }}</div>
      {% endif %}
    </div>
  </div>

  {% if edit %}
    <div class="alert alert-light border d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
      <div>
        <div class="small text-muted">{{ 'backend.projects.form.current_plan'|trans }}</div>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="fw-semibold">{{ 'backend.plan.tier.current'|trans }}:</span>
          <span class="badge bg-success-subtle text-success border border-success-subtle">{{ projectTierLabel }}</span>
        </div>
        {% if projectTierSummary is defined and projectTierSummary %}
          <div class="small text-muted mt-1">{{ projectTierSummary }}</div>
        {% endif %}
      </div>
      {% if projectTier is defined and projectTier != 'pro' %}
        <a href="{{ projectUpgradeUrl }}" class="btn btn-outline-primary">
          {{ 'backend.projects.form.upgrade_plan'|trans }}
        </a>
      {% else %}
        <span class="badge bg-success-subtle text-success border border-success-subtle">
          {{ 'backend.plan.upgrade.active_title'|trans }}
        </span>
      {% endif %}
    </div>
  {% endif %}

  {{ form_start(form, {
    attr: {
        'data-controller': 'project project-wizard',
        'data-project-target': 'form',
        'data-action': 'submit->project-wizard#submit',
        'data-project-index-value': form.phaseDates|length,
        'data-project-wizard-overview-label-value': 'backend.projects.form.wizard.overview_label'|trans,
        'data-project-wizard-project-label-value': 'backend.projects.form.wizard.project_label'|trans,
        'data-project-wizard-general-label-value': 'backend.projects.form.wizard.general_label'|trans,
        'data-project-wizard-dates-label-value': 'backend.projects.form.wizard.dates_label'|trans,
        'data-project-wizard-funding-label-value': 'backend.projects.form.wizard.funding_label'|trans,
        'data-project-wizard-companies-label-value': 'backend.projects.form.wizard.companies_label'|trans,
        'data-project-wizard-funding-sources-label-value': 'backend.projects.form.wizard.funding_sources_label'|trans,
        'data-project-wizard-eco-manager-label-value': 'backend.projects.form.eco_manager_status.label'|trans,
        'data-project-wizard-summary-empty-label-value': 'backend.projects.form.wizard.summary_empty'|trans,
        'data-project-wizard-no-companies-label-value': 'backend.projects.form.wizard.no_companies'|trans,
        'data-project-wizard-no-funding-label-value': 'backend.projects.form.wizard.no_funding'|trans,
        'data-project-wizard-edit-mode-value': edit ? 'true' : 'false',
        'data-project-wizard-initial-step-value': wizardInitialStep,

        'data-project-label-pre-event-value': 'backend.projects.phases.pre_event'|trans,
        'data-project-label-pre-filming-value': 'backend.projects.phases.pre_filming'|trans,
        'data-project-label-post-event-value': 'backend.projects.phases.post_event'|trans,
        'data-project-label-post-filming-value': 'backend.projects.phases.post_filming'|trans,
        'data-project-label-activity-event-value': 'backend.projects.phases.activity'|trans,
        'data-project-label-activity-filming-value': 'backend.aux.project_type.filming'|trans,

        'data-project-log-prototype-missing-value': 'backend.projects.form.log_prototype_missing'|trans,
        'data-project-log-cannot-insert-value': 'backend.projects.form.log_cannot_insert'|trans
    }
  }) }}
    <input type="hidden"
           name="_wizard_step"
           value="{{ wizardInitialStep }}"
           data-project-wizard-target="currentStepInput">

    {% if form.vars.errors|length %}
      <div class="alert alert-danger mb-4">
        {% for error in form.vars.errors %}
          {% set errorStep = 1 %}
          {% if error.messageTemplate == 'backend.projects.form.validation.funding_total_invalid' %}
            {% set errorStep = 4 %}
          {% elseif error.messageTemplate starts with 'backend.project.validation.' %}
            {% set errorStep = 3 %}
          {% endif %}
          <div class="small" data-project-wizard-error-step="{{ errorStep }}">
            {{ error.messageTemplate|trans(error.messageParameters, 'validators') }}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <nav class="mb-4" aria-label="{{ 'backend.projects.form.wizard.stepper_label'|trans }}">
      <div class="d-flex flex-wrap gap-2 justify-content-center" data-project-wizard-target="stepBar">
        {% set stepLabels = [
          'backend.projects.form.wizard.step_1'|trans,
          'backend.projects.form.wizard.step_2'|trans,
          'backend.projects.form.wizard.step_3'|trans,
          'backend.projects.form.wizard.step_4'|trans,
          'backend.projects.form.wizard.step_5'|trans,
        ] %}
        {% for stepLabel in stepLabels %}
          {% set stepNumber = loop.index %}
          <button type="button"
                  class="btn btn-light border rounded-pill d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold wizard-step-button"
                  data-project-wizard-target="stepButton"
                  data-step="{{ stepNumber }}"
                  aria-controls="project-step-{{ stepNumber }}">
            <span class="fw-bold flex-shrink-0"
                  data-project-wizard-step-indicator>{{ stepNumber }}</span>
            <span class="text-start">{{ stepLabel }}</span>
          </button>
        {% endfor %}
      </div>
    </nav>

    <div class="mb-4">
        <section id="project-step-1" class="wizard-step-panel" data-project-wizard-target="panel" data-step="1" tabindex="-1">
          <div class="mb-3">
            <h3 class="h4 mb-0 d-flex align-items-center gap-2">
              <span class="badge text-bg-success">1</span>
              <span>{{ 'backend.projects.form.wizard.step_1'|trans }}</span>
            </h3>
          </div>

          {% if form.commercialTier is defined %}
            <div class="d-none">
              {{ form_widget(form.commercialTier) }}
            </div>
          {% endif %}

        <div class="border rounded-4 p-3 p-lg-4 mb-4 bg-white">
          <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
            <div>
              <h4 class="h5 mb-1">{{ 'backend.projects.form.subsection_basic'|trans }}</h4>
              <div class="small text-muted">{{ 'backend.projects.form.subsection_basic_help'|trans }}</div>
            </div>
          </div>
          {% set showEmissionSource = form.emissionSourceName is defined %}
          <div class="row g-3">
            <div class="col-12">
              {{ form_label(form.name) }}
              {{ form_widget(form.name) }}
            </div>
            <div class="col-12 {{ showEmissionSource ? 'col-md-4' : 'col-md-6' }}">
              {{ form_label(form.country) }}
              {{ form_widget(form.country) }}
              {{ form_errors(form.country) }}
            </div>
            <div class="col-12 {{ showEmissionSource ? 'col-md-4' : 'col-md-6' }}">
              {{ form_label(form.type) }}
              {{ form_widget(form.type) }}
              {{ form_errors(form.type) }}
            </div>
            {% if showEmissionSource %}
              <div class="col-12 col-md-4">
                {{ form_label(form.emissionSourceName) }}
                {{ form_widget(form.emissionSourceName) }}
              </div>
            {% endif %}
          </div>
        </div>

        <div class="border rounded-4 p-3 p-lg-4 mb-4 bg-white" data-show-when="type:rodaje">
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <div>
              <h4 class="h5 mb-1">{{ 'backend.projects.form.subsection_filming'|trans }}</h4>
              <div class="small text-muted">{{ 'backend.projects.form.subsection_filming_help'|trans }}</div>
            </div>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-4">
              {{ form_label(form.filmingType) }}
              {{ form_widget(form.filmingType) }}
            </div>
            <div class="col-12 col-md-4" data-project-target="filmingGenreRow" data-show-when="filmingType:feature,filmingType:short,filmingType:tv_series,filmingType:tv_program">
              {{ form_label(form.filmingGenre) }}
              {{ form_widget(form.filmingGenre) }}
            </div>
            <div class="col-12 col-md-4" data-show-when="filmingType:tv_series,filmingType:tv_program">
              {{ form_label(form.episodios) }}
              {{ form_widget(form.episodios) }}
            </div>
            <div class="col-12 col-md-4" data-show-when="filmingType:tv_series,filmingType:tv_program">
              {{ form_label(form.duracionEpisodio) }}
              {{ form_widget(form.duracionEpisodio) }}
            </div>
          </div>
          <div class="mt-4">
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
              <div>
                <h5 class="h6 mb-1">{{ 'backend.projects.form.distribution_media.title'|trans }}</h5>
                <div class="small text-muted">{{ 'backend.projects.form.distribution_media.help'|trans }}</div>
              </div>
            </div>
            <div class="form-label-over">
              {{ form_label(form.distributionMedia) }}
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-2">
              {% for mediaChoice in form.distributionMedia %}
                <div class="col">
                  <div class="form-check">
                    {{ form_widget(mediaChoice, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(mediaChoice, null, {'label_attr': {'class': 'form-check-label'}}) }}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="border rounded-4 p-3 p-lg-4 mb-4 bg-white" data-show-when="type:evento">
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <div>
              <h4 class="h5 mb-1">{{ 'backend.projects.form.subsection_event'|trans }}</h4>
              <div class="small text-muted">{{ 'backend.projects.form.subsection_event_help'|trans }}</div>
            </div>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              {{ form_label(form.eventTypePrimary) }}
              {{ form_widget(form.eventTypePrimary) }}
            </div>
            <div class="col-12 col-md-6">
              {{ form_label(form.eventModality) }}
              {{ form_widget(form.eventModality) }}
            </div>
          </div>
        </div>

        </section>

        <section id="project-step-2" class="wizard-step-panel d-none" data-project-wizard-target="panel" data-step="2" tabindex="-1">
          <div class="mb-3">
            <h3 class="h4 mb-0 d-flex align-items-center gap-2">
              <span class="badge text-bg-success">2</span>
              <span>{{ 'backend.projects.form.wizard.step_2'|trans }}</span>
            </h3>
          </div>

        <div class="pt-3">
            <div class="row">
                <div class="col-12 col-md-6 form-label-over mb-3">
                    {{ form_label(form.mainLocation) }}
                    {{ form_widget(form.mainLocation) }}
                </div>
                <div class="col-12 col-md-6 form-label-over mb-3">
                    {{ form_label(form.presupuesto) }}
                    {{ form_widget(form.presupuesto) }}
                </div>
            </div>
        </div>

        {% set companyPrototype %}
            <div class="card mb-2 p-2 p-lg-3 border" data-collection-id="__company__">
                <div class="row g-2 align-items-lg-start">
                    <div class="col-12 col-md-4 col-lg-3">
                        {{ form_row(form.projectCompanies.vars.prototype.type, { row_attr: { class: 'mb-0' } }) }}
                    </div>
                    <div class="col-12 col-md-8 col-lg-4">
                        {{ form_row(form.projectCompanies.vars.prototype.name, { row_attr: { class: 'mb-0' } }) }}
                    </div>
                    <div class="col-12 col-md-10 col-lg-4">
                        {{ form_row(form.projectCompanies.vars.prototype.logoFile, { row_attr: { class: 'mb-0' } }) }}
                    </div>
                    <div class="col-12 col-md-2 col-lg-1 d-flex justify-content-end align-self-lg-center">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                data-action="project-collection#removeItem"
                                aria-label="{{ 'backend.common.delete'|trans }}"
                                title="{{ 'backend.common.delete'|trans }}">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        {% endset %}

        <div class="border-top pt-3 mt-4"
             data-controller="project-collection"
             data-project-collection-kind-value="company"
             data-project-collection-index-value="{{ form.projectCompanies|length }}"
             data-project-collection-prototype-value="{{ companyPrototype|e('html_attr') }}">
            <h6 class="text-muted mb-3">{{ 'backend.projects.form.wizard.companies_label'|trans }}</h6>
            <div data-project-collection-target="list">
                {% for companyForm in form.projectCompanies %}
                    <div class="card mb-2 p-2 p-lg-3 border" data-collection-id="{{ loop.index0 }}">
                        <div class="row g-2 align-items-lg-start">
                            <div class="col-12 col-md-4 col-lg-3">
                                {{ form_row(companyForm.type, { row_attr: { class: 'mb-0' } }) }}
                            </div>
                            <div class="col-12 col-md-8 col-lg-4">
                                {{ form_row(companyForm.name, { row_attr: { class: 'mb-0' } }) }}
                            </div>
                            <div class="col-12 col-md-10 col-lg-4">
                                {{ form_label(companyForm.logoFile) }}
                                <div class="d-flex align-items-start gap-2">
                                    {% if companyForm.vars.data.hasLogo %}
                                        {% set logoRemovalPending = companyForm.removeLogo.vars.data %}
                                        <div class="d-flex flex-column align-items-center flex-shrink-0">
                                            <div data-logo-preview{% if logoRemovalPending %} class="opacity-50"{% endif %}>
                                                <img src="{{ asset(companyForm.vars.data.logoUrl) }}"
                                                     alt="{{ 'backend.projects.form.project_company.current_logo_alt'|trans({ '%company%': companyForm.vars.data.name }) }}"
                                                     class="rounded-circle border object-fit-contain bg-white"
                                                     width="48" height="48">
                                            </div>
                                            <button type="button"
                                                    class="btn btn-link btn-sm {{ logoRemovalPending ? 'text-secondary' : 'text-danger' }} text-decoration-none p-0 mt-1"
                                                    data-action="project-collection#toggleLogoRemoval"
                                                    data-logo-remove-button
                                                    data-remove-label="{{ 'backend.projects.form.project_company.remove_logo'|trans }}"
                                                    data-undo-label="{{ 'backend.projects.form.project_company.undo_remove_logo'|trans }}"
                                                    aria-pressed="{{ logoRemovalPending ? 'true' : 'false' }}">
                                                {{ (logoRemovalPending
                                                    ? 'backend.projects.form.project_company.undo_remove_logo'
                                                    : 'backend.projects.form.project_company.remove_logo')|trans }}
                                            </button>
                                        </div>
                                    {% endif %}
                                    <div class="flex-grow-1">
                                        {{ form_widget(companyForm.logoFile) }}
                                        {{ form_help(companyForm.logoFile) }}
                                        {{ form_errors(companyForm.logoFile) }}
                                        {% if companyForm.vars.data.hasLogo %}
                                            <div class="d-none">
                                                {{ form_row(companyForm.removeLogo, {
                                                    label: false,
                                                    attr: {
                                                        'data-logo-remove-field': '1',
                                                        tabindex: '-1'
                                                    }
                                                }) }}
                                            </div>
                                        {% else %}
                                            <div class="d-none">{{ form_widget(companyForm.removeLogo) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-2 col-lg-1 d-flex justify-content-end align-self-lg-center">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-action="project-collection#removeItem"
                                        aria-label="{{ 'backend.common.delete'|trans }}"
                                        title="{{ 'backend.common.delete'|trans }}">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="d-flex justify-content-start">
                <button type="button" class="btn btn-outline-secondary mb-2" data-project-collection-target="addButton" data-action="project-collection#addItem">
                    <i class="bi bi-plus-circle"></i> {{ 'backend.common.add'|trans }}
                </button>
            </div>
        </div>

        </section>

        <section id="project-step-3" class="wizard-step-panel d-none" data-project-wizard-target="panel" data-step="3" tabindex="-1">
          <div class="mb-3">
            <h3 class="h4 mb-0 d-flex align-items-center gap-2">
              <span class="badge text-bg-success">3</span>
              <span>{{ 'backend.projects.form.wizard.step_3'|trans }}</span>
            </h3>
          </div>

        {# ========= FECHAS POR FASE ========= #}
        <fieldset class="border rounded p-3 mb-4">
          <legend class="float-none w-auto px-2 fw-semibold">{{ 'backend.projects.form.fs_phases'|trans }}</legend>

          <div data-project-target="list">
            {% for phaseForm in form.phaseDates %}
              <div class="card mb-3 p-3 border position-relative phase-entry-wrapper bg_green_1" data-collection-id="{{ loop.index }}">
                <div class="row">
                  <div class="col-12 col-md-4 form-label-over">
                    <label class="form-label">{{ 'backend.projects.form.phase'|trans }}</label>
                    <input type="text"
                           class="form-control text-start"
                           readonly
                           data-project-target="label"
                           data-phase="{{ phaseForm.phase.vars.value }}"
                           value="{% if phaseForm.phase.vars.value == 'actividad' %}{{ (form.type.vars.value == 'rodaje' ? 'backend.aux.project_type.filming' : 'backend.projects.phases.activity')|trans }}{% elseif phaseForm.phase.vars.value == 'preproduccion' %}{{ 'backend.projects.phases.pre'|trans }}{% elseif phaseForm.phase.vars.value == 'postproduccion' %}{{ 'backend.projects.phases.post'|trans }}{% endif %}">
                    {{ form_widget(phaseForm.phase) }}
                  </div>
                  <div class="col-12 col-md-4 form-label-over">
                    {{ form_row(phaseForm.startDate) }}
                  </div>
                  <div class="col-12 col-md-4 form-label-over">
                    {{ form_row(phaseForm.endDate) }}
                  </div>
                </div>

                {% if phaseForm.phase.vars.value == 'postproduccion' %}
                  {% set phaseId = phaseForm.vars.data.id %}
                  {% if lockedPhases is defined and not lockedPhases[phaseId] %}
                    <div class="text-end mt-0">
                      <button type="button" class="btn btn-sm btn-primary w-auto" data-action="project#removeItem">
                        <i class="bi bi-trash"></i> {{ 'backend.projects.form.remove_phase'|trans }}
                      </button>
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <div class="d-flex justify-content-start" data-project-target="addButton">
            <button type="button" class="btn btn-outline-secondary mb-2" data-action="project#addPostproduccion">
              <i class="bi bi-plus-circle"></i> {{ 'backend.projects.form.add_post_phase'|trans }}
            </button>
          </div>
        </fieldset>
        {# ========= /FECHAS POR FASE ========= #}

        <div class="border rounded-4 p-3 p-lg-4 mb-4 bg-white" data-show-when="type:evento">
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <div>
              <h4 class="h5 mb-1">{{ 'backend.projects.form.subsection_event_details'|trans }}</h4>
              <div class="small text-muted">{{ 'backend.projects.form.subsection_event_details_help'|trans }}</div>
            </div>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-6" data-show-when="eventModality:presencial,eventModality:hibrido">
              {{ form_label(form.eventAttendeesCount) }}
              {{ form_widget(form.eventAttendeesCount) }}
            </div>
            <div class="col-12 col-md-6" data-show-when="eventModality:virtual,eventModality:hibrido">
              {{ form_label(form.eventOnlineConnections) }}
              {{ form_widget(form.eventOnlineConnections) }}
            </div>
          </div>
        </div>

        </section>

        <section id="project-step-4" class="wizard-step-panel d-none" data-project-wizard-target="panel" data-step="4" tabindex="-1">
          <div class="mb-3">
            <h3 class="h4 mb-0 d-flex align-items-center gap-2">
              <span class="badge text-bg-success">4</span>
              <span>{{ 'backend.projects.form.wizard.step_4'|trans }}</span>
            </h3>
          </div>

        {% set fundingPrototype %}
            <div class="card mb-3 p-3 border position-relative" data-collection-id="__funding__">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-3">
                        {{ form_row(form.projectFundingSources.vars.prototype.type, { row_attr: { class: 'mb-0' } }) }}
                    </div>
                    <div class="col-12 col-md-4">
                        {{ form_row(form.projectFundingSources.vars.prototype.name, { row_attr: { class: 'mb-0' } }) }}
                    </div>
                    <div class="col-12 col-md-3">
                        {{ form_row(form.projectFundingSources.vars.prototype.percentage, { row_attr: { class: 'mb-0' } }) }}
                    </div>
                    <div class="col-12 col-md-2 d-flex">
                        <button type="button" class="btn btn-outline-danger w-100" data-action="project-collection#removeItem">
                            <i class="bi bi-trash"></i> {{ 'backend.common.delete'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        {% endset %}

        <div class="border-top pt-3 mt-4"
             data-controller="project-collection"
             data-project-collection-kind-value="funding"
             data-project-collection-index-value="{{ form.projectFundingSources|length }}"
             data-project-collection-prototype-value="{{ fundingPrototype|e('html_attr') }}">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <h6 class="text-muted mb-0">{{ 'backend.projects.form.wizard.funding_sources_label'|trans }}</h6>
                <div class="text-end">
                    <div class="small text-muted">{{ 'backend.projects.form.funding_total'|trans }}</div>
                    <div class="fw-semibold" data-project-collection-target="total">0.00%</div>
                    <div class="small" data-project-collection-target="feedback"
                         data-ok-label="{{ 'backend.projects.form.funding_complete'|trans }}"
                         data-missing-prefix="{{ 'backend.projects.form.funding_missing'|trans }}"
                         data-excess-prefix="{{ 'backend.projects.form.funding_excess'|trans }}"
                         data-invalid-label="{{ 'backend.projects.form.validation.percentage_invalid'|trans }}">
                    </div>
                </div>
            </div>
            <div data-project-collection-target="list">
                {% for fundingForm in form.projectFundingSources %}
                    <div class="card mb-3 p-3 border position-relative" data-collection-id="{{ loop.index0 }}">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-3">
                                {{ form_row(fundingForm.type, { row_attr: { class: 'mb-0' } }) }}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_row(fundingForm.name, { row_attr: { class: 'mb-0' } }) }}
                            </div>
                            <div class="col-12 col-md-3">
                                {{ form_row(fundingForm.percentage, { row_attr: { class: 'mb-0' } }) }}
                            </div>
                            <div class="col-12 col-md-2 d-flex">
                                <button type="button" class="btn btn-outline-danger w-100" data-action="project-collection#removeItem">
                                    <i class="bi bi-trash"></i> {{ 'backend.common.delete'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="d-flex justify-content-start">
                <button type="button" class="btn btn-outline-secondary mb-2" data-project-collection-target="addButton" data-action="project-collection#addItem">
                    <i class="bi bi-plus-circle"></i> {{ 'backend.common.add'|trans }}
                </button>
            </div>
        </div>

        <div class="pt-3">
            <div class="row">
                <div class="col-12 col-lg-10">
                    {{ form_widget(form.ecoManagerStatus) }}
                </div>
            </div>
        </div>

        </section>

        <section id="project-step-5" class="wizard-step-panel d-none" data-project-wizard-target="panel" data-step="5" tabindex="-1">
          <div class="mb-3">
            <h3 class="h4 mb-0 d-flex align-items-center gap-2">
              <span class="badge text-bg-success">5</span>
              <span>{{ 'backend.projects.form.wizard.step_5'|trans }}</span>
            </h3>
          </div>
          <div class="alert alert-success mb-3">
            {{ edit ? 'backend.projects.form.wizard.final_notice_update'|trans : 'backend.projects.form.wizard.final_notice_create'|trans }}
          </div>
          <div data-project-wizard-target="summary"></div>
        </section>
    </div>

        {# ========= EQUIPO TÉCNICO (SOLO VISTA) ========= #}
        {% set crew = project.crewMembers ?? [] %}
        {% if edit and crew is not empty %}
        <fieldset class="border rounded p-3 mb-4">
            <legend class="float-none w-auto px-2 fw-semibold">{{ 'backend.projects.form.fs_crew'|trans }}</legend>

            <div class="table-responsive">
            <table class="table align-middle table-hover green_table_1">
                <thead>
                <tr>
                    <th>{{ 'backend.projects.form.crew.name'|trans }}</th>
                    <th>{{ 'backend.projects.form.crew.role'|trans }}</th>
                    <th>{{ 'backend.projects.form.crew.contact'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for c in crew %}
                <tr>
                    <td>
                    {% if c.name is defined and c.name %}
                        {{ c.name }}
                        {% if c.surnames is defined and c.surnames %} {{ c.surnames }}{% endif %}
                    {% else %}
                        {{ c.email ?? '—' }}
                    {% endif %}
                    </td>
                    <td>
                    {% if c.role is defined and c.role %}
                        {{ c.role }}
                    {% elseif c.department is defined and c.department %}
                        {{ c.department }}
                    {% elseif c.position is defined and c.position %}
                        {{ c.position }}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                    </td>
                    <td>
                    {% set hasEmail = c.email is defined and c.email %}
                    {% set hasPhone = c.phone is defined and c.phone %}
                    {% if hasEmail or hasPhone %}
                        {% if hasEmail %}<div>{{ c.email }}</div>{% endif %}
                        {% if hasPhone %}<div class="small text-muted">{{ c.phone }}</div>{% endif %}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>

            <a href="{{ path('backend_project_edit_crew', { id: project.id }) }}" class="btn btn-outline-primary">
                {{ 'backend.common.edit'|trans }}
            </a>
        </fieldset>
        {% endif %}
        {% if edit and crew is empty %}
        <fieldset class="border rounded p-3 mb-4">
            <legend class="float-none w-auto px-2 fw-semibold">{{ 'backend.projects.form.fs_crew'|trans }}</legend>
            <div class="mb-3">
                <em class="text-muted">{{ 'backend.projects.form.crew.no_crew'|trans }}</em>
            </div>
            <a href="{{ path('backend_project_edit_crew', { id: project.id }) }}" class="btn btn-outline-primary">
                {{ 'backend.projects.form.crew_btn'|trans }}
            </a>
        </fieldset>
        {% endif %}
        {# ========= /EQUIPO TÉCNICO ========= #}

        {# ========= MIEMBROS DEL PROYECTO (SOLO VISTA) ========= #}
        {% set memberships = project.projectMemberships ?? [] %}
        {% if edit and memberships is not empty %}
          <fieldset class="border rounded p-3 mb-4">
            <legend class="float-none w-auto px-2 fw-semibold">{{ 'backend.projects.form.fs_members'|trans }}</legend>

            <div class="table-responsive">
              <table class="table align-middle table-hover green_table_1">
                <thead>
                  <tr>
                    <th>{{ 'backend.projects.members.user'|trans }}</th>
                    <th class="text-center">{{ 'backend.projects.members.creator'|trans }}</th>
                  </tr>
                </thead>
                <tbody>
                {% for m in memberships %}
                  {% set member = m.user %}
                  {% set isCreator = project.user and member and member.id == project.user.id %}
                  <tr>
                    <td>
                      {% if member %}
                        {{ member.name ? member.name ~ ' ' ~ member.surnames : member.email }}
                        <div class="small text-muted">{{ member.email }}</div>
                      {% else %}
                        <span class="text-muted">—</span>
                      {% endif %}
                    </td>
                    <td class="text-center" data-order="{{ isCreator ? 1 : 0 }}">
                      {% if isCreator %}
                        <i class="bi bi-check-lg text-success" title="{{ 'backend.projects.members.creator'|trans }}"></i>
                      {% else %}
                        <span class="text-muted">—</span>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
                </tbody>
              </table>
            </div>
          </fieldset>
        {% endif %}
        {# ========= /MIEMBROS DEL PROYECTO ========= #}

        {# ========= BOTONES ========= #}
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
          <div class="ms-auto d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary" data-project-wizard-target="previousButton">
              {{ 'backend.projects.form.wizard.previous'|trans }}
            </button>
            <button type="button" class="btn btn-primary" data-project-wizard-target="nextButton">
              {{ 'backend.projects.form.wizard.next'|trans }}
            </button>
            <button type="submit"
                    class="btn btn-primary d-none"
                    data-project-wizard-target="submitButton"
                    {% if edit %}formnovalidate{% endif %}>
              <i class="bi bi-save"></i> {{ edit ? 'backend.projects.form.wizard.save_changes'|trans : 'backend.projects.form.wizard.create_project'|trans }}
            </button>
          </div>
        </div>

    {% if form.phaseDates.vars.prototype is defined %}
    <div id="phase-prototype"
         data-project-prototype="{{ include('backend/project/_phase_prototype.html.twig', { prototype: form.phaseDates.vars.prototype })|e('html_attr') }}"
         hidden></div>
    {% endif %}
  {{ form_end(form) }}
</div>
{% endblock %}
