{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.projects.post_create.title'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item">
    <a href="{{ path('backend_project_index') }}" class="text-decoration-none">{{ 'backend.projects.list.breadcrumb'|trans }}</a>
  </li>
  <li class="breadcrumb-item active">{{ 'backend.projects.post_create.title'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-client-shell">
  <div class="backend-client-content">
    <div class="mb-4">
      <h2 class="mb-1">{{ 'backend.projects.post_create.title'|trans }}</h2>
      <div class="text-muted">{{ project.name }}</div>
    </div>

    <div class="alert alert-light border mb-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
          <div class="small text-muted">{{ 'backend.projects.post_create.plan_context'|trans }}</div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle">{{ projectTierLabel }}</span>
          </div>
          <div class="small text-muted mt-2">{{ 'backend.projects.post_create.description'|trans }}</div>
        </div>
        <a href="{{ projectUpgradeUrl }}" class="btn btn-outline-primary">
          {{ 'backend.projects.post_create.upgrade_plan'|trans }}
        </a>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <div class="row g-4 align-items-start">
          <div class="col-12 col-lg-8">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
              <span class="badge bg-success-subtle text-success border border-success-subtle">{{ projectTierLabel }}</span>
              <span class="text-muted">{{ 'backend.projects.post_create.description'|trans }}</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <a href="{{ projectUpgradeUrl }}" class="btn btn-primary">
                {{ 'backend.projects.post_create.upgrade_plan'|trans }}
              </a>
              <a href="{{ continueUrl }}" class="btn btn-outline-secondary">
                {{ 'backend.projects.post_create.continue_basic'|trans }}
              </a>
            </div>
          </div>
          <div class="col-12 col-lg-4">
            <div class="border rounded-4 p-3 bg-light h-100">
              <div class="small text-muted">{{ 'backend.projects.post_create.plan_context'|trans }}</div>
              <div class="h4 mb-2">{{ projectTierLabel }}</div>
              {% if projectTierSummary is defined and projectTierSummary %}
                <div class="text-muted">{{ projectTierSummary }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
