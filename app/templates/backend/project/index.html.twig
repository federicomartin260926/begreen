{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.projects.list.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.projects.list.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
{% set totalProjects = dashboardSummary.totalProjects|default(0) %}
{% set completedProjects = dashboardSummary.plans.completo|default(0) %}
{% set inProgressProjects = dashboardSummary.plans.incompleto|default(0) %}
{% set notStartedProjects = dashboardSummary.plans.sin_plan|default(0) %}
{% set phaseDonePct = totalProjects > 0 ? ((completedProjects * 100) / totalProjects)|round(0) : 0 %}
{% set donutBase = 280 %}
{% set donutCompleted = totalProjects > 0 ? (completedProjects / totalProjects * donutBase)|round(0) : 0 %}
{% set donutInProgress = totalProjects > 0 ? (inProgressProjects / totalProjects * donutBase)|round(0) : 0 %}
{% set donutPending = donutBase - donutCompleted - donutInProgress %}
{% set chartProjects = dashboardTopEmissionProjects|default([]) %}
{% set chartBarsMax = 1 %}
{% for project in chartProjects %}
    {% set chartBarsMax = max(chartBarsMax, project.emissionSum|default(0)) %}
{% endfor %}

{% set dashboardCharts %}
    <div class="backend-chart-strip mt-3">
        <div class="card dashboard-panel border-0 shadow-sm backend-chart-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div class="backend-chart-title">Fases completadas</div>
                    <span class="badge bg-light text-dark border">{{ phaseDonePct }}%</span>
                </div>

                <div class="backend-donut-wrap">
                    <div class="backend-donut" style="--completed: {{ donutCompleted }}; --in-progress: {{ donutInProgress }}; --pending: {{ donutPending }};">
                        <div class="backend-donut__center">
                            <div class="backend-donut__value">{{ phaseDonePct }}%</div>
                            <div class="backend-donut__label">completadas</div>
                        </div>
                    </div>

                    <div class="backend-donut-legend">
                        <div class="backend-donut-legend__item">
                            <span class="backend-dot bg-success"></span>
                            <span>Completada</span>
                            <strong>{{ completedProjects }}</strong>
                        </div>
                        <div class="backend-donut-legend__item">
                            <span class="backend-dot bg-warning"></span>
                            <span>En curso</span>
                            <strong>{{ inProgressProjects }}</strong>
                        </div>
                        <div class="backend-donut-legend__item">
                            <span class="backend-dot bg-light border"></span>
                            <span>Sin iniciar</span>
                            <strong>{{ notStartedProjects }}</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card dashboard-panel border-0 shadow-sm backend-chart-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div class="backend-chart-title">CO₂ por proyecto</div>
                    <span class="badge bg-light text-dark border">kgCO₂e</span>
                </div>

                {% if chartProjects is empty %}
                    <div class="backend-chart-empty-state">
                        <div class="backend-chart-empty-state__message">Todavía no hay emisiones registradas.</div>
                        <div class="backend-chart-empty-state__hint mt-2">
                            Cuando existan datos, aquí verás hasta 8 proyectos con emisiones.
                        </div>
                    </div>
                {% else %}
                    <div class="backend-chart-co2-wrap">
                        <svg viewBox="0 0 360 180" class="backend-chart-svg" role="img" aria-label="CO2 por proyecto">
                            <line x1="36" y1="18" x2="36" y2="148" class="backend-chart-axis"></line>
                            <line x1="36" y1="148" x2="342" y2="148" class="backend-chart-axis"></line>

                            {% set barGap = 14 %}
                            {% set barWidth = (240 / chartProjects|length)|round(0) %}
                            {% set cursor = 58 %}
                            {% for project in chartProjects %}
                                {% set barHeight = chartBarsMax > 0 ? ((project.emissionSum|default(0) / chartBarsMax) * 92)|round(0) : 0 %}
                                <g>
                                    <title>{{ project.name }} · {{ project.emissionSum|number_format(1, ',', '.') }} kgCO₂e</title>
                                    <rect x="{{ cursor }}" y="{{ 148 - barHeight }}" width="{{ barWidth }}" height="{{ barHeight }}" rx="4"
                                          class="{% if loop.index is even %}backend-bar backend-bar--soft{% else %}backend-bar{% endif %}"></rect>
                                    <text x="{{ (cursor + (barWidth / 2))|round(0) }}" y="164" text-anchor="middle" class="backend-chart-xlabel">
                                        {{ project.name|length > 9 ? project.name|slice(0, 9) ~ '…' : project.name }}
                                    </text>
                                    <text x="{{ (cursor + (barWidth / 2))|round(0) }}" y="{{ 138 - barHeight }}" text-anchor="middle" class="backend-chart-bar-value">
                                        {{ project.emissionSum|number_format(1, ',', '.') }}
                                    </text>
                                </g>
                                {% set cursor = cursor + barWidth + barGap %}
                            {% endfor %}
                        </svg>
                        {% if dashboardEmissionChartHasMore|default(false) %}
                            <div class="backend-chart-co2-note mt-2">
                                Mostrando los últimos 8 proyectos con emisiones registradas.
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endset %}

<div class="backend-project-dashboard container-fluid px-0">
    <div class="backend-dashboard-shell">
        <div class="backend-dashboard-hero mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <h1 class="h3 mb-0">{{ 'backend.projects.list.h2'|trans }}</h1>
                <a href="{{ path('backend_project_new') }}" class="btn btn-success text-decoration-none">
                    <i class="bi bi-plus-lg me-1"></i>{{ 'backend.projects.actions.new'|trans }}
                </a>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-end gap-3 mb-3 backend-project-toolbar">
            <form method="get" class="d-flex flex-column align-items-start gap-1 backend-project-sort-form" data-controller="project-list" data-project-list-target="form">
                {% for key, value in filters %}
                    {% if key != 'sort' and value is not empty %}
                        <input type="hidden" name="{{ key }}" value="{{ value }}">
                    {% endif %}
                {% endfor %}
                <label for="projects-sort" class="mb-0">{{ 'backend.projects.dashboard.sort.label'|trans }}</label>
                <select id="projects-sort" name="sort" class="form-select border-success backend-project-sort">
                    <option value="date_desc" {{ filters.sort == 'date_desc' ? 'selected' : '' }}>{{ 'backend.projects.dashboard.sort.date_desc'|trans }}</option>
                    <option value="date_asc" {{ filters.sort == 'date_asc' ? 'selected' : '' }}>{{ 'backend.projects.dashboard.sort.date_asc'|trans }}</option>
                    <option value="name_asc" {{ filters.sort == 'name_asc' ? 'selected' : '' }}>{{ 'backend.projects.dashboard.sort.name_asc'|trans }}</option>
                    <option value="name_desc" {{ filters.sort == 'name_desc' ? 'selected' : '' }}>{{ 'backend.projects.dashboard.sort.name_desc'|trans }}</option>
                </select>
            </form>
            <button type="button"
                    class="btn {{ dashboardSummary.hasActiveFilters ? 'btn-success' : 'btn-outline-success' }} backend-filters-toggle"
                    data-bs-toggle="collapse"
                    data-bs-target="#projectsFilters"
                    aria-expanded="{{ dashboardSummary.hasActiveFilters ? 'true' : 'false' }}"
                    aria-controls="projectsFilters">
                <i class="bi bi-funnel me-1"></i>{{ 'backend.projects.dashboard.filters'|trans }}
                {% if dashboardSummary.activeFilters > 0 %}
                    <span class="badge bg-success ms-2">{{ dashboardSummary.activeFilters }}</span>
                {% endif %}
            </button>
        </div>

        <div class="collapse {% if dashboardSummary.hasActiveFilters %}show{% endif %}" id="projectsFilters">
            <div class="card dashboard-panel shadow-sm mb-3 backend-project-filters-panel">
                <div class="card-body p-3 p-lg-4">
                    <h2 class="h6 d-flex align-items-center gap-2 mb-3 backend-project-filters-title">
                        <i class="bi bi-funnel" aria-hidden="true"></i>
                        {{ 'backend.projects.dashboard.filters'|trans }}
                    </h2>
                    <form method="get" id="projects-filters-form" class="w-100" data-controller="project-list" data-project-list-target="form">
                        <input type="hidden" name="sort" value="{{ filters.sort }}">
                        <div class="row g-3 backend-project-filters-grid">
                            <div class="col-12 col-md-6 col-xl">
                                <label for="f-name" class="form-label">{{ 'backend.projects.filters.name'|trans }}</label>
                                <input type="text" name="name" id="f-name" class="form-control" value="{{ filters.name|default('') }}" placeholder="{{ 'backend.projects.filters.name'|trans }}">
                            </div>
                            <div class="col-12 col-md-6 col-xl">
                                <label for="f-type" class="form-label">{{ 'backend.projects.table.type'|trans }}</label>
                                <select class="selectpicker" name="type" id="f-type" data-style="form-select border" data-width="100%" data-live-search="true" data-none-selected-text="{{ 'backend.projects.filters.all'|trans }}">
                                    <option value="">{{ 'backend.projects.filters.all'|trans }}</option>
                                    <option value="rodaje" {{ filters.type == 'rodaje' ? 'selected' : '' }}>{{ 'backend.aux.project_type.filming'|trans }}</option>
                                    <option value="evento" {{ filters.type == 'evento' ? 'selected' : '' }}>{{ 'backend.aux.project_type.event'|trans }}</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-xl">
                                <label for="f-country" class="form-label">{{ 'backend.projects.filters.country'|trans }}</label>
                                <input type="text" name="country" id="f-country" class="form-control" value="{{ filters.country|default('') }}" placeholder="{{ 'backend.projects.filters.country'|trans }}">
                            </div>
                            {% if is_admin %}
                                <div class="col-12 col-md-6 col-xl">
                                    <label for="f-owner" class="form-label">{{ 'backend.projects.filters.owner'|trans }}</label>
                                    <input type="text" name="owner" id="f-owner" class="form-control" value="{{ filters.owner|default('') }}" placeholder="{{ 'backend.projects.filters.owner'|trans }}">
                                </div>
                            {% endif %}
                            <div class="col-12 col-md-6 col-xl">
                                <label for="f-from" class="form-label">{{ 'backend.projects.filters.from'|trans }}</label>
                                <input type="date" name="date_from" id="f-from" class="form-control" value="{{ filters.date_from|default('') }}" title="{{ 'backend.projects.filters.from'|trans }}">
                            </div>
                            <div class="col-12 col-md-6 col-xl">
                                <label for="f-to" class="form-label">{{ 'backend.projects.filters.to'|trans }}</label>
                                <input type="date" name="date_to" id="f-to" class="form-control" value="{{ filters.date_to|default('') }}" title="{{ 'backend.projects.filters.to'|trans }}">
                            </div>
                            <div class="col-12 backend-project-filter-actions">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>{{ 'backend.projects.actions.search'|trans }}</button>
                                <a href="{{ path('backend_project_index', {sort: filters.sort}) }}" id="reset-filters" class="btn btn-outline-success" title="{{ 'backend.projects.filters.reset'|trans }}">
                                    <i class="bi bi-x-circle me-1"></i>{{ 'backend.projects.filters.reset'|trans }}
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {% if dashboardProjects is empty %}
            <div class="alert alert-light border">
                {{ 'backend.projects.dashboard.empty'|trans }}
                <a href="{{ path('backend_project_new') }}" class="alert-link text-decoration-none">{{ 'backend.projects.dashboard.create_first'|trans }}</a>.
            </div>
        {% else %}
            <div class="backend-project-pill-list">
                {% for project in dashboardProjects %}
                    <article class="card border shadow-sm backend-project-pill">
                        <div class="card-body">
                            <div class="backend-project-pill__layout">
                                <div class="backend-project-pill__summary">
                                    <div class="backend-project-pill__name">{{ project.name }}</div>
                                    <div class="backend-project-pill__type text-muted">
                                        {{ project.descriptionLabel }}
                                    </div>
                                    <div class="backend-project-pill__people">
                                        {% if project.creator %}
                                            {% set creatorName = project.creator.name ?: project.creator.email %}
                                            {% set creatorInitials = '' %}
                                            {% for namePart in creatorName|trim|split(' ')|slice(0, 2) %}
                                                {% set creatorInitials = creatorInitials ~ namePart|slice(0, 1)|upper %}
                                            {% endfor %}
                                            <span class="backend-project-creator" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'backend.projects.dashboard.creator'|trans }}: {{ creatorName }}" aria-label="{{ 'backend.projects.dashboard.creator'|trans }}: {{ creatorName }}" tabindex="0">
                                                <span class="backend-project-creator__avatar" aria-hidden="true">{{ creatorInitials ?: '?' }}</span>
                                            </span>
                                        {% endif %}
                                        <div class="backend-project-companies" aria-label="{{ 'backend.projects.dashboard.companies'|trans }}">
                                        {% set visibleCompanies = project.companies|slice(0, 4) %}
                                        {% for company in visibleCompanies %}
                                            {% if company.logoUrl %}
                                                <span class="backend-company-logo" title="{{ company.name }}"><img src="{{ asset(company.logoUrl) }}" alt="{{ company.name }}"></span>
                                            {% else %}
                                                {% set initials = '' %}
                                                {% for namePart in company.name|trim|split(' ')|slice(0, 2) %}
                                                    {% set initials = initials ~ namePart|slice(0, 1)|upper %}
                                                {% endfor %}
                                                <span class="backend-company-logo backend-company-logo--fallback" title="{{ company.name }}" aria-label="{{ company.name }}">{{ initials ?: '?' }}</span>
                                            {% endif %}
                                        {% endfor %}
                                        {% if project.companies|length > visibleCompanies|length %}
                                            {% set hiddenCompanies = project.companies|length - visibleCompanies|length %}
                                            <span class="backend-company-logo backend-company-logo--more" title="{{ 'backend.projects.dashboard.more_companies'|trans({ '%count%': hiddenCompanies }) }}">+{{ hiddenCompanies }}</span>
                                        {% endif %}
                                        </div>
                                    </div>
                                </div>

                                <div class="backend-project-phases" role="list" aria-label="{{ 'backend.projects.dashboard.phases_label'|trans }}">
                                    {% for phase in project.phases %}
                                        {% if phase.primaryTarget %}
                                            <a href="{{ path('backend_project_select_project', {id: project.id, target: phase.primaryTarget}) }}"
                                               class="backend-project-phase backend-project-phase--{{ phase.state }} text-decoration-none"
                                               title="{{ phase.title }}" aria-label="{{ phase.title }}" role="listitem">
                                                <span class="backend-project-phase__icon" aria-hidden="true"><i class="bi {{ phase.icon }}"></i></span>
                                                <span class="backend-project-phase__name">{{ phase.label }}</span>
                                                <span class="backend-project-phase__state">{{ phase.stateLabel }}</span>
                                            </a>
                                        {% else %}
                                            <span class="backend-project-phase backend-project-phase--{{ phase.state }} backend-project-phase--unavailable"
                                                  title="{{ phase.title }}" aria-label="{{ phase.title }}" aria-disabled="true" role="listitem" tabindex="0">
                                                <span class="backend-project-phase__icon" aria-hidden="true"><i class="bi {{ phase.icon }}"></i></span>
                                                <span class="backend-project-phase__name">{{ phase.label }}</span>
                                                <span class="backend-project-phase__state">{{ phase.stateLabel }}</span>
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </div>

                                <div class="dropdown backend-project-pill__actions">
                                    <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'backend.projects.dashboard.actions'|trans }}">
                                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li><a class="dropdown-item text-decoration-none" href="{{ path('backend_project_edit', {id: project.id}) }}"><i class="bi bi-pencil-square me-2"></i>{{ 'backend.common.edit'|trans }}</a></li>
                                        <li><a class="dropdown-item text-decoration-none" href="{{ path('backend_project_edit_crew', {id: project.id}) }}"><i class="bi bi-people me-2"></i>{{ 'backend.projects.dashboard.crew'|trans }}</a></li>
                                        <li><a class="dropdown-item text-decoration-none" href="{{ path('backend_project_clone', {id: project.id}) }}"><i class="bi bi-files me-2"></i>{{ 'backend.projects.dashboard.duplicate'|trans }}</a></li>
                                        {% if project.plan.canDelete %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form action="{{ path('backend_plan_delete', {id: project.id}) }}"
                                                      method="post"
                                                      onsubmit="return confirm('{{ 'backend.plan.delete.confirm'|trans|e('js') }}');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_plan_' ~ project.plan.id) }}">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>{{ 'backend.plan.delete.btn'|trans }}
                                                    </button>
                                                </form>
                                            </li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}

        <div class="backend-status-legend small mt-3">
            <span><span class="backend-status-legend__dot backend-status-legend__dot--completed"></span>{{ 'backend.projects.dashboard.phases.common.completed'|trans }}</span>
            <span><span class="backend-status-legend__dot backend-status-legend__dot--in-progress"></span>{{ 'backend.projects.dashboard.phases.common.in_progress'|trans }}</span>
            <span><span class="backend-status-legend__dot backend-status-legend__dot--not-started"></span>{{ 'backend.projects.dashboard.phases.common.not_started'|trans }}</span>
        </div>

        {% if totalPages > 1 %}
            {% set q = app.request.query.all %}
            <nav class="mt-3" aria-label="{{ 'backend.projects.pagination'|trans }}">
                <ul class="pagination mb-0">
                    {% set prevPage = currentPage - 1 %}
                    <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('backend_project_index', q|merge({'page': prevPage < 1 ? 1 : prevPage})) }}" aria-disabled="{{ currentPage == 1 ? 'true' : 'false' }}">&laquo;</a>
                    </li>

                    {% set startPage = currentPage - 2 %}
                    {% set endPage = currentPage + 2 %}
                    {% if startPage < 1 %}
                        {% set endPage = endPage + (1 - startPage) %}
                        {% set startPage = 1 %}
                    {% endif %}
                    {% if endPage > totalPages %}
                        {% set startPage = startPage - (endPage - totalPages) %}
                        {% set endPage = totalPages %}
                    {% endif %}
                    {% if startPage < 1 %}
                        {% set startPage = 1 %}
                    {% endif %}

                    {% if startPage > 1 %}
                        <li class="page-item"><a class="page-link" href="{{ path('backend_project_index', q|merge({'page': 1})) }}">1</a></li>
                        {% if startPage > 2 %}
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        {% endif %}
                    {% endif %}

                    {% for p in startPage..endPage %}
                        <li class="page-item {{ p == currentPage ? 'active' : '' }}"><a class="page-link" href="{{ path('backend_project_index', q|merge({'page': p})) }}">{{ p }}</a></li>
                    {% endfor %}

                    {% if endPage < totalPages %}
                        {% if endPage < totalPages - 1 %}
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        {% endif %}
                        <li class="page-item"><a class="page-link" href="{{ path('backend_project_index', q|merge({'page': totalPages})) }}">{{ totalPages }}</a></li>
                    {% endif %}

                    {% set nextPage = currentPage + 1 %}
                    <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('backend_project_index', q|merge({'page': nextPage > totalPages ? totalPages : nextPage})) }}">&raquo;</a>
                    </li>
                </ul>
            </nav>
        {% endif %}

        {{ dashboardCharts }}
    </div>
</div>
{% endblock %}
