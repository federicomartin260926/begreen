{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.subscription.card.title'|trans }} · {{ phaseLabel }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item">
    <a href="{{ path('backend_project_index') }}" class="text-decoration-none">{{ 'backend.projects.list.breadcrumb'|trans }}</a>
  </li>
  <li class="breadcrumb-item active">{{ 'backend.subscription.card.title'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-client-shell">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
      <h1 class="h3 mb-1">{{ 'backend.subscription.card.title'|trans }}</h1>
      <div class="text-muted">{{ 'backend.billing.project.global_subtitle'|trans }}</div>
    </div>
    <a href="{{ backUrl }}" class="btn btn-outline-secondary">{{ 'backend.common.back'|trans }}</a>
  </div>

  <div class="small text-muted mb-2">{{ 'backend.billing.project.phase_tabs'|trans }}</div>
  <ul class="nav nav-tabs mb-4">
    <li class="nav-item">
      <a class="nav-link {% if phase.value == 'elaboration' %}active{% endif %}"
         href="{{ path('backend_project_billing', {phase: 'elaboration'}) }}">
        {{ 'backend.commercial_phases.elaboration'|trans }}
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if phase.value == 'implementation' %}active{% endif %}"
         href="{{ path('backend_project_billing', {phase: 'implementation'}) }}">
        {{ 'backend.commercial_phases.implementation'|trans }}
      </a>
    </li>
  </ul>

  {% set canSeeStripeAdminActions = app.user and ('ROLE_ADMIN' in app.user.roles or 'ROLE_SUPER_ADMIN' in app.user.roles) %}

  {% for billing in projectBillings %}
    {% set project = billing.project %}
    {% set subscription = billing.subscription %}
    {% set pendingCheckout = billing.pendingCheckout %}
    {% set upgradeCta = billing.upgradeCta %}
    {% set pendingUpgrade = billing.pendingUpgrade %}
    {% set billingUpgradeCta = upgradeCta %}
    {% if subscription and subscription.tier|lower != 'pro' and upgradeCta.options is not empty %}
      {% set billingUpgradeCta = upgradeCta|merge({
        mode: 'comparison',
        label: 'Mejorar plan',
        buttonLabel: 'Mejorar plan',
        comparisonFrom: 'billing'
      }) %}
    {% endif %}

    <article id="billing-project-{{ project.id }}" class="card shadow-sm mb-3">
      <div class="card-body p-3 p-lg-4">
        <div class="row g-4 align-items-start">
          <div class="col-12 col-lg-4">
            <h2 class="h5 mb-2">{{ project.name }}</h2>
            <div class="text-muted mb-1">
              {{ 'backend.billing.project.phase_plan'|trans({'%phase%': phaseLabel}) }}:
              <strong class="text-body">{{ subscription ? subscription.tier|upper : '—' }}</strong>
            </div>
            <div class="mb-3">
              <span class="text-muted">{{ 'backend.billing.project.payment_status'|trans }}:</span>
              <strong class="{% if subscription and subscription.status == 'active' %}text-success{% endif %}">
                {{ subscription ? ('backend.subscription.status.' ~ subscription.status)|trans : '—' }}
              </strong>
            </div>

            {% if subscription and subscription.tier|lower != 'pro' and billingUpgradeCta.mode != 'unavailable' and billingUpgradeCta.options is not empty %}
              {% include 'backend/plan/_upgrade_cta.html.twig' with {
                upgradeCta: billingUpgradeCta,
                project: project
              } %}
            {% elseif billing.showUpgradeCta and upgradeCta.mode in ['comparison', 'single'] %}
              {% include 'backend/plan/_upgrade_cta.html.twig' with {
                upgradeCta: upgradeCta|merge({
                  label: 'Actualizar plan',
                  buttonLabel: 'Actualizar plan',
                  comparisonFrom: 'billing'
                }),
                project: project
              } %}
            {% endif %}

            {% if pendingUpgrade %}
              <div class="alert alert-warning py-2 px-3 mt-3 mb-0">
                <div class="small fw-semibold">{{ 'backend.billing.project.upgrade_pending_title'|trans }}</div>
                <div class="small">{{ pendingUpgrade.label }}</div>
                {% if billing.canManageBilling %}
                  <div class="d-flex flex-wrap gap-2 mt-2">
                    {% if pendingCheckout.isReusable %}
                      <form method="post" action="{{ path('backend_project_subscription_checkout', {id: project.id, phase: phase.value, targetTier: pendingUpgrade.targetTier}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_checkout_' ~ project.id ~ '_' ~ phase.value ~ '_' ~ pendingUpgrade.targetTier) }}">
                        <button type="submit" class="btn btn-success btn-sm">{{ 'backend.subscription.actions.continue_payment'|trans }}</button>
                      </form>
                    {% elseif pendingCheckout.shouldRetry %}
                      <form method="post" action="{{ path('backend_project_subscription_checkout', {id: project.id, phase: phase.value, targetTier: pendingUpgrade.targetTier}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_checkout_' ~ project.id ~ '_' ~ phase.value ~ '_' ~ pendingUpgrade.targetTier) }}">
                        <button type="submit" class="btn btn-warning btn-sm">{{ 'backend.subscription.actions.retry_payment'|trans }}</button>
                      </form>
                    {% endif %}
                    <form method="post" action="{{ path('backend_project_subscription_confirm_pending', {id: project.id, phase: phase.value, from: 'billing'}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_confirm_pending_' ~ project.id ~ '_' ~ phase.value) }}">
                      <button type="submit" class="btn btn-outline-secondary btn-sm">{{ 'backend.subscription.actions.verify_payment'|trans }}</button>
                    </form>
                    <form method="post" action="{{ path('backend_project_subscription_cancel_pending', {id: project.id, phase: phase.value, targetTier: pendingUpgrade.targetTier}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_cancel_pending_' ~ project.id ~ '_' ~ phase.value ~ '_' ~ pendingUpgrade.targetTier) }}">
                      <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'backend.subscription.actions.cancel_payment_attempt'|trans }}</button>
                    </form>
                  </div>
                {% endif %}
              </div>
            {% elseif canSeeStripeAdminActions and billing.canVerifyPayment %}
              <form method="post" action="{{ path('backend_project_subscription_confirm_pending', {id: project.id, phase: phase.value, from: 'billing'}) }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_confirm_pending_' ~ project.id ~ '_' ~ phase.value) }}">
                <button type="submit" class="btn btn-outline-secondary btn-sm">{{ 'backend.subscription.actions.verify_payment'|trans }}</button>
              </form>
            {% endif %}
          </div>

          <div class="col-12 col-lg-8">
            <div class="small text-muted mb-2">
              {{ 'backend.billing.project.documents_count'|trans({'%count%': billing.billingDocuments|length}) }}
            </div>

            {% if billing.billingDocuments is empty %}
              <div class="alert alert-light border mb-0">{{ 'backend.billing.project.no_documents'|trans }}</div>
            {% else %}
              <div class="vstack gap-2">
                {% for item in billing.billingDocuments %}
                  {% set document = item.document %}
                  {% set hasLocalCopy = item.hasLocalCopy %}
                  {% set documentDate = document.paidAt ?: document.issuedAt %}
                  {% set documentReference = document.stripeInvoiceId ?: document.paymentReference ?: document.stripeCheckoutSessionId ?: document.stripePaymentIntentId %}
                  {% set paymentReference = subscription ? (subscription.paymentReference ?: subscription.stripePaymentIntentId ?: subscription.stripeCheckoutSessionId) : document.paymentReference %}
                  {% set paidAmountCents = document.amountCents is not null ? document.amountCents : (subscription ? subscription.paidAmountCents : null) %}
                  {% set paidCurrency = document.currency ?: (subscription ? subscription.currency : 'EUR') %}
                  {% set paidDate = document.paidAt ?: (subscription ? subscription.paidAt : null) %}
                  {% set lastPaymentStatus = subscription and subscription.lastPaymentStatus ? subscription.lastPaymentStatus : document.status %}
                  {% set documentPlan = document.subscription ? document.subscription.tier : (subscription ? subscription.tier : null) %}

                  <div class="border rounded-3 p-3">
                    <div class="row g-2 align-items-center">
                      <div class="col-6 col-md-2">
                        <span class="badge rounded-pill {% if document.status == 'paid' %}bg-success{% elseif document.status == 'void' %}bg-danger{% elseif document.status == 'open' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                          {{ ('backend.billing.document.status.' ~ (document.status ?: 'unknown'))|trans }}
                        </span>
                      </div>
                      <div class="col-6 col-md-2 small text-muted">
                        {{ documentDate ? documentDate|date('d/m/Y') : '—' }}
                      </div>
                      <div class="col-12 col-md-3">
                        <div class="small text-muted text-truncate" title="{{ documentReference ?: '—' }}">
                          {{ documentReference ?: '—' }}
                        </div>
                      </div>
                      <div class="col-6 col-md-2 fw-semibold">
                        {% if document.amountCents is not null %}
                          {{ (document.amountCents / 100)|number_format(2, ',', '.') }} {{ document.currency|default('EUR') }}
                        {% else %}
                          —
                        {% endif %}
                      </div>
                      <div class="col-6 col-md-3 text-md-end">
                        <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#billingDetailModal{{ document.id }}">
                          {{ 'backend.billing.project.view_details'|trans }}
                        </button>
                      </div>
                    </div>
                    <div class="small text-muted mt-2">
                      {{ hasLocalCopy ? 'backend.billing.project.invoice_available'|trans : 'backend.billing.project.no_invoice_yet'|trans }}
                    </div>
                  </div>

                  <div class="modal fade" id="billingDetailModal{{ document.id }}" tabindex="-1" aria-labelledby="billingDetailModalLabel{{ document.id }}" aria-hidden="true">
                    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                      <div class="modal-content">
                        <div class="modal-header px-3 px-md-4 py-3">
                          <h2 class="modal-title h5" id="billingDetailModalLabel{{ document.id }}">{{ 'backend.billing.project.invoice_detail'|trans }}</h2>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                        </div>
                        <div class="modal-body p-3 p-md-4">
                          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 border-bottom">
                            <span class="badge rounded-pill {% if document.status == 'paid' %}bg-success{% elseif document.status == 'void' %}bg-danger{% elseif document.status == 'open' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                              {{ ('backend.billing.document.status.' ~ (document.status ?: 'unknown'))|trans }}
                            </span>
                            <span class="text-muted small">{{ hasLocalCopy ? 'backend.billing.project.invoice_available'|trans : 'backend.billing.project.no_invoice_yet'|trans }}</span>
                          </div>

                          <div class="py-3 border-bottom">
                            <div class="small text-muted">{{ 'backend.billing.project.project_label'|trans }}</div>
                            <div class="fw-semibold">{{ project.name }}</div>
                          </div>

                          <div class="row g-3 py-3 border-bottom">
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.phase_tabs'|trans }}</div>
                              <div class="fw-semibold">{{ phaseLabel }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.contracted_plan'|trans }}</div>
                              <div class="fw-semibold">{{ documentPlan ? documentPlan|upper : '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.payment_status'|trans }}</div>
                              <div class="fw-semibold">{{ subscription ? ('backend.subscription.status.' ~ subscription.status)|trans : '—' }}</div>
                            </div>
                          </div>

                          <div class="row g-3 py-3 border-bottom">
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.subscription.card.amount'|trans }}</div>
                              <div class="fw-semibold">
                                {{ paidAmountCents is not null ? (paidAmountCents / 100)|number_format(2, ',', '.') ~ ' ' ~ paidCurrency|default('EUR') : '—' }}
                              </div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.subscription.card.paid_at'|trans }}</div>
                              <div class="fw-semibold">{{ paidDate ? paidDate|date('d/m/Y H:i') : '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.last_payment_status'|trans }}</div>
                              <div class="fw-semibold">
                                {{ lastPaymentStatus ? ('backend.subscription.last_payment_status.' ~ lastPaymentStatus)|trans : '—' }}
                              </div>
                            </div>
                          </div>

                          <div class="border rounded-3 p-3 mt-3">
                            <div class="small text-muted">{{ 'backend.billing.project.payment_reference'|trans }}</div>
                            <div class="small text-muted" style="overflow-wrap: anywhere;">{{ paymentReference ?: '—' }}</div>
                          </div>

                          <div class="row g-3 border rounded-3 p-3 mx-0 mt-3">
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.document_reference'|trans }}</div>
                              <div class="small text-muted" style="overflow-wrap: anywhere;">{{ documentReference ?: '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.document_date'|trans }}</div>
                              <div class="fw-semibold">{{ documentDate ? documentDate|date('d/m/Y') : '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.concept'|trans }}</div>
                              <div class="fw-semibold text-break">{{ document.purchaseLabel ?: '—' }}</div>
                            </div>
                          </div>

                        </div>
                        <div class="modal-footer justify-content-between px-3 px-md-4 py-3">
                          <div class="small fw-semibold me-auto">{{ 'backend.billing.project.actions'|trans }}</div>
                          <div class="d-flex flex-wrap gap-2">
                            {% if hasLocalCopy %}
                              <a href="{{ path('backend_project_billing_document_view', {id: project.id, phase: phase.value, documentId: document.id}) }}" class="btn btn-primary" target="_blank" rel="noopener">
                                {{ 'backend.subscription.actions.view_invoice'|trans }}
                              </a>
                              <a href="{{ path('backend_project_billing_document_download', {id: project.id, phase: phase.value, documentId: document.id}) }}" class="btn btn-outline-success" target="_blank" rel="noopener">
                                {{ 'backend.subscription.actions.download_pdf'|trans }}
                              </a>
                            {% endif %}
                            {% if canSeeStripeAdminActions and document.hostedInvoiceUrl %}
                              <a href="{{ document.hostedInvoiceUrl }}" class="btn btn-outline-primary" target="_blank" rel="noopener">
                                {{ 'backend.billing.project.open_invoice_in_stripe'|trans }}
                              </a>
                            {% endif %}
                            {% set hasUsefulInvoiceRefs = document.invoicePdfUrl or document.stripeInvoiceId or document.stripeCheckoutSessionId or document.paymentReference %}
                            {% if canSeeStripeAdminActions and not hasLocalCopy and hasUsefulInvoiceRefs %}
                              <form method="post" action="{{ path('backend_project_billing_document_sync', {id: project.id, phase: phase.value, documentId: document.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('project_billing_document_sync_' ~ project.id ~ '_' ~ document.id) }}">
                                <button type="submit" class="btn btn-primary">{{ 'backend.billing.project.try_download_invoice'|trans }}</button>
                              </form>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </article>
  {% else %}
    <div class="alert alert-secondary mb-0">{{ 'backend.billing.project.no_activity'|trans }}</div>
  {% endfor %}
</div>
{% endblock %}
