{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.subscription.card.title'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item">
    <a href="{{ path('backend_project_index') }}" class="text-decoration-none">{{ 'backend.projects.list.breadcrumb'|trans }}</a>
  </li>
  <li class="breadcrumb-item active">{{ 'backend.subscription.card.title'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-client-shell">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
      <h1 class="h3 mb-1">{{ 'backend.subscription.card.title'|trans }}</h1>
      <div class="text-muted">{{ 'backend.billing.project.global_subtitle'|trans }}</div>
    </div>
    <a href="{{ backUrl }}" class="btn btn-outline-secondary">{{ 'backend.common.back'|trans }}</a>
  </div>

  {% set canSeeStripeAdminActions = app.user and ('ROLE_ADMIN' in app.user.roles or 'ROLE_SUPER_ADMIN' in app.user.roles) %}

  {% for billing in projectBillings %}
    {% set project = billing.project %}
    {% set subscription = billing.subscription %}
    {% set pendingCheckout = billing.pendingCheckout %}
    {% set upgradeCta = billing.upgradeCta %}
    {% set pendingUpgrade = billing.pendingUpgrade %}

    <article id="billing-project-{{ project.id }}" class="card shadow-sm mb-3">
      <div class="card-body p-3 p-lg-4">
        <div class="row g-4 align-items-start">
          <div class="col-12 col-lg-4">
            <h2 class="h5 mb-2">{{ project.name }}</h2>
            <div class="text-muted mb-1">
              Plan comercial único del proyecto:
              <strong class="text-body">{{ project.commercialTier|upper }}</strong>
            </div>
            <div class="mb-3">
              <span class="text-muted">Estado del pago:</span>
              {% if billing.projectPayments is not empty %}
                {% set latestProjectPayment = billing.projectPayments|first %}
                <strong class="{{ latestProjectPayment.status == 'paid' ? 'text-success' : '' }}">
                  {% if latestProjectPayment.status == 'paid' %}Pagado{% elseif latestProjectPayment.status == 'pending' %}Pendiente{% elseif latestProjectPayment.status == 'paid_review' %}En revisión{% else %}{{ latestProjectPayment.status }}{% endif %}
                </strong>
              {% else %}
                <strong>{{ subscription ? ('backend.subscription.status.' ~ subscription.status)|trans : '—' }}</strong>
              {% endif %}
            </div>

            {% if billing.canManageBilling and project.commercialTier != 'pro' %}
              <a href="{{ path('backend_project_plan_comparison', {id: project.id, phase: 'elaboration', from: 'billing'}) }}" class="btn btn-outline-success btn-sm">
                Comparar y mejorar plan
              </a>
            {% endif %}

            {% if billing.projectPayments is empty and pendingUpgrade %}
              <div class="alert alert-warning py-2 px-3 mt-3 mb-0">
                <div class="small fw-semibold">Pago histórico pendiente de Elaboración</div>
                <div class="small">{{ pendingUpgrade.label }}</div>
                {% if billing.canManageBilling %}
                  <form method="post" action="{{ path('backend_project_subscription_confirm_pending', {id: project.id, phase: 'elaboration', from: 'billing'}) }}" class="mt-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_confirm_pending_' ~ project.id ~ '_elaboration') }}">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Verificar pago histórico</button>
                  </form>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <div class="col-12 col-lg-8">
            {% if billing.projectPayments is not empty %}
              <div class="mb-4">
                <div class="fw-semibold mb-1">Pagos del plan único del proyecto</div>
                <p class="small text-muted mb-2">La contratación cubre Elaboración e Implementación. Estos movimientos son por proyecto, no por fase.</p>
                <div class="vstack gap-2">
                  {% for commercialPayment in billing.projectPayments %}
                    {% set projectInvoiceInfo = billing.projectInvoiceDocuments[commercialPayment.id] ?? null %}
                    <div class="border rounded-3 p-3">
                      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                          <span class="badge {% if commercialPayment.status == 'paid' %}bg-success{% elseif commercialPayment.status == 'pending' %}bg-warning text-dark{% elseif commercialPayment.status == 'paid_review' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                            {% if commercialPayment.status == 'paid' %}Pagado{% elseif commercialPayment.status == 'paid_review' %}Pago en revisión{% elseif commercialPayment.status == 'pending' %}Pendiente{% else %}{{ commercialPayment.status }}{% endif %}
                          </span>
                          <span class="ms-2 fw-semibold">{{ commercialPayment.fromTier|upper }} → {{ commercialPayment.targetTier|upper }}</span>
                        </div>
                        <div class="fw-semibold">{{ (commercialPayment.amountCents / 100)|number_format(2, ',', '.') }} {{ commercialPayment.currency }}</div>
                      </div>
                      <div class="small text-muted mt-2">
                        {{ commercialPayment.paidAt ? ('Fecha de pago: ' ~ commercialPayment.paidAt|date('d/m/Y H:i')) : 'Pago sin fecha confirmada' }}
                      </div>
                      <div class="small text-muted mt-1">
                        {% if commercialPayment.stripeInvoiceId %}
                          Factura Stripe: {{ canSeeStripeAdminActions ? commercialPayment.stripeInvoiceId : ((commercialPayment.stripeInvoiceId|length > 18) ? (commercialPayment.stripeInvoiceId|slice(0, 12) ~ '...' ~ commercialPayment.stripeInvoiceId|slice(-6)) : 'Referencia protegida') }}
                        {% elseif commercialPayment.status == 'paid' %}
                          Factura Stripe: pendiente de sincronización
                        {% else %}
                          Factura Stripe: no disponible todavía
                        {% endif %}
                      </div>
                      {% if projectInvoiceInfo and projectInvoiceInfo.hasLocalCopy %}
                        <div class="d-flex flex-wrap gap-2 mt-2">
                          <a class="btn btn-sm btn-outline-success" target="_blank" rel="noopener" href="{{ path('backend_project_billing_project_document_view', {id: project.id, documentId: projectInvoiceInfo.document.id}) }}">Ver factura</a>
                          <a class="btn btn-sm btn-outline-secondary" href="{{ path('backend_project_billing_project_document_download', {id: project.id, documentId: projectInvoiceInfo.document.id}) }}">Descargar PDF</a>
                        </div>
                        {% if billing.canSyncProjectInvoice and commercialPayment.status == 'paid' %}
                          <form method="post" class="mt-2" action="{{ path('backend_project_billing_project_invoice_sync', {id: project.id, paymentId: commercialPayment.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('project_commercial_invoice_sync_' ~ project.id ~ '_' ~ commercialPayment.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Actualizar factura de Stripe</button>
                          </form>
                        {% endif %}
                      {% elseif commercialPayment.status == 'paid' %}
                        {% if projectInvoiceInfo %}
                          <div class="small text-muted mt-2">Factura identificada, PDF pendiente de descarga.</div>
                        {% endif %}
                        {% if billing.canSyncProjectInvoice %}
                          <form method="post" class="mt-2" action="{{ path('backend_project_billing_project_invoice_sync', {id: project.id, paymentId: commercialPayment.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('project_commercial_invoice_sync_' ~ project.id ~ '_' ~ commercialPayment.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Sincronizar factura de Stripe</button>
                          </form>
                        {% endif %}
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
            <div class="small text-muted mb-2">
              {{ 'backend.billing.project.documents_count'|trans({'%count%': (billing.billingDocuments|length) + (billing.projectInvoiceDocuments|length)}) }}
            </div>

            {% if billing.billingDocuments is empty %}
              {% if billing.projectInvoiceDocuments is not empty %}
                <div class="small text-muted">Las facturas del plan único están vinculadas a cada pago, arriba.</div>
              {% elseif billing.projectPayments is not empty %}
                <div class="alert alert-light border mb-0">Los documentos de las compras del plan único todavía no están sincronizados en BEGREEN. El pago sigue confirmado en Stripe.</div>
              {% else %}
                <div class="alert alert-light border mb-0">{{ 'backend.billing.project.no_documents'|trans }}</div>
              {% endif %}
            {% else %}
              <div class="vstack gap-2">
                {% for item in billing.billingDocuments %}
                  {% set document = item.document %}
                  {% set legacyPhase = item.legacyPhase %}
                  {% set legacySubscription = item.legacySubscription %}
                  {% set hasLocalCopy = item.hasLocalCopy %}
                  {% set documentDate = document.paidAt ?: document.issuedAt %}
                  {% set documentReference = document.stripeInvoiceId ?: document.paymentReference ?: document.stripeCheckoutSessionId ?: document.stripePaymentIntentId %}
                  {% set paymentReference = legacySubscription.paymentReference ?: legacySubscription.stripePaymentIntentId ?: legacySubscription.stripeCheckoutSessionId ?: document.paymentReference %}
                  {% set paidAmountCents = document.amountCents is not null ? document.amountCents : legacySubscription.paidAmountCents %}
                  {% set paidCurrency = document.currency ?: (legacySubscription.currency ?: 'EUR') %}
                  {% set paidDate = document.paidAt ?: legacySubscription.paidAt %}
                  {% set lastPaymentStatus = legacySubscription.lastPaymentStatus ?: document.status %}
                  {% set documentPlan = document.subscription ? document.subscription.tier : legacySubscription.tier %}

                  <div class="border rounded-3 p-3">
                    <div class="row g-2 align-items-center">
                      <div class="col-6 col-md-2">
                        <span class="badge rounded-pill {% if document.status == 'paid' %}bg-success{% elseif document.status == 'void' %}bg-danger{% elseif document.status == 'open' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                          {{ ('backend.billing.document.status.' ~ (document.status ?: 'unknown'))|trans }}
                        </span>
                      </div>
                      <div class="col-6 col-md-2 small text-muted">
                        {{ documentDate ? documentDate|date('d/m/Y') : '—' }}
                      </div>
                      <div class="col-12 col-md-3">
                        <div class="small text-muted text-truncate" title="{{ documentReference ? (canSeeStripeAdminActions ? documentReference : ((documentReference|length > 18) ? (documentReference|slice(0, 12) ~ '...' ~ documentReference|slice(-6)) : 'Referencia protegida')) : '—' }}">
                          {{ documentReference ? (canSeeStripeAdminActions ? documentReference : ((documentReference|length > 18) ? (documentReference|slice(0, 12) ~ '...' ~ documentReference|slice(-6)) : 'Referencia protegida')) : '—' }}
                        </div>
                      </div>
                      <div class="col-6 col-md-2 fw-semibold">
                        {% if document.amountCents is not null %}
                          {{ (document.amountCents / 100)|number_format(2, ',', '.') }} {{ document.currency|default('EUR') }}
                        {% else %}
                          —
                        {% endif %}
                      </div>
                      <div class="col-6 col-md-3 text-md-end">
                        <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#billingDetailModal{{ document.id }}">
                          {{ 'backend.billing.project.view_details'|trans }}
                        </button>
                      </div>
                    </div>
                    <div class="small text-muted mt-2">
                      {{ hasLocalCopy ? 'backend.billing.project.invoice_available'|trans : 'backend.billing.project.no_invoice_yet'|trans }}
                    </div>
                  </div>

                  <div class="modal fade" id="billingDetailModal{{ document.id }}" tabindex="-1" aria-labelledby="billingDetailModalLabel{{ document.id }}" aria-hidden="true">
                    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                      <div class="modal-content">
                        <div class="modal-header px-3 px-md-4 py-3">
                          <h2 class="modal-title h5" id="billingDetailModalLabel{{ document.id }}">{{ 'backend.billing.project.invoice_detail'|trans }}</h2>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                        </div>
                        <div class="modal-body p-3 p-md-4">
                          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 border-bottom">
                            <span class="badge rounded-pill {% if document.status == 'paid' %}bg-success{% elseif document.status == 'void' %}bg-danger{% elseif document.status == 'open' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                              {{ ('backend.billing.document.status.' ~ (document.status ?: 'unknown'))|trans }}
                            </span>
                            <span class="text-muted small">{{ hasLocalCopy ? 'backend.billing.project.invoice_available'|trans : 'backend.billing.project.no_invoice_yet'|trans }}</span>
                          </div>

                          <div class="py-3 border-bottom">
                            <div class="small text-muted">{{ 'backend.billing.project.project_label'|trans }}</div>
                            <div class="fw-semibold">{{ project.name }}</div>
                          </div>

                          <div class="row g-3 py-3 border-bottom">
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">Fase del documento histórico</div>
                              <div class="fw-semibold">{{ ('backend.commercial_phases.' ~ legacyPhase.value)|trans }} (histórico)</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.contracted_plan'|trans }}</div>
                              <div class="fw-semibold">{{ documentPlan ? documentPlan|upper : '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.payment_status'|trans }}</div>
                              <div class="fw-semibold">{{ ('backend.subscription.status.' ~ legacySubscription.status)|trans }}</div>
                            </div>
                          </div>

                          <div class="row g-3 py-3 border-bottom">
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.subscription.card.amount'|trans }}</div>
                              <div class="fw-semibold">
                                {{ paidAmountCents is not null ? (paidAmountCents / 100)|number_format(2, ',', '.') ~ ' ' ~ paidCurrency|default('EUR') : '—' }}
                              </div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.subscription.card.paid_at'|trans }}</div>
                              <div class="fw-semibold">{{ paidDate ? paidDate|date('d/m/Y H:i') : '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.last_payment_status'|trans }}</div>
                              <div class="fw-semibold">
                                {{ lastPaymentStatus ? ('backend.subscription.last_payment_status.' ~ lastPaymentStatus)|trans : '—' }}
                              </div>
                            </div>
                          </div>

                          <div class="border rounded-3 p-3 mt-3">
                            <div class="small text-muted">{{ 'backend.billing.project.payment_reference'|trans }}</div>
                            <div class="small text-muted" style="overflow-wrap: anywhere;">{{ paymentReference ? (canSeeStripeAdminActions ? paymentReference : ((paymentReference|length > 18) ? (paymentReference|slice(0, 12) ~ '...' ~ paymentReference|slice(-6)) : 'Referencia protegida')) : '—' }}</div>
                          </div>

                          <div class="row g-3 border rounded-3 p-3 mx-0 mt-3">
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.document_reference'|trans }}</div>
                              <div class="small text-muted" style="overflow-wrap: anywhere;">{{ documentReference ? (canSeeStripeAdminActions ? documentReference : ((documentReference|length > 18) ? (documentReference|slice(0, 12) ~ '...' ~ documentReference|slice(-6)) : 'Referencia protegida')) : '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.document_date'|trans }}</div>
                              <div class="fw-semibold">{{ documentDate ? documentDate|date('d/m/Y') : '—' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                              <div class="small text-muted">{{ 'backend.billing.project.concept'|trans }}</div>
                              <div class="fw-semibold text-break">{{ document.purchaseLabel ?: '—' }}</div>
                            </div>
                          </div>

                        </div>
                        <div class="modal-footer justify-content-between px-3 px-md-4 py-3">
                          <div class="small fw-semibold me-auto">{{ 'backend.billing.project.actions'|trans }}</div>
                          <div class="d-flex flex-wrap gap-2">
                            {% if hasLocalCopy %}
                              <a href="{{ path('backend_project_billing_document_view', {id: project.id, phase: legacyPhase.value, documentId: document.id}) }}" class="btn btn-primary" target="_blank" rel="noopener">
                                {{ 'backend.subscription.actions.view_invoice'|trans }}
                              </a>
                              <a href="{{ path('backend_project_billing_document_download', {id: project.id, phase: legacyPhase.value, documentId: document.id}) }}" class="btn btn-outline-success" target="_blank" rel="noopener">
                                {{ 'backend.subscription.actions.download_pdf'|trans }}
                              </a>
                            {% endif %}
                            {% if canSeeStripeAdminActions and document.hostedInvoiceUrl %}
                              <a href="{{ document.hostedInvoiceUrl }}" class="btn btn-outline-primary" target="_blank" rel="noopener">
                                {{ 'backend.billing.project.open_invoice_in_stripe'|trans }}
                              </a>
                            {% endif %}
                            {% set hasUsefulInvoiceRefs = document.invoicePdfUrl or document.stripeInvoiceId or document.stripeCheckoutSessionId or document.paymentReference %}
                            {% if canSeeStripeAdminActions and not hasLocalCopy and hasUsefulInvoiceRefs %}
                              <form method="post" action="{{ path('backend_project_billing_document_sync', {id: project.id, phase: legacyPhase.value, documentId: document.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('project_billing_document_sync_' ~ project.id ~ '_' ~ document.id) }}">
                                <button type="submit" class="btn btn-primary">{{ 'backend.billing.project.try_download_invoice'|trans }}</button>
                              </form>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </article>
  {% else %}
    <div class="alert alert-secondary mb-0">{{ 'backend.billing.project.no_activity'|trans }}</div>
  {% endfor %}
</div>
{% endblock %}
