{% extends 'base_backend.html.twig' %}

{% macro assignment_row(assignmentForm) %}
    <div class="row g-2 align-items-end mb-2" data-crew-assignment-row>
        <div class="col-12 col-md-5 form-label-over">
            {{ form_label(assignmentForm.crewDepartment) }}
            {{ form_widget(assignmentForm.crewDepartment) }}
            {{ form_errors(assignmentForm.crewDepartment) }}
        </div>
        <div class="col-12 col-md-5 form-label-over">
            {{ form_label(assignmentForm.crewPosition) }}
            {{ form_widget(assignmentForm.crewPosition) }}
            {{ form_errors(assignmentForm.crewPosition) }}
        </div>
        <div class="col-12 col-md-2 text-md-end">
            <button type="button"
                    class="btn btn-sm btn-outline-danger w-auto"
                    data-action="crew#removeAssignment">
                {{ 'backend.projects.crew.form.remove_assignment'|trans }}
            </button>
        </div>
    </div>
{% endmacro %}

{% macro crew_card(crewForm) %}
    <div class="card mb-3 p-3 border bg_green_1" data-crew-card data-assignment-index="{{ crewForm.assignments|length }}">
        {{ form_errors(crewForm) }}
        <div class="row">
            <div class="col-12 col-md-6 col-lg-3 form-label-over">
                {{ form_row(crewForm.name) }}
            </div>
            <div class="col-12 col-md-6 col-lg-3 form-label-over">
                {{ form_row(crewForm.lastName) }}
            </div>
            <div class="col-12 col-md-6 col-lg-3 form-label-over">
                {{ form_row(crewForm.email) }}
            </div>
            <div class="col-12 col-md-6 col-lg-3 form-label-over">
                {{ form_row(crewForm.phone) }}
            </div>
        </div>

        <div class="border-top mt-3 pt-3">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <h3 class="h6 mb-0">{{ 'backend.projects.crew.form.assignments'|trans }}</h3>
                <button type="button"
                        class="btn btn-sm btn-outline-primary w-auto"
                        data-action="crew#addAssignment">
                    + {{ 'backend.projects.crew.form.add_assignment'|trans }}
                </button>
            </div>

            {{ form_errors(crewForm.assignments) }}
            <div data-crew-assignment-container>
                {% for assignmentForm in crewForm.assignments %}
                    {{ _self.assignment_row(assignmentForm) }}
                {% endfor %}
            </div>

            <template data-crew-assignment-prototype>
                {{ _self.assignment_row(crewForm.assignments.vars.prototype) }}
            </template>
        </div>

        <div class="text-end mt-3">
            <button type="button"
                    class="btn btn-sm btn-primary w-auto"
                    data-action="crew#removeCrewMember">
                {{ 'backend.projects.crew.form.remove_member'|trans }}
            </button>
        </div>
    </div>
{% endmacro %}

{% block title %}{{ 'backend.projects.crew.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a class="text-decoration-none" href="{{ path('backend_project_index') }}">{{ 'projects.name'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a class="text-decoration-none" href="{{ path('backend_project_edit', { id: project.id }) }}">{{ project.name }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ 'backend.projects.crew.breadcrumb'|trans }}
    </li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-client-shell">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2 class="mb-1">
                {{ 'backend.projects.crew.h2'|trans({'%project%': project.name}) }}
            </h2>
            <div class="text-muted">{{ project.name }}</div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#importCrewModal">
            <i class="bi bi-upload"></i> {{ 'backend.projects.crew.import_btn'|trans }}
        </button>
    </div>

    {{ form_start(form) }}
        {{ form_errors(form) }}

        <div data-controller="crew"
             data-crew-allow-add-value="true"
             data-crew-allow-delete-value="true"
             data-crew-prototype-name-value="__crew__"
             data-crew-positions-url-template-value="{{ path('backend_ajax_crew_positions_by_department', {id: '__department__'}) }}"
             data-crew-i18n-placeholder-position-value="{{ 'backend.projects.crew.placeholder.position'|trans }}"
             data-crew-i18n-network-error-value="{{ 'backend.common.network_error'|trans }}">

            <div data-crew-target="container">
                {% for crewForm in form.crewMembers %}
                    {{ _self.crew_card(crewForm) }}
                {% endfor %}
            </div>

            <template data-crew-target="prototype">
                {{ _self.crew_card(form.crewMembers.vars.prototype) }}
            </template>

            <button type="button"
                    class="btn btn-primary mt-2"
                    data-action="crew#addCrewMember">
                + {{ 'backend.projects.crew.form.add_member'|trans }}
            </button>
        </div>

        <hr>
        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('backend_project_edit', {id: project.id}) }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> {{ 'backend.common.back'|trans }}
            </a>
            <button class="btn btn-primary">
                <i class="bi bi-save"></i> {{ 'backend.common.save'|trans }}
            </button>
        </div>
    {{ form_end(form) }}
</div>

{# Modal para carga desde Excel #}
<div class="modal fade" id="importCrewModal" tabindex="-1" aria-labelledby="importCrewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="{{ path('backend_project_import_crew', {id: project.id}) }}" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="importCrewModalLabel">{{ 'backend.projects.crew.import_modal.title'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="crewFile" class="form-label">{{ 'backend.projects.crew.import_modal.file_label'|trans }}</label>
                        <input type="file" name="crewFile" id="crewFile" class="form-control" required accept=".xlsx,.xls">
                        <div class="form-text">
                            <a href="{{ path('backend_project_template_download') }}" class="btn btn-outline-primary btn-sm mt-2" download>
                                <i class="bi bi-download"></i> {{ 'backend.projects.crew.import_modal.download_template'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        {{ 'backend.common.cancel'|trans }}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        {{ 'backend.projects.crew.import_modal.submit'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
