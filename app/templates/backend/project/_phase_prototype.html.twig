<div class="card mb-3 p-3 border position-relative phase-entry-wrapper bg_green_3" data-collection-id="__phase__">
    <div class="row">
        <div class="col-12 col-md-4 form-label-over">
            <label class="form-label">{{ 'backend.projects.form.phase'|trans }}</label>
            <input
                type="text"
                class="form-control text-start"
                readonly
                data-project-target="label"
                data-phase="postproduccion"
                value="{{ 'backend.projects.form.phase_postprod'|trans }}"
            >
            <input
                type="hidden"
                name="{{ prototype.phase.vars.full_name }}"
                value="postproduccion"
            >
        </div>
        <div class="col-12 col-md-4 form-label-over">
            <label class="form-label" for="{{ prototype.startDate.vars.id }}">
                {{ prototype.startDate.vars.label|default('backend.projects.form.start_date'|trans) }}
            </label>
            <input
                type="date"
                class="form-control"
                id="{{ prototype.startDate.vars.id }}"
                name="{{ prototype.startDate.vars.full_name }}"
                value="{{ prototype.startDate.vars.value|default('') }}"
            >
        </div>
        <div class="col-12 col-md-4 form-label-over">
            <label class="form-label" for="{{ prototype.endDate.vars.id }}">
                {{ prototype.endDate.vars.label|default('backend.projects.form.end_date'|trans) }}
            </label>
            <input
                type="date"
                class="form-control"
                id="{{ prototype.endDate.vars.id }}"
                name="{{ prototype.endDate.vars.full_name }}"
                value="{{ prototype.endDate.vars.value|default('') }}"
            >
        </div>
    </div>

    <div class="text-end mt-0">
        <button type="button" class="btn btn-sm btn-primary w-auto" data-action="project#removeItem">
        <i class="bi bi-trash"></i> {{ 'backend.projects.form.remove_phase'|trans }}
        </button>
    </div>
</div>
