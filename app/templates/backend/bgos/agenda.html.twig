{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'backend.bgos.agenda.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.bgos.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
{% set categoryVisuals = {
    transport: {
        icon: 'bi-truck',
        tone: 'transport'
    },
    energy: {
        icon: 'bi-lightning-charge-fill',
        tone: 'energy'
    },
    water: {
        icon: 'bi-droplet-fill',
        tone: 'water'
    },
    accommodation: {
        icon: 'bi-house-door-fill',
        tone: 'accommodation'
    },
    catering: {
        icon: 'bi-cup-hot-fill',
        tone: 'catering'
    },
    materials: {
        icon: 'bi-box-seam-fill',
        tone: 'materials'
    },
    waste: {
        icon: 'bi-recycle',
        tone: 'waste'
    }
} %}

<div class="container-fluid px-0 backend-client-shell bgos-agenda">
    <div class="backend-client-content">

        <header class="bgos-agenda__header">
            <div class="bgos-agenda__heading">
                <div class="bgos-agenda__eyebrow">
                    {{ 'backend.bgos.agenda.eyebrow'|trans }}
                </div>

                <h2 class="bgos-agenda__project-name">{{ project.name }}</h2>

                <p class="bgos-agenda__intro">
                    {{ 'backend.bgos.agenda.intro'|trans }}
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary"
                   href="{{ path('backend_bgos_crew') }}">
                    <i class="bi bi-people me-1" aria-hidden="true"></i>
                    {{ 'actions.open'|trans({}, 'bgos_crew') }}
                </a>

                <a class="btn btn-outline-success bgos-agenda__configure"
                   href="{{ path('backend_bgos_config') }}">
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                    {{ 'backend.bgos.actions.configure'|trans }}
                </a>
            </div>
        </header>

        {% if window is null %}
            <div class="alert alert-info">
                {{ 'backend.bgos.agenda.no_dates'|trans }}
            </div>
        {% else %}

            <section class="bgos-agenda__summary"
                     aria-label="{{ 'backend.bgos.agenda.period_emissions'|trans }}">
                <div class="bgos-agenda__summary-item bgos-agenda__summary-item--emissions">
                    <span class="bgos-agenda__summary-label">
                        {{ (window.view == 'total'
                            ? 'backend.bgos.agenda.project_emissions'
                            : 'backend.bgos.agenda.period_emissions')|trans }}
                    </span>

                    <strong class="bgos-agenda__summary-emissions">
                        {% if period.totalKgCo2e is null %}
                            —
                        {% else %}
                            {{ period.totalKgCo2e|number_format(2, ',', '.') }}
                            <span>kg CO₂e</span>
                        {% endif %}
                    </strong>
                </div>

                <div class="bgos-agenda__summary-divider" aria-hidden="true"></div>

                <div class="bgos-agenda__summary-item">
                    <span class="bgos-agenda__summary-label">
                        {{ 'backend.bgos.agenda.period'|trans }}
                    </span>

                    <strong class="bgos-agenda__summary-period">
                        {% if window.view == 'total' %}
                            {{ 'backend.bgos.agenda.full_project'|trans }}
                        {% elseif window.startDate == window.endDate %}
                            {{ window.startDate|date('d/m/Y') }}
                        {% else %}
                            {{ window.startDate|date('d/m/Y') }}
                            <span aria-hidden="true">→</span>
                            {{ window.endDate|date('d/m/Y') }}
                        {% endif %}
                    </strong>
                </div>
            </section>

            <section class="bgos-agenda__calendar">
                <div class="bgos-agenda__calendar-heading">
                    <h3 class="bgos-agenda__section-title">
                        {{ 'backend.bgos.agenda.calendar_title'|trans }}
                    </h3>

                    <nav aria-label="{{ 'backend.bgos.agenda.views_label'|trans }}">
                        <div class="btn-group bgos-agenda__views" role="group">
                            {% for view in views %}
                                <a
                                    class="btn btn-sm {{ window.view == view ? 'btn-secondary active' : 'btn-outline-secondary' }}"
                                    href="{{ path('backend_bgos_index', {
                                        view: view,
                                        date: window.selectedDate|date('Y-m-d')
                                    }) }}"
                                    {% if window.view == view %}aria-current="page"{% endif %}
                                >
                                    {{ ('backend.bgos.agenda.views.' ~ view)|trans }}
                                </a>
                            {% endfor %}
                        </div>
                    </nav>
                </div>

                <div class="bgos-agenda__period-navigation">
                    {% if window.previousDate %}
                        <a class="btn btn-sm btn-outline-secondary bgos-agenda__period-button"
                           href="{{ path('backend_bgos_index', {
                               view: window.view,
                               date: window.previousDate|date('Y-m-d')
                           }) }}"
                           title="{{ 'backend.bgos.agenda.previous'|trans }}">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            <span class="visually-hidden">
                                {{ 'backend.bgos.agenda.previous'|trans }}
                            </span>
                        </a>
                    {% else %}
                        <span class="bgos-agenda__period-button-spacer" aria-hidden="true"></span>
                    {% endif %}

                    <strong class="bgos-agenda__period-current">
                        {% if window.view == 'total' %}
                            {{ 'backend.bgos.agenda.full_project'|trans }}
                        {% elseif window.startDate == window.endDate %}
                            {{ window.startDate|date('d/m/Y') }}
                        {% else %}
                            {{ window.startDate|date('d/m/Y') }}
                            <span aria-hidden="true">–</span>
                            {{ window.endDate|date('d/m/Y') }}
                        {% endif %}
                    </strong>

                    {% if window.nextDate %}
                        <a class="btn btn-sm btn-outline-secondary bgos-agenda__period-button"
                           href="{{ path('backend_bgos_index', {
                               view: window.view,
                               date: window.nextDate|date('Y-m-d')
                           }) }}"
                           title="{{ 'backend.bgos.agenda.next'|trans }}">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            <span class="visually-hidden">
                                {{ 'backend.bgos.agenda.next'|trans }}
                            </span>
                        </a>
                    {% else %}
                        <span class="bgos-agenda__period-button-spacer" aria-hidden="true"></span>
                    {% endif %}
                </div>

                <div class="accordion bgos-agenda__categories"
                     id="bgos-agenda-categories">

                    {% for category in period.categories %}
                        {% set isOpen = app.request.query.get('open') == category.key %}
                        {% set pct = category.completion.completionPercentage %}
                        {% set visual = categoryVisuals[category.key] ?? {
                            icon: 'bi-circle-fill',
                            tone: 'default'
                        } %}

                        <section
                            class="accordion-item bgos-agenda-category bgos-agenda-category--{{ visual.tone }}"
                            data-bgos-agenda-category="{{ category.key }}"
                        >
                            <h3 class="accordion-header"
                                id="bgos-agenda-heading-{{ category.key }}">

                                <button
                                    class="accordion-button bgos-agenda-category__header {{ isOpen ? '' : 'collapsed' }}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#bgos-agenda-category-{{ category.key }}"
                                    aria-expanded="{{ isOpen ? 'true' : 'false' }}"
                                    aria-controls="bgos-agenda-category-{{ category.key }}"
                                >
                                    <span class="bgos-agenda-category__icon" aria-hidden="true">
                                        <i class="bi {{ visual.icon }}"></i>
                                    </span>

                                    <span class="bgos-agenda-category__name">
                                        {{ category.labelKey|trans }}
                                    </span>

                                    <span class="bgos-agenda-category__progress-wrap">
                                        {% if pct is not null %}
                                            <span
                                                class="progress bgos-agenda-category__progress"
                                                role="progressbar"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                                aria-valuenow="{{ pct|round }}"
                                            >
                                                <span
                                                    class="progress-bar {{ pct >= 100 ? 'is-complete' : 'is-pending' }}"
                                                    style="width: {{ pct }}%"
                                                ></span>
                                            </span>

                                            <span class="bgos-agenda-category__percentage">
                                                {{ pct|round }}%
                                            </span>
                                        {% else %}
                                            <span class="bgos-agenda-category__progress bgos-agenda-category__progress--empty"></span>
                                        {% endif %}
                                    </span>

                                    <span class="bgos-agenda-category__emissions">
                                        {% if category.totalKgCo2e is null %}
                                            —
                                        {% else %}
                                            {{ category.totalKgCo2e|number_format(2, ',', '.') }}
                                            <small>kg CO₂e</small>
                                        {% endif %}
                                    </span>
                                </button>
                            </h3>

                            <div
                                id="bgos-agenda-category-{{ category.key }}"
                                class="accordion-collapse collapse {{ isOpen ? 'show' : '' }}"
                                aria-labelledby="bgos-agenda-heading-{{ category.key }}"
                                data-bs-parent="#bgos-agenda-categories"
                            >
                                <div class="accordion-body bgos-agenda-category__body">
                                    {% set hasVisibleSubcategory = false %}

                                    {% for subcategory in category.subcategories %}
                                        {% if subcategory.configured
                                            or subcategory.completion.expectedCount > 0
                                            or subcategory.totalKgCo2e is not null
                                            or subcategory.crewTracking is defined
                                        %}
                                            {% set isCrewTransport =
                                                category.key == 'transport'
                                                and subcategory.key == 'people'
                                            %}
                                            {% set hasVisibleSubcategory = true %}
                                            {% set subPct = subcategory.completion.completionPercentage %}

                                            <div
                                                class="bgos-agenda-subcategory"
                                                data-bgos-agenda-subcategory="{{ subcategory.key }}"
                                            >
                                                <div class="bgos-agenda-subcategory__main">
                                                    <div class="bgos-agenda-subcategory__name">
                                                        {{ subcategory.labelKey
                                                            ? subcategory.labelKey|trans
                                                            : subcategory.label }}
                                                    </div>

                                                    {% if subcategory.groupLabel %}
                                                        <div class="bgos-agenda-subcategory__group">
                                                            {{ subcategory.groupLabel }}
                                                        </div>
                                                    {% endif %}
                                                </div>

                                                <div class="bgos-agenda-subcategory__status bgos-agenda-subcategory__status--{{ subcategory.trackingStatus }}">
                                                    <span>
                                                        {{ ('backend.bgos.agenda.status.' ~ subcategory.trackingStatus)|trans }}
                                                    </span>

                                                    {% if subPct is not null %}
                                                        <strong>{{ subPct|round }}%</strong>
                                                    {% endif %}
                                                </div>

                                                <div class="bgos-agenda-subcategory__emissions">
                                                    {% if subcategory.totalKgCo2e is null %}
                                                        —
                                                    {% else %}
                                                        {{ subcategory.totalKgCo2e|number_format(2, ',', '.') }}
                                                        <small>kg CO₂e</small>
                                                    {% endif %}
                                                </div>

                                                {% if not isCrewTransport
                                                    and window.view == 'day'
                                                    and subcategory.configured
                                                    and subcategory.active
                                                    and subcategory.trackingStatus != 'not_applicable'
                                                %}
                                                    <div class="bgos-agenda-subcategory__action">
                                                        <a class="btn btn-sm btn-outline-success"
                                                           href="{{ path(entryRoutes[category.key], {
                                                               bgosDate: window.selectedDate|date('Y-m-d'),
                                                               bgosView: window.view,
                                                               bgosCategory: category.key,
                                                               bgosSubcategory: subcategory.key
                                                           }) }}">
                                                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                                            {{ (subcategory.trackingStatus == 'complete'
                                                                ? 'backend.bgos.actions.add_another_record'
                                                                : 'backend.bgos.actions.add_record')|trans }}
                                                        </a>
                                                    </div>
                                                {% endif %}

                                                {% if isCrewTransport %}
                                                    {% set crew = subcategory.crewTracking %}

                                                    <div
                                                        id="bgos-crew-transport"
                                                        class="mt-3 pt-3 border-top"
                                                        style="grid-column: 1 / -1;"
                                                    >
                                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                            <div>
                                                                <strong>
                                                                    {{ 'tracking.title'|trans({}, 'bgos_crew') }}
                                                                </strong>

                                                                {% if window.view == 'day' %}
                                                                    <span class="text-muted ms-2">
                                                                        {{ crew.completedCount }}/{{ crew.expectedCount }}
                                                                        {{ 'tracking.people'|trans({}, 'bgos_crew') }}
                                                                    </span>
                                                                {% else %}
                                                                    <span class="text-muted ms-2">
                                                                        {{ crew.completedCount }}/{{ crew.expectedCount }}
                                                                        {{ 'tracking.person_days'|trans({}, 'bgos_crew') }}
                                                                    </span>
                                                                {% endif %}
                                                            </div>

                                                            <a
                                                                class="btn btn-sm btn-outline-secondary"
                                                                href="{{ path('backend_bgos_crew') }}"
                                                            >
                                                                <i class="bi bi-people me-1" aria-hidden="true"></i>
                                                                {{ 'actions.open'|trans({}, 'bgos_crew') }}
                                                            </a>
                                                        </div>

                                                        {% if crew.departments is not empty %}
                                                            <div class="vstack gap-2 mb-3">
                                                                {% for department in crew.departments %}
                                                                    <div class="border rounded p-2 bg-light">
                                                                        <div class="d-flex justify-content-between gap-3">
                                                                            <strong class="small">
                                                                                {{ department.department
                                                                                    ? department.department.name
                                                                                    : 'tracking.unassigned'|trans({}, 'bgos_crew') }}
                                                                            </strong>

                                                                            <span class="small fw-semibold">
                                                                                {{ department.completedCount }}/{{ department.expectedCount }}
                                                                            </span>
                                                                        </div>

                                                                        {% if window.view == 'day' %}
                                                                            <div class="vstack gap-2 mt-2">
                                                                                {% for day in department.days %}
                                                                                    {% set member = day.crewMember %}

                                                                                    <div class="d-flex flex-column flex-xl-row justify-content-between gap-2 bg-white border rounded p-2">
                                                                                        <div>
                                                                                            <div class="fw-semibold">
                                                                                                {{ member.name }} {{ member.lastName }}
                                                                                            </div>

                                                                                            <div class="small text-muted">
                                                                                                {% if day.crewAssignment %}
                                                                                                    {{ day.crewAssignment.crewDepartment.name }}

                                                                                                    {% if day.crewAssignment.crewPosition %}
                                                                                                        · {{ day.crewAssignment.crewPosition.name }}
                                                                                                    {% endif %}
                                                                                                {% endif %}

                                                                                                {% if day.origin %}
                                                                                                    · {{ day.origin }}
                                                                                                {% endif %}

                                                                                                {% if day.mode %}
                                                                                                    · {{ ('modes.' ~ day.mode)|trans({}, 'bgos_crew') }}
                                                                                                {% endif %}
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                                                                            <form
                                                                                                method="post"
                                                                                                action="{{ path('backend_bgos_crew_day_status', {
                                                                                                    dayId: day.id
                                                                                                }) }}"
                                                                                                class="d-flex gap-2"
                                                                                            >
                                                                                                <input
                                                                                                    type="hidden"
                                                                                                    name="_token"
                                                                                                    value="{{ csrf_token('bgos_crew_day_status_' ~ day.id) }}"
                                                                                                >

                                                                                                <select
                                                                                                    class="form-select form-select-sm"
                                                                                                    name="status"
                                                                                                    aria-label="{{ 'tracking.status'|trans({}, 'bgos_crew') }}"
                                                                                                >
                                                                                                    {% for status in ['pending', 'resolved', 'not_applicable'] %}
                                                                                                        <option
                                                                                                            value="{{ status }}"
                                                                                                            {% if day.status == status %}selected{% endif %}
                                                                                                        >
                                                                                                            {{ ('tracking.statuses.' ~ status)|trans({}, 'bgos_crew') }}
                                                                                                        </option>
                                                                                                    {% endfor %}
                                                                                                </select>

                                                                                                <button
                                                                                                    class="btn btn-sm btn-outline-success"
                                                                                                    type="submit"
                                                                                                >
                                                                                                    {{ 'tracking.update'|trans({}, 'bgos_crew') }}
                                                                                                </button>
                                                                                            </form>

                                                                                            <button
                                                                                                class="btn btn-sm btn-outline-secondary"
                                                                                                type="button"
                                                                                                data-bs-toggle="collapse"
                                                                                                data-bs-target="#bgos-crew-day-edit-{{ day.id }}"
                                                                                                aria-expanded="false"
                                                                                                aria-controls="bgos-crew-day-edit-{{ day.id }}"
                                                                                            >
                                                                                                <i class="bi bi-pencil me-1" aria-hidden="true"></i>
                                                                                                {{ 'tracking.edit_day'|trans({}, 'bgos_crew') }}
                                                                                            </button>

                                                                                            <form
                                                                                                method="post"
                                                                                                action="{{ path('backend_bgos_crew_day_remove', {
                                                                                                    dayId: day.id
                                                                                                }) }}"
                                                                                            >
                                                                                                <input
                                                                                                    type="hidden"
                                                                                                    name="_token"
                                                                                                    value="{{ csrf_token('bgos_crew_day_remove_' ~ day.id) }}"
                                                                                                >

                                                                                                <button
                                                                                                    class="btn btn-sm btn-outline-danger"
                                                                                                    type="submit"
                                                                                                    title="{{ 'tracking.remove'|trans({}, 'bgos_crew') }}"
                                                                                                >
                                                                                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                                                                    <span class="visually-hidden">
                                                                                                        {{ 'tracking.remove'|trans({}, 'bgos_crew') }}
                                                                                                    </span>
                                                                                                </button>
                                                                                            </form>
                                                                                        </div>
                                                                                    </div>

                                                                                    <div
                                                                                        class="collapse mt-2"
                                                                                        id="bgos-crew-day-edit-{{ day.id }}"
                                                                                    >
                                                                                        <form
                                                                                            method="post"
                                                                                            action="{{ path('backend_bgos_crew_day_update', {
                                                                                                dayId: day.id
                                                                                            }) }}"
                                                                                            class="border rounded bg-light p-3"
                                                                                        >
                                                                                            <input
                                                                                                type="hidden"
                                                                                                name="_token"
                                                                                                value="{{ csrf_token('bgos_crew_day_update_' ~ day.id) }}"
                                                                                            >

                                                                                            <div class="small text-muted mb-3">
                                                                                                {{ 'tracking.day_help'|trans({}, 'bgos_crew') }}
                                                                                            </div>

                                                                                            <div class="row g-3">
                                                                                                <div class="col-12 col-xl-4">
                                                                                                    <label class="form-label">
                                                                                                        {{ 'fields.assignment'|trans({}, 'bgos_crew') }}
                                                                                                    </label>

                                                                                                    <select
                                                                                                        class="form-select form-select-sm"
                                                                                                        name="crewAssignment"
                                                                                                    >
                                                                                                        <option value="">
                                                                                                            {{ 'assignment.none'|trans({}, 'bgos_crew') }}
                                                                                                        </option>

                                                                                                        {% for assignment in member.assignments %}
                                                                                                            <option
                                                                                                                value="{{ assignment.id }}"
                                                                                                                {% if day.crewAssignment and day.crewAssignment.id == assignment.id %}
                                                                                                                    selected
                                                                                                                {% endif %}
                                                                                                            >
                                                                                                                {{ assignment.crewDepartment.name }}
                                                                                                                {% if assignment.crewPosition %}
                                                                                                                    · {{ assignment.crewPosition.name }}
                                                                                                                {% endif %}
                                                                                                            </option>
                                                                                                        {% endfor %}
                                                                                                    </select>
                                                                                                </div>

                                                                                                <div class="col-12 col-xl-8">
                                                                                                    <label class="form-label">
                                                                                                        {{ 'fields.origin'|trans({}, 'bgos_crew') }}
                                                                                                    </label>

                                                                                                    <input
                                                                                                        class="form-control form-control-sm"
                                                                                                        type="text"
                                                                                                        name="origin"
                                                                                                        maxlength="255"
                                                                                                        value="{{ day.origin ?? '' }}"
                                                                                                    >
                                                                                                </div>

                                                                                                <div class="col-12 col-md-6 col-xl-3">
                                                                                                    <label class="form-label">
                                                                                                        {{ 'fields.mode'|trans({}, 'bgos_crew') }}
                                                                                                    </label>

                                                                                                    <select
                                                                                                        class="form-select form-select-sm"
                                                                                                        name="mode"
                                                                                                    >
                                                                                                        <option value="">
                                                                                                            {{ 'common.not_defined'|trans({}, 'bgos_crew') }}
                                                                                                        </option>

                                                                                                        {% for mode in crewTransportOptions.peopleModes %}
                                                                                                            <option
                                                                                                                value="{{ mode }}"
                                                                                                                {% if day.mode == mode %}selected{% endif %}
                                                                                                            >
                                                                                                                {{ ('modes.' ~ mode)|trans({}, 'bgos_crew') }}
                                                                                                            </option>
                                                                                                        {% endfor %}
                                                                                                    </select>
                                                                                                </div>

                                                                                                <div class="col-12 col-md-6 col-xl-3">
                                                                                                    <label class="form-label">
                                                                                                        {{ 'fields.vehicle_type'|trans({}, 'bgos_crew') }}
                                                                                                    </label>

                                                                                                    <select
                                                                                                        class="form-select form-select-sm"
                                                                                                        name="vehicleType"
                                                                                                    >
                                                                                                        <option value="">
                                                                                                            {{ 'common.not_defined'|trans({}, 'bgos_crew') }}
                                                                                                        </option>

                                                                                                        {% for vehicleType in crewTransportOptions.vehicleTypes %}
                                                                                                            <option
                                                                                                                value="{{ vehicleType }}"
                                                                                                                {% if day.vehicleType == vehicleType %}selected{% endif %}
                                                                                                            >
                                                                                                                {{ ('vehicle_types.' ~ vehicleType)|trans({}, 'bgos_crew') }}
                                                                                                            </option>
                                                                                                        {% endfor %}
                                                                                                    </select>
                                                                                                </div>

                                                                                                <div class="col-12 col-md-6 col-xl-3">
                                                                                                    <label class="form-label">
                                                                                                        {{ 'fields.fuel'|trans({}, 'bgos_crew') }}
                                                                                                    </label>

                                                                                                    <select
                                                                                                        class="form-select form-select-sm"
                                                                                                        name="fuel"
                                                                                                    >
                                                                                                        <option value="">
                                                                                                            {{ 'common.not_defined'|trans({}, 'bgos_crew') }}
                                                                                                        </option>

                                                                                                        {% for fuel in crewTransportOptions.fuels %}
                                                                                                            <option
                                                                                                                value="{{ fuel }}"
                                                                                                                {% if day.fuel == fuel %}selected{% endif %}
                                                                                                            >
                                                                                                                {{ ('fuels.' ~ fuel)|trans({}, 'bgos_crew') }}
                                                                                                            </option>
                                                                                                        {% endfor %}
                                                                                                    </select>
                                                                                                </div>

                                                                                                <div class="col-12 col-md-6 col-xl-3">
                                                                                                    <label class="form-label">
                                                                                                        {{ 'fields.thermal_fuel'|trans({}, 'bgos_crew') }}
                                                                                                    </label>

                                                                                                    <select
                                                                                                        class="form-select form-select-sm"
                                                                                                        name="thermalFuel"
                                                                                                    >
                                                                                                        <option value="">
                                                                                                            {{ 'common.not_defined'|trans({}, 'bgos_crew') }}
                                                                                                        </option>

                                                                                                        {% for fuel in crewTransportOptions.thermalFuels %}
                                                                                                            <option
                                                                                                                value="{{ fuel }}"
                                                                                                                {% if day.thermalFuel == fuel %}selected{% endif %}
                                                                                                            >
                                                                                                                {{ ('fuels.' ~ fuel)|trans({}, 'bgos_crew') }}
                                                                                                            </option>
                                                                                                        {% endfor %}
                                                                                                    </select>
                                                                                                </div>

                                                                                                <div class="col-12 col-md-6 col-xl-3">
                                                                                                    <label class="form-label">
                                                                                                        {{ 'tracking.status'|trans({}, 'bgos_crew') }}
                                                                                                    </label>

                                                                                                    <select
                                                                                                        class="form-select form-select-sm"
                                                                                                        name="status"
                                                                                                    >
                                                                                                        {% for status in ['pending', 'resolved', 'not_applicable'] %}
                                                                                                            <option
                                                                                                                value="{{ status }}"
                                                                                                                {% if day.status == status %}selected{% endif %}
                                                                                                            >
                                                                                                                {{ ('tracking.statuses.' ~ status)|trans({}, 'bgos_crew') }}
                                                                                                            </option>
                                                                                                        {% endfor %}
                                                                                                    </select>
                                                                                                </div>
                                                                                            </div>

                                                                                            <div class="d-flex justify-content-end mt-3">
                                                                                                <button
                                                                                                    class="btn btn-sm btn-success"
                                                                                                    type="submit"
                                                                                                >
                                                                                                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                                                                                    {{ 'tracking.save_day'|trans({}, 'bgos_crew') }}
                                                                                                </button>
                                                                                            </div>
                                                                                        </form>
                                                                                    </div>
                                                                                {% endfor %}
                                                                            </div>
                                                                        {% endif %}
                                                                    </div>
                                                                {% endfor %}
                                                            </div>
                                                        {% endif %}

                                                        {% if window.view == 'day' and subcategory.active %}
                                                            <div class="border rounded p-3">
                                                                <div class="fw-semibold mb-2">
                                                                    {{ 'tracking.add_for_today'|trans({}, 'bgos_crew') }}
                                                                </div>

                                                                {% set hasCandidate = false %}

                                                                <div class="d-flex flex-wrap gap-2">
                                                                    {% for rosterRow in period.crewRoster %}
                                                                        {% set member = rosterRow.member %}

                                                                        {% if member.id not in crew.trackedMemberIds %}
                                                                            {% set hasCandidate = true %}

                                                                            {% if rosterRow.effectiveAssignment %}
                                                                                <form
                                                                                    method="post"
                                                                                    action="{{ path('backend_bgos_crew_day_add', {
                                                                                        crewMemberId: member.id
                                                                                    }) }}"
                                                                                >
                                                                                    <input
                                                                                        type="hidden"
                                                                                        name="date"
                                                                                        value="{{ window.selectedDate|date('Y-m-d') }}"
                                                                                    >

                                                                                    <input
                                                                                        type="hidden"
                                                                                        name="_token"
                                                                                        value="{{ csrf_token(
                                                                                            'bgos_crew_day_add_'
                                                                                            ~ member.id
                                                                                            ~ '_'
                                                                                            ~ window.selectedDate|date('Y-m-d')
                                                                                        ) }}"
                                                                                    >

                                                                                    <button
                                                                                        class="btn btn-sm btn-outline-success"
                                                                                        type="submit"
                                                                                    >
                                                                                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i>
                                                                                        {{ member.name }} {{ member.lastName }}
                                                                                    </button>
                                                                                </form>
                                                                            {% else %}
                                                                                <a
                                                                                    class="btn btn-sm btn-outline-warning"
                                                                                    href="{{ path('backend_bgos_crew') }}#crew-member-{{ member.id }}"
                                                                                >
                                                                                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                                                                                    {{ member.name }} {{ member.lastName }}
                                                                                </a>
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    {% endfor %}
                                                                </div>

                                                                {% if not hasCandidate %}
                                                                    <div class="small text-muted">
                                                                        {{ 'tracking.no_candidates'|trans({}, 'bgos_crew') }}
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    {% endfor %}

                                    {% if category.key == 'transport' and window.view == 'day' %}
                                        {% set hasVisibleSubcategory = true %}
                                        {% include 'backend/bgos/_crew_transport_journeys.html.twig' %}
                                    {% endif %}

                                    {% if not hasVisibleSubcategory %}
                                        <p class="bgos-agenda__empty mb-0">
                                            {{ 'backend.bgos.agenda.no_tracking'|trans }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </section>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
</div>
{% endblock %}
