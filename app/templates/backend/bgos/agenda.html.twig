{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'backend.bgos.agenda.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.bgos.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
{% set categoryVisuals = {
    transport: {
        icon: 'bi-truck',
        tone: 'transport'
    },
    energy: {
        icon: 'bi-lightning-charge-fill',
        tone: 'energy'
    },
    water: {
        icon: 'bi-droplet-fill',
        tone: 'water'
    },
    accommodation: {
        icon: 'bi-house-door-fill',
        tone: 'accommodation'
    },
    catering: {
        icon: 'bi-cup-hot-fill',
        tone: 'catering'
    },
    materials: {
        icon: 'bi-box-seam-fill',
        tone: 'materials'
    },
    waste: {
        icon: 'bi-recycle',
        tone: 'waste'
    }
} %}

<div class="container-fluid px-0 backend-client-shell bgos-agenda">
    <div class="backend-client-content">

        <header class="bgos-agenda__header">
            <div class="bgos-agenda__heading">
                <div class="bgos-agenda__eyebrow">
                    {{ 'backend.bgos.agenda.eyebrow'|trans }}
                </div>

                <h2 class="bgos-agenda__project-name">{{ project.name }}</h2>

                <p class="bgos-agenda__intro">
                    {{ 'backend.bgos.agenda.intro'|trans }}
                </p>
            </div>

            <a class="btn btn-outline-success bgos-agenda__configure"
               href="{{ path('backend_bgos_config') }}">
                <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                {{ 'backend.bgos.actions.configure'|trans }}
            </a>
        </header>

        {% if window is null %}
            <div class="alert alert-info">
                {{ 'backend.bgos.agenda.no_dates'|trans }}
            </div>
        {% else %}

            <section class="bgos-agenda__summary"
                     aria-label="{{ 'backend.bgos.agenda.period_emissions'|trans }}">
                <div class="bgos-agenda__summary-item bgos-agenda__summary-item--emissions">
                    <span class="bgos-agenda__summary-label">
                        {{ (window.view == 'total'
                            ? 'backend.bgos.agenda.project_emissions'
                            : 'backend.bgos.agenda.period_emissions')|trans }}
                    </span>

                    <strong class="bgos-agenda__summary-emissions">
                        {% if period.totalKgCo2e is null %}
                            —
                        {% else %}
                            {{ period.totalKgCo2e|number_format(2, ',', '.') }}
                            <span>kg CO₂e</span>
                        {% endif %}
                    </strong>
                </div>

                <div class="bgos-agenda__summary-divider" aria-hidden="true"></div>

                <div class="bgos-agenda__summary-item">
                    <span class="bgos-agenda__summary-label">
                        {{ 'backend.bgos.agenda.period'|trans }}
                    </span>

                    <strong class="bgos-agenda__summary-period">
                        {% if window.view == 'total' %}
                            {{ 'backend.bgos.agenda.full_project'|trans }}
                        {% elseif window.startDate == window.endDate %}
                            {{ window.startDate|date('d/m/Y') }}
                        {% else %}
                            {{ window.startDate|date('d/m/Y') }}
                            <span aria-hidden="true">→</span>
                            {{ window.endDate|date('d/m/Y') }}
                        {% endif %}
                    </strong>
                </div>
            </section>

            <section class="bgos-agenda__calendar">
                <div class="bgos-agenda__calendar-heading">
                    <h3 class="bgos-agenda__section-title">
                        {{ 'backend.bgos.agenda.calendar_title'|trans }}
                    </h3>

                    <nav aria-label="{{ 'backend.bgos.agenda.views_label'|trans }}">
                        <div class="btn-group bgos-agenda__views" role="group">
                            {% for view in views %}
                                <a
                                    class="btn btn-sm {{ window.view == view ? 'btn-secondary active' : 'btn-outline-secondary' }}"
                                    href="{{ path('backend_bgos_index', {
                                        view: view,
                                        date: window.selectedDate|date('Y-m-d')
                                    }) }}"
                                    {% if window.view == view %}aria-current="page"{% endif %}
                                >
                                    {{ ('backend.bgos.agenda.views.' ~ view)|trans }}
                                </a>
                            {% endfor %}
                        </div>
                    </nav>
                </div>

                <div class="bgos-agenda__period-navigation">
                    {% if window.previousDate %}
                        <a class="btn btn-sm btn-outline-secondary bgos-agenda__period-button"
                           href="{{ path('backend_bgos_index', {
                               view: window.view,
                               date: window.previousDate|date('Y-m-d')
                           }) }}"
                           title="{{ 'backend.bgos.agenda.previous'|trans }}">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            <span class="visually-hidden">
                                {{ 'backend.bgos.agenda.previous'|trans }}
                            </span>
                        </a>
                    {% else %}
                        <span class="bgos-agenda__period-button-spacer" aria-hidden="true"></span>
                    {% endif %}

                    <strong class="bgos-agenda__period-current">
                        {% if window.view == 'total' %}
                            {{ 'backend.bgos.agenda.full_project'|trans }}
                        {% elseif window.startDate == window.endDate %}
                            {{ window.startDate|date('d/m/Y') }}
                        {% else %}
                            {{ window.startDate|date('d/m/Y') }}
                            <span aria-hidden="true">–</span>
                            {{ window.endDate|date('d/m/Y') }}
                        {% endif %}
                    </strong>

                    {% if window.nextDate %}
                        <a class="btn btn-sm btn-outline-secondary bgos-agenda__period-button"
                           href="{{ path('backend_bgos_index', {
                               view: window.view,
                               date: window.nextDate|date('Y-m-d')
                           }) }}"
                           title="{{ 'backend.bgos.agenda.next'|trans }}">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            <span class="visually-hidden">
                                {{ 'backend.bgos.agenda.next'|trans }}
                            </span>
                        </a>
                    {% else %}
                        <span class="bgos-agenda__period-button-spacer" aria-hidden="true"></span>
                    {% endif %}
                </div>

                <div class="accordion bgos-agenda__categories"
                     id="bgos-agenda-categories">

                    {% for category in period.categories %}
                        {% set pct = category.completion.completionPercentage %}
                        {% set visual = categoryVisuals[category.key] ?? {
                            icon: 'bi-circle-fill',
                            tone: 'default'
                        } %}

                        <section
                            class="accordion-item bgos-agenda-category bgos-agenda-category--{{ visual.tone }}"
                            data-bgos-agenda-category="{{ category.key }}"
                        >
                            <h3 class="accordion-header"
                                id="bgos-agenda-heading-{{ category.key }}">

                                <button
                                    class="accordion-button bgos-agenda-category__header {{ loop.first ? '' : 'collapsed' }}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#bgos-agenda-category-{{ category.key }}"
                                    aria-expanded="{{ loop.first ? 'true' : 'false' }}"
                                    aria-controls="bgos-agenda-category-{{ category.key }}"
                                >
                                    <span class="bgos-agenda-category__icon" aria-hidden="true">
                                        <i class="bi {{ visual.icon }}"></i>
                                    </span>

                                    <span class="bgos-agenda-category__name">
                                        {{ category.labelKey|trans }}
                                    </span>

                                    <span class="bgos-agenda-category__progress-wrap">
                                        {% if pct is not null %}
                                            <span
                                                class="progress bgos-agenda-category__progress"
                                                role="progressbar"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                                aria-valuenow="{{ pct|round }}"
                                            >
                                                <span
                                                    class="progress-bar {{ pct >= 100 ? 'is-complete' : 'is-pending' }}"
                                                    style="width: {{ pct }}%"
                                                ></span>
                                            </span>

                                            <span class="bgos-agenda-category__percentage">
                                                {{ pct|round }}%
                                            </span>
                                        {% else %}
                                            <span class="bgos-agenda-category__progress bgos-agenda-category__progress--empty"></span>
                                        {% endif %}
                                    </span>

                                    <span class="bgos-agenda-category__emissions">
                                        {% if category.totalKgCo2e is null %}
                                            —
                                        {% else %}
                                            {{ category.totalKgCo2e|number_format(2, ',', '.') }}
                                            <small>kg CO₂e</small>
                                        {% endif %}
                                    </span>
                                </button>
                            </h3>

                            <div
                                id="bgos-agenda-category-{{ category.key }}"
                                class="accordion-collapse collapse {{ loop.first ? 'show' : '' }}"
                                aria-labelledby="bgos-agenda-heading-{{ category.key }}"
                                data-bs-parent="#bgos-agenda-categories"
                            >
                                <div class="accordion-body bgos-agenda-category__body">
                                    {% set hasVisibleSubcategory = false %}

                                    {% for subcategory in category.subcategories %}
                                        {% if subcategory.configured
                                            or subcategory.completion.expectedCount > 0
                                            or subcategory.totalKgCo2e is not null
                                        %}
                                            {% set hasVisibleSubcategory = true %}
                                            {% set subPct = subcategory.completion.completionPercentage %}

                                            <div
                                                class="bgos-agenda-subcategory"
                                                data-bgos-agenda-subcategory="{{ subcategory.key }}"
                                            >
                                                <div class="bgos-agenda-subcategory__main">
                                                    <div class="bgos-agenda-subcategory__name">
                                                        {{ subcategory.labelKey
                                                            ? subcategory.labelKey|trans
                                                            : subcategory.label }}
                                                    </div>

                                                    {% if subcategory.groupLabel %}
                                                        <div class="bgos-agenda-subcategory__group">
                                                            {{ subcategory.groupLabel }}
                                                        </div>
                                                    {% endif %}
                                                </div>

                                                <div class="bgos-agenda-subcategory__status bgos-agenda-subcategory__status--{{ subcategory.trackingStatus }}">
                                                    <span>
                                                        {{ ('backend.bgos.agenda.status.' ~ subcategory.trackingStatus)|trans }}
                                                    </span>

                                                    {% if subPct is not null %}
                                                        <strong>{{ subPct|round }}%</strong>
                                                    {% endif %}
                                                </div>

                                                <div class="bgos-agenda-subcategory__emissions">
                                                    {% if subcategory.totalKgCo2e is null %}
                                                        —
                                                    {% else %}
                                                        {{ subcategory.totalKgCo2e|number_format(2, ',', '.') }}
                                                        <small>kg CO₂e</small>
                                                    {% endif %}
                                                </div>

                                                {% if window.view == 'day'
                                                    and subcategory.configured
                                                    and subcategory.active
                                                    and subcategory.trackingStatus != 'not_applicable'
                                                %}
                                                    <div class="bgos-agenda-subcategory__action">
                                                        <a class="btn btn-sm btn-outline-success"
                                                           href="{{ path(entryRoutes[category.key], {
                                                               bgosDate: window.selectedDate|date('Y-m-d'),
                                                               bgosView: window.view,
                                                               bgosCategory: category.key,
                                                               bgosSubcategory: subcategory.key
                                                           }) }}">
                                                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                                            {{ (subcategory.trackingStatus == 'complete'
                                                                ? 'backend.bgos.actions.add_another_record'
                                                                : 'backend.bgos.actions.add_record')|trans }}
                                                        </a>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    {% endfor %}

                                    {% if not hasVisibleSubcategory %}
                                        <p class="bgos-agenda__empty mb-0">
                                            {{ 'backend.bgos.agenda.no_tracking'|trans }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </section>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
</div>
{% endblock %}
