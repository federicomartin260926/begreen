{% extends 'base_backend.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'backend.bgos.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.bgos.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
{% set categoryVisuals = {
    transport: {
        icon: 'bi-truck',
        tone: 'transport'
    },
    energy: {
        icon: 'bi-lightning-charge',
        tone: 'energy'
    },
    water: {
        icon: 'bi-droplet',
        tone: 'water'
    },
    accommodation: {
        icon: 'bi-house-door',
        tone: 'accommodation'
    },
    catering: {
        icon: 'bi-cup-straw',
        tone: 'catering'
    },
    materials: {
        icon: 'bi-box-seam',
        tone: 'materials'
    },
    waste: {
        icon: 'bi-recycle',
        tone: 'waste'
    }
} %}

<div class="container-fluid px-0 backend-client-shell bgos-config">
    <div class="backend-client-content">

        <header class="bgos-config__header">
            <div>
                <div class="bgos-config__eyebrow">
                    {{ 'backend.bgos.agenda.eyebrow'|trans }}
                </div>

                <h2 class="bgos-config__project-name">{{ project.name }}</h2>

                <p class="bgos-config__intro">
                    {{ 'backend.bgos.intro'|trans }}
                </p>
            </div>

            <a class="btn btn-outline-success bgos-config__back"
               href="{{ path('backend_bgos_index') }}">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                {{ 'backend.bgos.actions.back_to_agenda'|trans }}
            </a>
        </header>

        <div class="bgos-config__section-heading">
            <h3>{{ 'backend.bgos.eyebrow'|trans }}</h3>
        </div>

        <div class="accordion bgos-config__categories" id="bgos-categories">
            {% for category in categories %}
                {% set visual = categoryVisuals[category.key] ?? {
                    icon: 'bi-circle-fill',
                    tone: 'default'
                } %}

                <section
                    class="accordion-item bgos-config-category bgos-config-category--{{ visual.tone }}"
                    data-bgos-category="{{ category.key }}"
                >
                    <h3 class="accordion-header"
                        id="bgos-category-heading-{{ category.key }}">

                        <button
                            class="accordion-button bgos-config-category__header {{ category.open ? '' : 'collapsed' }}"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#bgos-category-{{ category.key }}"
                            aria-expanded="{{ category.open ? 'true' : 'false' }}"
                            aria-controls="bgos-category-{{ category.key }}"
                        >
                            <span class="bgos-config-category__icon" aria-hidden="true">
                                <i class="bi {{ visual.icon }}"></i>
                            </span>

                            <span class="bgos-config-category__name">
                                {{ category.labelKey|trans }}
                            </span>

                            <span class="bgos-config-category__count">
                                {{ category.subcategories|length }}
                            </span>
                        </button>
                    </h3>

                    <div
                        id="bgos-category-{{ category.key }}"
                        class="accordion-collapse collapse {{ category.open ? 'show' : '' }}"
                        aria-labelledby="bgos-category-heading-{{ category.key }}"
                        data-bs-parent="#bgos-categories"
                    >
                        <div class="accordion-body bgos-config-category__body">
                            {% for definition in category.subcategories %}

                                {% if definition.showGroup %}
                                    <h4
                                        class="bgos-config__group"
                                        data-bgos-group="{{ definition.groupKey }}"
                                    >
                                        {{ definition.groupLabel }}
                                    </h4>
                                {% endif %}

                                <form
                                    method="post"
                                    action="{{ path('backend_bgos_subcategory_save', {
                                        categoryKey: definition.categoryKey,
                                        subcategoryKey: definition.subcategoryKey
                                    }) }}"
                                    id="bgos-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                    class="bgos-config-row"
                                    data-bgos-subcategory="{{ definition.subcategoryKey }}"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token(
                                            'bgos_subcategory_save_' ~
                                            definition.categoryKey ~
                                            '_' ~
                                            definition.subcategoryKey
                                        ) }}"
                                    >

                                    <div class="bgos-config-row__name">
                                        {{ definition.labelKey
                                            ? definition.labelKey|trans
                                            : definition.label }}
                                    </div>

                                    <div class="bgos-config-row__frequency">
                                        <label
                                            class="form-label"
                                            for="bgos-preproduction-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                        >
                                            {{ phaseLabels.preproduction|trans }}
                                        </label>

                                        <select
                                            class="form-select form-select-sm"
                                            id="bgos-preproduction-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                            name="preproductionFrequency"
                                        >
                                            {% for frequency in frequencies %}
                                                <option
                                                    value="{{ frequency }}"
                                                    {{ definition.preproductionFrequency == frequency ? 'selected' : '' }}
                                                >
                                                    {{ ('backend.bgos.frequencies.' ~ frequency)|trans }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="bgos-config-row__frequency">
                                        <label
                                            class="form-label"
                                            for="bgos-activity-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                        >
                                            {{ phaseLabels.activity|trans }}
                                        </label>

                                        <select
                                            class="form-select form-select-sm"
                                            id="bgos-activity-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                            name="activityFrequency"
                                        >
                                            {% for frequency in frequencies %}
                                                <option
                                                    value="{{ frequency }}"
                                                    {{ definition.activityFrequency == frequency ? 'selected' : '' }}
                                                >
                                                    {{ ('backend.bgos.frequencies.' ~ frequency)|trans }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="bgos-config-row__frequency">
                                        <label
                                            class="form-label"
                                            for="bgos-postproduction-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                        >
                                            {{ phaseLabels.postproduction|trans }}
                                        </label>

                                        <select
                                            class="form-select form-select-sm"
                                            id="bgos-postproduction-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                            name="postproductionFrequency"
                                        >
                                            {% for frequency in frequencies %}
                                                <option
                                                    value="{{ frequency }}"
                                                    {{ definition.postproductionFrequency == frequency ? 'selected' : '' }}
                                                >
                                                    {{ ('backend.bgos.frequencies.' ~ frequency)|trans }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="bgos-config-row__active">
                                        <input type="hidden" name="active" value="0">

                                        <div class="form-check form-switch">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                role="switch"
                                                id="bgos-active-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                                name="active"
                                                value="1"
                                                {{ definition.active ? 'checked' : '' }}
                                            >

                                            <label
                                                class="form-check-label"
                                                for="bgos-active-{{ definition.categoryKey }}-{{ definition.subcategoryKey }}"
                                            >
                                                {{ 'backend.bgos.fields.active'|trans }}
                                            </label>
                                        </div>
                                    </div>

                                    <div class="bgos-config-row__action">
                                        <button class="btn btn-sm btn-primary" type="submit">
                                            <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                            {{ 'backend.bgos.actions.save'|trans }}
                                        </button>
                                    </div>
                                </form>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
