{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.plan.filters.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {% include 'backend/project/_breadcrumb_context.html.twig' with {breadcrumbProject: project} only %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.plan.filters.title'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0 backend-client-shell">
    <div class="backend-client-content">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
            <div>
                <h2 class="mb-1">{{ 'backend.plan.filters.heading'|trans }}</h2>
                <p class="text-muted mb-0">{{ 'backend.plan.filters.help'|trans }}</p>
            </div>
            <a class="btn btn-outline-secondary" href="{{ path('backend_plan_measures') }}">
                {{ 'backend.plan.filters.back'|trans }}
            </a>
        </div>

        {# Backend valida y muestra errores claros, en lugar de bloqueo HTML5 silencioso. #}
        {% if validationError is defined and validationError %}
            <div class="alert alert-danger" role="alert">
                {% if validationError starts with 'Debes responder el filtro ' %}
                    Debes responder todas las preguntas para continuar.
                    <span class="d-block small mt-1">{{ validationError|replace({'Debes responder el filtro ': 'Primera pregunta pendiente: '}) }}</span>
                {% else %}
                    {{ validationError }}
                {% endif %}
            </div>
        {% endif %}
        <form method="post" novalidate class="card shadow-sm border-0">
            <input type="hidden" name="_token" value="{{ csrf_token('plan_filters_' ~ plan.id) }}">
            <div class="card-body d-grid gap-4">
                {% for filter in filters %}
                    {% set code = filter.code %}
                    <fieldset class="border rounded p-3">
                        <legend class="float-none w-auto px-2 fs-6 fw-semibold mb-2">
                            <span class="badge bg-success me-2">{{ code }}</span>{{ filter.question }}
                        </legend>

                        {% if filter.type == 'boolean' %}
                            <div class="d-flex flex-wrap gap-3">
                                {% for value, labelKey in {'1': 'backend.common.yes', '0': 'backend.common.no'} %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" required
                                               id="filter-{{ code }}-{{ value }}" name="filters[{{ code }}]" value="{{ value }}"
                                               {% if answers[code] is defined and answers[code] is same as(value == '1') %}checked{% endif %}>
                                        <label class="form-check-label" for="filter-{{ code }}-{{ value }}">{{ labelKey|trans }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% elseif filter.type == 'multiple' %}
                            <div class="row g-2">
                                {% for option in filter.options %}
                                    <div class="col-12 col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="filter-{{ code }}-{{ loop.index }}" name="filters[{{ code }}][]" value="{{ option.value }}"
                                                   {% if option.value in (answers[code]|default([])) %}checked{% endif %}>
                                            <label class="form-check-label" for="filter-{{ code }}-{{ loop.index }}">{{ option.label }}</label>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <select class="form-select" required name="filters[{{ code }}]" id="filter-{{ code }}">
                                <option value="">{{ 'backend.plan.filters.choose'|trans }}</option>
                                {% for option in filter.options %}
                                    <option value="{{ option.value }}" {% if answers[code]|default(null) == option.value %}selected{% endif %}>{{ option.label }}</option>
                                {% endfor %}
                            </select>
                        {% endif %}

                        <div class="small text-muted mt-2">
                            <strong>{{ 'backend.plan.filters.exclusion'|trans }}:</strong> {{ filter.excludesWhen }}
                        </div>
                        <div class="small text-muted mt-1">
                            <strong>{{ 'backend.plan.filters.evidence'|trans }}:</strong> {{ filter.objectiveEvidence }}
                        </div>
                    </fieldset>
                {% endfor %}
            </div>
            <div class="card-footer bg-white d-flex justify-content-end">
                <button class="btn btn-success" type="submit">{{ 'backend.plan.filters.save'|trans }}</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
