{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.plan.done.title'|trans }}{% endblock %}

{% block body %}
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 bg-white p-5 rounded shadow text-center">
      <h1 class="mb-3">{{ 'backend.plan.done.h1'|trans }}</h1>
      <p class="lead mb-4">
        {{ 'backend.plan.done.lead'|trans({'%project%': project.name})|raw }}
      </p>
      <a href="{{ path('backend_plan_review', { is_applicable: '1', will_implement: '1' }) }}" class="btn btn-primary text-decoration-none">{{ 'backend.plan.done.view_btn'|trans }}</a>
    </div>
  </div>
</div>
{% endblock %}
