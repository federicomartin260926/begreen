{% set panelId = panelId|default('locked-features-panel') %}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="fw-semibold">{{ 'backend.plan.features_blocked_panel_title'|trans }}</div>
                {% if panelHelp is defined and panelHelp %}
                    <div class="text-muted small">{{ panelHelp }}</div>
                {% endif %}
            </div>
            <button
                class="btn btn-outline-secondary btn-sm"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#{{ panelId }}"
                aria-expanded="false"
                aria-controls="{{ panelId }}">
                {{ 'backend.plan.features_blocked_panel_open'|trans }}
            </button>
        </div>

        <div class="collapse mt-3" id="{{ panelId }}">
            <div class="row g-3">
                {% for card in commercialCards %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="border rounded p-3 h-100 bg-light">
                            <div class="fw-semibold">{{ card.label }}</div>
                            <div class="small text-muted">{{ card.reason }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-3">
                <button
                    class="btn btn-link btn-sm px-0 text-decoration-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#{{ panelId }}"
                    aria-expanded="true"
                    aria-controls="{{ panelId }}">
                    {{ 'backend.plan.features_blocked_panel_close'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
