<div id="plan-commercial-summary" class="card border shadow-sm mb-3">
    <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <strong>{{ 'backend.plan.tier.phase_current'|trans({'%phase%': phaseLabel, '%tier%': projectTierLabel}) }}</strong>
        <div class="d-flex align-items-center flex-wrap gap-2">
            {% if projectTier != 'pro' %}
                {% include 'backend/plan/_upgrade_cta.html.twig' with {
                    upgradeCta: upgradeCta|merge({buttonLabel: phaseUpgradeLabel, comparisonFrom: comparisonFrom|default('measures'), buttonClass: 'btn btn-outline-success btn-sm px-3'}),
                    project: project
                } %}
            {% endif %}
            {% if showComparisonLink|default(false) %}
                <a href="{{ path('backend_project_plan_comparison', {id: project.id, phase: upgradeCta.phase, from: comparisonFrom|default('measures')}) }}" class="btn btn-link btn-sm px-1 text-decoration-none">
                    {{ 'backend.plan.upgrade.compare_plans'|trans }}
                </a>
            {% endif %}
        </div>
    </div>
</div>
