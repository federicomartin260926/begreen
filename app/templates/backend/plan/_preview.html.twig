{# templates/backend/plan/_preview.html.twig #}
<style>
    #plan-preview-content thead th{
        background-color: #3FC38A0D !important;
    }
</style>

<div id="plan-preview-content" class="px-4 py-3 d-flex flex-column h-100">
    <h2 class="text-center">
        {{ 'backend.plan.preview.title'|trans({
            '%project%': project.name|slice(0, 50) ~ (project.name|length > 50 ? '…' : '')
        }) }}
    </h2>

    <div class="text-center text-muted mb-2">
        {{ 'backend.plan.preview.status'|trans({
            '%status%': ('backend.plan.status.' ~ plan.status)|trans
        })|raw }}
        <br>
        {# ---línea: puntuación --- #}
        {% if scoreMax is defined and scoreMax > 0 %}
            <strong>{{ 'backend.plan.pdf.score.title'|trans }}</strong>
            {{ 'backend.plan.pdf.score.value'|trans({
            '%gained%': scoreGained,
            '%max%': scoreMax,
            '%pct%': (scorePct ~ '%')
            }) }}
        {% else %}
            <strong>{{ 'backend.plan.pdf.score.title'|trans }}</strong>
            {{ 'backend.plan.pdf.score.na'|trans }}
        {% endif %}
    </div>

    {# Bloque filtros activos #}
    {% if activeFilters is not empty %}
        <div class="alert alert-secondary small mb-4">
            <strong>{{ 'backend.plan.preview.filters_applied'|trans }}</strong>
            <ul class="mb-0 ps-3">
                {% for name, value in activeFilters %}
                    <li>{{ name }}: {{ value }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="text-center text-muted mb-4">
        {{ 'backend.plan.preview.date'|trans }} {{ "now"|date("d/m/Y") }}<br>
        {{ 'backend.plan.preview.user'|trans }} {{ currentUserLabel|default(app.user.email ?? '') }}
    </div>

    {% if commitmentSummary is defined %}
        {% include 'backend/plan/_commitment_banner.html.twig' with { commitmentSummary: commitmentSummary } %}
    {% endif %}

    <div class="flex-grow-1 overflow-auto pe-1" style="min-height: 0;">
        {% if measuresByDpto is empty %}
            <p class="text-center fw-semibold">{{ 'backend.plan.preview.empty'|trans }}</p>
        {% else %}
            <h4>{{ 'backend.plan.preview.summary_by_department'|trans }}</h4>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="bg_green_1">
                        <tr>
                            <th>{{ 'backend.plan.preview.th.department'|trans }}</th>
                            <th>{{ 'backend.plan.preview.th.total_measures'|trans }}</th>
                            <th>{{ 'backend.plan.preview.th.applicable'|trans }}</th>
                            <th>{{ 'backend.plan.preview.th.to_implement'|trans }}</th>
                            <th>{{ 'backend.plan.preview.th.critical_yes'|trans }}</th>
                            {% if plan.status == 'completo' %}
                                <th>{{ 'backend.plan.preview.th.implemented'|trans }}</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for dpto, measures in measuresByDpto %}
                        <tr>
                            <td>{{ dpto }}</td>
                            <td>{{ measures|length }}</td>
                            <td>{{ measures|filter(pm => pm.isApplicable)|length }}</td>
                            <td>{{ measures|filter(pm => pm.willImplement)|length }}</td>
                            <td>{{ measures|filter(pm => pm.isCritical)|length }}</td>
                            {% if plan.status == 'completo' %}
                                <td>{{ measures|filter(pm => pm.isImplemented)|length }}</td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% for dpto, measures in measuresByDpto %}
                <h5 class="mt-4">{{ dpto }}</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>{{ 'backend.plan.preview.th.measure'|trans }}</th>
                                <th>{{ 'backend.plan.preview.th.applicable_q'|trans }}</th>
                                <th>{{ 'backend.plan.preview.th.implement_q'|trans }}</th>
                                {% if plan.status == 'completo' %}
                                    <th>{{ 'backend.plan.preview.th.implemented_q'|trans }}</th>
                                {% endif %}
                                <th>{{ 'backend.plan.preview.th.critical'|trans }}</th>
                                <th>{{ 'backend.plan.measure.department'|trans }}</th>
                                <th>{{ 'backend.plan.preview.th.ods'|trans }}</th>
                                <th>{{ 'backend.plan.review.verification_sources'|trans }}</th>
                                <th>Áreas de impacto</th>
                                <th>Triple balance</th>
                                <th>{{ 'backend.plan.preview.th.follow_up'|trans }}</th>
                                <th>{{ 'backend.plan.preview.th.notes'|trans }}</th>
                                <th>{{ 'backend.plan.preview.th.esg'|trans }}</th>
                                <th>{{ 'backend.plan.preview.th.scope'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for pm in measures %}
                                <tr>
                                    <td>{{ pm.measure.name }}</td>
                                    <td>{{ pm.isApplicable ? ('backend.plan.preview.yes'|trans) : ('backend.plan.preview.no'|trans) }}</td>
                                    <td>{{ pm.willImplement ? ('backend.plan.preview.yes'|trans) : ('backend.plan.preview.no'|trans) }}</td>
                                    {% if plan.status == 'completo' %}
                                        <td>{{ pm.isImplemented ? ('backend.plan.preview.yes'|trans) : ('backend.plan.preview.no'|trans) }}</td>
                                    {% endif %}
                                    <td>
                                        {{ pm.isCritical is same as(true)
                                            ? ('backend.plan.preview.yes'|trans)
                                            : (pm.isCritical is same as(false) ? ('backend.plan.preview.no'|trans) : '—') }}
                                        {% if pm.criticalReason %}
                                            <div class="small text-muted mt-1">{{ pm.criticalReason }}</div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set departments = pm.measure ? taxonomyPresenter.departmentBadges(pm.measure, project.type|default(null)) : [] %}
                                        {% if departments is not empty %}
                                            {% for department in departments %}
                                                <span class="badge bg-success-subtle text-success-emphasis border"
                                                      title="{{ department.title|default(department.displayName) }}">
                                                    {{ department.displayName }}
                                                </span>
                                            {% endfor %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set odsItems = pm.measure ? taxonomyPresenter.odsBadges(pm.measure) : [] %}
                                        {% if odsItems is not empty %}
                                            {% for ods in odsItems %}
                                                <span class="badge bg-warning-subtle text-warning-emphasis border"
                                                      title="{{ ods.title|default(ods.label) }}">
                                                    {{ ods.badgeLabel|default(ods.label) }}
                                                </span>
                                            {% endfor %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set sources = pm.measure ? taxonomyPresenter.verificationSourcesWithPriority(pm.measure) : [] %}
                                        {% if sources is not empty %}
                                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                                {% for link in sources %}
                                                    <span class="badge bg-light text-dark border rounded-pill">
                                                        {{ link.displayName|default(link.name) }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            {{ pm.measure and pm.measure.verificationSources ? pm.measure.verificationSources : '—' }}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set impactAreas = pm.measure ? taxonomyPresenter.impactAreas(pm.measure) : [] %}
                                        {% if impactAreas is not empty %}
                                            {% for impactArea in impactAreas %}
                                                <span class="badge bg-success-subtle text-success-emphasis border">{{ impactArea.name }}</span>
                                            {% endfor %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set axes = pm.measure ? taxonomyPresenter.tripleBalanceAxes(pm.measure) : [] %}
                                        {% if axes is not empty %}
                                            {% for axis in axes %}
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis border">{{ axis.name }}</span>
                                            {% endfor %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div><span class="fw-semibold">{{ 'backend.plan.preview.implemented'|trans }}:</span> {{ pm.isImplemented ? ('backend.common.yes'|trans) : ('backend.common.no'|trans) }}</div>
                                        <div><span class="fw-semibold">{{ 'backend.plan.preview.verified'|trans }}:</span> {{ pm.verification ? ('backend.common.yes'|trans) : ('backend.common.no'|trans) }}</div>
                                        <div><span class="fw-semibold">{{ 'backend.plan.preview.evidences'|trans }}:</span> {{ pm.evidence ? pm.evidence|split("\n")|filter(v => v)|length : 0 }}</div>
                                        <div>
                                            <span class="fw-semibold">{{ 'backend.plan.preview.responsibles'|trans }}:</span>
                                            {% set responsibles = [] %}
                                            {% for member in pm.responsibleCrewMembers %}
                                                {% set responsibles = responsibles|merge([((member.name ?? '') ~ ' ' ~ (member.lastName ?? ''))|trim]) %}
                                            {% endfor %}
                                            {{ responsibles is not empty ? responsibles|join(', ') : '—' }}
                                        </div>
                                    </td>
                                    <td>
                                        {% if pm.executionIncident %}
                                            <div class="small">{{ pm.executionIncident }}</div>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>{{ pm.measure and pm.measure.esg ? pm.measure.esg.name : '—' }}</td>
                                    <td>{{ pm.measure and pm.measure.scope ? pm.measure.scope.name : '—' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endfor %}

            {% if customMeasures is defined and customMeasures is not empty %}
                <h4 class="mt-4">{{ 'backend.plan.preview.custom_measures.title'|trans }}</h4>
                <div class="row g-3">
                    {% for customMeasure in customMeasures %}
                        <div class="col-12 col-md-6">
                            <div class="border rounded p-3 h-100 bg-light">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div class="fw-semibold">{{ customMeasure.title }}</div>
                                    <span class="badge bg-success-subtle text-success border">{{ 'backend.plan.preview.custom_measures.badge'|trans }}</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    <span class="text-capitalize">{{ ('backend.plan.review.custom_measures.state.' ~ customMeasure.state)|trans }}</span>
                                </div>
                                {% if customMeasure.description %}
                                    <div class="small mt-2">{{ customMeasure.description }}</div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
