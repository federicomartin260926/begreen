{# templates/backend/plan/_pagination.html.twig #}
{% if totalPages > 1 %}
    {% set startPage = currentPage - 2 %}
    {% set endPage = currentPage + 2 %}
    {% if startPage < 1 %}
        {% set endPage = endPage + (1 - startPage) %}
        {% set startPage = 1 %}
    {% endif %}
    {% if endPage > totalPages %}
        {% set startPage = startPage - (endPage - totalPages) %}
        {% set endPage = totalPages %}
        {% if startPage < 1 %}
            {% set startPage = 1 %}
        {% endif %}
    {% endif %}

    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination mb-0">
            {# Previous #}
            <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                <a class="page-link text-decoration-none"
                   href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': currentPage - 1})) }}"
                   tabindex="-1">&laquo; {{ 'backend.pagination.previous'|trans }}</a>
            </li>

            {# Ellipsis before #}
            {% if startPage > 1 %}
                <li class="page-item">
                    <a class="page-link text-decoration-none"
                       href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': 1})) }}">1</a>
                </li>
                {% if startPage > 2 %}
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                {% endif %}
            {% endif %}

            {# Central pages #}
            {% for p in startPage..endPage %}
                <li class="page-item {% if p == currentPage %}active{% endif %}">
                    <a class="page-link text-decoration-none"
                       href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': p})) }}">{{ p }}</a>
                </li>
            {% endfor %}

            {# Ellipsis after #}
            {% if endPage < totalPages %}
                {% if endPage < totalPages - 1 %}
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                {% endif %}
                <li class="page-item">
                    <a class="page-link text-decoration-none"
                       href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': totalPages})) }}">{{ totalPages }}</a>
                </li>
            {% endif %}

            {# Next #}
            <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                <a class="page-link text-decoration-none"
                   href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': currentPage + 1})) }}">{{ 'backend.pagination.next'|trans }} &raquo;</a>
            </li>
        </ul>
    </nav>
{% endif %}
