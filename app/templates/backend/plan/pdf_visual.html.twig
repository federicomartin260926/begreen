{% extends 'backend/plan/pdf/_base_visual.html.twig' %}

{% block pdf_extra_styles %}
    {% if reportDesignCss is defined and reportDesignCss %}
        {{ reportDesignCss|raw }}

        /*
         * Layout firewall:
         * el diseño IA puede cambiar presentación interna, jerarquía,
         * tipografía y color, pero la geometría/paginación A4 sigue
         * siendo responsabilidad de la plantilla estable.
         */
        .cover,
        .analytics,
        .ai_report,
        .departments,
        .final_conclusion {
            margin: 0 !important;
            padding: 0 !important;
            border: 0 !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            position: static !important;
            overflow: visible !important;
            page-break-before: auto !important;
            page-break-after: auto !important;
            page-break-inside: auto !important;
            break-before: auto !important;
            break-after: auto !important;
            break-inside: auto !important;
        }

        .pdf-page {
            position: relative !important;
            width: 210mm !important;
            height: 297mm !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            page-break-after: always !important;
        }

        .pdf-page--last {
            page-break-after: auto !important;
        }
    {% endif %}
{% endblock %}

{% block pdf_body %}
    {% if reportDesignHtml is defined and reportDesignHtml is not null %}
        {{ reportDesignHtml|raw }}
    {% else %}
        {% include 'backend/plan/pdf/_cover.html.twig' %}
        {% include 'backend/plan/pdf/_analytics.html.twig' %}
        {% include 'backend/plan/pdf/_ai_report.html.twig' %}
        {% include 'backend/plan/pdf/_departments.html.twig' %}
        {% include 'backend/plan/pdf/_final_conclusion.html.twig' %}
    {% endif %}
{% endblock %}
