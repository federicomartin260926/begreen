{% extends 'backend/plan/pdf/_base_visual.html.twig' %}

{% block pdf_extra_styles %}
    {% if reportDesignCss is defined and reportDesignCss %}
        {{ reportDesignCss|raw }}

        /*
         * Layout firewall.
         *
         * El diseño IA puede modificar la presentación visual,
         * pero las páginas físicas, la geometría A4 y la paginación
         * pertenecen siempre a la plantilla estable.
         */
        .report-design-cover {
            position: relative !important;
            width: 210mm !important;
            height: 297mm !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            page-break-after: always !important;
        }

        .report-design-analytics,
        .report-design-departments,
        .report-design-ai-report {
            position: relative !important;
            width: 210mm !important;
            height: 296mm !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            page-break-after: always !important;
        }

        .report-design-ai-report.pdf-ai-page--last {
            page-break-after: auto !important;
        }

        .report-design-final-conclusion {
            position: relative !important;
            width: 210mm !important;
            height: 297mm !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            page-break-after: auto !important;
        }
    {% endif %}
{% endblock %}

{% block pdf_body %}
    {% if reportDesignHtml is defined and reportDesignHtml is not null %}
        {{ reportDesignHtml|raw }}
    {% else %}
        {% include 'backend/plan/pdf/_cover.html.twig' %}
        {% include 'backend/plan/pdf/_analytics.html.twig' %}
        {% include 'backend/plan/pdf/_ai_report.html.twig' %}
        {% include 'backend/plan/pdf/_departments.html.twig' %}
        {% include 'backend/plan/pdf/_final_conclusion.html.twig' %}
    {% endif %}
{% endblock %}
