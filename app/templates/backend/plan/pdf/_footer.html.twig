{% set footerVariant = footerVariant|default('cover') %}
<footer class="pdf-vegetal-footer pdf-vegetal-footer--{{ footerVariant }}">
    <div class="pdf-vegetal-footer__caption">
        {{ 'backend.plan.pdf_visual.footer_label'|trans }}
    </div>
    {% if pdfVisualAssets.vegetation|default('') %}
        <table class="pdf-vegetal-footer__plants" role="presentation">
            <tr>
                {% for item in 1..3 %}
                    <td class="pdf-vegetal-footer__plant-cell">
                        <img
                            class="pdf-vegetal-footer__plant"
                            src="{{ pdfVisualAssets.vegetation }}"
                            alt="">
                    </td>
                {% endfor %}
            </tr>
        </table>
    {% endif %}
</footer>
