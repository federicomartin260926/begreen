{% macro categoryCard(category) %}
    <table class="pdf-ai-page__category" role="presentation">
        <tr>
            <td class="pdf-ai-page__category-cell">
                <h3 class="pdf-ai-page__category-title">
                    {{ category.name }}
                </h3>

                <p class="pdf-ai-page__category-summary">
                    {{ category.summary }}
                </p>

                {% if category.committedMeasures is not empty %}
                    <div class="pdf-ai-page__commitments">
                        {% for measure in category.committedMeasures %}
                            <div class="pdf-ai-page__commitment{% if measure.critical %} pdf-ai-page__commitment--critical{% endif %}">
                                <span class="pdf-ai-page__commitment-check">✓</span>
                                <span class="pdf-ai-page__commitment-name">{{ measure.name }}</span>
                                {% if measure.critical %}
                                    <span class="pdf-ai-page__commitment-critical">
                                        {{ 'backend.plan.pdf_visual.ai_report.critical'|trans }}
                                    </span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if category.futureMeasures is not empty %}
                    <div class="pdf-ai-page__future">
                        <div class="pdf-ai-page__future-title">
                            {{ 'backend.plan.pdf_visual.ai_report.future'|trans }}
                        </div>
                        {% for measure in category.futureMeasures %}
                            <div class="pdf-ai-page__future-measure">
                                {{ measure.name }}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

            </td>
        </tr>
    </table>
{% endmacro %}

{% import _self as report %}

{% set categoryPages = [] %}
{% set currentPage = [] %}

{% for category in aiCategorySummaries %}
    {% if category.name == 'Transporte' or category.name == 'Transport' %}
        {% if currentPage is not empty %}
            {% set categoryPages = categoryPages|merge([currentPage]) %}
            {% set currentPage = [] %}
        {% endif %}

        {% set categoryPages = categoryPages|merge([[category]]) %}
    {% else %}
        {% set currentPage = currentPage|merge([category]) %}

        {% if currentPage|length == 4 %}
            {% set categoryPages = categoryPages|merge([currentPage]) %}
            {% set currentPage = [] %}
        {% endif %}
    {% endif %}
{% endfor %}

{% if currentPage is not empty %}
    {% set categoryPages = categoryPages|merge([currentPage]) %}
{% endif %}

{% for categoryPage in categoryPages %}
    <section class="pdf-ai-page{% if loop.last %} pdf-ai-page--last{% endif %}">
        {% include 'backend/plan/pdf/_watermark.html.twig' %}

        {% include 'backend/plan/pdf/_header.html.twig' with {
            headerVariant: 'cover'
        } %}

        <main class="pdf-ai-page__content">
            <h2 class="pdf-ai-page__section-title">
                {{ 'backend.plan.pdf_visual.ai_report.category_summaries'|trans }}
            </h2>

            {% for category in categoryPage %}
                {% if category is not null %}
                    {{ report.categoryCard(category) }}
                {% endif %}
            {% endfor %}
        </main>
    </section>
{% endfor %}
