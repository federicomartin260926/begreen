{% macro measureCard(measure, category, showObservations) %}
    <div class="pdf-ai-page__measure-block">
        <div
            class="pdf-ai-page__measure-pill{% if measure.critical %} pdf-ai-page__measure-pill--critical{% endif %}"
            style="
                border-color: {{ category.visual.color }};
                color: {{ category.visual.color }};
                background: {{ category.visual.background }};
            "
        >
            <table class="pdf-ai-page__measure-layout" role="presentation">
                <tr>
                    <td class="pdf-ai-page__measure-check-cell">
                        <span class="pdf-ai-page__measure-check">✓</span>
                    </td>
                    <td class="pdf-ai-page__measure-name">
                        {{ measure.name }}
                    </td>
                    {% if measure.critical %}
                        <td class="pdf-ai-page__measure-critical-cell">
                            <span
                                class="pdf-ai-page__measure-critical"
                                style="
                                    border-color: {{ category.visual.color }};
                                    color: {{ category.visual.color }};
                                "
                            >
                                {{ 'backend.plan.pdf_visual.ai_report.critical'|trans }}
                            </span>
                        </td>
                    {% endif %}
                </tr>
            </table>
        </div>

        {% if showObservations and measure.observations is not empty %}
            <div class="pdf-ai-page__measure-observation">
                <strong>{{ 'backend.plan.pdf_visual.ai_report.observations'|trans }}:</strong>
                {{ measure.observations }}
            </div>
        {% endif %}
    </div>
{% endmacro %}

{% macro categoryContent(category, measures, showSummary, showFutureSummary, continuation, showObservations) %}
    {% import _self as report %}

    <h2 class="pdf-ai-page__section-title">
        {{ 'backend.plan.pdf_visual.ai_report.category_summaries'|trans }}
    </h2>

    <table class="pdf-ai-page__category" role="presentation">
        <tr>
            <td class="pdf-ai-page__category-cell">
                <div
                    class="pdf-ai-page__category-card"
                    style="border-color: {{ category.visual.color }};"
                >
                <div class="pdf-ai-page__category-heading">
                    <span
                        class="pdf-ai-page__category-icon"
                        style="background: {{ category.visual.background }};"
                    >
                        <img
                            src="{{ category.visual.icon }}"
                            alt=""
                        >
                    </span>

                    <h3
                        class="pdf-ai-page__category-title"
                        style="color: {{ category.visual.color }};"
                    >
                        {{ category.name }}
                        {% if continuation %}
                            <span class="pdf-ai-page__category-continuation">
                                · {{ 'backend.plan.pdf_visual.ai_report.continuation'|trans }}
                            </span>
                        {% endif %}
                    </h3>
                </div>

                {% if showSummary %}
                    <p class="pdf-ai-page__category-summary">
                        {{ category.summary }}
                    </p>
                {% endif %}

                {% if measures is not empty %}
                    <div class="pdf-ai-page__measures">
                        {% for measure in measures %}
                            {{ report.measureCard(measure, category, showObservations) }}
                        {% endfor %}
                    </div>
                {% endif %}

                {% if showFutureSummary and category.futureSummary is not empty %}
                    <div class="pdf-ai-page__future">
                        <h4
                            class="pdf-ai-page__future-title"
                            style="color: {{ category.visual.color }};"
                        >
                            {{ 'backend.plan.pdf_visual.ai_report.future_horizon'|trans }}
                        </h4>

                        <p class="pdf-ai-page__future-summary">
                            {{ category.futureSummary }}
                        </p>
                    </div>
                {% endif %}
                </div>
            </td>
        </tr>
    </table>
{% endmacro %}

{% import _self as report %}

{% set categoryFragments = [] %}
{% set showObservations = projectTier|default('basic') == 'basic' %}

{#
    Fragmentación física segura.

    Se mantiene la fragmentación ya validada:
    - 3 medidas cuando existe resumen futuro;
    - 4 medidas en el resto.

    Cada fragmento recibe además un peso aproximado basado en el
    contenido que realmente ocupa altura: resumen, medidas,
    observaciones y próxima edición.
#}
{% for category in aiCategorySummaries %}
    {% if category is not null %}
        {% set measures = category.committedMeasures %}
        {% set hasFutureSummary = category.futureSummary is not empty %}
        {% set measureChunkSize = hasFutureSummary ? 3 : 4 %}
        {% set measureChunks = measures|batch(measureChunkSize) %}
        {% set categoryKey = category.key|default(category.name|default('')) %}

        {% if measures is empty %}
            {% set summaryLength = category.summary|default('')|length %}
            {% set futureLength = hasFutureSummary
                ? category.futureSummary|default('')|length
                : 0
            %}

            {% set fragmentWeight =
                220
                + summaryLength
                + (futureLength * 0.8)
            %}

            {% set categoryFragments = categoryFragments|merge([{
                category: category,
                categoryKey: categoryKey,
                measures: [],
                showSummary: true,
                showFutureSummary: hasFutureSummary,
                continuation: false,
                weight: fragmentWeight
            }]) %}
        {% else %}
            {% for chunk in measureChunks %}
                {% set showSummary = loop.first %}
                {% set showFutureSummary = hasFutureSummary and loop.last %}

                {% set summaryLength = showSummary
                    ? category.summary|default('')|length
                    : 0
                %}

                {% set futureLength = showFutureSummary
                    ? category.futureSummary|default('')|length
                    : 0
                %}

                {% set observationsLength = 0 %}
                {% set titlesLength = 0 %}

                {% for measure in chunk %}
                    {% set titlesLength =
                        titlesLength
                        + measure.title|default('')|length
                    %}

                    {% if showObservations %}
                        {% set observationsLength =
                            observationsLength
                            + measure.observations|default('')|length
                        %}
                    {% endif %}
                {% endfor %}

                {#
                    Peso empírico conservador.

                    No representa píxeles/mm: únicamente permite comparar
                    tamaños relativos de los fragmentos antes de entregarlos
                    a Dompdf.
                #}
                {% set fragmentWeight =
                    220
                    + summaryLength
                    + (futureLength * 0.8)
                    + (titlesLength * 0.7)
                    + (observationsLength * 0.9)
                    + (chunk|length * 180)
                %}

                {% set categoryFragments = categoryFragments|merge([{
                    category: category,
                    categoryKey: categoryKey,
                    measures: chunk,
                    showSummary: showSummary,
                    showFutureSummary: showFutureSummary,
                    continuation: not loop.first,
                    weight: fragmentWeight
                }]) %}
            {% endfor %}
        {% endif %}
    {% endif %}
{% endfor %}

{#
    Empaquetado secuencial conservador.

    - máximo 2 fragmentos por página;
    - nunca juntamos dos fragmentos de la misma categoría;
    - presupuesto máximo aproximado: 2600;
    - si no hay seguridad suficiente, se conserva página exclusiva.
#}
{% set pageWeightLimit = 2600 %}
{% set reportPages = [] %}
{% set currentPageFragments = [] %}
{% set currentPageWeight = 0 %}
{% set currentPageCategoryKey = null %}

{% for fragment in categoryFragments %}
    {% set canJoinCurrentPage =
        currentPageFragments|length == 1
        and currentPageCategoryKey != fragment.categoryKey
        and (currentPageWeight + fragment.weight) <= pageWeightLimit
    %}

    {% if currentPageFragments is empty %}
        {% set currentPageFragments = [fragment] %}
        {% set currentPageWeight = fragment.weight %}
        {% set currentPageCategoryKey = fragment.categoryKey %}
    {% elseif canJoinCurrentPage %}
        {% set currentPageFragments = currentPageFragments|merge([fragment]) %}
        {% set currentPageWeight = currentPageWeight + fragment.weight %}

        {# Máximo dos: cerramos inmediatamente la página. #}
        {% set reportPages = reportPages|merge([{
            fragments: currentPageFragments,
            weight: currentPageWeight
        }]) %}

        {% set currentPageFragments = [] %}
        {% set currentPageWeight = 0 %}
        {% set currentPageCategoryKey = null %}
    {% else %}
        {% set reportPages = reportPages|merge([{
            fragments: currentPageFragments,
            weight: currentPageWeight
        }]) %}

        {% set currentPageFragments = [fragment] %}
        {% set currentPageWeight = fragment.weight %}
        {% set currentPageCategoryKey = fragment.categoryKey %}
    {% endif %}
{% endfor %}

{% if currentPageFragments is not empty %}
    {% set reportPages = reportPages|merge([{
        fragments: currentPageFragments,
        weight: currentPageWeight
    }]) %}
{% endif %}

{% for reportPage in reportPages %}
    <section
        class="pdf-ai-page{% if loop.last %} pdf-ai-page--last{% endif %}"
        data-pdf-page-weight="{{ reportPage.weight|round }}"
        data-pdf-fragment-count="{{ reportPage.fragments|length }}">

        {% include 'backend/plan/pdf/_watermark.html.twig' %}

        {% include 'backend/plan/pdf/_header.html.twig' with {
            headerVariant: 'cover'
        } %}

        <main class="pdf-ai-page__content">
            {% for categoryPage in reportPage.fragments %}
                {{ report.categoryContent(
                    categoryPage.category,
                    categoryPage.measures,
                    categoryPage.showSummary,
                    categoryPage.showFutureSummary,
                    categoryPage.continuation,
                    showObservations
                ) }}
            {% endfor %}
        </main>
    </section>
{% endfor %}
