{% set statusLabel = ('backend.plan.status.' ~ plan.status)|trans %}
{% set displayedScorePct = scorePct is not null ? scorePct : 0 %}
{% set plannedCommitment = commitmentSummary.planned %}
{% set commitmentLevels = [
    {key: 'seed', labelKey: 'backend.plan.commitment.levels.seed.label'},
    {key: 'plant', labelKey: 'backend.plan.commitment.levels.plant.label'},
    {key: 'tree', labelKey: 'backend.plan.commitment.levels.tree.label'},
    {key: 'forest', labelKey: 'backend.plan.commitment.levels.forest.label'},
    {key: 'jungle', labelKey: 'backend.plan.commitment.levels.jungle.label'}
] %}

<section class="pdf-page pdf-page--cover">
    {% include 'backend/plan/pdf/_watermark.html.twig' %}

    {% include 'backend/plan/pdf/_header.html.twig' with { headerVariant: 'cover' } %}

    <main class="pdf-cover pdf-cover--approved">
        <table class="pdf-cover-approved__hero" role="presentation">
            <tr>
                <td class="pdf-cover-approved__main">
                    <div class="pdf-cover-approved__main-content">
                    <h1 class="pdf-cover__title">
                        {{ 'backend.plan.pdf_visual.cover.title'|trans }}
                    </h1>

                    <h2 class="pdf-cover__project">{{ project.name }}</h2>

                    {% set projectMeta = [] %}

                    {% if project.type == 'rodaje' %}
                        {% if project.filmingType %}
                            {% set projectMeta = projectMeta|merge([
                                ('backend.projects.form.filming_type.options.' ~ project.filmingType)|trans
                            ]) %}
                        {% endif %}

                        {% if project.filmingGenre %}
                            {% set projectMeta = projectMeta|merge([
                                ('backend.projects.form.filming_genre.options.' ~ project.filmingGenre)|trans
                            ]) %}
                        {% endif %}
                    {% elseif project.type == 'evento' %}
                        {% if project.eventTypePrimary %}
                            {% set projectMeta = projectMeta|merge([
                                ('backend.projects.form.event_type_primary.options.' ~ project.eventTypePrimary)|trans
                            ]) %}
                        {% endif %}

                        {% if project.eventModality %}
                            {% set projectMeta = projectMeta|merge([
                                ('backend.projects.form.event_modality.options.' ~ project.eventModality)|trans
                            ]) %}
                        {% endif %}

                        {% if project.eventAttendeesCount %}
                            {% set projectMeta = projectMeta|merge([
                                project.eventAttendeesCount ~ ' ' ~
                                ('backend.plan.pdf_visual.cover.attendees'|trans)
                            ]) %}
                        {% endif %}
                    {% endif %}

                    {% set projectStartDate = null %}
                    {% set projectEndDate = null %}

                    {% for phaseDate in project.phaseDates %}
                        {% if phaseDate.startDate and (projectStartDate is null or phaseDate.startDate < projectStartDate) %}
                            {% set projectStartDate = phaseDate.startDate %}
                        {% endif %}

                        {% if phaseDate.endDate and (projectEndDate is null or phaseDate.endDate > projectEndDate) %}
                            {% set projectEndDate = phaseDate.endDate %}
                        {% endif %}
                    {% endfor %}

                    {% if projectStartDate and projectEndDate %}
                        {% set projectMeta = projectMeta|merge([
                            projectStartDate|date('d/m/Y') ~ ' – ' ~ projectEndDate|date('d/m/Y')
                        ]) %}
                    {% endif %}

                    {% if projectMeta is not empty %}
                        <div class="pdf-cover__project-meta">
                            {{ projectMeta|join(' · ') }}
                        </div>
                    {% endif %}

                    {% set companyLogos = pdfVisualAssets.companyLogos|default([]) %}
                    {% if companyLogos is not empty %}
                        <table class="pdf-cover-company-logos" role="presentation">
                            <tr>
                                {% for companyLogo in companyLogos %}
                                    <td class="pdf-cover-company-logos__cell">
                                        <div class="pdf-cover-company-logos__box">
                                            <img
                                                class="pdf-cover-company-logos__image"
                                                src="{{ companyLogo.src }}"
                                                alt="{{ companyLogo.name }}">
                                        </div>
                                    </td>
                                {% endfor %}
                            </tr>
                        </table>
                    {% endif %}

                    </div>
                </td>

                <td class="pdf-cover-approved__score">
                    <div class="pdf-score-ring">
                        <img
                            class="pdf-score-ring__image"
                            src="{{ pdfVisualAssets.scoreRing }}"
                            alt="">
                        <div class="pdf-score-circle__inner">
                            <div class="pdf-score-circle__value">{{ displayedScorePct }}%</div>
                            <div class="pdf-score-circle__label">
                                {{ 'backend.plan.pdf_visual.cover.score_label'|trans }}
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <table class="pdf-indicators pdf-indicators--approved" role="presentation">
            <tr>
                <td class="pdf-indicators__cell">
                    <div class="pdf-indicators__value">{{ coverIndicators.total }}</div>
                    <div class="pdf-indicators__label">
                        {{ 'backend.plan.pdf_visual.indicators.total'|trans }}
                    </div>
                </td>
                <td class="pdf-indicators__cell">
                    <div class="pdf-indicators__value">{{ coverIndicators.applicable }}</div>
                    <div class="pdf-indicators__label">
                        {{ 'backend.plan.pdf_visual.indicators.applicable'|trans }}
                    </div>
                </td>
                <td class="pdf-indicators__cell">
                    <div class="pdf-indicators__value">{{ coverIndicators.toImplement }}</div>
                    <div class="pdf-indicators__label">
                        {{ 'backend.plan.pdf_visual.indicators.to_implement'|trans }}
                    </div>
                </td>
                <td class="pdf-indicators__cell">
                    <div class="pdf-indicators__value">{{ coverIndicators.critical }}</div>
                    <div class="pdf-indicators__label">
                        {{ 'backend.plan.pdf_visual.indicators.critical'|trans }}
                    </div>
                </td>
            </tr>
        </table>

    </main>

    <div class="pdf-cover-approved__details">
        <section class="pdf-cover-approved__summary">
        <h3 class="pdf-cover-approved__summary-title">
            {{ 'backend.plan.pdf_visual.cover.summary.title'|trans }}
        </h3>

        <table class="pdf-cover-approved__summary-table" role="presentation">
            <tr>
                <td>
                    <strong>{{ 'backend.plan.pdf_visual.cover.summary.status'|trans }}:</strong>
                    {{ statusLabel }}
                </td>
                <td>
                    <strong>{{ 'backend.plan.pdf_visual.cover.summary.date'|trans }}:</strong>
                    {{ generatedAt|date('d/m/Y') }}
                </td>
                <td>
                    <strong>{{ 'backend.plan.pdf_visual.cover.summary.user'|trans }}:</strong>
                    {{ currentUserLabel ?: '—' }}
                </td>
            </tr>
        </table>

        <div class="pdf-cover-approved__summary-line">
            <strong>{{ 'backend.plan.pdf_visual.cover.summary.score'|trans }}:</strong>
            {% if scoreMax > 0 %}
                {{ scoreGained }} / {{ scoreMax }} ({{ displayedScorePct }}%)
            {% else %}
                {{ 'backend.plan.pdf.score.na'|trans }}
            {% endif %}

            &nbsp;&nbsp;&nbsp;

            <strong>{{ 'backend.plan.pdf_visual.cover.summary.catalog'|trans }}:</strong>
            {{ coverIndicators.total }}
        </div>

        {% set projectDetails = [] %}

        {% if project.country %}
            {% set projectDetails = projectDetails|merge([{
                label: 'backend.projects.form.country'|trans,
                value: project.country
            }]) %}
        {% endif %}

        {% if project.mainLocation %}
            {% set projectDetails = projectDetails|merge([{
                label: 'backend.projects.form.main_location'|trans,
                value: project.mainLocation
            }]) %}
        {% endif %}

        {% if project.ecoManagerStatus %}
            {% set projectDetails = projectDetails|merge([{
                label: 'backend.projects.form.eco_manager_status.label'|trans,
                value: ('backend.projects.form.eco_manager_status.options.' ~ project.ecoManagerStatus)|trans
            }]) %}
        {% endif %}

        {% if project.presupuesto %}
            {% set projectDetails = projectDetails|merge([{
                label: 'backend.projects.form.budget_eur'|trans,
                value: project.presupuesto ~ ' €'
            }]) %}
        {% endif %}

        {% if project.type == 'rodaje' %}
            {% if project.filmingType %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.filming_type.label'|trans,
                    value: ('backend.projects.form.filming_type.options.' ~ project.filmingType)|trans
                }]) %}
            {% endif %}

            {% if project.filmingGenre %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.filming_genre.label'|trans,
                    value: ('backend.projects.form.filming_genre.options.' ~ project.filmingGenre)|trans
                }]) %}
            {% endif %}

            {% if project.episodios %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.common.episodios'|trans,
                    value: project.episodios
                }]) %}
            {% endif %}

            {% if project.duracionEpisodio %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.common.duracion_episodio'|trans,
                    value: project.duracionEpisodio
                }]) %}
            {% endif %}
        {% elseif project.type == 'evento' %}
            {% if project.eventTypePrimary %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.event_type_primary.label'|trans,
                    value: ('backend.projects.form.event_type_primary.options.' ~ project.eventTypePrimary)|trans
                }]) %}
            {% endif %}

            {% if project.eventModality %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.event_modality.label'|trans,
                    value: ('backend.projects.form.event_modality.options.' ~ project.eventModality)|trans
                }]) %}
            {% endif %}

            {% if project.eventAttendeesCount %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.event_attendees_count.label'|trans,
                    value: project.eventAttendeesCount
                }]) %}
            {% endif %}

            {% if project.eventOnlineConnections %}
                {% set projectDetails = projectDetails|merge([{
                    label: 'backend.projects.form.event_online_connections.label'|trans,
                    value: project.eventOnlineConnections
                }]) %}
            {% endif %}
        {% endif %}

        {% if project.distributionMedia is not empty %}
            {% set distributionLabels = [] %}
            {% for medium in project.distributionMedia %}
                {% set distributionLabels = distributionLabels|merge([
                    ('backend.projects.form.distribution_media.options.' ~ medium)|trans
                ]) %}
            {% endfor %}

            {% set projectDetails = projectDetails|merge([{
                label: 'backend.projects.form.distribution_media.label'|trans,
                value: distributionLabels|join(', ')
            }]) %}
        {% endif %}

        {% if projectDetails is not empty %}
            <div class="pdf-cover-project-data">
                {% for row in projectDetails|batch(3, null) %}
                    <table class="pdf-cover-project-data__row" role="presentation">
                        <tr>
                            {% for item in row %}
                                <td>
                                    {% if item %}
                                        <strong>{{ item.label }}:</strong>
                                        <span>{{ item.value }}</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    </table>
                {% endfor %}
            </div>
        {% endif %}

        {% if project.phaseDates is not empty %}
            <div class="pdf-cover-project-dates">
                <strong class="pdf-cover-project-dates__title">
                    {{ 'backend.projects.form.fs_phases'|trans }}
                </strong>

                <table class="pdf-cover-project-dates__table" role="presentation">
                    <tr>
                        {% for phaseDate in project.phaseDates %}
                            {% set phaseKey = phaseDate.phase|default('') %}

                            <td>
                                <strong>
                                    {% if phaseKey == 'preproduccion' %}
                                        {{ 'backend.projects.phases.pre_filming'|trans }}
                                    {% elseif phaseKey == 'postproduccion' %}
                                        {{ 'backend.projects.phases.post_filming'|trans }}
                                    {% elseif phaseKey == 'actividad' %}
                                        {{ 'backend.projects.phases.activity'|trans }}
                                    {% elseif phaseKey == 'setup' %}
                                        {{ 'backend.project.phase.setup'|trans }}
                                    {% elseif phaseKey == 'event' %}
                                        {{ 'backend.project.phase.event'|trans }}
                                    {% elseif phaseKey == 'teardown' %}
                                        {{ 'backend.project.phase.teardown'|trans }}
                                    {% elseif phaseKey == 'preproduction' %}
                                        {{ 'backend.project.phase.preproduction'|trans }}
                                    {% elseif phaseKey == 'shoot' %}
                                        {{ 'backend.project.phase.shoot'|trans }}
                                    {% elseif phaseKey == 'postproduction' %}
                                        {{ 'backend.project.phase.postproduction'|trans }}
                                    {% else %}
                                        {{ phaseKey }}
                                    {% endif %}
                                </strong>

                                <span>
                                    {% if phaseDate.startDate %}
                                        {{ phaseDate.startDate|date('d/m/Y') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                    –
                                    {% if phaseDate.endDate %}
                                        {{ phaseDate.endDate|date('d/m/Y') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </span>
                            </td>
                        {% endfor %}
                    </tr>
                </table>
            </div>
        {% endif %}
        </section>


        <section class="pdf-cover-commitment">
        <table class="pdf-cover-commitment__heading" role="presentation">
            <tr>
                <td>
                    <h3>{{ 'backend.plan.pdf_visual.analytics.commitment.title'|trans }}</h3>
                </td>
                <td class="pdf-cover-commitment__level">
                    {{ plannedCommitment.labelKey|trans }}
                </td>
            </tr>
        </table>

        <div class="pdf-cover-commitment__chart">
            <img
                class="pdf-cover-commitment__chart-image"
                src="{{ pdfVisualAssets.commitmentChart }}"
                alt="">
        </div>

        <table class="pdf-cover-commitment__labels" role="presentation">
            <tr>
                {% for level in commitmentLevels %}
                    <td class="{% if level.key == plannedCommitment.levelKey %}is-current{% endif %}">
                        {{ level.labelKey|trans }}
                    </td>
                {% endfor %}
            </tr>
        </table>

        <table class="pdf-cover-commitment__meta" role="presentation">
            <tr>
                <td>
                    <strong>
                        {{ plannedCommitment.points }}
                        /
                        {{ commitmentSummary.totalOfficialPoints }}
                        {{ 'backend.plan.pdf_visual.analytics.commitment.points'|trans }}
                    </strong>
                    · {{ plannedCommitment.percentageRounded }}%
                </td>
                <td>
                    {% if plannedCommitment.pointsToNextLevel is not null %}
                        {{ 'backend.plan.pdf_visual.analytics.commitment.next'|trans({
                            '%points%': plannedCommitment.pointsToNextLevel
                        }) }}
                    {% else %}
                        {{ 'backend.plan.pdf_visual.analytics.commitment.maximum'|trans }}
                    {% endif %}
                </td>
            </tr>
        </table>

        </section>
    </div>

    {% include 'backend/plan/pdf/_footer.html.twig' with { footerVariant: 'cover' } %}
</section>
