{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.plan.welcome.title'|trans }}{% endblock %}

{% block breadcrumb %}
  {{ parent() }}
  <li class="breadcrumb-item active" aria-current="page">{{ 'backend.plan.welcome.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 bg-white p-4 rounded shadow text-center">
      <div class="mb-3">
        <img src="{{ asset('build/images/welcome.jpg') }}" alt="{{ 'backend.plan.welcome.img_alt'|trans }}" width="124" height="142" class="img-fluid">
      </div>

      {# Mensaje de bienvenida #}
      <section id="welcome-block" class="text-center">
        <h1 class="mb-3">{{ 'backend.plan.welcome.h1'|trans }}</h1>
        <h2 class="h5 mb-3">{{ 'backend.plan.welcome.h2'|trans }}</h2>
        {% if protocols|length > 1 %}
        <p class="mb-4">{{ 'backend.plan.welcome.intro'|trans }}</p>
        <button id="btn-start" class="btn btn-success px-4">{{ 'backend.plan.welcome.start_btn'|trans }}</button>
        {% endif %}
      </section>

      {# Formulario selección de protocolo (manual, sin FormType) #}
      <section id="protocol-form-block" class="{% if protocols|length > 1 %}d-none{% endif %}">
        {% if protocols|length == 1 %}
          {% set proto = protocols|first %}
          <div class="border rounded-4 p-4 bg-light text-center mx-auto" style="max-width: 520px;">
            <form action="{{ path('backend_plan_select_protocol') }}" method="post">
              <input type="hidden" name="protocol_id" value="{{ proto.id }}">
              <p class="mb-4">{{ 'backend.plan.welcome.single_protocol_copy'|trans }}</p>
              <button type="submit" class="btn btn-primary">{{ 'backend.plan.welcome.single_protocol_button'|trans }}</button>
            </form>
          </div>
        {% else %}
          <h4 class="mb-3">{{ 'backend.plan.welcome.select_title'|trans }}</h4>

          <form action="{{ path('backend_plan_select_protocol') }}" method="post" class="d-grid gap-3">
            <div class="d-flex justify-content-center">
              <select class="form-select w-auto mb-4" id="protocol_id" name="protocol_id" style="max-width:300px" required>
                <option value="" selected disabled>{{ 'backend.plan.welcome.select_placeholder'|trans }}</option>
                {% for proto in protocols %}
                  <option value="{{ proto.id }}" {% if plan.protocol and plan.protocol.id == proto.id %}selected{% endif %}>
                    {{ proto.name }}
                  </option>
                {% endfor %}
              </select>
            </div>

            <p class="mb-4">{{ 'backend.plan.welcome.helper_text'|trans }}</p>

            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-primary">{{ 'backend.plan.welcome.continue'|trans }}</button>
            </div>
          </form>
        {% endif %}
      </section>

    </div>
  </div>
</div>

<script>
document.getElementById('btn-start')?.addEventListener('click', function () {
  document.getElementById('welcome-block')?.classList.add('d-none');
  document.getElementById('protocol-form-block')?.classList.remove('d-none');
});
</script>
{% endblock %}
