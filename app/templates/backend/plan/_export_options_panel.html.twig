{% set panelId = panelId|default('export-options-panel') %}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="fw-semibold">{{ 'backend.plan.exports.panel_title'|trans }}</div>
                <div class="text-muted small">{{ 'backend.plan.exports.subtitle'|trans }}</div>
            </div>
            <button
                class="btn btn-success btn-sm text-white"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#{{ panelId }}"
                aria-expanded="false"
                aria-controls="{{ panelId }}">
                {{ 'backend.plan.exports.panel_open'|trans }}
            </button>
        </div>

        <div class="collapse mt-3" id="{{ panelId }}">
            <div class="row g-3">
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="border rounded p-3 h-100 bg-light d-flex flex-column">
                        <div class="fw-semibold mb-1">{{ 'backend.plan.exports.unified_pdf'|trans }}</div>
                        <div class="small text-muted mb-3">{{ 'backend.plan.exports.unified_pdf_help'|trans }}</div>
                        <div class="mt-auto">
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="plan-review#downloadPdf">
                                <i class="bi bi-download"></i> {{ 'backend.plan.exports.download_now'|trans }}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="border rounded p-3 h-100 {% if projectTier == 'basic' %}bg-light{% endif %} d-flex flex-column">
                        <div class="fw-semibold mb-1">{{ 'backend.plan.exports.by_department'|trans }}</div>
                        <div class="small text-muted mb-3">{{ 'backend.plan.exports.by_department_help'|trans }}</div>
                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            {% if projectTier in ['standard', 'pro'] %}
                                <a href="{{ path('backend_plan_export_pdf', {'id': plan.id, 'grouping': 'department'}) }}" class="btn btn-outline-primary btn-sm text-decoration-none">
                                    <i class="bi bi-file-earmark-pdf"></i> {{ 'backend.plan.exports.download_pdf'|trans }}
                                </a>
                            {% else %}
                                <a href="#" class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">
                                    {{ 'backend.plan.exports.available_in_standard'|trans }}
                                </a>
                            {% endif %}

                            {% if projectTier == 'pro' %}
                                <a href="{{ path('backend_plan_export_excel', {'id': plan.id, 'grouping': 'department'}) }}" class="btn btn-outline-success btn-sm text-decoration-none">
                                    <i class="bi bi-file-earmark-excel"></i> {{ 'backend.plan.exports.download_excel'|trans }}
                                </a>
                            {% else %}
                                <a href="#" class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">
                                    {{ 'backend.plan.exports.available_in_pro'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {% for export in [
                    {'key': 'category', 'label': 'backend.plan.exports.by_category', 'help': 'backend.plan.exports.by_category_help'},
                    {'key': 'impact_area', 'label': 'backend.plan.exports.by_impact_area', 'help': 'backend.plan.exports.by_impact_area_help'},
                    {'key': 'triple_balance', 'label': 'backend.plan.exports.by_triple_balance', 'help': 'backend.plan.exports.by_triple_balance_help'},
                    {'key': 'ods', 'label': 'backend.plan.exports.by_ods', 'help': 'backend.plan.exports.by_ods_help'}
                ] %}
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="border rounded p-3 h-100 {% if projectTier == 'basic' %}bg-light{% endif %} d-flex flex-column">
                            <div class="fw-semibold mb-1">{{ export.label|trans }}</div>
                            <div class="small text-muted mb-3">{{ export.help|trans }}</div>
                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                {% if projectTier == 'pro' %}
                                    <a href="{{ path('backend_plan_export_pdf', {'id': plan.id, 'grouping': export.key}) }}" class="btn btn-outline-primary btn-sm text-decoration-none">
                                        <i class="bi bi-file-earmark-pdf"></i> {{ 'backend.plan.exports.download_pdf'|trans }}
                                    </a>
                                    <a href="{{ path('backend_plan_export_excel', {'id': plan.id, 'grouping': export.key}) }}" class="btn btn-outline-success btn-sm text-decoration-none">
                                        <i class="bi bi-file-earmark-excel"></i> {{ 'backend.plan.exports.download_excel'|trans }}
                                    </a>
                                {% else %}
                                    <a href="#" class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">
                                        {{ 'backend.plan.exports.available_in_pro'|trans }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="mt-3">
                <button
                    class="btn btn-link btn-sm px-0 text-decoration-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#{{ panelId }}"
                    aria-expanded="true"
                    aria-controls="{{ panelId }}">
                    {{ 'backend.plan.exports.panel_close'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
