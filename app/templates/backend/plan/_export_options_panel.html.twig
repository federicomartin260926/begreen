{% set modalId = modalId|default('implementation-export-options') %}
{% set pdfActions = [
    {
        key: 'department',
        label: 'backend.plan.exports.by_department',
        help: 'backend.plan.exports.by_department_help',
        icon: 'bi-diagram-3'
    },
    {
        key: 'category',
        label: 'backend.plan.exports.by_category',
        help: 'backend.plan.exports.by_category_help',
        icon: 'bi-tags'
    },
    {
        key: 'impact_area',
        label: 'backend.plan.exports.by_impact_area',
        help: 'backend.plan.exports.by_impact_area_help',
        icon: 'bi-bullseye'
    },
    {
        key: 'triple_balance',
        label: 'backend.plan.exports.by_triple_balance',
        help: 'backend.plan.exports.by_triple_balance_help',
        icon: 'bi-circle-square'
    },
    {
        key: 'ods',
        label: 'backend.plan.exports.by_ods',
        help: 'backend.plan.exports.by_ods_help',
        icon: 'bi-globe2'
    }
] %}

<div class="modal fade" id="{{ modalId }}" tabindex="-1" aria-labelledby="{{ modalId }}Label" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <div>
                    <h2 class="modal-title h5 mb-0" id="{{ modalId }}Label">{{ 'backend.plan.exports.panel_title'|trans }}</h2>
                    <div class="text-muted small">{{ 'backend.plan.exports.subtitle'|trans }}</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
            </div>

            <div class="modal-body p-3">
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 row-cols-xxl-4 g-2">
                    <div class="col">
                        <div class="border rounded-3 p-2 h-100 d-flex flex-column" data-export-option="general_pdf" data-export-option-state="enabled">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <i class="bi bi-file-earmark-pdf fs-5 text-primary" aria-hidden="true"></i>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    {{ 'backend.plan.closure.available'|trans }}
                                </span>
                            </div>
                            <h3 class="small fw-semibold mb-1">{{ 'backend.plan.exports.unified_pdf'|trans }}</h3>
                            <div class="small text-muted mb-2">{{ 'backend.plan.exports.unified_pdf_help'|trans }}</div>
                            <div class="mt-auto">
                                <button
                                    type="button"
                                    class="btn btn-outline-primary btn-sm py-1 px-2"
                                    data-controller="download-state"
                                    data-action="plan-review#downloadPdf"
                                    data-download-state-loading-label-value="{{ 'backend.plan.actions.spinner_pdf'|trans }}">
                                    <i class="bi bi-download me-1"></i>{{ 'backend.plan.exports.download_now'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>

                    {% for action in pdfActions %}
                        {% set feature = exportOptions.groupings[action.key].pdf %}
                        <div class="col">
                            <div
                                class="border rounded-3 p-2 h-100 d-flex flex-column {{ feature.enabled ? 'bg-white' : 'bg-light' }}"
                                data-export-option="{{ action.key }}_pdf"
                                data-export-option-state="{{ feature.enabled ? 'enabled' : 'blocked' }}">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <i class="bi {{ action.icon }} fs-5 {{ feature.enabled ? 'text-primary' : 'text-muted' }}" aria-hidden="true"></i>
                                    <span class="badge {{ feature.enabled ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border' }}">
                                        {{ (feature.enabled ? 'backend.plan.closure.available' : 'backend.plan.closure.locked')|trans }}
                                    </span>
                                </div>
                                <h3 class="small fw-semibold mb-1">{{ action.label|trans }}</h3>
                                <div class="small text-muted mb-2">{{ action.help|trans }}</div>
                                <div class="mt-auto">
                                    {% if feature.enabled %}
                                        <a
                                            href="{{ path('backend_plan_export_pdf', {'id': plan.id, 'grouping': action.key}) }}"
                                            class="btn btn-outline-primary btn-sm py-1 px-2 text-decoration-none"
                                            data-controller="download-state"
                                            data-action="click->download-state#start"
                                            data-download-state-loading-label-value="{{ 'backend.plan.actions.spinner_pdf'|trans }}">
                                            <i class="bi bi-file-earmark-pdf me-1"></i>{{ 'backend.plan.exports.download_pdf'|trans }}
                                        </a>
                                    {% else %}
                                        <span class="badge bg-secondary-subtle text-secondary border fw-normal small" data-export-option-locked>
                                            <i class="bi bi-lock me-1" aria-hidden="true"></i>
                                            {{ 'backend.plan.closure.available_from'|trans({
                                                '%tier%': ('backend.plan.tier.level.' ~ feature.requiredTier)|trans
                                            }) }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    {% set excel = exportOptions.excel %}
                    <div class="col">
                        <div
                            class="border rounded-3 p-2 h-100 d-flex flex-column {{ excel.enabled ? 'bg-white' : 'bg-light' }}"
                            data-export-option="excel"
                            data-export-option-state="{{ excel.enabled ? 'enabled' : 'blocked' }}">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <i class="bi bi-file-earmark-excel fs-5 {{ excel.enabled ? 'text-success' : 'text-muted' }}" aria-hidden="true"></i>
                                <span class="badge {{ excel.enabled ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border' }}">
                                    {{ (excel.enabled ? 'backend.plan.closure.available' : 'backend.plan.closure.locked')|trans }}
                                </span>
                            </div>
                            <h3 class="small fw-semibold mb-1">{{ 'backend.plan.closure.excel'|trans }}</h3>
                            <div class="small text-muted mb-2">{{ 'backend.plan.closure.excel_help'|trans }}</div>
                            <div class="mt-auto">
                                {% if excel.enabled %}
                                    <div class="dropdown">
                                        <button class="btn btn-outline-success btn-sm py-1 px-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            {{ 'backend.plan.closure.choose_grouping'|trans }}
                                        </button>
                                        <ul class="dropdown-menu">
                                            {% for grouping, label in {
                                                department: 'backend.plan.exports.grouping.department',
                                                category: 'backend.plan.exports.grouping.category',
                                                impact_area: 'backend.plan.exports.grouping.impact_area',
                                                triple_balance: 'backend.plan.exports.grouping.triple_balance',
                                                ods: 'backend.plan.exports.grouping.ods'
                                            } %}
                                                {% if exportOptions.groupings[grouping].excel.enabled %}
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('backend_plan_export_excel', {'id': plan.id, 'grouping': grouping}) }}">
                                                            {{ label|trans }}
                                                        </a>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary border fw-normal small" data-export-option-locked>
                                        <i class="bi bi-lock me-1" aria-hidden="true"></i>
                                        {{ 'backend.plan.closure.available_from'|trans({
                                            '%tier%': ('backend.plan.tier.level.' ~ excel.requiredTier)|trans
                                        }) }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    {{ 'backend.common.close'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
