{% extends 'backend/plan/pdf_visual.html.twig' %}

{% block document_title %}
    {{ 'backend.plan.exports.pdf.title'|trans({
        '%grouping%': groupingLabel,
        '%project%': project.name
    }) }}
{% endblock %}

{% block pdf_extra_styles %}
        .pdf-group-page {
            position: relative;
            width: 210mm;
            height: 296mm;
            overflow: hidden;
            page-break-after: always;
            background: #f3faf5;
        }

        .pdf-group-page--last {
            page-break-after: auto;
        }

        .pdf-group-page > .pdf-watermark {
            top: 102mm;
            color: rgba(0, 110, 86, .05);
        }

        .pdf-group-page .pdf-brand-header {
            height: 14mm;
            padding: 3mm 16mm;
        }

        .pdf-group-page .pdf-brand-header__logo {
            width: 31mm;
        }

        .pdf-group-page .pdf-brand-header__meta-cell {
            font-size: 7px;
        }

        .pdf-group-page__content {
            position: relative;
            z-index: 1;
            padding: 8mm 16mm 14mm;
        }

        .pdf-group-page__heading {
            width: 100%;
            margin: 0 0 5mm;
            border-collapse: collapse;
        }

        .pdf-group-page__heading td {
            padding: 0;
            border: 0;
            vertical-align: middle;
        }

        .pdf-group-page__title {
            margin: 0;
            color: #075c48;
            font-size: 22px;
            line-height: 1.15;
        }

        .pdf-group-page__count {
            color: #58736a;
            font-size: 9px;
            text-align: right;
        }

        .pdf-group-measure {
            width: 100%;
            margin: 0 0 1.8mm;
            border-collapse: collapse;
            page-break-inside: avoid;
        }

        .pdf-group-measure__cell {
            padding: 2.4mm 4mm;
            border: 1px solid #d3e8da;
            border-radius: 2mm;
            background: #ffffff;
            vertical-align: top;
        }

        .pdf-group-measure__title {
            margin: 0;
            color: #075c48;
            font-size: 11px;
            line-height: 1.2;
        }

        .pdf-group-measure__observations {
            margin: 0.25mm 0 0;
            padding-top: 0.4mm;
            border-top: 1px solid #e3f0e7;
            color: #2e5549;
            font-size: 8.5px;
            line-height: 1.25;
            white-space: pre-line;
        }
{% endblock %}

{% block pdf_body %}
    {% include 'backend/plan/pdf/_cover.html.twig' %}
    {% include 'backend/plan/pdf/_grouped_analytics.html.twig' %}
    {% include 'backend/plan/pdf/_grouped_report.html.twig' %}
{% endblock %}
