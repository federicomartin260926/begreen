{# ---- MEDIDAS COMPACTAS CON DETALLE PLEGABLE ---- #}
{% if implementationItems is not empty %}
    <div class="d-flex flex-column gap-2">
        {% for item in implementationItems %}
            {% set measure = item.measure %}
            {% set pm = item.planMeasure %}
            {% set operationalState = item.operationalState %}
            {% set collapseId = 'mrow_' ~ measure.id %}
            {% set isOpen = openId and openId == measure.id %}
            {% set statusTitle = ('backend.plan.review.status_' ~ operationalState)|trans %}
            {% set showStar = pm.isCritical is same as(true) %}

            <article class="implementation-measure implementation-measure-row--{{ operationalState }}"
                     data-implementation-measure
                     data-measure-id="{{ measure.id }}">
                <div class="implementation-measure-row d-flex flex-wrap align-items-center gap-2 gap-md-3 p-2 p-md-3 rounded-3"
                     data-measure-summary>
                    <div class="implementation-measure-row__title flex-grow-1 min-w-0 fw-semibold">
                        {{ measure.displayNameForReview }}
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 ms-md-auto">
                        <span class="badge border {{ showStar ? 'bg-warning-subtle text-warning-emphasis' : 'bg-light text-muted' }}"
                              {% if showStar %}title="{{ 'backend.plan.review.critical_measure'|trans }}"{% endif %}>
                            {% if showStar %}<i class="bi bi-star-fill me-1" aria-hidden="true"></i>{% endif %}
                            {{ 'backend.plan.review.critical_short'|trans }}:
                            {{ pm.isCritical is same as(true) ? 'backend.common.yes'|trans : (pm.isCritical is same as(false) ? 'backend.common.no'|trans : '—') }}
                        </span>
                        {% if measure.score is not null %}
                            <span class="badge bg-light text-dark border" title="{{ 'backend.plan.review.score_badge_title'|trans }}">
                                {{ measure.score }} {{ 'backend.common.points'|trans }}
                            </span>
                        {% endif %}
                        <span class="badge implementation-measure-row__state">{{ statusTitle }}</span>
                        <button class="btn btn-sm {{ isOpen ? 'btn-primary' : 'btn-outline-primary' }}"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#{{ collapseId }}"
                                data-implementation-measure-toggle
                                aria-expanded="{{ isOpen ? 'true' : 'false' }}"
                                aria-controls="{{ collapseId }}"
                                aria-label="{{ isOpen ? 'backend.plan.review.collapse_measure'|trans : 'backend.plan.review.expand_measure'|trans }}">
                            <i class="bi {{ isOpen ? 'bi-chevron-down' : 'bi-chevron-right' }}" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="collapse implementation-measure-detail {{ isOpen ? 'show' : '' }}"
                     id="{{ collapseId }}"
                     data-implementation-measure-collapse>
                    {% include 'backend/plan/_implementation_measure_detail.html.twig' with {
                        measure: measure,
                        pm: pm,
                        taxonomyPresenter: taxonomyPresenter,
                        project: project,
                        crewMembersByMeasure: crewMembersByMeasure|default([]),
                        canUseChecklist: canUseChecklist|default(false),
                        canUseResponsibles: canUseResponsibles|default(false),
                        canUseInternalNotes: canUseInternalNotes|default(false),
                        verificationSources: verificationSources|default([])
                    } only %}
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
