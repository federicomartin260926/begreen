{# ---- LISTADO PLEGABLE ---- #}
{% if measures is not empty %}
    <div class="table-responsive">
        <table class="table align-middle green_table_1 table-hover">
            <thead class="table-light">
                <tr>
                    <th style="width:48px;"></th>
                    <th style="width:80px;"></th>
                    <th>{{ 'backend.plan.review.th.measure'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% set openId = app.request.query.get('open') %}
            {% for measure in measures %}
                {% set rowNum = positionById[measure.id] ?? '-' %}
                {% set collapseId = 'mrow_' ~ measure.id %}

                {% set isOpen = openId and openId == measure.id %}

                {# pm debe definirse ANTES de usarlo #}
                {% set pm = null %}
                {% for item in planMeasures %}
                    {% if item.measure.id == measure.id %}
                        {% set pm = item %}
                    {% endif %}
                {% endfor %}

                <tr>
                    <td class="text-center">
                        <button class="btn btn-sm {{ isOpen ? 'btn-primary' : 'btn-outline-primary' }}"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#{{ collapseId }}"
                                aria-expanded="{{ isOpen ? 'true' : 'false' }}"
                                aria-controls="{{ collapseId }}">
                            <i class="bi {{ isOpen ? 'bi-chevron-down' : 'bi-chevron-right' }}"></i>
                        </button>
                    </td>

                    {# Determinar color y estrella según reglas #}
                    {% set statusColor = 'bg-secondary' %}
                    {% set showStar = false %}
                    {% if pm %}
                        {% if pm.isApplicable is same as(true) and pm.willImplement is same as(true) and pm.isCritical is same as(true) %}
                            {% set statusColor = 'bg-success' %}
                            {% set showStar = true %}
                        {% elseif pm.isApplicable is same as(true) and pm.willImplement is same as(true) %}
                            {% set statusColor = 'bg-success' %}
                        {% elseif pm.isApplicable is same as(true) and pm.willImplement is same as(false) %}
                            {% set statusColor = 'bg-warning' %}
                        {% elseif pm.isApplicable is same as(false) %}
                            {% set statusColor = 'bg-danger' %}
                        {% endif %}
                    {% endif %}

                    <td class="text-muted text-nowrap">
                        <span class="d-inline-flex align-items-center flex-nowrap">
                            <span class="d-inline-block rounded-circle me-2 {{ statusColor }}" style="width:10px;height:10px;"></span>
                            {% if showStar %}<i class="bi bi-star-fill text-warning me-1"></i>{% endif %}
                            <span class="d-inline-block">{{ rowNum }}</span>
                        </span>
                    </td>

                    <td>
                        {{ measure.displayNameForReview }}
                        {% if measure.score is not null %}
                            <span class="badge bg-light text-dark border ms-2" title="{{ 'backend.plan.review.score_badge_title'|trans }}">
                                <i class="bi bi-star-fill text-warning me-1"></i>{{ measure.score }} {{ 'backend.common.points'|trans }}
                            </span>
                        {% endif %}
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <a
                                href="{{ path('admin_measures_edit', { id: measure.id }) }}"
                                class="ms-2 small link-primary"
                                target="_blank" rel="noopener"
                                data-bs-toggle="popover"
                                data-bs-trigger="hover"
                                data-bs-html="true"
                                data-bs-content="{{ 'backend.plan.review.edit_in_admin'|trans }}">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        {% endif %}
                    </td>

                </tr>

                {# Fila plegable con detalles de la medida #}
                <tr class="collapse {{ isOpen ? 'show' : '' }}" id="{{ collapseId }}">
                    <td colspan="3">
                        <div class="p-3 border rounded bg_green_1 shadow-sm">
                            <div class="row g-3">
                                {% if measure.category %}
                                    <div class="col-md-3">
                                        <div class="small text-muted">{{ 'backend.plan.measure.category'|trans }}</div>
                                        <div>{{ measure.category.name }}</div>
                                    </div>
                                {% endif %}
                                <div class="col-12">
                                    <div class="row g-3">
                                        {% include 'backend/plan/_measure_taxonomy.html.twig' with {
                                            measure: measure,
                                            taxonomyPresenter: taxonomyPresenter,
                                            dtClass: 'col-md-3 col-lg-2',
                                            ddClass: 'col-md-9 col-lg-10',
                                            showVerificationSources: false
                                        } %}
                                    </div>
                                </div>

                                {% if measure.implementation %}
                                    <div class="col-12">
                                        <div class="small text-muted">{{ 'backend.plan.measure.implementation'|trans }}</div>
                                        <div>{{ measure.implementation }}</div>
                                    </div>
                                {% endif %}

                                {% if measure.description %}
                                    <div class="col-12">
                                        <div class="small text-muted">{{ 'backend.plan.measure.description'|trans }}</div>
                                        <div>{{ measure.description }}</div>
                                    </div>
                                {% endif %}

                                {% set verificationLinks = measure.resolvedVerificationSourceLinks %}
                                {% if verificationLinks is not empty %}
                                    <div class="col-12">
                                        <div class="small text-muted">{{ 'backend.plan.review.verification_sources'|trans }}</div>
                                        <ol class="mb-0 ps-3">
                                            {% for link in verificationLinks %}
                                                {% set source = link.verificationSource %}
                                                <li>
                                                    {{ link.priority }}.
                                                    {{ source ? source.name : '—' }}
                                                </li>
                                            {% endfor %}
                                        </ol>
                                    </div>
                                {% elseif measure.verificationSources %}
                                    <div class="col-12">
                                        <div class="small text-muted">{{ 'backend.plan.review.verification_sources'|trans }}</div>
                                        <div>{{ measure.verificationSources }}</div>
                                    </div>
                                {% endif %}

                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        {% set canEditEstado =
                                            is_granted('ROLE_SUPER_ADMIN') or
                                            is_granted('ROLE_ADMIN') or
                                            (not is_granted('ROLE_MANAGER'))
                                        %}
                                        <div class="small text-muted">{{ 'backend.plan.review.state_in_plan'|trans }}</div>
                                        {% if pm and canEditEstado %}
                                            <button
                                                type="button"
                                                class="btn"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="hover"
                                                data-bs-html="true"
                                                data-bs-content="{{ 'backend.plan.review.state_edit_help'|trans }}"
                                                data-action="click->plan-review#toggleInlineEdit"
                                                data-edit-id="{{ measure.id }}">
                                                <i class="bi bi-pencil-square me-1"></i>
                                            </button>
                                        {% endif %}
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        <span class="badge {{ pm and pm.isApplicable is same as(true) ? 'bg-success' : (pm and pm.isApplicable is same as(false) ? 'bg-danger' : 'bg-secondary') }}">
                                            {{ pm ? (pm.isApplicable is same as(true)
                                                ? 'backend.plan.answers.applicable'|trans
                                                : (pm.isApplicable is same as(false)
                                                    ? 'backend.plan.answers.not_applicable'|trans
                                                    : 'backend.common.no_answer'|trans))
                                                : 'backend.common.no_answer'|trans }}
                                        </span>

                                        {% if pm and pm.isApplicable %}
                                            <span class="badge {{ pm.isCritical is same as(true) ? 'bg-success' : (pm.isCritical is same as(false) ? 'bg-danger' : 'bg-secondary') }}">
                                                {{ 'backend.plan.review.critical_short'|trans }}:
                                                {{ pm.isCritical is same as(true) ? 'backend.common.yes'|trans : (pm.isCritical is same as(false) ? 'backend.common.no'|trans : '—') }}
                                            </span>
                                            <span class="badge {{ pm.willImplement is same as(true) ? 'bg-success' : (pm.willImplement is same as(false) ? 'bg-danger' : 'bg-secondary') }}">
                                                {{ 'backend.plan.answers.implement'|trans }}:
                                                {{ pm.willImplement is same as(true) ? 'backend.common.yes'|trans : (pm.willImplement is same as(false) ? 'backend.common.no'|trans : '—') }}
                                            </span>
                                        {% endif %}
                                    </div>

                                    {% if pm %}
                                        <div class="border rounded p-3 bg-white d-none"
                                             data-plan-review-target="inlineEdit"
                                             id="inline-edit-{{ measure.id }}">
                                            <div class="row g-3">
                                                {# — Aplica — #}
                                                <div class="col-12 col-md-4">
                                                    <div class="small text-muted mb-1">{{ 'backend.plan.q.apply'|trans }}</div>
                                                    <div class="d-flex gap-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="applies-{{ measure.id }}"
                                                                   id="applies-yes-{{ measure.id }}"
                                                                   value="true"
                                                                   {% if pm.isApplicable is same as(true) %}checked{% endif %}
                                                                   data-action="change->plan-review#onAppliesChange">
                                                            <label class="form-check-label" for="applies-yes-{{ measure.id }}">{{ 'backend.common.yes'|trans }}</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="applies-{{ measure.id }}"
                                                                   id="applies-no-{{ measure.id }}"
                                                                   value="false"
                                                                   {% if pm.isApplicable is same as(false) %}checked{% endif %}
                                                                   data-action="change->plan-review#onAppliesChange">
                                                            <label class="form-check-label" for="applies-no-{{ measure.id }}">{{ 'backend.common.no'|trans }}</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                {# — Crítica — #}
                                                <div class="col-12 col-md-4" data-critical-block>
                                                    <div class="small text-muted mb-1">{{ 'backend.plan.review.critical_q'|trans }}</div>
                                                    <div class="d-flex gap-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="critical-{{ measure.id }}"
                                                                   id="critical-yes-{{ measure.id }}"
                                                                   value="true"
                                                                   {% if pm.isCritical is same as(true) %}checked{% endif %}
                                                                   {% if pm.isApplicable is same as(false) %}disabled{% endif %}
                                                                   data-action="change->plan-review#toggleCriticalReasonVisibility">
                                                            <label class="form-check-label" for="critical-yes-{{ measure.id }}">{{ 'backend.common.yes'|trans }}</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="critical-{{ measure.id }}"
                                                                   id="critical-no-{{ measure.id }}"
                                                                   value="false"
                                                                   {% if pm.isCritical is same as(false) %}checked{% endif %}
                                                                   {% if pm.isApplicable is same as(false) %}disabled{% endif %}
                                                                   data-action="change->plan-review#toggleCriticalReasonVisibility">
                                                            <label class="form-check-label" for="critical-no-{{ measure.id }}">{{ 'backend.common.no'|trans }}</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                {# — Implementar — #}
                                                <div class="col-12 col-md-4" data-implement-block>
                                                    <div class="small text-muted mb-1">{{ 'backend.plan.q.implement'|trans }}</div>
                                                    <div class="d-flex gap-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="implement-{{ measure.id }}"
                                                                   id="implement-yes-{{ measure.id }}"
                                                                   value="true"
                                                                   {% if pm.willImplement is same as(true) %}checked{% endif %}
                                                                   {% if pm.isApplicable is same as(false) %}disabled{% endif %}>
                                                            <label class="form-check-label" for="implement-yes-{{ measure.id }}">{{ 'backend.common.yes'|trans }}</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="implement-{{ measure.id }}"
                                                                   id="implement-no-{{ measure.id }}"
                                                                   value="false"
                                                                   {% if pm.willImplement is same as(false) %}checked{% endif %}
                                                                   {% if pm.isApplicable is same as(false) %}disabled{% endif %}>
                                                            <label class="form-check-label" for="implement-no-{{ measure.id }}">{{ 'backend.common.no'|trans }}</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            {# Grupo de motivo (visible solo si isCritical === true) #}
                                            <div class="mt-3"
                                                 data-critical-reason-group
                                                 style="{{ pm.isCritical is same as(true) and (pm.isApplicable is not same as(false)) ? '' : 'display:none;' }}">
                                                <label class="small text-muted mb-1" for="critical-reason-{{ measure.id }}">{{ 'backend.plan.q.critical_reason'|trans }}</label>
                                                <input type="text"
                                                       id="critical-reason-{{ measure.id }}"
                                                       class="form-control"
                                                       value="{{ pm.criticalReason ?? '' }}"
                                                       placeholder="{{ 'backend.plan.q.critical_reason_ph'|trans }}">
                                            </div>

                                            <div class="mt-3 d-flex justify-content-end">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary"
                                                        data-action="click->plan-review#saveInlineEdit"
                                                        data-measure-id="{{ measure.id }}">
                                                    {{ 'backend.common.save_changes'|trans }}
                                                </button>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>

                                {% if pm and pm.criticalReason %}
                                    <div class="col-12">
                                        <div class="small text-muted">{{ 'backend.plan.review.critical_reason_label'|trans }}</div>
                                        <div>{{ pm.criticalReason }}</div>
                                    </div>
                                {% endif %}

                                {# Acciones sobre el ítem #}
                                {% if pm and pm.willImplement is same as(true) %}
                                    <div class="col-12">
                                        <div class="small text-muted mb-1">{{ 'backend.plan.review.actions_title'|trans }}</div>

                                        {% set canAll = is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_ADMIN') %}
                                        {% set canVerify = canAll %}
                                        {% set canManageEvidence = canAll or is_granted('ROLE_MANAGER') %}
                                        {% set canProFeatures = projectTier == 'pro' or is_granted('ROLE_SUPER_ADMIN') %}
                                        {% set measureCrewMembers = crewMembersByMeasure[measure.id]|default([]) %}
                                        {% set responsibleIds = [] %}
                                        {% set responsibleLabels = [] %}
                                        {% if pm %}
                                            {% for responsible in pm.responsibleCrewMembers %}
                                                {% set responsibleIds = responsibleIds|merge([responsible.id]) %}
                                                {% set responsibleLabels = responsibleLabels|merge([((responsible.name ?? '') ~ ' ' ~ (responsible.lastName ?? ''))|trim]) %}
                                            {% endfor %}
                                        {% endif %}

                                        <div class="d-flex flex-wrap gap-2 bg-white p-4">

                                            {# — Medida implementada — #}
                                            <div class="form-check form-switch w-100">
                                                <input
                                                    class="form-check-input"
                                                    type="checkbox"
                                                    id="implemented-{{ measure.id }}"
                                                    {% if pm and pm.isImplemented is same as(true) %}checked{% endif %}
                                                    {% if not (pm and pm.willImplement is same as(true)) %}disabled{% endif %}>
                                                <label class="form-check-label" for="implemented-{{ measure.id }}">
                                                    {{ 'backend.plan.review.flag_implemented'|trans }}
                                                </label>
                                                {% if not (pm and pm.willImplement is same as(true)) %}
                                                    <div class="form-text text-muted">{{ 'backend.plan.review.flag_implemented_hint'|trans }}</div>
                                                {% endif %}
                                            </div>

                                            {# — Verificación realizada — #}
                                            <div class="form-check form-switch w-100 mt-2">
                                                {% if canVerify %}
                                                    <input
                                                        class="form-check-input"
                                                        type="checkbox"
                                                        id="verification-{{ measure.id }}"
                                                        {% if pm and pm.verification %}checked{% endif %}>
                                                    <label class="form-check-label" for="verification-{{ measure.id }}">
                                                        {{ 'backend.plan.review.flag_verified'|trans }}
                                                    </label>
                                                {% else %}
                                                    <input
                                                        class="form-check-input"
                                                        type="checkbox"
                                                        id="verification-{{ measure.id }}"
                                                        {% if pm and pm.verification %}checked{% endif %}
                                                        disabled data-locked="1">
                                                    <label class="form-check-label" for="verification-{{ measure.id }}">
                                                        {{ 'backend.plan.review.flag_verified'|trans }}
                                                    </label>
                                                {% endif %}
                                            </div>

                                            {# — Acción realizada — #}
                                            <div class="w-100 mt-3">
                                                <label class="form-label small" for="action-taken-{{ measure.id }}">{{ 'backend.plan.review.action_taken'|trans }}</label>
                                                <textarea
                                                    id="action-taken-{{ measure.id }}"
                                                    class="form-control"
                                                    rows="2"
                                                    placeholder="{{ 'backend.plan.review.action_taken_ph'|trans }}">{{ pm.actionTaken ?? '' }}</textarea>
                                            </div>

                                            {# — Comentario visible — #}
                                            <div class="w-100 mt-3">
                                                <label class="form-label small" for="observations-{{ measure.id }}">{{ 'backend.plan.review.public_comment'|trans }}</label>
                                                {% if canProFeatures %}
                                                    <textarea
                                                        id="observations-{{ measure.id }}"
                                                        class="form-control"
                                                        rows="2"
                                                        autocomplete="off"
                                                        placeholder="{{ 'backend.plan.review.public_comment_ph'|trans }}">{{ pm.publicComment ?? '' }}</textarea>
                                                {% else %}
                                                    <textarea
                                                        id="observations-{{ measure.id }}"
                                                        class="form-control"
                                                        rows="2"
                                                        autocomplete="off"
                                                        disabled
                                                        placeholder="{{ 'backend.plan.review.available_in_pro'|trans }}">{{ pm.publicComment ?? '' }}</textarea>
                                                {% endif %}
                                            </div>

                                            {# — Responsables — #}
                                            <div class="w-100 mt-3">
                                                <label class="form-label small d-flex justify-content-between align-items-center" for="responsibles-{{ measure.id }}">
                                                    <span>{{ 'backend.plan.review.responsibles'|trans }}</span>
                                                    {% if not canProFeatures %}
                                                        <span class="text-muted">{{ 'backend.plan.exports.available_in_pro'|trans }}</span>
                                                    {% endif %}
                                                </label>
                                                {% if canProFeatures %}
                                                    <select
                                                        id="responsibles-{{ measure.id }}"
                                                        class="form-select"
                                                        multiple
                                                        size="4">
                                                        {% for crewMember in measureCrewMembers %}
                                                            {% set fullName = (crewMember.name ?? '') ~ ' ' ~ (crewMember.lastName ?? '') %}
                                                            <option value="{{ crewMember.id }}"
                                                                    {% if crewMember.id in responsibleIds %}selected{% endif %}>
                                                                {{ fullName|trim }}{% if crewMember.department %} · {{ crewMember.department.displayName }}{% endif %}
                                                            </option>
                                                        {% endfor %}
                                                    </select>
                                                    <div class="form-text">{{ 'backend.plan.review.responsibles_hint'|trans }}</div>
                                                {% else %}
                                                    <div class="form-control-plaintext">
                                                        {% if responsibleLabels is not empty %}
                                                            {{ responsibleLabels|join(', ') }}
                                                        {% else %}
                                                            —
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                            </div>

                                            {# — Notas internas — #}
                                            <div class="w-100 mt-3">
                                                <label class="form-label small d-flex justify-content-between align-items-center" for="internal-notes-{{ measure.id }}">
                                                    <span>{{ 'backend.plan.review.internal_notes'|trans }}</span>
                                                    <span class="text-muted small">{{ 'backend.plan.review.internal_notes_hint'|trans }}</span>
                                                </label>
                                                {% if canProFeatures %}
                                                    <textarea
                                                        id="internal-notes-{{ measure.id }}"
                                                        class="form-control"
                                                        rows="2"
                                                        placeholder="{{ 'backend.plan.review.internal_notes_ph'|trans }}">{{ pm.internalNotes ?? '' }}</textarea>
                                                {% else %}
                                                    <textarea
                                                        id="internal-notes-{{ measure.id }}"
                                                        class="form-control"
                                                        rows="2"
                                                        disabled
                                                        placeholder="{{ 'backend.plan.review.available_in_pro'|trans }}">{{ pm.internalNotes ?? '' }}</textarea>
                                                {% endif %}
                                            </div>

                                            {# — Evidencias — #}
                                            <div class="w-100 mt-3">
                                                <label class="form-label small d-flex justify-content-between align-items-center" for="evidences-{{ measure.id }}">
                                                    {{ 'backend.plan.review.evidences'|trans }}
                                                    {% if not canManageEvidence %}
                                                        <span class="text-muted small">({{ 'backend.common.readonly'|trans }})</span>
                                                    {% endif %}
                                                </label>

                                                {% if canManageEvidence %}
                                                    <input
                                                        type="file"
                                                        id="evidences-{{ measure.id }}"
                                                        class="form-control"
                                                        multiple
                                                        data-action="change->plan-review#validateEvidenceFiles change->plan-review#uploadEvidences"
                                                        data-measure-id="{{ measure.id }}"
                                                    >
                                                    <div class="form-text">{{ 'backend.plan.review.evidences_hint'|trans }}</div>
                                                {% endif %}

                                                {% set evidenceList = (pm and pm.evidence) ? pm.evidence|split("\n") : [] %}
                                                <ul id="evidence-list-{{ measure.id }}" class="list-group list-group-flush mt-2 border rounded">
                                                    {% if evidenceList is not empty %}
                                                        {% for path in evidenceList %}
                                                            {% if path %}
                                                                <li class="list-group-item d-flex align-items-center justify-content-between py-2">
                                                                    <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                                                                        <i class="bi bi-paperclip text-muted"></i>
                                                                        <a href="{{ path }}" target="_blank" rel="noopener"
                                                                           class="text-truncate text-decoration-none"
                                                                           style="max-width: 75%;">
                                                                            {{ path|split('/')|last }}
                                                                        </a>
                                                                    </div>

                                                                    {% if canManageEvidence %}
                                                                        <div class="ms-2">
                                                                            <button
                                                                                type="button"
                                                                                class="btn btn-sm text-danger"
                                                                                data-action="click->plan-review#deleteEvidence"
                                                                                data-measure-id="{{ measure.id }}"
                                                                                data-file="{{ path }}"
                                                                                data-bs-toggle="popover"
                                                                                data-bs-trigger="hover"
                                                                                data-bs-content="{{ 'backend.plan.review.delete_file'|trans({'%file%': path|split('/')|last}) }}">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        </div>
                                                                    {% endif %}
                                                                </li>
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        <li class="list-group-item py-2 text-muted small">{{ 'backend.plan.review.no_evidences'|trans }}</li>
                                                    {% endif %}
                                                </ul>
                                            </div>

                                            <div class="w-100 d-flex justify-content-end mt-2">
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-action="click->plan-review#saveInlineEdit"
                                                    data-measure-id="{{ measure.id }}">
                                                    {{ 'backend.common.save_changes'|trans }}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="col-12">
                                        <div class="small text-muted mb-1">{{ 'backend.plan.review.actions_title'|trans }}</div>
                                        <div class="d-flex flex-wrap gap-2 bg-white p-4">
                                            <div class="text-muted">{{ 'backend.plan.review.actions_hint'|trans }}</div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>

            {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="alert alert-info">{{ 'backend.plan.review.empty_filters'|trans }}</div>
{% endif %}
