{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.plan.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.plan.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div
    class="container my-4"
    data-controller="plan-measures"
    data-current-index="{{ index }}"
    data-total-measures="{{ total }}"
    data-review-url="{{ path('backend_plan_review') }}"
    data-critical-reason-error="{{ 'backend.plan.measures.critical_reason_required'|trans|e('html_attr') }}">
    <div class="row justify-content-center">
        <div class="col-12 bg-white p-4 rounded shadow">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">
                    {{ 'backend.plan.h2'|trans({'%project%': project.name})|raw }}
                </h2>

                <form action="{{ path('backend_plan_delete') }}" method="post" onsubmit="return confirm('{{ 'backend.plan.delete.confirm'|trans|e('js') }}');">
                    <button class="btn btn-outline-danger">
                        <i class="bi bi-trash"></i> {{ 'backend.plan.delete.btn'|trans }}
                    </button>
                </form>
            </div>

            {# --- Línea de badges: protocolo + tipo de proyecto + obligatoria --- #}
            <div class="d-flex justify-content-between align-items-start text-muted mb-3">
                <div class="d-flex align-items-center flex-wrap gap-1">
                    {# Badge de Protocolo #}
                    {% if plan.protocol %}
                        <span
                            class="badge bg-success"
                            data-bs-toggle="popover"
                            data-bs-trigger="hover"
                            data-bs-html="true"
                            data-bs-content="{{ 'backend.plan.badges.protocol_popover'|trans({'%protocol%': plan.protocol.name})|e('html_attr') }}">
                            <i class="bi bi-exclamation-circle"></i> {{ plan.protocol.name }}
                        </span>
                    {% else %}
                        <span class="badge bg-secondary">
                            <i class="bi bi-exclamation-circle"></i> —
                        </span>
                    {% endif %}

                    {# Badge de tipo de proyecto con icono (i18n) #}
                    {% set typeKey   = (project.type ?? '')|lower %}
                    {% set typeIcon  = typeKey == 'evento' ? 'bi-calendar-event' : 'bi-camera-reels' %}
                    {% set typeLabel = ('backend.project.type.' ~ typeKey)|trans %}

                    <span
                        class="badge bg-secondary"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover"
                        data-bs-html="true"
                        data-bs-content="{{ 'backend.plan.badges.type_popover'|trans({'%type%': typeLabel})|e('html_attr') }}">
                        <i class="bi {{ typeIcon }}"></i> {{ typeLabel }}
                    </span>

                    {# Badge de medida obligatoria (solo si la medida actual lo es) #}
                    {% if measure and measure.mandatory %}
                        <span
                            class="badge bg-danger-subtle text-danger border border-danger-subtle"
                            data-bs-toggle="popover"
                            data-bs-trigger="hover"
                            data-bs-html="true"
                            data-bs-content="{{ 'backend.plan.badges.mandatory_popover'|trans|e('html_attr') }}">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            {{ 'backend.plan.badges.mandatory'|trans }}
                        </span>
                    {% endif %}
                </div>

                <div class="text-end">
                    {% if measure %}
                        {% if scoreMax > 0 %}
                            <div
                                class="fw-semibold"
                                data-bs-toggle="popover"
                                data-bs-trigger="hover"
                                data-bs-html="true"
                                data-bs-content="{{ 'backend.plan.score.total_popover'|trans({'%gained%': scoreGained, '%max%': scoreMax})|e('html_attr') }}">
                                <i class="bi bi-star-fill me-1 text-warning me-2"></i>{{ scoreGained }} {{ 'backend.common.points'|trans }} / {{ scoreMax }} {{ 'backend.common.points'|trans }}
                            </div>
                        {% endif %}
                        <div
                            class="small text-muted"
                            data-bs-toggle="popover"
                            data-bs-trigger="hover"
                            data-bs-html="true"
                            data-bs-content="{{ 'backend.plan.score.current_popover'|trans({'%score%': (measure.score is not null ? measure.score : 0)})|e('html_attr') }}">
                            {{ 'backend.plan.score.current_label'|trans }}
                            <i class="bi bi-star-fill ms-1 me-1 text-warning"></i>{{ measure.score is not null ? (measure.score ~ ' ' ~ 'backend.common.points'|trans) : '—' }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex flex-column gap-1">
                    <div>
                        <strong>{{ 'backend.plan.tier.current'|trans }}:</strong> {{ projectTierLabel }}
                    </div>
                    <div>{{ projectTierSummary }}</div>
                    <div>
                        {% if evidenceLimit is not null %}
                            {{ 'backend.plan.tier.evidence_used'|trans({'%used%': evidenceCount, '%limit%': evidenceLimit}) }}
                        {% else %}
                            {{ 'backend.plan.tier.evidence_unlimited'|trans({'%used%': evidenceCount}) }}
                        {% endif %}
                    </div>
                </div>
                {% if upgradeCta.mode == 'modal' %}
                    <button
                        type="button"
                        class="btn btn-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#planUpgradeModal">
                        {{ upgradeCta.label }}
                    </button>
                {% elseif upgradeCta.mode == 'single' %}
                    {% set upgradeOption = upgradeCta.options|first %}
                    <form method="post" action="{{ path('backend_project_subscription_checkout', {id: project.id, targetTier: upgradeOption.targetTier}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_checkout_' ~ project.id ~ '_' ~ upgradeOption.targetTier) }}">
                        <button type="submit" class="btn btn-primary btn-sm">
                            {{ upgradeOption.ctaLabel }}
                        </button>
                    </form>
                {% elseif upgradeCta.mode == 'unavailable' %}
                    <span class="badge bg-warning text-dark border border-warning-subtle">
                        {{ upgradeCta.label }}
                    </span>
                {% else %}
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        {{ 'backend.plan.upgrade.active_title'|trans }}
                    </span>
                {% endif %}
            </div>

            {% if upgradeCta.mode == 'modal' %}
                <div class="modal fade" id="planUpgradeModal" tabindex="-1" aria-labelledby="planUpgradeModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <div>
                                    <h5 class="modal-title mb-1" id="planUpgradeModalLabel">{{ upgradeCta.title }}</h5>
                                    <div class="small text-muted">{{ 'backend.plan.upgrade.help'|trans }}</div>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row g-3">
                                    {% for option in upgradeCta.options %}
                                        <div class="col-12 {% if upgradeCta.options|length > 1 %}col-md-6{% endif %}">
                                            <div class="border rounded p-3 h-100 bg-light">
                                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                                    <div>
                                                        <div class="fw-semibold">{{ option.name }}</div>
                                                        {% if option.description %}
                                                            <div class="small text-muted">{{ option.description }}</div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="fw-semibold text-nowrap">{{ option.priceLabel }} <span class="small text-muted">+ IVA</span></div>
                                                    </div>
                                                </div>

                                                {% if option.allowedScores is not empty %}
                                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                                        {% for score in option.allowedScores %}
                                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">{{ score }}</span>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}

                                                <form method="post" action="{{ path('backend_project_subscription_checkout', {id: project.id, targetTier: option.targetTier}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('project_subscription_checkout_' ~ project.id ~ '_' ~ option.targetTier) }}">
                                                    <button type="submit" class="btn btn-primary w-100">
                                                        {{ option.ctaLabel }}
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if commercialCards is not empty %}
                <div class="row g-3 mb-3">
                    {% for card in commercialCards %}
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="border rounded p-3 h-100 bg-light">
                                <div class="fw-semibold">{{ card.label }}</div>
                                <div class="small text-muted">{{ card.reason }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if commitmentSummary is defined %}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="card-title mb-1">{{ 'backend.plan.commitment.title'|trans }}</h5>
                                <div class="text-muted small">{{ 'backend.plan.commitment.note'|trans }}</div>
                            </div>
                        </div>

                        <div class="row g-3">
                            {% for key, item in {
                                'planned': commitmentSummary.planned,
                                'real': commitmentSummary.implemented
                            } %}
                                <div class="col-12 col-lg-6">
                                    <div class="border rounded p-3 h-100 bg-light">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="fw-semibold">{{ ('backend.plan.commitment.' ~ key)|trans }}</div>
                                            <span class="badge bg-success">{{ ('backend.plan.commitment.levels.' ~ item.levelKey ~ '.label')|trans }}</span>
                                        </div>
                                        <div class="small text-muted mt-1">{{ ('backend.plan.commitment.levels.' ~ item.levelKey ~ '.message')|trans }}</div>
                                        <div class="d-flex justify-content-between small mt-3">
                                            <span>{{ 'backend.plan.commitment.points_of_total'|trans({'%points%': item.points, '%total%': commitmentSummary.totalOfficialPoints}) }}</span>
                                            <span>{{ item.percentageRounded }}%</span>
                                        </div>
                                        <div class="progress mt-2" style="height: 8px;">
                                            <div
                                                class="progress-bar bg-success"
                                                role="progressbar"
                                                style="width: {{ item.percentageRounded }}%;"
                                                aria-valuenow="{{ item.percentageRounded }}"
                                                aria-valuemin="0"
                                                aria-valuemax="100"></div>
                                        </div>
                                        {% if item.pointsToNextLevel is not null and item.levelKey != 'jungle' %}
                                            <div class="small text-muted mt-2">
                                                {{ 'backend.plan.commitment.next_level'|trans({'%points%': item.pointsToNextLevel}) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# ---- CONTENIDO PRINCIPAL ---- #}
            {% if planComplete %}
                {# Mostrar formulario de medidas personalizadas y Finalizar #}
                <div class="border rounded p-4 bg_green_1 shadow">
                    <h4 class="mb-3">{{ 'backend.plan.complete.title'|trans }}</h4>
                    <p class="text-muted">{{ 'backend.plan.complete.help'|trans }}</p>

                    <form action="{{ path('backend_plan_measures', app.request.query.all) }}" method="post" class="d-grid gap-3">
                        {% if projectTier == 'pro' %}
                            <div>
                                <textarea
                                    id="custom-measures"
                                    name="custom_measures"
                                    class="form-control"
                                    rows="5"
                                    placeholder="{{ 'backend.plan.complete.textarea_ph'|trans }}">{{ plan.customMeasures }}</textarea>
                                <div class="form-text">
                                    {{ 'backend.plan.complete.custom_measures_help'|trans }}
                                </div>
                            </div>
                        {% else %}
                            <div class="alert alert-warning mb-0">
                                {{ 'backend.plan.complete.custom_measures_locked'|trans }}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2 justify-content-end">
                            <button type="submit" name="finalize" class="btn btn-success">{{ 'backend.plan.complete.finalize_btn'|trans }}</button>
                        </div>
                    </form>
                </div>
            {% else %}
                {# Tarjeta de la medida actual #}
                {% if measure %}
                    {% include 'backend/plan/_measure_card.html.twig' with {
                        measure: measure,
                        planMeasures: planMeasures,
                        currentBlockAnswer: currentBlockAnswer,
                        projectType: project.type|default(null)
                    } %}
                {% else %}
                    <div class="alert alert-info">{{ 'backend.plan.measures.no_items'|trans }}</div>
                {% endif %}
            {% endif %}

            {% if not planComplete %}
                {# ——— Navegación medida a medida ——— #}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        {% set hasPrev = index > 0 %}
                        {% set hasNext = total > 0 and (index + 1) < total %}
                        {% set nextEnabled = hasNext and canGoNext %}

                        <a class="btn btn-outline-secondary text-decoration-none {% if not hasPrev %}disabled{% endif %}"
                           href="{% if hasPrev %}{{ path('backend_plan_measures', { i: index - 1 }) }}{% else %}#{% endif %}"
                           {% if not hasPrev %}tabindex="-1" aria-disabled="true"{% endif %}>
                            <i class="bi bi-chevron-left"></i> {{ 'backend.common.prev'|trans }}
                        </a>

                        <a class="btn btn-outline-secondary ms-2 text-decoration-none {% if not nextEnabled %}disabled{% endif %}"
                           href="{% if nextEnabled %}{{ path('backend_plan_measures', { i: index + 1 }) }}{% else %}#{% endif %}"
                           {% if not nextEnabled %}tabindex="-1" aria-disabled="true"{% endif %}>
                            {{ 'backend.common.next'|trans }} <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>

                    <div class="text-muted">
                        {% if total > 0 %}
                            {{ 'backend.plan.progress_applicable'|trans({'%current%': index + 1, '%total%': total}) }}
                            {% if catalogMeasuresTotal is defined and catalogMeasuresTotal > total %}
                                · {{ 'backend.plan.progress_included'|trans({'%total%': catalogMeasuresTotal}) }}
                            {% endif %}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# ——— Gráficos ——— #}
            <div class="col-12 mt-4"
                 data-controller="plan-charts"
                 data-plan-charts-charts-config-value='{{ planChartsConfig|json_encode|e('html_attr') }}'>

                <div class="row g-4">
                    <div class="col-12 col-lg-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="ratio ratio-16x9">
                                    <canvas data-plan-charts-target="canvas" data-chart-key="summary"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="ratio ratio-16x9">
                                    <canvas data-plan-charts-target="canvas" data-chart-key="alcance"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="ratio ratio-16x9">
                                    <canvas data-plan-charts-target="canvas" data-chart-key="commitment"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if app.request.query.has('i') and measure %}
        <script>
            window.addEventListener('load', () => {
                const card = document.getElementById('measure-card');
                if (!card) {
                    return;
                }

                const offset = 88;
                const top = card.getBoundingClientRect().top + window.scrollY - offset;
                window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
            });
        </script>
    {% endif %}
{% endblock %}
