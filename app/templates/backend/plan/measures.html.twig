{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.plan.elaboration.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.plan.elaboration.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div
    class="container-fluid px-0 backend-client-shell plan-measures-page"
    data-controller="plan-measures"
    data-current-index="{{ index }}"
    data-total-measures="{{ total }}"
    data-update-url="{{ path('backend_plan_update_selection') }}"
    data-review-url="{{ path('backend_plan_review', { is_applicable: '1', will_implement: '1' }) }}"
    data-observations-error="{{ 'backend.plan.measures.observations_required'|trans|e('html_attr') }}">
    <div class="backend-client-content">

            <div class="plan-page-header mb-3">
                <h2 class="mb-0">
                    {{ 'backend.plan.elaboration.h2'|trans({'%project%': project.name})|raw }}
                </h2>
            </div>

            {# --- Línea de badges: protocolo + tipo de proyecto + obligatoria --- #}
            <div class="plan-page-meta d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 text-muted mb-3">
                <div class="d-flex align-items-center flex-wrap gap-1">
                    {# Badge de Protocolo #}
                    {% if plan.protocol %}
                        <span
                            class="badge bg-success"
                            data-bs-toggle="popover"
                            data-bs-trigger="hover"
                            data-bs-html="true"
                            data-bs-content="{{ 'backend.plan.badges.protocol_popover'|trans({'%protocol%': plan.protocol.name})|e('html_attr') }}">
                            <i class="bi bi-exclamation-circle"></i> {{ plan.protocol.name }}
                        </span>
                    {% else %}
                        <span class="badge bg-secondary">
                            <i class="bi bi-exclamation-circle"></i> —
                        </span>
                    {% endif %}

                    {# Badge de tipo de proyecto con icono (i18n) #}
                    {% set typeKey   = (project.type ?? '')|lower %}
                    {% set typeIcon  = typeKey == 'evento' ? 'bi-calendar-event' : 'bi-camera-reels' %}
                    {% set typeLabel = ('backend.project.type.' ~ typeKey)|trans %}

                    <span
                        class="badge bg-secondary"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover"
                        data-bs-html="true"
                        data-bs-content="{{ 'backend.plan.badges.type_popover'|trans({'%type%': typeLabel})|e('html_attr') }}">
                        <i class="bi {{ typeIcon }}"></i> {{ typeLabel }}
                    </span>

                    {# Badge de medida obligatoria (solo si la medida actual lo es) #}
                    {% if measure and measure.mandatory %}
                        <span
                            class="badge bg-danger-subtle text-danger border border-danger-subtle"
                            data-bs-toggle="popover"
                            data-bs-trigger="hover"
                            data-bs-html="true"
                            data-bs-content="{{ 'backend.plan.badges.mandatory_popover'|trans|e('html_attr') }}">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            {{ 'backend.plan.badges.mandatory'|trans }}
                        </span>
                    {% endif %}
                </div>

            </div>

            {% include 'backend/plan/_gamification_message.html.twig' %}

            {% include 'backend/plan/_tier_summary_panel.html.twig' with {
                projectTier: projectTier,
                projectTierLabel: projectTierLabel,
                projectTierDisplayLabel: projectTierDisplayLabel|default(projectTierLabel),
                projectTierSummary: projectTierSummary,
                evidenceCount: evidenceCount,
                evidenceLimit: evidenceLimit,
                upgradeCta: upgradeCta,
                project: project,
                phaseLabel: 'backend.commercial_phases.elaboration'|trans,
                phaseUpgradeLabel: 'backend.plan.upgrade.elaboration'|trans
            } %}

            {# ---- CONTENIDO PRINCIPAL ---- #}
            {% if planComplete %}
                <div class="border rounded p-4 bg_green_1 shadow">
                    <div class="alert alert-success border-0 mb-3">
                        <div class="fw-semibold mb-1">{{ 'backend.plan.complete.custom_measures_prompt'|trans }}</div>
                        <div class="small">{{ 'backend.plan.complete.custom_measures_prompt_help'|trans }}</div>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
                        <div>
                            <h4 class="mb-1">{{ 'backend.plan.complete.title'|trans }}</h4>
                            <p class="text-muted mb-0">{{ 'backend.plan.complete.help'|trans }}</p>
                        </div>

                        {% if canUseCustomMeasures %}
                            <button
                                type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#customMeasureModal">
                                <i class="bi bi-plus-circle"></i> {{ 'backend.plan.complete.add_custom_measure'|trans }}
                            </button>
                        {% endif %}
                    </div>

                    {% if customMeasures is not empty %}
                        <div class="mb-3">
                            <div class="small text-uppercase text-muted fw-semibold mb-2">{{ 'backend.plan.complete.custom_measures_title'|trans }}</div>
                            <div class="row g-3">
                                {% for customMeasure in customMeasures %}
                                    <div class="col-12 col-md-6">
                                        <div class="border rounded p-3 bg-white h-100">
                                            <div class="d-flex align-items-start justify-content-between gap-2">
                                                <div class="fw-semibold">{{ customMeasure.title }}</div>
                                                <span class="badge bg-success-subtle text-success border">{{ 'backend.plan.complete.custom_measure_badge'|trans }}</span>
                                            </div>
                                            <div class="small text-muted mt-2">
                                                {{ customMeasure.description ?: 'backend.plan.custom_measures.no_description'|trans }}
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge bg-light text-dark border">
                                                    {{ ('backend.plan.review.custom_measures.state.' ~ customMeasure.state)|trans }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-3">
                            {{ 'backend.plan.complete.custom_measures_empty'|trans }}
                        </div>
                    {% endif %}

                    {% if not canUseCustomMeasures %}
                        <div class="alert alert-warning mb-0">
                            <div class="fw-semibold mb-1">{{ 'backend.plan.complete.custom_measures_locked'|trans }}</div>
                            <div class="small">{{ 'backend.plan.complete.custom_measures_locked_help'|trans }}</div>
                        </div>
                    {% endif %}

                    <form action="{{ path('backend_plan_measures', navigationQuery) }}" method="post" class="d-grid gap-3 mt-3">
                        <input type="hidden" name="action" value="continue_custom_measures">
                        <div class="d-flex gap-2 justify-content-end">
                            <button type="submit" class="btn btn-success">
                                {{ 'backend.plan.complete.go_to_elaboration_close'|trans }}
                            </button>
                        </div>
                    </form>
                </div>

                {% if canUseCustomMeasures %}
                    <div class="modal fade" id="customMeasureModal" tabindex="-1" aria-labelledby="customMeasureModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <form action="{{ path('backend_plan_measures', navigationQuery) }}" method="post">
                                    <input type="hidden" name="action" value="add_custom_measure">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="customMeasureModalLabel">{{ 'backend.plan.complete.custom_measures_modal_title'|trans }}</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="text-muted">{{ 'backend.plan.complete.custom_measures_modal_help'|trans }}</p>
                                        <div class="mb-3">
                                            <label for="custom_measure_title" class="form-label">{{ 'backend.plan.complete.custom_measure_title_label'|trans }}</label>
                                            <input
                                                type="text"
                                                id="custom_measure_title"
                                                name="custom_measure_title"
                                                class="form-control"
                                                maxlength="255"
                                                required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="custom_measure_description" class="form-label">{{ 'backend.plan.complete.custom_measure_description_label'|trans }}</label>
                                            <textarea
                                                id="custom_measure_description"
                                                name="custom_measure_description"
                                                class="form-control"
                                                rows="4"
                                                placeholder="{{ 'backend.plan.complete.custom_measure_description_ph'|trans }}"></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'backend.common.cancel'|trans }}</button>
                                        <button type="submit" class="btn btn-primary">{{ 'backend.plan.complete.custom_measure_save_btn'|trans }}</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                {# Tarjeta de la medida actual #}
                {% if measure %}
                    {% set measureNavigation = {
                        hasPrev: index > 0,
                        hasNext: total > 0 and (index + 1) < total,
                        nextEnabled: total > 0 and (index + 1) < total and canGoNext,
                        prevHref: path('backend_plan_measures', navigationQuery|merge({ i: index - 1 })),
                        nextHref: path('backend_plan_measures', navigationQuery|merge({ i: index + 1 })),
                        current: progressIndex|default(index),
                        total: total
                    } %}

                    {% include 'backend/plan/_measure_card.html.twig' with {
                        measure: measure,
                        planMeasures: planMeasures,
                        currentBlockAnswer: currentBlockAnswer,
                        projectType: project.type|default(null),
                        measureNavigation: measureNavigation
                    } %}
                    {% if commitmentSummary is defined %}
                        {% include 'backend/plan/_commitment_growth_footer.html.twig' with {
                            variant: 'full',
                            showHeader: false,
                            title: 'backend.plan.commitment.planned'|trans,
                            note: 'backend.plan.commitment.note'|trans,
                            totalPoints: commitmentSummary.totalOfficialPoints,
                            items: [
                                {
                                    label: 'backend.plan.commitment.planned'|trans,
                                    block: commitmentSummary.planned
                                }
                            ]
                        } %}
                    {% endif %}
                {% else %}
                    <div class="alert alert-info">{{ 'backend.plan.measures.no_items'|trans }}</div>
                {% endif %}
            {% endif %}

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if app.request.query.has('i') and measure %}
        <script>
            window.addEventListener('load', () => {
                const target = document.querySelector('[data-gamification-message]')
                    || document.getElementById('measure-card');
                if (!target) {
                    return;
                }

                const offset = 96;
                const top = target.getBoundingClientRect().top + window.scrollY - offset;
                window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
            });
        </script>
    {% endif %}
{% endblock %}
