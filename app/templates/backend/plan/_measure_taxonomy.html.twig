{% set showDepartments = showDepartments is defined ? showDepartments : true %}
{% set showImpactAreas = showImpactAreas is defined ? showImpactAreas : true %}
{% set showTripleBalance = showTripleBalance is defined ? showTripleBalance : true %}
{% set showVerificationSources = showVerificationSources is defined ? showVerificationSources : true %}
{% set projectType = projectType|default(null) %}

{% set departments = showDepartments ? taxonomyPresenter.departmentBadges(measure, projectType) : [] %}
{% if departments is not empty %}
    <dt class="{{ dtClass|default('col-md-4 col-lg-2') }}">{{ 'backend.plan.measure.department'|trans }}</dt>
    <dd class="{{ ddClass|default('col-md-8 col-lg-10') }} d-flex flex-wrap gap-1">
        {% for department in departments %}
            <span class="badge bg-success-subtle text-success-emphasis border"
                  title="{{ department.title|default(department.displayName) }}">
                {{ department.displayName }}
            </span>
        {% endfor %}
    </dd>
{% endif %}

{% set odsItems = showOds is defined and showOds is same as(false) ? [] : taxonomyPresenter.odsBadges(measure) %}
{% if odsItems is not empty %}
    <dt class="{{ dtClass|default('col-md-4 col-lg-2') }}">ODS</dt>
    <dd class="{{ ddClass|default('col-md-8 col-lg-10') }} d-flex flex-wrap gap-1">
        {% for ods in odsItems %}
            <span class="badge bg-warning-subtle text-warning-emphasis border"
                  title="{{ ods.title|default(ods.label) }}">
                {{ ods.badgeLabel|default(ods.label) }}
            </span>
        {% endfor %}
    </dd>
{% endif %}

{% set impactAreas = showImpactAreas ? taxonomyPresenter.impactAreas(measure) : [] %}
{% if impactAreas is not empty %}
    <dt class="{{ dtClass|default('col-md-4 col-lg-2') }}">Áreas de impacto</dt>
    <dd class="{{ ddClass|default('col-md-8 col-lg-10') }} d-flex flex-wrap gap-1">
        {% for impactArea in impactAreas %}
            <span class="badge bg-success-subtle text-success-emphasis border">{{ impactArea.name }}</span>
        {% endfor %}
    </dd>
{% endif %}

{% set axes = showTripleBalance ? taxonomyPresenter.tripleBalanceAxes(measure) : [] %}
{% if axes is not empty %}
    <dt class="{{ dtClass|default('col-md-4 col-lg-2') }}">Triple balance</dt>
    <dd class="{{ ddClass|default('col-md-8 col-lg-10') }} d-flex flex-wrap gap-1">
        {% for axis in axes %}
            {% set axisName = (axis.name|default('')|lower)|replace({
                'á': 'a',
                'é': 'e',
                'í': 'i',
                'ó': 'o',
                'ú': 'u',
                'ü': 'u',
            }) %}
            {% set axisBadgeClass = 'bg-secondary-subtle text-secondary-emphasis border' %}
            {% if axisName == 'ambiental' %}
                {% set axisBadgeClass = 'bg-success-subtle text-success-emphasis border' %}
            {% elseif axisName == 'economico' %}
                {% set axisBadgeClass = 'bg-warning-subtle text-warning-emphasis border' %}
            {% elseif axisName == 'social' %}
                {% set axisBadgeClass = 'bg-primary-subtle text-primary-emphasis border' %}
            {% endif %}
            <span class="badge rounded-pill {{ axisBadgeClass }}">{{ axis.name }}</span>
        {% endfor %}
    </dd>
{% endif %}

{% if showVerificationSources %}
    {% set verificationLinks = taxonomyPresenter.verificationSourcesWithPriority(measure) %}
    {% if verificationLinks is not empty %}
        <dt class="{{ dtClass|default('col-md-4 col-lg-2') }}">{{ 'backend.plan.review.verification_sources'|trans }}</dt>
        <dd class="{{ ddClass|default('col-md-8 col-lg-10') }} d-flex flex-wrap gap-1 align-items-center">
            {% for link in verificationLinks %}
                <span class="badge bg-light text-dark border rounded-pill">
                    {{ link.displayName|default(link.name) }}
                </span>
            {% endfor %}
        </dd>
    {% elseif measure.verificationSources %}
        <dt class="{{ dtClass|default('col-md-4 col-lg-2') }}">{{ 'backend.plan.review.verification_sources'|trans }}</dt>
        <dd class="{{ ddClass|default('col-md-8 col-lg-10') }}">{{ measure.verificationSources }}</dd>
    {% endif %}
{% endif %}
