<form method="get" id="plan-filters-form" class="w-100 mb-4" style="scroll-margin-top: 110px;">
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-4">
            <label class="form-label small text-muted fw-semibold mb-1" for="filter-category">
                {{ 'backend.plan.filters.category'|trans }}
            </label>
            <select
                class="selectpicker"
                name="category"
                id="filter-category"
                data-style="form-select border border-success-subtle bg-white shadow-sm py-2"
                data-width="100%"
                data-live-search="true"
                data-none-selected-text="{{ 'backend.plan.filters.category_all'|trans }}"
                data-dt-filter="category">
                <option value="">{{ 'backend.plan.filters.category_all'|trans }}</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>
                        {{ category.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <label class="form-label small text-muted fw-semibold mb-1" for="filter-department">
                {{ 'backend.plan.filters.department'|trans }}
            </label>
            <select
                class="selectpicker"
                name="department"
                id="filter-department"
                data-style="form-select border border-success-subtle bg-white shadow-sm py-2"
                data-width="100%"
                data-live-search="true"
                data-none-selected-text="{{ 'backend.plan.filters.department_all'|trans }}"
                data-dt-filter="department">
                <option value="">{{ 'backend.plan.filters.department_all'|trans }}</option>
                {% for department in departments %}
                    <option value="{{ department.id }}" {{ filters.department == department.id ? 'selected' : '' }}>
                        {{ department.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <label class="form-label small text-muted fw-semibold mb-1" for="filter-ods">
                {{ 'backend.plan.filters.ods'|trans }}
            </label>
            <select
                class="selectpicker"
                name="ods"
                id="filter-ods"
                data-style="form-select border border-success-subtle bg-white shadow-sm py-2"
                data-width="100%"
                data-live-search="true"
                data-none-selected-text="{{ 'backend.plan.filters.ods_all'|trans }}"
                data-dt-filter="ods">
                <option value="">{{ 'backend.plan.filters.ods_all'|trans }}</option>
                {% for ods in odsList %}
                    <option value="{{ ods.id }}" {{ filters.ods == ods.id ? 'selected' : '' }}>
                        {{ ods.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <label class="form-label small text-muted fw-semibold mb-1" for="filter-impact-area">
                {{ 'backend.plan.filters.impact_area'|trans }}
            </label>
            <select
                class="selectpicker"
                name="impact_area"
                id="filter-impact-area"
                data-style="form-select border border-success-subtle bg-white shadow-sm py-2"
                data-width="100%"
                data-live-search="true"
                data-none-selected-text="{{ 'backend.plan.filters.impact_area_all'|trans }}"
                data-dt-filter="impact_area">
                <option value="">{{ 'backend.plan.filters.impact_area_all'|trans }}</option>
                {% for impactArea in impactAreas %}
                    <option value="{{ impactArea.id }}" {{ filters.impact_area == impactArea.id ? 'selected' : '' }}>
                        {{ impactArea.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <label class="form-label small text-muted fw-semibold mb-1" for="filter-triple-balance-axis">
                {{ 'backend.plan.filters.triple_balance'|trans }}
            </label>
            <select
                class="selectpicker"
                name="triple_balance_axis"
                id="filter-triple-balance-axis"
                data-style="form-select border border-success-subtle bg-white shadow-sm py-2"
                data-width="100%"
                data-live-search="true"
                data-none-selected-text="{{ 'backend.plan.filters.triple_balance_all'|trans }}"
                data-dt-filter="triple_balance_axis">
                <option value="">{{ 'backend.plan.filters.triple_balance_all'|trans }}</option>
                {% for axis in tripleBalanceAxes %}
                    <option value="{{ axis.id }}" {{ filters.triple_balance_axis == axis.id ? 'selected' : '' }}>
                        {{ axis.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <label class="form-label small text-muted fw-semibold mb-1" for="filter-scope">
                {{ 'backend.plan.filters.scope'|trans }}
            </label>
            <select
                class="selectpicker"
                name="scope"
                id="filter-scope"
                data-style="form-select border border-success-subtle bg-white shadow-sm py-2"
                data-width="100%"
                data-live-search="true"
                data-none-selected-text="{{ 'backend.plan.filters.scope_all'|trans }}"
                data-dt-filter="scope">
                <option value="">{{ 'backend.plan.filters.scope_all'|trans }}</option>
                {% for scope in scopeList %}
                    <option value="{{ scope.id }}" {{ filters.scope == scope.id ? 'selected' : '' }}>
                        {{ scope.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
    </div>

    <div class="border-top mt-4 pt-3">
        <div class="d-flex flex-column flex-xl-row gap-3 align-items-start">
            <div class="flex-grow-1">
                <div class="small text-uppercase text-muted fw-semibold mb-2">
                    {{ 'backend.plan.filters.state_title'|trans }}
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <input
                        class="btn-check"
                        type="radio"
                        name="state"
                        id="filter-state-all"
                        value="all"
                        {{ filters.state|default('pending') == 'all' ? 'checked' : '' }}
                        data-dt-filter="state">
                    <label
                        class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.state|default('pending') == 'all' ? 'btn-success' : 'btn-outline-success' }}"
                        for="filter-state-all">
                        <i class="bi bi-list-ul"></i>
                        {{ 'backend.plan.filters.state_all'|trans }}
                    </label>

                    <input
                        class="btn-check"
                        type="radio"
                        name="state"
                        id="filter-state-pending"
                        value="pending"
                        {{ filters.state|default('pending') == 'pending' ? 'checked' : '' }}
                        data-dt-filter="state">
                    <label
                        class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.state|default('pending') == 'pending' ? 'btn-success' : 'btn-outline-success' }}"
                        for="filter-state-pending">
                        <i class="bi bi-clock"></i>
                        {{ 'backend.plan.filters.state_pending'|trans }}
                    </label>

                    <input class="btn-check" type="radio" name="state" id="filter-state-in-progress" value="in_progress"
                        {{ filters.state|default('pending') == 'in_progress' ? 'checked' : '' }} data-dt-filter="state">
                    <label class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.state|default('pending') == 'in_progress' ? 'btn-success' : 'btn-outline-success' }}" for="filter-state-in-progress">
                        <i class="bi bi-arrow-repeat"></i>{{ 'backend.plan.filters.state_in_progress'|trans }}
                    </label>

                    <input class="btn-check" type="radio" name="state" id="filter-state-implemented" value="implemented"
                        {{ filters.state|default('pending') == 'implemented' ? 'checked' : '' }} data-dt-filter="state">
                    <label class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.state|default('pending') == 'implemented' ? 'btn-success' : 'btn-outline-success' }}" for="filter-state-implemented">
                        <i class="bi bi-check-circle"></i>{{ 'backend.plan.filters.state_implemented'|trans }}
                    </label>

                    <input class="btn-check" type="radio" name="state" id="filter-state-not-implemented" value="not_implemented"
                        {{ filters.state|default('pending') == 'not_implemented' ? 'checked' : '' }} data-dt-filter="state">
                    <label class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.state|default('pending') == 'not_implemented' ? 'btn-success' : 'btn-outline-success' }}" for="filter-state-not-implemented">
                        <i class="bi bi-x-circle"></i>{{ 'backend.plan.filters.state_not_implemented'|trans }}
                    </label>

                    <input
                        class="btn-check"
                        type="radio"
                        name="state"
                        id="filter-state-discarded"
                        value="discarded"
                        {{ filters.state|default('pending') == 'discarded' ? 'checked' : '' }}
                        data-dt-filter="state">
                    <label
                        class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.state|default('pending') == 'discarded' ? 'btn-success' : 'btn-outline-success' }}"
                        for="filter-state-discarded">
                        <i class="bi bi-slash-circle"></i>
                        {{ 'backend.plan.filters.state_discarded'|trans }}
                    </label>

                    <input class="btn-check" type="radio" name="state" id="filter-state-not-applicable" value="not_applicable"
                        {{ filters.state|default('pending') == 'not_applicable' ? 'checked' : '' }} data-dt-filter="state">
                    <label class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.state|default('pending') == 'not_applicable' ? 'btn-success' : 'btn-outline-success' }}" for="filter-state-not-applicable">
                        <i class="bi bi-dash-circle"></i>{{ 'backend.plan.filters.state_not_applicable'|trans }}
                    </label>
                </div>
            </div>

            <div class="flex-shrink-0 ms-xl-auto">
                <div class="small text-uppercase text-muted fw-semibold mb-2">
                    {{ 'backend.plan.filters.quick_title'|trans }}
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <input
                        class="btn-check"
                        type="checkbox"
                        name="is_critical"
                        id="filter-is-critical"
                        value="1"
                        {{ filters.is_critical ? 'checked' : '' }}
                        data-dt-filter="is_critical">
                    <label
                        class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ filters.is_critical ? 'btn-outline-danger' : 'btn-outline-secondary' }}"
                        for="filter-is-critical">
                        <i class="bi bi-exclamation-triangle"></i>
                        {{ 'backend.plan.filters.critical'|trans }}
                    </label>
                </div>
            </div>
        </div>
    </div>
</form>
