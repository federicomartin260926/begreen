{% extends 'base_backend.html.twig' %}

{% block title %}{{ 'backend.plan.implementation.title'|trans }}{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'backend.plan.implementation.breadcrumb'|trans }}</li>
{% endblock %}

{% block body %}
<div
    class="container-fluid px-0 backend-client-shell"
    data-controller="plan-review"
    data-plan-review-i18n-value="{{ {
        'loading_preview':               'backend.plan.review.stimulus.loading_preview'|trans,
        'preview_error':                 'backend.plan.review.stimulus.preview_error'|trans,
        'pdf_error_http':                'backend.plan.review.stimulus.pdf_error_http'|trans,
        'pdf_error_generic':             'backend.plan.review.stimulus.pdf_error_generic'|trans,
        'pdf_default_filename':          'backend.plan.review.stimulus.pdf_default_filename'|trans,
        'status_pending':                'backend.plan.review.status_pending'|trans,
        'status_in_progress':            'backend.plan.review.status_in_progress'|trans,
        'status_implemented':            'backend.plan.review.status_implemented'|trans,
        'status_not_implemented':        'backend.plan.review.status_not_implemented'|trans,
        'save_error_generic':            'backend.plan.review.stimulus.save_error_generic'|trans,
        'network_error':                 'backend.plan.review.stimulus.network_error'|trans,
        'modal.error_title':             'backend.plan.review.stimulus.modal.error_title'|trans,
        'modal.notice_title':            'backend.plan.review.stimulus.modal.notice_title'|trans,
        'modal.missing_title':           'backend.plan.review.stimulus.modal.missing_title'|trans,
        'modal.default_title':           'backend.plan.review.stimulus.modal.default_title'|trans,
        'save_missing_fields_html':      'backend.plan.review.stimulus.save_missing_fields_html'|trans|raw,
        'upload_invalid_response':       'backend.plan.review.stimulus.upload_invalid_response'|trans,
        'upload_failed_http':            'backend.plan.review.stimulus.upload_failed_http'|trans,
        'evidence_upload_failed':        'backend.plan.review.stimulus.evidence_upload_failed'|trans,
        'evidence_add_modal_source_required': 'backend.plan.review.stimulus.evidence_add_modal_source_required'|trans,
        'evidence_add_modal_source_required_inline': 'backend.plan.review.stimulus.evidence_add_modal_source_required_inline'|trans,
        'evidence_delete_confirm':       'backend.plan.review.stimulus.evidence_delete_confirm'|trans,
        'evidence_delete_error':         'backend.plan.review.stimulus.evidence_delete_error'|trans,
        'evidence_delete_failed':        'backend.plan.review.stimulus.evidence_delete_failed'|trans,
        'evidence_max_files':            'backend.plan.review.stimulus.evidence_max_files'|trans,
        'evidence_selected_files':       'backend.plan.review.stimulus.evidence_selected_files'|trans,
        'evidence_max_size':             'backend.plan.review.stimulus.evidence_max_size'|trans,
        'evidence_oversized_list_intro': 'backend.plan.review.stimulus.evidence_oversized_list_intro'|trans,
        'observations_required_html':   'backend.plan.review.stimulus.observations_required_html'|trans({'%min%': constant('App\\Service\\PlanMeasureElaborationDecisionValidator::MIN_OBSERVATIONS_LENGTH')})|raw
    }|json_encode|e('html_attr') }}">
    <div class="backend-client-content">
            <div class="mb-4">
                <h2 class="mb-0">
                    {{ 'backend.plan.implementation.h2'|trans({'%project%': project.name})|raw }}
                </h2>
            </div>

            {% set typeKey   = (project.type ?? '')|lower %}
            {% set typeIcon  = typeKey == 'evento' ? 'bi-calendar-event' : 'bi-camera-reels' %}
            {% set typeLabel = ('backend.project.type.' ~ typeKey)|trans %}

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2 gap-lg-3 mb-3">
                <div class="plan-review-meta d-flex flex-wrap align-items-center gap-2 min-w-0">
                    {# Estado del plan #}
                    <span
                        class="badge bg-success"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover"
                        data-bs-html="true"
                        data-bs-content="{{ 'backend.plan.review.badges.status_popover'|trans({'%status%': ('backend.plan.status.' ~ plan.status)|trans })|e('html_attr') }}">
                        <i class="bi bi-exclamation-circle"></i>
                        {{ 'backend.plan.review.plan_status'|trans({'%status%': ('backend.plan.status.' ~ plan.status)|trans }) }}
                        {% if plan.statusChangedAt %}
                            <span class="ms-2 small">
                                ({{ plan.statusChangedAt|date('d/m/Y H:i') }})
                            </span>
                        {% endif %}
                    </span>

                    {# Protocolo #}
                    {% if plan.protocol %}
                        <span
                            class="badge bg-success ms-1"
                            data-bs-toggle="popover"
                            data-bs-trigger="hover"
                            data-bs-html="true"
                            data-bs-content="{{ 'backend.plan.badges.protocol_popover'|trans({'%protocol%': plan.protocol.name})|e('html_attr') }}">
                            <i class="bi bi-exclamation-circle"></i> {{ plan.protocol.name }}
                        </span>
                    {% endif %}

                    <span
                        class="badge bg-secondary ms-1"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover"
                        data-bs-html="true"
                        data-bs-content="{{ 'backend.plan.badges.type_popover'|trans({'%type%': typeLabel})|e('html_attr') }}">
                        <i class="bi {{ typeIcon }}"></i> {{ typeLabel }}
                    </span>

                    <span
                        class="badge ms-1 {% if projectTier == 'pro' %}bg-success{% elseif projectTier == 'standard' %}bg-warning text-dark{% else %}bg-secondary{% endif %}"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover"
                        data-bs-html="true"
                        data-bs-content="{{ projectTierSummary|e('html_attr') }}">
                        {{ 'backend.plan.review.plan_context'|trans }} {{ projectTierLabel }}
                    </span>

                    <span class="badge bg-light text-dark border ms-1">
                        {{ 'backend.plan.tier.evidence_used'|trans({'%used%': evidenceCount, '%limit%': evidenceLimit is not null ? evidenceLimit : '∞'}) }}
                    </span>

                    {# Puntuación #}
                    {% if scoreMax > 0 %}
                        <span
                            class="badge bg-warning text-dark ms-1">
                            <i class="bi bi-star-fill me-1"></i>{{ scoreGained }} {{ 'backend.common.points'|trans }} / {{ scoreMax }} {{ 'backend.common.points'|trans }}
                        </span>
                    {% endif %}
                </div>

            </div>

            {% include 'backend/plan/_tier_summary_panel.html.twig' with {
                phaseLabel: 'backend.commercial_phases.implementation'|trans,
                phaseUpgradeLabel: 'backend.plan.upgrade.implementation'|trans,
                comparisonFrom: 'review',
                exportModalId: 'implementation-export-options'
            } %}

            {% include 'backend/plan/_export_options_panel.html.twig' with {
                plan: plan,
                exportOptions: reviewExportOptions,
                modalId: 'implementation-export-options'
            } only %}

            {% if customMeasures is not empty %}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="card-title mb-1">{{ 'backend.plan.review.custom_measures.title'|trans }}</h5>
                                <div class="text-muted small">{{ 'backend.plan.review.custom_measures.help'|trans }}</div>
                            </div>
                            <span class="badge bg-success">{{ customMeasures|length }}</span>
                        </div>

                        <div class="row g-3">
                            {% for customMeasure in customMeasures %}
                                <div class="col-12 col-md-6">
                                    <div class="border rounded p-3 h-100 bg-light">
                                        <div class="d-flex align-items-start justify-content-between gap-2">
                                            <div class="fw-semibold">{{ customMeasure.title }}</div>
                                            <span class="badge bg-success-subtle text-success border">{{ 'backend.plan.review.custom_measures.badge'|trans }}</span>
                                        </div>
                                        <div class="small text-muted mb-2 mt-1">
                                            <span class="text-capitalize">{{ ('backend.plan.review.custom_measures.state.' ~ customMeasure.state)|trans }}</span>
                                        </div>
                                        {% if customMeasure.description %}
                                            <div class="small">{{ customMeasure.description }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# FILTROS #}
            <div id="implementation-filters">
                {% include 'backend/plan/_measure_filters_panel.html.twig' with {
                    filters: filters,
                    panelId: 'measure-filters-review',
                    compact: true
                } %}
            </div>

            {# MEDIDAS AGRUPADAS POR CATEGORÍA #}
            {% if implementationGroups is not empty %}
                <div class="implementation-categories d-flex flex-column gap-3" data-implementation-categories>
                    {% for group in implementationGroups %}
                        {% set categoryCollapseId = 'implementation-category-' ~ group.key %}
                        <section class="implementation-category card border-0 shadow-sm {{ group.completed ? 'implementation-category--completed' : '' }}"
                                 data-implementation-category="{{ group.key }}">
                            <div class="implementation-category__header card-header bg-body p-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                            <h3 class="h6 mb-0 text-success-emphasis">{{ group.name }}</h3>
                                            <span class="badge bg-light text-dark border">
                                                {% if group.outsideProgress or group.visibleCount == group.totalComputable %}
                                                    {{ 'backend.plan.review.implementation_categories.measures'|trans({'%count%': group.visibleCount}) }}
                                                {% else %}
                                                    {{ 'backend.plan.review.implementation_categories.visible_of_total'|trans({'%visible%': group.visibleCount, '%total%': group.totalComputable}) }}
                                                {% endif %}
                                            </span>
                                            {% if group.completed %}
                                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                                                    <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>{{ 'backend.plan.review.implementation_categories.completed'|trans }}
                                                </span>
                                            {% endif %}
                                        </div>

                                        {% if group.outsideProgress %}
                                            <div class="small text-muted">
                                                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>{{ 'backend.plan.review.implementation_categories.outside_progress'|trans }}
                                            </div>
                                        {% else %}
                                            <div class="d-flex flex-wrap align-items-center gap-2 small mb-1">
                                                <span>{{ 'backend.plan.review.implementation_categories.resolved'|trans({'%resolved%': group.resolved, '%total%': group.totalComputable}) }}</span>
                                                <span class="text-muted">{{ 'backend.plan.review.implementation_categories.progress'|trans({'%percentage%': group.progressPercentage}) }}</span>
                                            </div>
                                            <div class="progress implementation-category__progress"
                                                 role="progressbar"
                                                 aria-label="{{ 'backend.plan.review.implementation_categories.progress_label'|trans({'%category%': group.name}) }}"
                                                 aria-valuenow="{{ group.progressPercentage }}"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                <div class="progress-bar bg-success" style="width: {{ group.progressPercentage }}%"></div>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <button class="btn btn-sm {{ group.isOpen ? 'btn-success' : 'btn-outline-success' }} flex-shrink-0"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#{{ categoryCollapseId }}"
                                            data-implementation-category-toggle
                                            data-collapse-static-class="1"
                                            data-expand-label="{{ 'backend.plan.review.implementation_categories.expand'|trans({'%category%': group.name}) }}"
                                            data-collapse-label="{{ 'backend.plan.review.implementation_categories.collapse'|trans({'%category%': group.name}) }}"
                                            aria-expanded="{{ group.isOpen ? 'true' : 'false' }}"
                                            aria-controls="{{ categoryCollapseId }}"
                                            aria-label="{{ group.isOpen ? 'backend.plan.review.implementation_categories.collapse'|trans({'%category%': group.name}) : 'backend.plan.review.implementation_categories.expand'|trans({'%category%': group.name}) }}">
                                        <i class="bi {{ group.isOpen ? 'bi-chevron-down' : 'bi-chevron-right' }}" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div id="{{ categoryCollapseId }}"
                                 class="collapse {{ group.isOpen ? 'show' : '' }}"
                                 data-implementation-category-collapse>
                                <div class="card-body p-2 p-md-3">
                                    {% include 'backend/plan/_list.html.twig' with {
                                        implementationItems: group.items
                                    } %}
                                </div>
                            </div>
                        </section>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info">{{ 'backend.plan.review.empty_filters'|trans }}</div>
            {% endif %}

            {# GRÁFICOS #}
            <div
                data-controller="plan-charts"
                data-plan-charts-charts-config-value='{{ planChartsConfig|json_encode|e('html_attr') }}'>

                <div class="row g-4 mt-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="backend-chart-title backend-review-chart-title text-center mb-2">{{ 'backend.plan.review.charts.applicability.title'|trans }}</div>
                                <div class="ratio ratio-16x9 flex-grow-1">
                                    <canvas data-plan-charts-target="canvas" data-chart-key="applicability"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="backend-chart-title backend-review-chart-title text-center mb-2">{{ 'backend.plan.review.charts.commitment.title'|trans }}</div>
                                <div class="ratio ratio-16x9 flex-grow-1">
                                    <canvas data-plan-charts-target="canvas" data-chart-key="commitment"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="backend-chart-title backend-review-chart-title text-center mb-2">{{ 'backend.plan.review.charts.compliance.title'|trans }}</div>
                                <div class="ratio ratio-16x9 flex-grow-1">
                                    <canvas data-plan-charts-target="canvas" data-chart-key="compliance"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="backend-chart-title backend-review-chart-title text-center mb-2">{{ 'backend.plan.review.charts.achievements.title'|trans }}</div>
                                <div class="ratio ratio-16x9 flex-grow-1">
                                    <canvas data-plan-charts-target="canvas" data-chart-key="achievements"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if commitmentSummary is defined %}
                <div class="d-flex flex-column gap-4 mt-4">
                    {% include 'backend/plan/_commitment_growth_footer.html.twig' with {
                        variant: 'full',
                        title: 'backend.plan.commitment.title'|trans,
                        note: 'backend.plan.commitment.note'|trans,
                        totalPoints: commitmentSummary.totalOfficialPoints,
                        items: [
                            {
                                label: 'backend.plan.commitment.real'|trans,
                                block: commitmentSummary.implemented
                            }
                        ]
                    } %}

                    {% include 'backend/plan/_commitment_growth_footer.html.twig' with {
                        variant: 'compact',
                        title: 'backend.plan.commitment.planned'|trans,
                        totalPoints: commitmentSummary.totalOfficialPoints,
                        items: [
                            {
                                label: 'backend.plan.commitment.planned'|trans,
                                block: commitmentSummary.planned
                            }
                        ]
                    } %}
                </div>
            {% endif %}
    </div>

    {# MODAL vista previa #}
    <div class="modal fade" id="planPreviewModal" tabindex="-1" aria-labelledby="planPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl" style="height: calc(100vh - 2rem);">
            <div class="modal-content h-100 d-flex flex-column">
                <div class="modal-header">
                    <h5 class="modal-title" id="planPreviewModalLabel">{{ 'backend.plan.review.preview_modal.title'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                </div>
                <div class="modal-body p-0 flex-grow-1 overflow-hidden d-flex flex-column" id="plan-preview-body">
                    <div class="text-center text-muted">{{ 'backend.plan.review.preview_modal.loading'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Modal de errores de evidencias #}
    <div class="modal fade" id="evidenceErrorModal" tabindex="-1" aria-labelledby="evidenceErrorModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="evidenceErrorModalLabel">{{ 'backend.plan.review.evidence_modal.title'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                </div>
                <div class="modal-body" data-plan-review-target="errorModalBody">
                    <!-- contenido desde Stimulus -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">{{ 'backend.common.close'|trans }}</button>
                </div>
            </div>
        </div>
    </div>

    {# Modal genérico #}
    <div class="modal fade" id="appModal" tabindex="-1" aria-labelledby="appModalLabel" aria-hidden="true">
        <div class="modal-dialog" data-plan-review-target="modalDialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="appModalLabel" data-plan-review-target="modalTitle">{{ 'backend.common.message'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'backend.common.close'|trans }}"></button>
                </div>
                <div class="modal-body" data-plan-review-target="modalBody">
                    <!-- contenido dinámico -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">{{ 'backend.common.ok'|trans }}</button>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
