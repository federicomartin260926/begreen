{# Se espera: measure y planMeasures #}
<div class="measure-card mb-3 bg_green_1 shadow py-3" id="measure-card">
    {% set categoryIcons = {
        'Alojamientos':'bi-house-door',
        'Transporte':'bi-truck',
        'Viajes':'bi-airplane',
        'Energía':'bi-lightning-charge',
        'Catering':'bi-cup-straw',
        'Materiales':'bi-box-seam',
        'Agua':'bi-droplet',
        'Residuos':'bi-recycle'
    } %}

    {% set measureBlock = measure.measureBlock ?? null %}
    {% set blockAnswer = currentBlockAnswer ?? null %}

    {# Cat y nombre seguros #}
    {% set cat = measure.category ?? null %}
    {% set catName = cat ? cat.name : (nextCategoryName ?? prevCategoryName ?? null) %}
    {% set catIcon = catName ? (categoryIcons[catName]|default('bi-info-circle')) : 'bi-info-circle' %}
    {% set departments = taxonomyPresenter.departmentBadges(measure, projectType|default(null)) %}

    {% if measureBlock and measureBlock.hasScreeningQuestion and blockAnswer is null %}
        <div class="alert alert-warning mb-3 px-3 py-2">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 gap-lg-3">
                <div class="d-flex flex-grow-1 flex-wrap align-items-baseline gap-2">
                    <span class="fw-semibold">{{ measureBlock.name }}</span>
                    <span>{{ measureBlock.screeningQuestion }}</span>
                </div>
                <div
                    class="measure-action-group d-flex flex-wrap justify-content-end gap-2 ms-auto"
                    role="group"
                    aria-label="{{ measureBlock.screeningQuestion }}">
                    <button
                        type="button"
                        class="btn btn-outline-danger px-3"
                        data-plan-measures-target="actionBtn"
                        data-measure-id="{{ measure.id }}"
                        data-field="blockQuestion"
                        data-value="false">
                        {{ 'backend.common.no'|trans }}
                    </button>
                    <button
                        type="button"
                        class="btn btn-outline-success px-3"
                        data-plan-measures-target="actionBtn"
                        data-measure-id="{{ measure.id }}"
                        data-field="blockQuestion"
                        data-value="true">
                        {{ 'backend.common.yes'|trans }}
                    </button>
                </div>
            </div>
        </div>
    {% endif %}

    <div
        class="alert alert-danger d-none mb-3"
        role="alert"
        data-plan-measures-target="errorAlert"></div>

    <div class="measure-card__meta d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <div class="d-flex flex-wrap align-items-center gap-2 gap-sm-3">
            <span class="badge bg-light border text-dark text-wrap" style="max-width: 100%;">
                <i class="bi {{ catIcon }}"></i>
                {{ catName ?? '—' }}
            </span>
            {% for department in departments %}
                <span class="badge bg-success-subtle text-success-emphasis border text-wrap" style="max-width: 100%;" title="{{ department.title|default(department.displayName) }}">
                    {{ department.displayName }}
                </span>
            {% endfor %}
        </div>

        {% if measureNavigation is defined and measureNavigation.total|default(0) > 0 %}
            <div class="measure-card__progress text-end ms-auto flex-shrink-0 small">
                <div class="fw-semibold text-success text-nowrap">
                    {{ 'backend.plan.progress_applicable'|trans({
                        '%current%': measureNavigation.current + 1,
                        '%total%': measureNavigation.total
                    }) }}
                </div>
                <div class="text-muted text-nowrap">{{ 'backend.plan.score.total_inline'|trans({'%gained%': scoreGained|default(0), '%max%': scoreMax|default(0)}) }}</div>
                <div class="text-muted text-nowrap">{{ 'backend.plan.score.current_inline'|trans({'%score%': measure.score is not null ? measure.score : 0}) }}</div>
            </div>
        {% endif %}
    </div>

    <h5 class="fw-semibold mb-2">{{ measure.questionText ?: measure.name }}</h5>

    <div class="measure-details bg-white shadow-sm rounded-3 p-3">
        <dl class="row mb-0">
            {% if measure.implementation %}
                <dt class="col-md-4 col-lg-2">{{ 'backend.plan.measure.implementation'|trans }}</dt>
                <dd class="col-md-8 col-lg-10">{{ measure.implementation }}</dd>
            {% endif %}
            {% if measure.description %}
                <dt class="col-md-4 col-lg-2">{{ 'backend.plan.measure.description'|trans }}</dt>
                <dd class="col-md-8 col-lg-10">
                    {% include 'backend/plan/_description_toggle.html.twig' with {
                        description: measure.description,
                        toggleId: 'measure-description-' ~ measure.id,
                        excerptLength: 200
                    } %}
                </dd>
            {% endif %}
            {% include 'backend/plan/_measure_taxonomy.html.twig' with {
                measure: measure,
                taxonomyPresenter: taxonomyPresenter,
                projectType: projectType|default(null),
                showDepartments: false,
                showOds: false,
                showVerificationSources: false
            } %}
        </dl>
    </div>

    {# Busca el PlanMeasure de esta medida #}
    {% set pm = null %}
    {% for item in planMeasures %}
        {% if item.measure.id == measure.id %}
            {% set pm = item %}
        {% endif %}
    {% endfor %}
    {# Helpers de estado #}
    {% set applicable = pm ? pm.isApplicable : null %}   {# null|true|false #}
    {% set critical  = pm ? pm.isCritical  : null %}     {# null|true|false #}
    {% set reason    = pm ? pm.criticalReason : '' %}
    {% set willImpl  = pm is not null ? pm.willImplement : null %}
    {% set implDone  = pm ? pm.isImplemented : false %}
    {% set decision  = pm is not null
        ? (pm.isApplicable is same as(false)
            ? 'na'
            : (pm.isApplicable is same as(true)
                ? (pm.willImplement is same as(true)
                    ? 'true'
                    : (pm.willImplement is same as(false) ? 'false' : null))
                : null))
        : null %}

    <div class="mt-3">

        {% if not (measureBlock and measureBlock.hasScreeningQuestion and blockAnswer is null) %}
            {# 1) ¿Quieres incluirla? #}
            <div class="text-center mb-2">{{ 'backend.plan.q.include_in_plan'|trans }}</div>
            <div class="measure-action-group d-flex justify-content-center gap-3">
                <button
                    type="button"
                    class="btn {% if decision == 'true' %}btn-success{% else %}btn-outline-success{% endif %} px-4"
                    data-plan-measures-target="actionBtn"
                    data-measure-id="{{ measure.id }}"
                    data-field="decision"
                    data-value="true">
                    {% if decision == 'true' %}<i class="bi bi-check-lg me-1"></i>{% endif %}
                    {{ 'backend.common.yes'|trans }}
                </button>

                <button
                    type="button"
                    class="btn {% if decision == 'false' %}btn-danger{% else %}btn-outline-danger{% endif %} px-4"
                    data-plan-measures-target="actionBtn"
                    data-measure-id="{{ measure.id }}"
                    data-field="decision"
                    data-value="false">
                    {% if decision == 'false' %}<i class="bi bi-check-lg me-1"></i>{% endif %}
                    {{ 'backend.common.no'|trans }}
                </button>

                <button
                    type="button"
                    class="btn {% if decision == 'na' %}btn-secondary{% else %}btn-outline-secondary{% endif %} px-4"
                    data-plan-measures-target="actionBtn"
                    data-measure-id="{{ measure.id }}"
                    data-field="decision"
                    data-value="na">
                    {% if decision == 'na' %}<i class="bi bi-check-lg me-1"></i>{% endif %}
                    {{ 'backend.plan.answers.not_applicable_project'|trans }}
                </button>
            </div>

            {# 2) ¿Crítica? (se renderiza oculta hasta que Aplica = true) #}
            <div
                data-plan-measures-section="critical"
                class="{% if not (applicable is same as(true) and willImpl is same as(true)) %}d-none{% endif %}">
                <div class="text-center mb-2">{{ 'backend.plan.q.critical'|trans }}</div>
                <div class="measure-action-group d-flex justify-content-center gap-3 mb-3">
                    {# No #}
                    <button
                        type="button"
                        class="btn {% if critical is same as(false) %}btn-danger{% else %}btn-outline-danger{% endif %} px-4"
                        data-plan-measures-target="actionBtn"
                        data-measure-id="{{ measure.id }}"
                        data-field="critical"
                        data-value="false">
                        {% if critical is same as(false) %}<i class="bi bi-check-lg me-1"></i>{% endif %}
                        {{ 'backend.common.no'|trans }}
                    </button>

                    {# Sí #}
                    <button
                        type="button"
                        class="btn {% if critical is same as(true) %}btn-success{% else %}btn-outline-success{% endif %} px-4"
                        data-plan-measures-target="actionBtn"
                        data-measure-id="{{ measure.id }}"
                        data-field="critical"
                        data-value="true">
                        {% if critical is same as(true) %}<i class="bi bi-check-lg me-1"></i>{% endif %}
                        {{ 'backend.common.yes'|trans }}
                    </button>
                </div>
            </div>

            {# 3) Motivo (solo visible si Crítica == true) #}
            <div
                data-plan-measures-section="critical-reason"
                class="{% if critical is not same as(true) %}d-none{% endif %}">
                <div class="d-flex justify-content-center mb-3">
                    <div class="w-100 text-center" style="max-width: 500px;">
                        <label for="crit-reason-{{ measure.id }}" class="form-label">{{ 'backend.plan.q.critical_reason'|trans }}</label>
                        <textarea
                            id="crit-reason-{{ measure.id }}"
                            rows="3"
                            class="form-control"
                            placeholder="{{ 'backend.plan.q.critical_reason_ph'|trans }}"
                            data-plan-measures-target="criticalReason"
                            data-measure-id="{{ measure.id }}"
                        >{{ reason }}</textarea>
                    </div>
                </div>
            </div>

            {% if not (measureBlock and measureBlock.hasScreeningQuestion and blockAnswer is null) %}
                <div
                    data-plan-measures-section="critical-continue"
                    class="{% if critical is not same as(true) %}d-none{% endif %}">
                    <div class="d-flex justify-content-center">
                        <button
                            type="button"
                            class="btn btn-success px-4"
                            {% if reason|trim == '' %}disabled{% endif %}
                            data-plan-measures-target="actionBtn"
                            data-plan-measures-action="critical-continue"
                            data-measure-id="{{ measure.id }}"
                            data-field="willImplement"
                            data-value="true">
                            {{ 'backend.plan.welcome.continue'|trans }}
                        </button>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
