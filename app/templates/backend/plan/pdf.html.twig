<!DOCTYPE html>
<html lang="{{ app.request.locale|default('es') }}">
<head>
  <meta charset="UTF-8">
  {% set project_short = project.name|slice(0, 50) ~ (project.name|length > 50 ? '…' : '') %}
  <title>{{ 'backend.plan.pdf.title'|trans({'%project%': project_short}) }}</title>
  <style>
    /* Página A4 apaisada + margen consistente para PDF */
    @page { size: A4 landscape; margin: 10mm; }

    /* Tipografía y layout base */
    body { font-family: Arial, sans-serif; font-size: 12px; color: #333; margin: 0; }
    h2, h3 { text-align: center; }
    h2 { font-size: 18px; margin: 0 0 6px; }
    h3 { font-size: 14px; margin: 0 0 8px; }

    .meta { text-align: center; margin: 8px 0 16px; font-size: 13px; }

    /* Tablas de resumen y detalle */
    .summary-table, .detail-table { width: 100%; border-collapse: collapse; margin: 0 0 18px; }
    .detail-table { table-layout: fixed; }
    th, td { border: 1px solid #999; padding: 6px; text-align: left; vertical-align: top; }
    .detail-table th,
    .detail-table td {
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    th { background-color: rgba(63, 195, 138, 0.40); }
    .page-break { page-break-before: always; }

    /* Cuadrícula 2×2 de gráficos (tabla fija = más robusta en dompdf) */
    table.charts-2col { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.charts-2col td { width: 50%; vertical-align: top; padding: 2.5mm; }

    .chart-box { page-break-inside: avoid; }
    .chart-box img { width: 100%; height: auto; max-height: 68mm; display: block; }
    .chart-caption { text-align: center; font-size: 11px; margin-top: 1.5mm; color: #555; font-weight: 600; line-height: 1.2; }
    .watermark {
      position: fixed;
      top: 35%;
      left: 8%;
      right: 8%;
      text-align: center;
      font-size: 56px;
      font-weight: 700;
      color: rgba(0, 0, 0, 0.12);
      transform: rotate(-28deg);
      z-index: 0;
    }
  </style>
</head>
<body>

  {% if hasWatermark is defined and hasWatermark %}
    <div class="watermark">PLAN BASIC - BEGREENMYFRIEND</div>
  {% endif %}

  {# --- Portada --- #}
  <div style="position:relative;z-index:1;">
  <h2>{{ 'backend.plan.pdf.h2'|trans({'%project%': project_short}) }}</h2>
  <div class="meta">
    {{ 'backend.plan.pdf.status'|trans({
        '%status%': ('backend.plan.status.' ~ plan.status)|trans
    })|raw }}<br>
    {{ 'backend.plan.pdf.date'|trans }} {{ "now"|date("d/m/Y") }}<br>
    {{ 'backend.plan.pdf.user'|trans }} {{ currentUserLabel|default(app.user.email ?? '') }}<br>

    {# ---línea: puntuación --- #}
    {% if scoreMax is defined and scoreMax > 0 %}
        <strong>{{ 'backend.plan.pdf.score.title'|trans }}</strong>
        {{ 'backend.plan.pdf.score.value'|trans({
        '%gained%': scoreGained,
        '%max%': scoreMax,
        '%pct%': (scorePct ~ '%')
        }) }}
    {% else %}
        <strong>{{ 'backend.plan.pdf.score.title'|trans }}</strong>
        {{ 'backend.plan.pdf.score.na'|trans }}
    {% endif %}
  </div>


  {% if activeFilters is not empty %}
    <div style="margin:0 0 16px;font-size:12px;background-color:rgb(204.2,222.8,218.8);border:1px solid rgb(153.4,190.6,182.6);padding:8px 12px;border-radius:4px;">
      <strong>{{ 'backend.plan.pdf.filters_applied'|trans }}</strong>
      <ul style="margin:6px 0 0 20px;padding:0;">
        {% for name, value in activeFilters %}
          <li>{{ name }}: {{ value }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if collaborationSummary is defined %}
    <div style="margin:0 0 16px;font-size:12px;background-color:#f8fafc;border:1px solid #d1d5db;padding:8px 12px;border-radius:4px;">
      <strong>{{ 'backend.plan.pdf.follow_up.title'|trans }}</strong>
      <ul style="margin:6px 0 0 20px;padding:0;">
        <li>{{ 'backend.plan.pdf.follow_up.to_implement'|trans }}: {{ collaborationSummary.toImplement }}</li>
        <li>{{ 'backend.plan.pdf.follow_up.implemented'|trans }}: {{ collaborationSummary.implemented }}</li>
        <li>{{ 'backend.plan.pdf.follow_up.verified_count'|trans }}: {{ collaborationSummary.verified }}</li>
        <li>{{ 'backend.plan.pdf.follow_up.evidences'|trans }}: {{ collaborationSummary.evidenceFiles }}</li>
      </ul>
    </div>
  {% endif %}

  {% if commitmentSummary is defined %}
    <div style="margin:0 0 16px;font-size:12px;background-color:#f8fafc;border:1px solid #d1d5db;padding:8px 12px;border-radius:4px;">
      <strong>{{ 'backend.plan.commitment.title'|trans }}</strong>
      <table style="width:100%;border-collapse:collapse;margin-top:6px;">
        <tr>
          <td style="width:50%;vertical-align:top;padding-right:8px;">
            <strong>{{ 'backend.plan.commitment.planned'|trans }}:</strong>
            {{ ('backend.plan.commitment.levels.' ~ commitmentSummary.planned.levelKey ~ '.label')|trans }}
            ({{ commitmentSummary.planned.percentageRounded }}%)
            <div style="color:#4b5563;margin-top:3px;">{{ ('backend.plan.commitment.levels.' ~ commitmentSummary.planned.levelKey ~ '.message')|trans }}</div>
            <div style="margin-top:3px;">{{ 'backend.plan.commitment.points_of_total'|trans({'%points%': commitmentSummary.planned.points, '%total%': commitmentSummary.totalOfficialPoints}) }}</div>
            {% if commitmentSummary.planned.pointsToNextLevel is not null and commitmentSummary.planned.levelKey != 'jungle' %}
              <div style="margin-top:3px;">{{ 'backend.plan.commitment.next_level'|trans({'%points%': commitmentSummary.planned.pointsToNextLevel}) }}</div>
            {% endif %}
          </td>
          <td style="width:50%;vertical-align:top;padding-left:8px;">
            <strong>{{ 'backend.plan.commitment.real'|trans }}:</strong>
            {{ ('backend.plan.commitment.levels.' ~ commitmentSummary.implemented.levelKey ~ '.label')|trans }}
            ({{ commitmentSummary.implemented.percentageRounded }}%)
            <div style="color:#4b5563;margin-top:3px;">{{ ('backend.plan.commitment.levels.' ~ commitmentSummary.implemented.levelKey ~ '.message')|trans }}</div>
            <div style="margin-top:3px;">{{ 'backend.plan.commitment.points_of_total'|trans({'%points%': commitmentSummary.implemented.points, '%total%': commitmentSummary.totalOfficialPoints}) }}</div>
            {% if commitmentSummary.implemented.pointsToNextLevel is not null and commitmentSummary.implemented.levelKey != 'jungle' %}
              <div style="margin-top:3px;">{{ 'backend.plan.commitment.next_level'|trans({'%points%': commitmentSummary.implemented.pointsToNextLevel}) }}</div>
            {% endif %}
          </td>
        </tr>
      </table>
    </div>
  {% endif %}

  {% if commitmentSummary is defined %}
    {% set hiddenMeasures = commitmentSummary.catalogMeasures - commitmentSummary.officialMeasures %}
    <div style="margin:0 0 16px;font-size:12px;background-color:#eff6ff;border:1px solid #bfdbfe;padding:8px 12px;border-radius:4px;">
      {{ 'backend.plan.tier.catalog_breakdown'|trans({
        '%included%': commitmentSummary.catalogMeasures,
        '%visible%': commitmentSummary.officialMeasures,
        '%skipped%': hiddenMeasures
      }) }}
    </div>
  {% endif %}

  {% if measuresByDpto is not empty %}
    <h3>{{ 'backend.plan.pdf.summary_by_department'|trans }}</h3>
    <table class="summary-table">
      <thead>
        <tr>
          <th>{{ 'backend.plan.pdf.th.department'|trans }}</th>
          <th>{{ 'backend.plan.pdf.th.total_measures'|trans }}</th>
          <th>{{ 'backend.plan.pdf.th.applicable'|trans }}</th>
          <th>{{ 'backend.plan.pdf.th.to_implement'|trans }}</th>
          <th>{{ 'backend.plan.pdf.th.critical_yes'|trans }}</th>
          {% if plan.status == 'completo' %}
            <th>{{ 'backend.plan.pdf.th.implemented'|trans }}</th>
          {% endif %}
        </tr>
      </thead>
      <tbody>
      {% for dpto, measures in measuresByDpto %}
        <tr>
          <td>{{ dpto }}</td>
          <td>{{ measures|length }}</td>
          <td>{{ measures|filter(pm => pm.isApplicable)|length }}</td>
          <td>{{ measures|filter(pm => pm.willImplement)|length }}</td>
          <td>{{ measures|filter(pm => pm.isCritical)|length }}</td>
          {% if plan.status == 'completo' %}
            <td>{{ measures|filter(pm => pm.isImplemented)|length }}</td>
          {% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>

    <div class="page-break"></div>

    {# --- Detalle por departamento --- #}
    {% for dpto, measures in measuresByDpto %}
      <h3>{{ dpto }}</h3>
      <table class="detail-table">
        <thead>
          <tr>
            <th>{{ 'backend.plan.pdf.th.measure'|trans }}</th>
            <th>{{ 'backend.plan.pdf.th.applicable_q'|trans }}</th>
            <th>{{ 'backend.plan.pdf.th.implement_q'|trans }}</th>
            {% if plan.status == 'completo' %}
              <th>{{ 'backend.plan.pdf.th.implemented_q'|trans }}</th>
            {% endif %}
            <th>{{ 'backend.plan.pdf.th.critical_reason'|trans }}</th>
            <th>{{ 'backend.plan.measure.department'|trans }}</th>
            <th>{{ 'backend.plan.pdf.th.ods'|trans }}</th>
            <th>{{ 'backend.plan.review.verification_sources'|trans }}</th>
            <th>Áreas de impacto</th>
            <th>Triple balance</th>
            <th>{{ 'backend.plan.pdf.th.follow_up'|trans }}</th>
            <th>{{ 'backend.plan.pdf.th.notes'|trans }}</th>
            <th>{{ 'backend.plan.pdf.th.esg'|trans }}</th>
            <th>{{ 'backend.plan.pdf.th.scope'|trans }}</th>
          </tr>
        </thead>
        <tbody>
        {% for pm in measures %}
          <tr>
            <td>
              {% if useDepartmentActionText|default(false) %}
                {{ pm.measure.departmentActionDisplayName }}
              {% else %}
                {{ pm.measure.displayNameForReview }}
              {% endif %}
            </td>
            <td>{{ pm.isApplicable ? ('backend.plan.preview.yes'|trans) : ('backend.plan.preview.no'|trans) }}</td>
            <td>{{ pm.willImplement ? ('backend.plan.preview.yes'|trans) : ('backend.plan.preview.no'|trans) }}</td>
            {% if plan.status == 'completo' %}
              <td>{{ pm.isImplemented ? ('backend.plan.preview.yes'|trans) : ('backend.plan.preview.no'|trans) }}</td>
            {% endif %}
            <td>
              {{ pm.isCritical is same as(true)
                  ? ('backend.plan.preview.yes'|trans)
                  : (pm.isCritical is same as(false) ? ('backend.plan.preview.no'|trans) : '—') }}
              {% if pm.criticalReason %}
                <div style="font-size:11px;color:#666;margin-top:4px;">{{ pm.criticalReason }}</div>
              {% endif %}
            </td>
            <td>
              {% set departments = pm.measure ? taxonomyPresenter.departmentBadges(pm.measure, project.type|default(null)) : [] %}
              {% if departments is not empty %}
                {% for department in departments %}
                  <span style="display:inline-block;border:1px solid #3fc38a;background:#eaf4ea;color:#1a3d1e;border-radius:999px;padding:2px 8px;margin:0 3px 3px 0;font-size:10px;"
                        title="{{ department.title|default(department.displayName) }}">
                    {{ department.displayName }}
                  </span>
                {% endfor %}
              {% else %}
                —
              {% endif %}
            </td>
            <td>
              {% set odsItems = pm.measure ? taxonomyPresenter.odsBadges(pm.measure) : [] %}
              {% if odsItems is not empty %}
                {% for ods in odsItems %}
                  <span style="display:inline-block;border:1px solid #b45309;background:#fef3c7;color:#92400e;border-radius:999px;padding:2px 8px;margin:0 3px 3px 0;font-size:10px;"
                        title="{{ ods.title|default(ods.label) }}">
                    {{ ods.badgeLabel|default(ods.label) }}
                  </span>
                {% endfor %}
              {% else %}
                —
              {% endif %}
            </td>
            <td>
              {% set sources = pm.measure ? taxonomyPresenter.verificationSourcesWithPriority(pm.measure) : [] %}
              {% if sources is not empty %}
                <div style="display:flex;flex-wrap:wrap;gap:4px;align-items:center;">
                  {% for link in sources %}
                    <span style="display:inline-block;border:1px solid #999;border-radius:999px;padding:2px 8px;font-size:10px;">
                      {{ link.displayName|default(link.name) }}
                    </span>
                  {% endfor %}
                </div>
              {% else %}
                {{ pm.measure.verificationSources|default('—') }}
              {% endif %}
            </td>
            <td>
              {% set impactAreas = pm.measure ? taxonomyPresenter.impactAreas(pm.measure) : [] %}
              {% if impactAreas is not empty %}
                {% for impactArea in impactAreas %}
                  <span style="display:inline-block;border:1px solid #3fc38a;border-radius:999px;padding:2px 6px;margin:0 3px 3px 0;">{{ impactArea.name }}</span>
                {% endfor %}
              {% else %}
                —
              {% endif %}
            </td>
            <td>
              {% set axes = pm.measure ? taxonomyPresenter.tripleBalanceAxes(pm.measure) : [] %}
              {% if axes is not empty %}
                {% for axis in axes %}
                  <span style="display:inline-block;border:1px solid #777;border-radius:999px;padding:2px 6px;margin:0 3px 3px 0;">{{ axis.name }}</span>
                {% endfor %}
              {% else %}
                —
              {% endif %}
            </td>
            <td>
              <div><strong>{{ 'backend.plan.pdf.follow_up.implemented'|trans }}:</strong> {{ pm.isImplemented ? ('backend.common.yes'|trans) : ('backend.common.no'|trans) }}</div>
              <div><strong>{{ 'backend.plan.pdf.follow_up.verified'|trans }}:</strong> {{ pm.isVerification() ? ('backend.common.yes'|trans) : ('backend.common.no'|trans) }}</div>
              <div><strong>{{ 'backend.plan.pdf.follow_up.evidences'|trans }}:</strong> {{ pm.evidence ? pm.evidence|split("\n")|filter(v => v)|length : 0 }}</div>
              <div>
                <strong>{{ 'backend.plan.pdf.follow_up.responsibles'|trans }}:</strong>
                {% set responsibles = [] %}
                {% for member in pm.responsibleCrewMembers %}
                  {% set responsibles = responsibles|merge([((member.name ?? '') ~ ' ' ~ (member.lastName ?? ''))|trim]) %}
                {% endfor %}
                {{ responsibles is not empty ? responsibles|join(', ') : '—' }}
              </div>
            </td>
            <td>
              {% if pm.publicComment %}
                <div style="white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;">{{ pm.publicComment }}</div>
              {% else %}
                —
              {% endif %}
              {% if pm.measure and pm.measure.description %}
                <div style="font-size:10px;color:#666;margin-top:4px;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;">{{ pm.measure.description }}</div>
              {% endif %}
            </td>
            <td>{{ pm.measure.esg.name|default('—') }}</td>
            <td>{{ pm.measure.scope.name|default('—') }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    {% endfor %}
  {% else %}
    <p style="text-align:center;margin-top:60px;font-style:italic;">{{ 'backend.plan.pdf.empty'|trans }}</p>
  {% endif %}

  {% if planChartsUrls is defined and planChartsUrls %}
    <div class="page-break"></div>
    <h3>{{ 'backend.plan.pdf.charts.title'|trans }}</h3>
    <table class="charts-2col">
      <tr>
        <td>
          <div class="chart-box">
            <img src="{{ planChartsUrls.summary }}" alt="{{ 'backend.plan.charts.measures'|trans }}">
            <div class="chart-caption">{{ 'backend.plan.charts.measures'|trans }}</div>
          </div>
        </td>
        <td>
          <div class="chart-box">
            <img src="{{ planChartsUrls.alcance }}" alt="{{ 'backend.plan.charts.reach'|trans }}">
            <div class="chart-caption">{{ 'backend.plan.charts.reach'|trans }}</div>
          </div>
        </td>
      </tr>
      <tr>
        <td>
          <div class="chart-box">
            <img src="{{ planChartsUrls.commitment }}" alt="{{ 'backend.plan.charts.commitment'|trans }}">
            <div class="chart-caption">{{ 'backend.plan.charts.commitment'|trans }}</div>
          </div>
        </td>
        <td>
          <div class="chart-box">
            <img src="{{ planChartsUrls.implementation }}" alt="{{ 'backend.plan.charts.performance'|trans }}">
            <div class="chart-caption">{{ 'backend.plan.charts.performance'|trans }}</div>
          </div>
        </td>
      </tr>
    </table>
  {% endif %}

  {% if customMeasures is defined and customMeasures is not empty %}
    <div class="page-break"></div>
    <h3>{{ 'backend.plan.pdf.custom_measures.title'|trans }}</h3>
    <table class="detail-table">
      <thead>
        <tr>
          <th>{{ 'backend.plan.pdf.custom_measures.th.title'|trans }}</th>
          <th>{{ 'backend.plan.pdf.custom_measures.th.score'|trans }}</th>
          <th>{{ 'backend.plan.pdf.custom_measures.th.state'|trans }}</th>
          <th>{{ 'backend.plan.pdf.custom_measures.th.description'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% for customMeasure in customMeasures %}
          <tr>
            <td>{{ customMeasure.title }}</td>
            <td>{{ customMeasure.score ?? '—' }}</td>
            <td>{{ ('backend.plan.review.custom_measures.state.' ~ customMeasure.state)|trans }}</td>
            <td>{{ customMeasure.description ?: '—' }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
  </div>

</body>
</html>
