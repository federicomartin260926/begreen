{% if upgradeCta.mode in ['comparison', 'single'] and upgradeCta.options is not empty %}
    {% set comparisonParams = {
        id: project.id,
        phase: upgradeCta.phase,
        from: upgradeCta.comparisonFrom|default('project')
    } %}
    <a
        href="{{ path('backend_project_plan_comparison', comparisonParams) }}"
        class="{{ upgradeCta.buttonClass|default('btn btn-primary btn-sm px-3 py-2 d-inline-flex align-items-center gap-1 shadow-sm') }} text-decoration-none">
        {% if upgradeCta.buttonIcon|default(false) %}
            <i class="bi {{ upgradeCta.buttonIcon }}"></i>
        {% endif %}
        {{ upgradeCta.buttonLabel|default(upgradeCta.label) }}
    </a>
{% elseif upgradeCta.mode == 'unavailable' %}
    <span class="badge bg-warning text-dark border border-warning-subtle">
        {{ upgradeCta.label }}
    </span>
{% else %}
    <span class="badge bg-success-subtle text-success border border-success-subtle">
        {{ 'backend.plan.upgrade.active_title'|trans }}
    </span>
{% endif %}
