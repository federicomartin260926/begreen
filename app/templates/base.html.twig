<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Be Green My Friend{% endblock %}</title>

    {# Meta SEO y favicon #}
    <meta name="description" content="{% block meta_description %}Proyecto de sostenibilidad y medio ambiente{% endblock %}">
    <link rel="icon" href="{{ asset('build/images/logo/favicon-75x75.png') }}" sizes="75x75" type="image/png">
    <link rel="icon" href="{{ asset('build/images/logo/favicon-300x300.png') }}" sizes="192x192" type="image/png">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    {% block stylesheets %}{% endblock %}
    {{ encore_entry_link_tags('app') }}
  </head>
  <body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
      <div class="container">
        <a class="navbar-brand" href="{{ path('home') }}">
          <img src="{{ asset('build/images/logo.svg') }}" alt="Logo" height="40">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
            <li class="nav-item text-uppercase"><a class="nav-link" href="{{ path('home') }}#servicios">{{ 'menu.services'|trans }}</a></li>
            <li class="nav-item text-uppercase"><a class="nav-link" href="{{ path('home') }}#clientes">{{ 'menu.customers'|trans }}</a></li>
            <li class="nav-item text-uppercase"><a class="nav-link" href="{{ path('home') }}#contactar">{{ 'menu.contact'|trans }}</a></li>
            <li class="nav-item"><div class="vr mx-2" style="height: 100%;"></div></li>

            {# Selector de idioma #}
            {% if app.request.attributes.get('_route') != 'app_reset_password' %}
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-uppercase text-decoration-none" href="#" id="languageMenuButton" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    {{ app.request.locale|upper }}
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageMenuButton">
                <li>
                    <a class="dropdown-item {% if app.request.locale == 'es' %}active{% endif %} text-decoration-none"
                    href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'_locale': 'es'})) }}">
                    🇪🇸 Español
                    </a>
                </li>
                <li>
                    <a class="dropdown-item {% if app.request.locale == 'en' %}active{% endif %} text-decoration-none"
                    href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'_locale': 'en'})) }}">
                    🇬🇧  English
                    </a>
                </li>
                </ul>
            </li>
            <li class="nav-item"><div class="vr mx-2" style="height: 100%;"></div></li>
            {% endif %}

            {# Login #}
            {% if not app.user %}
              <li class="nav-item">
                <a class="btn btn-success btn-sm text-white px-3 py-2 text-decoration-none" href="{{ path('app_login') }}">
                  {{ 'auth.sign_in'|trans }}
                </a>
                <a class="btn btn-outline-success btn-sm px-3 py-2 bg-white custom-hover text-decoration-none" href="{{ path('app_register') }}">
                  {{ 'auth.register'|trans }}
                </a>
              </li>
            {% else %}
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-decoration-none" href="#" role="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i>
                  {{ app.user.name|slice(0, 10) }}{% if app.user.name|length > 10 %}...{% endif %}
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li>
                        <a class="dropdown-item text-decoration-none{% if app.request.attributes.get('_route') == 'app_profile' %} active{% endif %}" href="{{ path('app_profile') }}">
                        <i class="bi bi-person-circle me-1"></i> {{ 'auth.profile'|trans }}
                        </a>
                    </li>
                    {% if app.request.attributes.get('_route') != 'app_backend' %}
                    <li>
                        <a class="dropdown-item text-decoration-none{% if app.request.attributes.get('_route') == 'app_backend' %} active{% endif %}" href="{{ path('app_backend') }}">
                        <i class="bi bi-speedometer2 me-1"></i> {{ 'menu.backend'|trans }}
                        </a>
                    </li>
                    {% endif %}
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-decoration-none{% if app.request.attributes.get('_route') == 'app_logout' %} active{% endif %}" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right me-1"></i> {{ 'auth.logout'|trans }}
                        </a>
                    </li>
                </ul>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main id="{{ app.request.attributes.get('_route') }}" class="py-5">
      <section class="bg-white">
        <div class="container">
            {% for label, messages in app.flashes %}
                {% set bootstrapClass = {
                    'success': 'success',
                    'danger': 'danger',
                    'error': 'danger',
                    'warning': 'warning',
                    'info': 'info'
                }[label]|default('secondary') %}

                {% for message in messages %}
                    <div class="alert alert-{{ bootstrapClass }} alert-dismissible fade show" role="alert">
                        {{ message|trans|raw }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </section>
        {% block body %}{% endblock %}
    </main>

    <!-- FOOTER -->
    <footer id="Footer" class="clearfix" role="contentinfo">
      <div class="container">
        <div class="row text-center text-md-start">

          <!-- Columna 1: Logo + texto + copyright -->
          <div class="col-12 col-md-4 mb-4">
            <img src="{{ asset('build/images/logo-white.svg') }}" alt="Logo" width="150" height="auto" />
            <div style="height:20px;"></div>
            <p>{{ 'footer.text'|trans }}</p>
            <p>© {{ "now"|date("Y") }} Be Green My Friend</p>
          </div>

          <!-- Columna 2: Enlaces Servicios y Clientes -->
          <div class="col-12 col-md-4 mb-4">
            <ul class="list-unstyled list-footer">
              <li><a href="{{ path('home') }}#servicios" title="Servicios" class="text-white-50 text-decoration-none">{{ 'menu.services'|trans }}</a></li>
              <li><a href="{{ path('home') }}#clientes" title="Clientes" class="text-white-50 text-decoration-none">{{ 'menu.customers'|trans }}</a></li>
            </ul>
          </div>

          <!-- Columna 3: Enlaces legales -->
          <div class="col-12 col-md-4 mb-4">
            <ul class="list-unstyled list-footer">
              <li><a href="{{ path('politica_privacidad') }}" title="Política de privacidad" class="text-white-50 text-decoration-none">{{ 'footer.policy'|trans }}</a></li>
              <li><a href="{{ path('aviso_legal') }}" title="Aviso legal" class="text-white-50 text-decoration-none">{{ 'footer.legal'|trans }}</a></li>
              <li><a href="{{ path('accesibilidad') }}" title="Accesibilidad" class="text-white-50 text-decoration-none">{{ 'footer.accessibility'|trans }}</a></li>
            </ul>
          </div>

        </div>
      </div>

      <!-- Footer inferior -->
      <div class="footer_copy bg-white py-4 mt-3">
        <div class="container">
          <div class="text-center">
            <img src="{{ asset('build/images/logos-kit-digital-transparent.png') }}" alt="Kit Digital" class="img-fluid" style="max-width: 100%; height: auto;" />
          </div>
        </div>
      </div>
    </footer>

    {% block javascripts %}{% endblock %}
    {{ encore_entry_script_tags('app') }}

  </body>
</html>
