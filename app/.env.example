# Symfony
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me

# Database (official stack: MariaDB)
DATABASE_URL="mysql://begreen:begreen@db:3306/begreenmyfriend?serverVersion=11.3&charset=utf8mb4"
MARIADB_DATABASE=begreenmyfriend
MARIADB_USER=begreen
MARIADB_PASSWORD=begreen
MARIADB_ROOT_PASSWORD=root

# Mail
MAILER_DSN=smtp://mailpit:1025
MESSENGER_TRANSPORT_DSN=null://null
CONTACT_EMAIL=contact@example.com
APP_MAIL_FROM=noreply@example.com

# Locales
DEFAULT_LOCALE=es
SECONDARY_LOCALE=en
LOCALES=es,en

# ReCAPTCHA / anti-bot
EWZ_RECAPTCHA_PUBLIC_KEY=change-me
EWZ_RECAPTCHA_PRIVATE_KEY=change-me
GOOGLE_RECAPTCHA_SITE_KEY=change-me
GOOGLE_RECAPTCHA_SECRET_KEY=change-me

# External APIs
ORS_API_KEY=

# Optional dev host ports
APP_HTTP_PORT=18080
APP_DB_PORT=3307
APP_PMA_PORT=8081
APP_MAILPIT_SMTP_PORT=1025
APP_MAILPIT_WEB_PORT=8025
